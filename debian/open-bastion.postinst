#!/bin/sh
set -e

. /usr/share/debconf/confmodule

CONF_FILE="/etc/open-bastion/openbastion.conf"
BACKUP_DIR="/var/backups/open-bastion"
PAM_SSHD="/etc/pam.d/sshd"
PAM_SUDO="/etc/pam.d/sudo"

backup_pam_file() {
    file="$1"
    name="$2"
    if [ -f "$file" ] && [ ! -f "$BACKUP_DIR/${name}.orig" ]; then
        mkdir -p "$BACKUP_DIR"
        cp -a "$file" "$BACKUP_DIR/${name}.orig"
    fi
}

# We deliberately do NOT edit sshd_config here: disabling password
# authentication from a package postinst can lock out an administrator
# connected over a password session. ob-bastion-setup writes the
# `PasswordAuthentication no` drop-in, and it is run deliberately.
#
# The generated PAM stack already denies (auth required pam_deny.so), so a
# password attempt is refused -- but only while sshd routes it through PAM.
# With `UsePAM no` sshd checks /etc/shadow itself and never consults the stack,
# so the mismatch is worth reporting rather than leaving silent.
warn_if_sshd_accepts_passwords() {
    _mode="$1"

    # mode-c ONLY: the one mode whose generated stack refuses passwords.
    # mode-b and mode-d both accept `auth sufficient pam_unix.so` by design,
    # so warning there would advise turning off a method the administrator
    # explicitly chose.
    case "$_mode" in
        mode-c) ;;
        *) return 0 ;;
    esac

    command -v sshd >/dev/null 2>&1 || return 0

    # Deliberately without -C: a connection spec would need a user, host and
    # address we do not have at install time. `Match` blocks are therefore not
    # evaluated, so a Match that re-enables PasswordAuthentication is not seen
    # and this check stays silent -- best-effort, never claims an absence.
    _eff=$(sshd -T 2>/dev/null) || return 0
    [ -n "$_eff" ] || return 0

    _pw=$(printf '%s\n' "$_eff" | sed -n 's/^passwordauthentication //p')
    _kbd=$(printf '%s\n' "$_eff" | sed -n 's/^kbdinteractiveauthentication //p')
    _usepam=$(printf '%s\n' "$_eff" | sed -n 's/^usepam //p')

    [ "$_pw" = "yes" ] || [ "$_kbd" = "yes" ] || return 0

    echo "open-bastion: WARNING - PAM mode '$_mode' expects certificate or key" >&2
    echo "  authentication, but sshd still accepts passwords" >&2
    echo "  (PasswordAuthentication=$_pw, KbdInteractiveAuthentication=$_kbd)." >&2
    echo "  The installed PAM stack denies password authentication, so logins" >&2
    echo "  are refused -- but that protection depends on sshd using PAM." >&2
    if [ "$_usepam" = "no" ]; then
        echo "  UsePAM is 'no' on this host: sshd checks /etc/shadow itself and" >&2
        echo "  never consults the PAM stack. Password logins are NOT refused." >&2
    fi
    echo "  Run ob-bastion-setup (or ob-backend-setup) to write the sshd" >&2
    echo "  drop-in that turns password authentication off." >&2

    return 0
}

generate_pam_sshd() {
    mode="$1"
    server_group="$2"
    cat << EOF
# /etc/pam.d/sshd - Configured by open-bastion
# Mode: $mode
# Server group: $server_group
#
EOF
    case "$mode" in
        mode-a)
            cat << EOF
# AUTHENTICATION: Only Open Bastion tokens accepted
auth       sufficient   pam_openbastion.so server_group=$server_group
auth       required     pam_deny.so
EOF
            ;;
        mode-b|mode-d)
            cat << EOF
# AUTHENTICATION: Open Bastion token OR Unix password
auth       sufficient   pam_openbastion.so server_group=$server_group
auth       sufficient   pam_unix.so nullok try_first_pass
auth       required     pam_deny.so
EOF
            ;;
        mode-c)
            cat << 'EOF'
# AUTHENTICATION: refused. SSH keys/certificates are validated by sshd, which
# never calls pam_authenticate() on that path, so this stack is only reached by
# password or keyboard-interactive authentication -- which this mode does not
# allow. pam_deny returns PAM_AUTH_ERR (a plain authentication failure).
auth       required     pam_deny.so
EOF
            ;;
    esac
    cat << EOF

# AUTHORIZATION: Open Bastion checks if user can access this server
account    required     pam_openbastion.so server_group=$server_group
account    required     pam_unix.so

# SESSION (pam_openbastion creates Unix account if needed)
session    required     pam_openbastion.so server_group=$server_group
session    required     pam_unix.so
EOF
}

generate_pam_sudo() {
    mode="$1"
    server_group="$2"
    cat << EOF
# /etc/pam.d/sudo - Configured by open-bastion
# Mode: $mode
# Server group: $server_group
#
EOF
    case "$mode" in
        mode-a)
            cat << EOF
# AUTHENTICATION: Only Open Bastion tokens accepted
auth       sufficient   pam_openbastion.so server_group=$server_group
auth       required     pam_deny.so
EOF
            ;;
        mode-b|mode-d)
            cat << EOF
# AUTHENTICATION: Open Bastion token OR Unix password
auth       sufficient   pam_openbastion.so server_group=$server_group
auth       sufficient   pam_unix.so nullok try_first_pass
auth       required     pam_deny.so
EOF
            ;;
        mode-c)
            cat << 'EOF'
# AUTHENTICATION: Permit -- this mode grants sudo without a password (the login
# control is the SSH key/certificate). Canonical fail-closed permit: pam_permit
# returns PAM_SUCCESS and success=1 skips exactly one module (the pam_deny
# below), landing on the trailing pam_permit which records the success. If
# pam_permit is missing or errors, default=ignore falls through to pam_deny and
# the stack refuses. The trailing pam_permit is mandatory: a jump that lands
# past the end of the stack records no positive result and PAM returns
# PAM_PERM_DENIED, so the jump/deny pair alone would deny every sudo.
auth       [success=1 default=ignore] pam_permit.so
auth       required     pam_deny.so
auth       required     pam_permit.so
EOF
            ;;
    esac
    cat << EOF

# AUTHORIZATION
account    required     pam_openbastion.so server_group=$server_group
account    required     pam_unix.so

# SESSION (pam_openbastion creates Unix account if needed)
session    required     pam_openbastion.so server_group=$server_group
session    required     pam_unix.so
EOF
}

generate_openbastion_conf() {
    portal_url="$1"
    client_id="$2"
    client_secret="$3"
    server_group="$4"
    create_user="$5"

    cat << EOF
# /etc/open-bastion/openbastion.conf
# Configured by open-bastion debconf
# Run 'dpkg-reconfigure open-bastion' to modify

# Open Bastion portal URL
portal_url = $portal_url

# OIDC client credentials
client_id = $client_id
client_secret = $client_secret

# Server authentication
server_token_file = /var/lib/open-bastion/token
server_group = $server_group

# HTTP settings
timeout = 10
verify_ssl = true

# Cache settings
cache_enabled = true
cache_dir = /var/cache/open-bastion
cache_ttl = 300

# Logging: error, warn, info, debug
log_level = warn

# Auto-create Unix accounts on first login
create_user = $create_user
EOF
}

case "$1" in
    configure)
        mkdir -p /etc/open-bastion
        chmod 755 /etc/open-bastion
        mkdir -p /var/cache/open-bastion
        chmod 700 /var/cache/open-bastion
        mkdir -p /var/lib/open-bastion
        chmod 711 /var/lib/open-bastion
        # NSS cross-process passwd cache (libnss_openbastion). 0711 = traversable
        # but NOT listable: entries stay 0644 so an unprivileged getpwnam()/
        # getpwuid() can read its own record, but no local account can readdir()
        # the directory and enumerate the SSO user directory wholesale -- this
        # matters most for byname/, whose filenames are the login names
        # themselves. The module re-asserts these modes at runtime; setting them
        # here closes the gap on upgrade from a version that shipped them 0755.
        mkdir -p /var/cache/nss_llng/byname
        chmod 711 /var/cache/nss_llng /var/cache/nss_llng/byname
        groupadd --system ob-sessions 2>/dev/null || true
        groupadd --system open-bastion-sudo 2>/dev/null || true
        mkdir -p /var/lib/open-bastion/sessions
        # Tamper-evident layout: root:ob-sessions 0750. Recordings are written by
        # the root sink (ob-record-sink) and are unreadable/undeletable by the
        # recorded user (NOT in ob-sessions); auditors in ob-sessions can read.
        # ob-bastion-setup re-asserts this and migrates any legacy user-owned
        # subdirs.
        chown root:ob-sessions /var/lib/open-bastion/sessions
        chmod 0750 /var/lib/open-bastion/sessions
        # Removes the setgid recorder wrapper if a prior version left it: the
        # current layout above no longer uses it.
        rm -f /usr/sbin/ob-session-recorder-wrapper

        db_get open-bastion/pam-mode
        MODE="$RET"

        if [ "$MODE" != "none" ] && [ -n "$MODE" ]; then
            db_get open-bastion/portal-url
            PORTAL_URL="$RET"
            db_get open-bastion/client-id
            CLIENT_ID="$RET"
            db_get open-bastion/client-secret
            CLIENT_SECRET="$RET"
            db_get open-bastion/server-group
            SERVER_GROUP="$RET"
            db_get open-bastion/configure-sudo
            CONFIGURE_SUDO="$RET"
            db_get open-bastion/sudo-server-group
            SUDO_SERVER_GROUP="$RET"
            db_get open-bastion/create-user
            CREATE_USER="$RET"

            if [ -z "$SUDO_SERVER_GROUP" ]; then
                SUDO_SERVER_GROUP="$SERVER_GROUP"
            fi

            if [ -n "$PORTAL_URL" ]; then
                generate_openbastion_conf "$PORTAL_URL" "$CLIENT_ID" "$CLIENT_SECRET" "$SERVER_GROUP" "$CREATE_USER" > "$CONF_FILE"
                chmod 600 "$CONF_FILE"
                chown root:root "$CONF_FILE"
            fi

            backup_pam_file "$PAM_SSHD" "sshd"
            generate_pam_sshd "$MODE" "$SERVER_GROUP" > "$PAM_SSHD"
            warn_if_sshd_accepts_passwords "$MODE"

            if [ "$CONFIGURE_SUDO" = "true" ]; then
                backup_pam_file "$PAM_SUDO" "sudo"
                generate_pam_sudo "$MODE" "$SUDO_SERVER_GROUP" > "$PAM_SUDO"
            fi

            mkdir -p /var/cache/open-bastion
            chmod 700 /var/cache/open-bastion

            # Mode 711 (NOT 700): the session recorder runs as the connecting
            # user and must traverse this directory to reach its own subdir
            # under sessions/. Secrets here stay protected by their own modes
            # (token is 600 root), so o+x exposes only traversal, not listing.
            mkdir -p /var/lib/open-bastion
            chmod 711 /var/lib/open-bastion

            # Migrates the server token from its legacy /etc location to
            # /var/lib (runtime state): it is rewritten every few minutes by
            # ob-heartbeat, whose ProtectSystem=strict sandbox needs /etc to
            # stay read-only. Idempotent.
            if [ -f /etc/open-bastion/token ] && [ ! -e /var/lib/open-bastion/token ]; then
                mv /etc/open-bastion/token /var/lib/open-bastion/token
                chown root:root /var/lib/open-bastion/token
                chmod 600 /var/lib/open-bastion/token
            fi
            for _cf in /etc/open-bastion/openbastion.conf /etc/open-bastion/nss_openbastion.conf; do
                [ -f "$_cf" ] && sed -i \
                    's#^\([[:space:]]*server_token_file[[:space:]]*=[[:space:]]*\)/etc/open-bastion/token#\1/var/lib/open-bastion/token#' \
                    "$_cf"
            done
            [ -f /etc/open-bastion/ssh-proxy.conf ] && sed -i \
                's#^\([[:space:]]*SERVER_TOKEN_FILE=\)"\{0,1\}/etc/open-bastion/token"\{0,1\}#\1"/var/lib/open-bastion/token"#' \
                /etc/open-bastion/ssh-proxy.conf

        fi

        # ALWAYS clear the OIDC client secret from the debconf database, even
        # when pam-mode is "none" -- otherwise it would sit unused forever in
        # /var/cache/debconf/passwords.dat.
        #
        # db_reset, not `db_set ""`: db_set leaves the question flagged as seen
        # with an empty answer, so a later reconfigure silently reuses the blank
        # instead of asking again. db_reset restores the template default and
        # clears the seen flag, which is what "forget this secret" should mean.
        db_reset open-bastion/client-secret || true
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

# ob-cert.socket (hop-certificate minting) and ob-record.socket (the session-
# recording sink) ship --no-enable/--no-start: the package can't know a host's
# role, so ob-bastion-setup is what enables them. A plain `apt upgrade` would
# therefore leave them inactive on an already configured bastion -- and since
# recording is fail-closed, every login is then refused. Re-enable them here,
# idempotently, but ONLY when this host is already a bastion: the sshd drop-in
# that ob-bastion-setup writes is the role marker. Runs after the
# debhelper-generated section so the unit files are registered and
# daemon-reload has happened. Failures are non-fatal; the admin can re-run
# ob-bastion-setup.
#
# NOTE: never write the literal debhelper substitution token in a comment
# here -- debhelper replaces that token wherever it appears, including inside
# comments, which splits the comment and leaves the trailing words as a stray
# command.
if [ "$1" = configure ] \
    && [ -d /run/systemd/system ] \
    && command -v systemctl >/dev/null 2>&1; then
    for _ob_dropin in /etc/ssh/sshd_config.d/*-open-bastion-bastion.conf; do
        [ -f "$_ob_dropin" ] || continue
        systemctl enable --now ob-cert.socket >/dev/null 2>&1 || true
        # Only when recording is enabled (the ForceCommand is absent under
        # ob-bastion-setup --disable-session-recorder).
        if grep -Eq '^[[:space:]]*ForceCommand[[:space:]]+.*ob-session-recorder' "$_ob_dropin"; then
            systemctl enable --now ob-record.socket >/dev/null 2>&1 || true
        fi
        break
    done
fi

# ob-fp.socket ships --no-enable/--no-start like the other sockets, but unlike
# ob-cert.socket it is needed on BOTH roles: a backend runs an
# AuthorizedPrincipalsCommand too. Enable it wherever either sshd drop-in
# exists. Without it the principals helper has nowhere to deposit and the
# fingerprint binding disappears with no error at login time.
if [ "$1" = configure ] \
    && [ -d /run/systemd/system ] \
    && command -v systemctl >/dev/null 2>&1; then
    for _ob_role in /etc/ssh/sshd_config.d/*-open-bastion-bastion.conf \
                    /etc/ssh/sshd_config.d/*-open-bastion-backend.conf; do
        [ -f "$_ob_role" ] || continue
        systemctl enable --now ob-fp.socket >/dev/null 2>&1 || true
        break
    done
fi

# Legacy cron jobs keep working until ob-post-upgrade replaces them with timers.
if [ "$1" = configure ] \
    && { [ -e /etc/cron.d/open-bastion-krl ] \
         || [ -e /etc/cron.daily/open-bastion-audit-rotate ] \
         || [ -e /etc/cron.weekly/open-bastion-audit-rotate ]; }; then
    echo "open-bastion: this host still runs the cron jobs of 0.6 (KRL refresh and/or" >&2
    echo "  audit rotation). They keep working; run 'ob-post-upgrade' to replace them" >&2
    echo "  with ob-krl-refresh.timer / ob-audit-rotate.timer, same schedule." >&2
fi

# pam_openbastion enforces ssh_key_policy_* fail-closed: with the policy
# enabled, a key whose type/size cannot be determined is DENIED. The key type
# reaches the module through the v1 key-metadata drop written by
# /usr/local/sbin/ob-ssh-principals -- and that helper is (re)written only by
# ob-bastion-setup / ob-backend-setup, never by this package. A plain upgrade
# therefore leaves a NEW module next to an OLD helper. Warn loudly here instead
# of letting the admin find out at the next login. Hosts that never enabled the
# policy (the default) are not concerned and print nothing.
_ob_conf=/etc/open-bastion/openbastion.conf
_ob_helper=/usr/local/sbin/ob-ssh-principals
if [ "$1" = configure ] && [ -f "$_ob_conf" ] && [ -f "$_ob_helper" ] \
    && grep -Eq '^[[:space:]]*ssh_key_policy(_enabled)?[[:space:]]*=[[:space:]]*(1|true|yes|on)[[:space:]]*$' "$_ob_conf" \
    && ! grep -q 'spool-format: v1' "$_ob_helper"; then
    echo "" >&2
    echo "*** open-bastion: ACTION REQUIRED ***" >&2
    echo "ssh_key_policy_enabled is set in $_ob_conf, but $_ob_helper" >&2
    echo "is the pre-v1 version and does not record the SSH key type." >&2
    echo "The PAM module now enforces this policy fail-closed, so SSH logins" >&2
    echo "will be DENIED until you re-run the setup script for this host:" >&2
    echo "    ob-bastion-setup ...      (bastion)" >&2
    echo "    ob-backend-setup ...      (backend)" >&2
    echo "or comment out ssh_key_policy_enabled to keep the previous behaviour." >&2
    echo "" >&2
fi
unset _ob_conf _ob_helper

exit 0
