usr/sbin/ob-sign-request
usr/sbin/ob-client-jwt
usr/sbin/ob-post-upgrade
usr/sbin/ob-service-account-keys
usr/sbin/ob-record-sink
usr/sbin/ob-cache-admin
usr/sbin/ob-session-prune

# Shared cert-vouching library (sourced by ob-ssh / ob-scp / ob-sftp)
usr/lib/open-bastion/ob-cert-lib.sh
usr/lib/open-bastion/ob-sign-lib.sh
usr/lib/open-bastion/ob-ssh-principals.bastion
usr/lib/open-bastion/ob-ssh-principals.backend
usr/lib/open-bastion/ob-fp-spool.tmpfiles
usr/lib/open-bastion/ob-portal-prerequisites.txt

# User scripts
usr/bin/ob-ssh-cert
usr/bin/ob-ssh
usr/bin/ob-scp
usr/bin/ob-sftp
usr/bin/ob-bastion-id
usr/bin/ob-cert-request
usr/bin/ob-record-connect

