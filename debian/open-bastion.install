usr/share/man/man1/ob-ssh-cert.1
usr/share/man/man1/ob-ssh.1
usr/share/man/man1/ob-scp.1
usr/share/man/man1/ob-sftp.1
usr/share/man/man1/ob-bastion-id.1
usr/share/man/man1/ob-cert-request.1
usr/share/man/man1/ob-record-connect.1
usr/share/man/man8/ob-enroll.8
usr/share/man/man8/ob-heartbeat.8
usr/share/man/man8/ob-bastion-setup.8
usr/share/man/man8/ob-standalone-setup.8
usr/share/man/man8/ob-backend-setup.8
usr/share/man/man8/ob-session-recorder.8
usr/share/man/man8/ob-session-prune.8
usr/share/man/man8/ob-cert-daemon.8
usr/share/man/man8/ob-fp-daemon.8
usr/share/man/man8/ob-fp-submit.8
usr/share/man/man8/ob-record-sink.8
usr/share/man/man8/ob-sign-request.8
usr/share/man/man8/ob-client-jwt.8
usr/share/man/man8/ob-post-upgrade.8

# Audit trace templates (deployed by `ob-bastion-setup --enable-audit-trace`)
usr/share/open-bastion/audit/rules.d/open-bastion.rules
usr/share/open-bastion/audit/cron.daily/open-bastion-audit-rotate

# logrotate template for the JSON audit log (copied to /etc/logrotate.d/ by the
# admin; not a conffile, since audit_log_file is configurable)
usr/share/open-bastion/logrotate/open-bastion

# Hardening templates (deployed by `ob-bastion-setup --enable-hardening`)
usr/share/open-bastion/hardening/logind.conf.d/open-bastion.conf
usr/share/open-bastion/hardening/security/limits.d/open-bastion.conf
usr/share/open-bastion/hardening/at.allow
usr/share/open-bastion/hardening/cron.allow

# Documentation
usr/share/doc/open-bastion/README.md

# Heartbeat systemd timer and service (not installed by cmake when INSTALL_SYSTEMD=OFF)
systemd/ob-heartbeat.timer lib/systemd/system/
systemd/ob-heartbeat.service lib/systemd/system/

# Session-recording retention timer and service. Enabled at install time by
# dh_installsystemd (see debian/rules); no ConditionPathExists gate, so it arms
# immediately and no-ops on hosts without recordings.
systemd/ob-session-prune.timer lib/systemd/system/
systemd/ob-session-prune.service lib/systemd/system/

# Socket-activated units, sockets and their @.service templates alike, installed
# from systemd/ like every other unit in this package (#254).
#
# The .socket files used to come from debian/open-bastion.ob-<name>.socket
# instead -- a second copy of the same content, which drifted: the hardening
# added to systemd/ in a9a28d8 never reached them. dh_installsystemd finds a
# unit already staged in the package tree (that is how ob-heartbeat.timer has
# always worked), so it still generates the enable/cleanup blocks from
# debian/rules; it just no longer needs its own copy of the file.
#
# The @.service templates are never "enabled" -- the .socket spawns instances --
# but must be present, or the socket cannot start one ("Connection refused").
systemd/ob-cert.socket usr/lib/systemd/system/
systemd/ob-cert@.service usr/lib/systemd/system/
systemd/ob-record.socket usr/lib/systemd/system/
systemd/ob-record@.service usr/lib/systemd/system/
systemd/ob-fp.socket usr/lib/systemd/system/
systemd/ob-fp@.service usr/lib/systemd/system/
