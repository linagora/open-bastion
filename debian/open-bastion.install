# Deployed by `ob-bastion-setup --enable-audit-trace`.
usr/share/open-bastion/audit/rules.d/open-bastion.rules

# NOT a conffile: audit_log_file is configurable.
usr/share/open-bastion/logrotate/open-bastion

# Deployed by `ob-bastion-setup --enable-hardening`.
usr/share/open-bastion/hardening/logind.conf.d/open-bastion.conf
usr/share/open-bastion/hardening/security/limits.d/open-bastion.conf
usr/share/open-bastion/hardening/at.allow
usr/share/open-bastion/hardening/cron.allow

usr/share/doc/open-bastion/README.md

# Not installed by cmake when INSTALL_SYSTEMD=OFF, so listed explicitly here.
systemd/ob-heartbeat.timer lib/systemd/system/
systemd/ob-heartbeat.service lib/systemd/system/

# No ConditionPathExists gate: it arms immediately and no-ops on hosts
# without recordings.
systemd/ob-session-prune.timer lib/systemd/system/
systemd/ob-session-prune.service lib/systemd/system/

# Not enabled at install (see debian/rules): the setup enables each where it
# applies.
systemd/ob-krl-refresh.timer lib/systemd/system/
systemd/ob-krl-refresh.service lib/systemd/system/
systemd/ob-audit-rotate.timer lib/systemd/system/
systemd/ob-audit-rotate.service lib/systemd/system/

# dh_installsystemd finds each unit already staged here and still generates
# the enable/cleanup blocks from debian/rules for it. The @.service templates
# are never "enabled" -- the .socket spawns instances -- but must be present,
# or the socket cannot start one ("Connection refused").
systemd/ob-cert.socket usr/lib/systemd/system/
systemd/ob-cert@.service usr/lib/systemd/system/
systemd/ob-record.socket usr/lib/systemd/system/
systemd/ob-record@.service usr/lib/systemd/system/
systemd/ob-fp.socket usr/lib/systemd/system/
systemd/ob-fp@.service usr/lib/systemd/system/
