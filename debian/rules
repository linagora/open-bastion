#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --with sphinxdoc

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DUSE_LIBSODIUM=ON \
		-DINSTALL_SYSTEMD=OFF \
		-DINSTALL_DESKTOP=ON \
		-DBUILD_DOC=ON

override_dh_auto_install:
	dh_auto_install
	# Stages the admin-builder tree so debian/open-bastion-builder.install can
	# pick it up: CMake does not build this pure-bash tool.
	install -Dm 0755 admin-builder/ob-builder debian/tmp/usr/bin/ob-builder
	install -dm 0755 debian/tmp/usr/share/open-bastion-builder/lib
	install -dm 0755 debian/tmp/usr/share/open-bastion-builder/templates
	install -dm 0755 debian/tmp/usr/share/open-bastion-builder/keyrings
	cp -a admin-builder/lib/.       debian/tmp/usr/share/open-bastion-builder/lib/
	cp -a admin-builder/templates/. debian/tmp/usr/share/open-bastion-builder/templates/
	cp -a admin-builder/keyrings/.  debian/tmp/usr/share/open-bastion-builder/keyrings/
	install -Dm 0644 admin-builder/man/ob-builder.1 debian/tmp/usr/share/man/man1/ob-builder.1

# -X/security/: NSS and PAM modules need ldconfig but no development symlinks.
override_dh_makeshlibs:
	dh_makeshlibs -X/security/

override_dh_installsystemd:
	dh_installsystemd -popen-bastion --name=ob-heartbeat ob-heartbeat.timer
	# No ConditionPathExists gate, unlike ob-heartbeat.timer: enabled and
	# started at install so it actually arms and bounds recording disk usage.
	dh_installsystemd -popen-bastion --name=ob-session-prune ob-session-prune.timer
	# Not enabled at install: ob-bastion-setup enables the first under
	# --max-security and the second under --enable-audit-trace.
	dh_installsystemd -popen-bastion --no-enable --no-start --name=ob-krl-refresh ob-krl-refresh.timer
	dh_installsystemd -popen-bastion --no-enable --no-start --name=ob-audit-rotate ob-audit-rotate.timer
	# Unit files come from systemd/ via debian/open-bastion.install;
	# dh_installsystemd finds them already staged and only generates the
	# enable/cleanup maintainer-script blocks. Not enabled/started at install
	# -- ob-bastion-setup activates it (bastion/standalone only).
	dh_installsystemd -popen-bastion --no-enable --no-start --name=ob-cert ob-cert.socket
	# Same arrangement as ob-cert.socket.
	dh_installsystemd -popen-bastion --no-enable --no-start --name=ob-record ob-record.socket
	# Same arrangement. Not enabled at install: only a bastion or backend runs
	# an AuthorizedPrincipalsCommand, so ob-bastion-setup / ob-backend-setup
	# activate it, and the postinst re-asserts it on upgrade.
	dh_installsystemd -popen-bastion --no-enable --no-start --name=ob-fp ob-fp.socket
	dh_installsystemd -popen-bastion-desktop --name=ob-session-monitor ob-session-monitor.service
