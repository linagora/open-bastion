[Unit]
Description=Open Bastion SSH fingerprint sink (per-deposit)
Documentation=https://github.com/linagora/open-bastion

[Service]
# systemd passes the connected socket as stdin AND stdout; the daemon reads
# the three-line request from fd 0 and writes its one-line verdict to fd 1.
ExecStart=/usr/sbin/ob-fp-daemon
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Owns /run/open-bastion/ssh-fp at 0700, so the shared `nobody` account cannot
# read other sessions' fingerprints or forge a drop.
User=root

# No network at all -- AF_UNIX for the activation socket, and that is the
# whole list.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true
UMask=0077
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The one exception to ProtectSystem=strict: the spool is the only thing it writes.
ReadWritePaths=/run/open-bastion
# Must see the real process tree to derive the sshd anchor from the peer's
# ancestry, so /proc cannot be hidden or subset'd here.
ProcSubset=all
ProtectProc=default
