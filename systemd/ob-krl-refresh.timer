[Unit]
Description=Open Bastion SSH key revocation list refresh timer
Documentation=man:ob-krl-refresh(8)

[Timer]
# --krl-refresh-interval overrides this in ob-krl-refresh.timer.d/schedule.conf.
OnCalendar=*:0/30
Persistent=true
# Spreads a fleet's requests to the portal, well inside the interval.
RandomizedDelaySec=1min

[Install]
WantedBy=timers.target
