[Unit]
Description=Open Bastion Heartbeat Timer
Documentation=man:ob-heartbeat(8)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/open-bastion/token

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min
Persistent=true
# Avoids a thundering herd across a fleet.
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
