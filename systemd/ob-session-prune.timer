[Unit]
Description=Open Bastion session-recording retention timer
Documentation=man:ob-session-prune(8)

[Timer]
# Unlike ob-heartbeat.timer there is no ConditionPathExists gate: on a host
# with no recordings (e.g. a backend) the job simply no-ops.
OnCalendar=daily
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
