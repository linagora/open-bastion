[Unit]
Description=Open Bastion auditd log rotation
Documentation=man:auditd(8) https://github.com/linagora/open-bastion/blob/main/doc/audit.rst
After=auditd.service

[Service]
Type=oneshot
# SIGUSR1 is auditd's "rotate the logs now" (`service auditd rotate`). A
# stopped auditd fails the unit, which is wanted.
ExecStart=systemctl kill --kill-who=main --signal=SIGUSR1 auditd.service

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
