[Unit]
Description=Open Bastion auditd log rotation timer
Documentation=https://github.com/linagora/open-bastion/blob/main/doc/audit.rst

[Timer]
# With num_logs=7 in auditd.conf, about a week of history (doc/audit.rst).
OnCalendar=daily
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
