[Unit]
Description=Open Bastion session recording sink (per-connection)
Documentation=https://github.com/linagora/open-bastion

[Service]
# systemd passes the connected socket as stdin; the sink reads the JSON header
# then the recording stream from fd 0.
ExecStart=/usr/sbin/ob-record-sink
StandardInput=socket
StandardError=journal
# Writes recordings the recorded user cannot touch
# (/var/lib/open-bastion/sessions/<user>/, root-owned, group ob-sessions).
User=root

# AF_INET(6) is required for NSS (getpwuid via libnss_openbastion / SSSD),
# which may be networked; AF_UNIX for the activation socket itself.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/open-bastion/sessions
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Does not weaken the recordings' group-read for auditors: the sink fchmod()s
# the session dir to 0750 and every file to 0640 explicitly, never relying on
# the umask for those.
UMask=0077
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
