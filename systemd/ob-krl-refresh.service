[Unit]
Description=Open Bastion SSH key revocation list refresh
Documentation=man:ob-krl-refresh(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/ob-krl-refresh
User=root
Group=root

# Root only because /etc/ssh and the file sshd reads are root's. Root without
# capabilities is enough for that: it owns both, so no DAC override is needed,
# and the one config file read (openbastion.conf, 0600 root) is root's too.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# It talks to the portal and to nothing else.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0022

# The new list is written next to the old one and renamed over it: a rename is
# atomic only within a directory, so the directory has to be writable, not just
# the file (a single-file bind mount cannot be renamed over at all). The sshd
# configuration in that directory decides who logs in, and this program has no
# business changing it: it stays read-only. The leading '-' tolerates a host
# that has one without the other.
ReadWritePaths=/etc/ssh
ReadOnlyPaths=-/etc/ssh/sshd_config -/etc/ssh/sshd_config.d
