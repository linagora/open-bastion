[Unit]
Description=Open Bastion SSH key revocation list refresh
Documentation=man:ob-krl-refresh(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/ob-krl-refresh
User=root
Group=root

# Root owns every file it touches, so it needs no capability.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0022

# The directory, not just the file: the new list is renamed over the old one.
# The sshd configuration in it stays read-only.
ReadWritePaths=/etc/ssh
ReadOnlyPaths=-/etc/ssh/sshd_config -/etc/ssh/sshd_config.d
