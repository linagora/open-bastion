[Unit]
Description=Open Bastion SSH fingerprint sink socket
Documentation=https://github.com/linagora/open-bastion

[Socket]
ListenStream=/run/open-bastion/ssh-fp.sock
# Restricted to the principals helper user, unlike ob-cert.socket: connecting
# here deposits into the spool pam_openbastion trusts. Defence in depth only
# -- ob-fp-daemon checks SO_PEERCRED itself and derives the sshd anchor from
# the peer's /proc ancestry.
# No SocketGroup: the group name differs across distributions (nogroup on
# Debian, nobody on RHEL/Rocky) -- naming one would fail to start on the other.
SocketUser=nobody
SocketMode=0600
Accept=yes
# Parent /run/open-bastion must exist before sockets.target; created at 0711
# by the package tmpfiles.d entry and by ob-bastion-setup.

[Install]
WantedBy=sockets.target
