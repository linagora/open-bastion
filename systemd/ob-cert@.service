[Unit]
Description=Open Bastion certificate minting (per-connection)
Documentation=https://github.com/linagora/open-bastion

[Service]
# systemd passes the connected socket as stdin AND stdout; the daemon reads
# the request from fd 0 and writes the LLNG JSON response to fd 1.
ExecStart=/usr/sbin/ob-cert-daemon
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Must read the root-only server token (/var/lib/open-bastion/token, 0600).
User=root

# AF_INET(6) is required for the HTTPS call to the portal and for NSS lookups
# (getpwuid via libnss_openbastion); AF_UNIX for the activation socket itself.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
# @system-service is systemd's broad, well-tested allow set; it keeps the
# AF_UNIX/AF_INET syscalls above intact while denying kexec, module loading,
# raw ptrace, clock setting, etc.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/open-bastion /var/lib/open-bastion
