[Unit]
Description=Open Bastion Offline Session Monitor
Documentation=man:ob-session-monitor(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/ob-session-monitor
Restart=on-failure
RestartSec=30
User=root
Group=root

NoNewPrivileges=yes
# NOT ProtectSystem=strict: the monitor legitimately writes (and CREATES)
# /etc/open-bastion/force_online, so /etc cannot be made fully read-only.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# force_online is listed as its DIRECTORY, not the file: the monitor appends
# with `>>`, CREATING the file when missing, which needs the parent directory
# writable -- and systemd refuses to start the unit if a ReadWritePaths= entry
# names a path that does not yet exist.
# ReadOnlyPaths= is applied after ReadWritePaths=, so openbastion.conf stays
# read-only despite the broader entry above.
ReadWritePaths=/run/open-bastion /etc/open-bastion
ReadOnlyPaths=/etc/open-bastion/openbastion.conf

PrivateNetwork=no

[Install]
WantedBy=multi-user.target
