{
  "attributes": {
    "sshCaActivation": {
      "type": "bool",
      "default": 0,
      "documentation": "SSH CA activation"
    },
    "sshCaAdminRule": {
      "type": "boolOrExpr",
      "default": 0,
      "documentation": "Rule granting access to the SSH CA administration endpoints (/ssh/admin, /ssh/certs, /ssh/revoke). These endpoints list and revoke every user's certificates, so there is no permissive default: an empty rule (or 0) denies everyone."
    },
    "sshCaKeyRef": {
      "type": "text",
      "documentation": "SSH CA key reference (key ID from LLNG keys)"
    },
    "sshCaCertMaxValidity": {
      "type": "int",
      "default": 365,
      "documentation": "SSH certificate max validity (days)"
    },
    "sshCaAllowedKeyTypes": {
      "type": "text",
      "default": "ed25519,ecdsa,sk-ed25519,sk-ecdsa,rsa",
      "documentation": "Allowed SSH key families for signing (comma-separated: ed25519, sk-ed25519, ecdsa, sk-ecdsa, rsa, dss)"
    },
    "sshCaMinKeyBits": {
      "type": "int",
      "default": 2048,
      "documentation": "Minimum SSH key size in bits (RSA/DSA only)"
    },
    "sshCaPrincipalSources": {
      "type": "text",
      "default": "$uid",
      "documentation": "SSH certificate principal sources (Perl expression)"
    },
    "sshCaKrlPath": {
      "type": "text",
      "default": "/var/lib/lemonldap-ng/ssh/revoked_keys",
      "documentation": "Path to SSH Key Revocation List file"
    },
    "sshCaSignMaxPerHour": {
      "type": "int",
      "default": 20,
      "documentation": "Maximum /ssh/sign calls per user per hour. 0 disables the limit. Bounds KRL growth: each re-signature of the same key revokes the superseded serial."
    },
    "sshCaMaxCertsPerUser": {
      "type": "int",
      "default": 20,
      "documentation": "Maximum active (non-revoked, non-expired) certificates per user. 0 disables the limit. Re-signing an existing key replaces its record and is not counted."
    }
  },
  "tree": [
    {
      "insert_into": "generalParameters/plugins",
      "insert_after": "oidcOfflineTokens",
      "nodes": [
        {
          "title": "sshCa",
          "help": "sshca.html",
