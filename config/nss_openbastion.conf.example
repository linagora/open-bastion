# /etc/open-bastion/nss_openbastion.conf - Configuration for libnss_openbastion
#
# This NSS module queries LemonLDAP::NG to resolve users.
# It allows SSH and other services to authenticate users that don't
# exist in /etc/passwd.

# LemonLDAP::NG portal URL (required)
portal_url = https://auth.example.com

# Server token file (from PAM module enrollment)
server_token_file = /var/lib/open-bastion/token

# HTTP timeout in seconds
timeout = 5

# Verify SSL certificates (set to false for testing only)
verify_ssl = true

# Cache TTL in seconds (how long to cache user info)
cache_ttl = 300

# Default shell for users without loginShell attribute. With force_shell, the
# shell of the recorded session.
default_shell = /bin/bash

# Login shell of every user this module resolves, whatever the portal supplies.
# Set on hosts that record sessions, never on a backend; see ob-login-shell(8).
# A value that is not a plain absolute path forces /usr/sbin/ob-login-shell.
#force_shell = /usr/sbin/ob-login-shell

# Base directory for home directories
default_home_base = /home

# UID range for auto-generated UIDs (when not provided by LLNG)
min_uid = 10000
max_uid = 60000

# Default GID (usually 'users' group = 100)
default_gid = 100

# Policy range for a *server-supplied* primary GID (the `gid` key of
# pamAccessExportedVars, usually an LDAP gidNumber). This is a group policy of
# its own, NOT the min_uid/max_uid range above: an ordinary gidNumber has no
# reason to live in the synthetic UID range.
#
# The default floor is 1000, the Debian/RHEL boundary between system groups
# (login.defs SYS_GID_MIN=100 .. SYS_GID_MAX=999) and user groups
# (login.defs GID_MIN=1000). It refuses gid 0 and every system group, including
# the dynamically allocated ones such as `docker` or `libvirt` that land in
# 100-999 on Debian and are root-equivalent.
#
# A gid outside this range is NOT fatal: it is replaced by default_gid and a
# warning is logged to syslog. Lower min_gid if you legitimately export a low
# gidNumber (100 = users, for instance).
#
# gid 0 is always refused, whatever min_gid says.
min_gid = 1000
max_gid = 65533
