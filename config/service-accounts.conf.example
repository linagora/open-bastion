# Service Accounts Configuration for Open Bastion
#
# This file lists local service accounts (ansible, backup, deploy, etc.)
# that authenticate via SSH key only, without OIDC authentication. Listing
# an account here exempts it from the SSO in pam_openbastion; nothing more.
#
# The Unix account is yours: create it before its first login, Open Bastion
# does not. On a host that records sessions give it the launcher as shell,
# since bash would read ~/.bashrc ahead of the recorder:
#   useradd --system --create-home --shell /usr/sbin/ob-login-shell ansible
# Its key goes to /etc/open-bastion/service-accounts.d/<name>.pub (root, 0644),
# served to sshd by ob-service-account-keys (ob-bastion-setup
# --enable-service-keys). If it needs sudo, write a sudoers rule for it:
# Open Bastion grants service accounts no sudo right.
#
# SECURITY: This file must be:
# - Owned by root (uid 0)
# - Mode 0600 (read/write only by owner)
# - Not a symlink
#
# File location: /etc/open-bastion/service-accounts.conf
# (configurable via service_accounts_file in openbastion.conf)
#
# Format:
#   [accountname]
#   key_fingerprint = SHA256:...      (aliases: fingerprint, ssh_key)
#
# The keys of older releases -- uid, gid, shell, home, gecos, sudo_allowed,
# sudo_nopasswd and their aliases -- are ignored, with a warning in the log.
#
# Account names must:
# - Start with a lowercase letter or underscore
# - Contain only lowercase letters, digits, underscores, and hyphens
# - Be at most 32 characters long
#
# Key fingerprint must:
# - Start with SHA256: or MD5:
# - Contain only base64-safe characters
#
# The fingerprint is compared with the one sshd reports for the session
# where one is available (certificate logins, or SSH_USER_AUTH with
# ExposeAuthInfo yes); on a plain-key login there is usually none, and the
# .pub file above is then what decides who logs in.
#
# The SSH key fingerprint can be obtained with:
#   ssh-keygen -lf /path/to/key.pub
#
# Example output: 256 SHA256:abc123def456 ansible@example.com (ED25519)
# Use the SHA256:... part as the fingerprint.

# Ansible automation account
# Used for configuration management and deployments
[ansible]
key_fingerprint = SHA256:CHANGE_ME_ansible_key_fingerprint

# Backup service account
# Used for automated backups (rsync, borg, restic, etc.)
[backup]
key_fingerprint = SHA256:CHANGE_ME_backup_key_fingerprint

# Monitoring agent account
# Used for Prometheus node exporter, Zabbix agent, etc.
[monitoring]
key_fingerprint = SHA256:CHANGE_ME_monitoring_key_fingerprint

# Deployment account
# Used for CI/CD pipelines (GitLab Runner, GitHub Actions, etc.)
[deploy]
key_fingerprint = SHA256:CHANGE_ME_deploy_key_fingerprint
