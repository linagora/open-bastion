replace || if (0 && !S_ISREG(st->st_mode)) {
suite   || tests/test_ob_cache_key.sh
why     || #268: the offline cache key file must be a regular file, not a fifo
why     || or a device that feeds the derivation attacker-chosen bytes.

id      || cache-key-nonblocking-open
file    || src/cache_key.c
search  || int fd = open(path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK);
replace || int fd = open(path, O_RDONLY | O_NOFOLLOW);
suite   || tests/test_ob_cache_key.sh
why     || #268: without O_NONBLOCK the S_ISREG refusal above is unreachable --
why     || opening a fifo read-only waits for a writer, so the check is never
why     || reached and the PAM path hangs instead of refusing.

