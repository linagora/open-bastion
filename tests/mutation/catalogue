search  || \n            rm -f "$stale"\n
replace || \n
suite   || tests/test_ob_setup_roles.sh
why     || #288: re-running a host under the other role must not leave the old
why     || drop-in behind. Both would be read, and a bastion's ForceCommand
why     || would then apply to every session of the new backend.

id      || setup-backend-vouching-token
file    || scripts/ob-bastion-setup
search  || principals_args="%u %f %i %t %k"
replace || principals_args="%u %f %t %k"
suite   || tests/test_ob_ssh_principals_spool.sh
why     || A backend's principals helper reads the certificate key-id (%i) to
why     || check which bastion vouched for the hop. Without it every argument
why     || after the fingerprint shifts by one: the key type is read as the
why     || key-id, and the vouching check no longer checks anything real.

id      || principals-bastion-refuses-backend-sshd
file    || share/ob-ssh-principals.bastion
