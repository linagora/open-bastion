replace || is_backend() { [ "$PROG_ROLE" = "backend" ]; }
suite   || tests/test_ob_setup_roles.sh
why     || #288: --node-role must configure the role it names. Keying the stack
why     || on the command name instead is exactly the old behaviour, where
why     || `ob-bastion-setup --node-role backend` wrote a full bastion -- recorder,
why     || ForceCommand, a principals helper that accepts direct SSO
why     || certificates -- and labelled it backend.

id      || setup-role-options-refused
file    || scripts/ob-bastion-setup
search  || \n    if [ "$bad" = "true" ]; then\n        exit 1\n    fi
replace || \n    :
suite   || tests/test_ob_setup_roles.sh
why     || #288: an option of one role given to another (--no-sudo on a bastion,
why     || --disable-session-recorder on a backend) must stop the run, not be
why     || silently ignored while reading like a decision that was carried out.

id      || setup-other-role-dropin-removed
