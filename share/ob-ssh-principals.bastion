#!/bin/sh
# ob-ssh-principals — sshd AuthorizedPrincipalsCommand helper.
# spool-format: v1 (fingerprint drop + key-metadata drop)
# Args: <username> <fingerprint> <key-type> <key-blob-base64>
#
# Prints the username if it resolves, and hands the key to ob-fp-daemon, which
# writes the .fp/.key drops: sshd exposes no key to PAM at pam_acct_mgmt.

# Five arguments is the backend's sshd line (role change in progress). This
# helper does no vouching, so deny rather than admit a direct SSO certificate.
if [ "$#" -gt 4 ]; then
    logger -t ob-ssh-principals -p authpriv.warning \
        "called with the backend's arguments by an sshd still configured as a backend; denying '$1' (finish the role change: re-run the setup, restart sshd)" \
        2>/dev/null || :
    exit 0
fi

USERNAME="$1"
FINGERPRINT="$2"
KEYTYPE="$3"
KEYBLOB="$4"

# Runs as the unprivileged AuthorizedPrincipalsCommandUser, so it cannot own
# the spool; the root daemon derives the session anchor from our /proc ancestry.
case "$FINGERPRINT" in
    SHA256:[A-Za-z0-9+/]*) : ;;
    *) FINGERPRINT="" ;;
esac
# Defense in depth (the daemon re-validates); keeps the deposit parseable.
case "$KEYTYPE" in
    ""|*[!A-Za-z0-9@._-]*) KEYTYPE="" ;;
esac
case "$KEYBLOB" in
    ""|*[!A-Za-z0-9+/=]*) KEYBLOB="" ;;
esac
if [ -n "$FINGERPRINT" ]; then
    # Never fatal: a lost binding drops an extra check and must not refuse a
    # login sshd has already accepted. OB_FP_SUBMIT is for the test suite.
    _ob_submit="${OB_FP_SUBMIT:-/usr/sbin/ob-fp-submit}"
    if [ -x "$_ob_submit" ]; then
        printf '%s\n%s\n%s\n' "$FINGERPRINT" "$KEYTYPE" "$KEYBLOB" \
            | "$_ob_submit" || :
    fi
fi

if getent passwd "$USERNAME" >/dev/null 2>&1; then
    echo "$USERNAME"
fi
