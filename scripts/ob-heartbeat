#!/bin/bash
#
# ob-heartbeat - Send heartbeat to LemonLDAP::NG PAM server
#
# This script is called periodically by systemd timer to send heartbeat
# to the LLNG portal, allowing the SSO to track active PAM servers.
#
# Copyright (C) 2025 Linagora
# License: AGPL-3.0

set -e

VERSION="0.3.2"
PROG_NAME=$(basename "$0")

CONFIG_FILE="/etc/open-bastion/openbastion.conf"
TOKEN_FILE="/var/lib/open-bastion/token"
STATS_FILE="/var/lib/open-bastion/stats.json"
TIMEOUT=10
# How long a run waits for another one to finish, in seconds (see lock_run).
LOCK_WAIT="${OB_HEARTBEAT_LOCK_WAIT:-60}"
[[ "$LOCK_WAIT" =~ ^[0-9]+$ ]] || LOCK_WAIT=60

log_info() {
    logger -t "$PROG_NAME" -p auth.info "$*"
}

log_warn() {
    logger -t "$PROG_NAME" -p auth.warning "$*"
}

log_error() {
    logger -t "$PROG_NAME" -p auth.err "$*"
}

log_debug() {
    if [ -n "$DEBUG" ]; then
        logger -t "$PROG_NAME" -p auth.debug "$*"
    fi
}

read_config() {
    local key="$1"
    local file="$2"

    if [ -f "$file" ]; then
        awk -F '=' -v key="$key" '
            $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
                val = substr($0, index($0, "=") + 1)
                # Trim leading whitespace
                gsub(/^[[:space:]]+/, "", val)
                # Remove inline comments (quote-aware)
                in_sq = 0; in_dq = 0; out = ""
                for (i = 1; i <= length(val); i++) {
                    c = substr(val, i, 1)
                    if (c == "\"" && in_sq == 0) in_dq = 1 - in_dq
                    else if (c == "'"'"'" && in_dq == 0) in_sq = 1 - in_sq
                    if (c == "#" && in_sq == 0 && in_dq == 0) break
                    out = out c
                }
                val = out
                gsub(/[[:space:]]+$/, "", val)
                # Remove surrounding matching quote pairs
                while (length(val) >= 2) {
                    first = substr(val, 1, 1)
                    last  = substr(val, length(val), 1)
                    if ((first == last) && (first == "\"" || first == "'"'"'")) {
                        val = substr(val, 2, length(val) - 2)
                    } else break
                }
                result = val
            }
            END { if (result != "") print result }
        ' "$file"
    fi
}

load_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        exit 1
    fi

    PORTAL_URL=$(read_config "portal_url" "$CONFIG_FILE")
    [ -z "$PORTAL_URL" ] && PORTAL_URL=$(read_config "portal" "$CONFIG_FILE")

    SERVER_GROUP=$(read_config "server_group" "$CONFIG_FILE")
    [ -z "$SERVER_GROUP" ] && SERVER_GROUP="default"

    # bastion | standalone | backend, written by the setup scripts.
    NODE_ROLE=$(read_config "node_role" "$CONFIG_FILE")

    local token_file_config
    token_file_config=$(read_config "server_token_file" "$CONFIG_FILE")
    [ -z "$token_file_config" ] && token_file_config=$(read_config "token_file" "$CONFIG_FILE")
    [ -n "$token_file_config" ] && TOKEN_FILE="$token_file_config"

    VERIFY_SSL=$(read_config "verify_ssl" "$CONFIG_FILE")
    [ -z "$VERIFY_SSL" ] && VERIFY_SSL="true"

    REPORT_SESSIONS=$(read_config "report_sessions" "$CONFIG_FILE")
    [ -z "$REPORT_SESSIONS" ] && REPORT_SESSIONS="true"

    # Must be a positive integer: it feeds `[ -ge ]` tests under `set -e`.
    MAX_SESSIONS=$(read_config "max_reported_sessions" "$CONFIG_FILE")
    if ! [[ "$MAX_SESSIONS" =~ ^[1-9][0-9]*$ ]]; then
        [ -n "$MAX_SESSIONS" ] &&
            log_warn "Invalid max_reported_sessions '$MAX_SESSIONS', using default 200"
        MAX_SESSIONS=200
    fi

    if [ -z "$PORTAL_URL" ]; then
        log_error "portal_url not configured"
        exit 1
    fi

    PORTAL_URL="${PORTAL_URL%/}"

    if [[ "$PORTAL_URL" != https://* ]] && [[ "$VERIFY_SSL" != "false" ]]; then
        log_warn "PORTAL_URL does not use HTTPS - credentials will be sent in clear text"
    fi
}

read_token() {
    if [ ! -f "$TOKEN_FILE" ]; then
        log_debug "Token file not found: $TOKEN_FILE"
        exit 0  # Exit silently - server may not be enrolled yet
    fi

    if head -1 "$TOKEN_FILE" | grep -q '^{'; then
        REFRESH_TOKEN=$(jq -r '.refresh_token // empty' "$TOKEN_FILE" 2>/dev/null)
    else
        log_debug "Token file is in legacy format, cannot send heartbeat"
        exit 0
    fi

    if [ -z "$REFRESH_TOKEN" ]; then
        log_debug "No refresh_token in token file"
        exit 0
    fi
}

get_stats() {
    if [ -f "$STATS_FILE" ]; then
        cat "$STATS_FILE"
    else
        echo '{}'
    fi
}

# JSON array of {user, from, tty, since}; '[]' when disabled or nothing found.
get_sessions() {
    case "$REPORT_SESSIONS" in
        true | 1 | yes | on) ;;
        *)
            echo '[]'
            return 0
            ;;
    esac

    local objs="" count=0 truncated=0

    # loginctl may exist without a working logind (containers, chroots): fall
    # back to who(1) rather than report an empty list.
    local ids=""
    if command -v loginctl >/dev/null 2>&1 &&
        ids=$(loginctl list-sessions --no-legend 2>/dev/null); then
        ids=$(printf '%s\n' "$ids" | awk '{print $1}')
        local id props
        for id in $ids; do
            [ -n "$id" ] || continue
            props=$(loginctl show-session "$id" \
                -p Name -p RemoteHost -p TTY -p Timestamp -p Class 2>/dev/null) || props=""
            local name="" remote="" tty="" class="" ts="" since="" key val
            while IFS='=' read -r key val; do
                case "$key" in
                    Name) name="$val" ;;
                    RemoteHost) remote="$val" ;;
                    TTY) tty="$val" ;;
                    Class) class="$val" ;;
                    Timestamp) ts="$val" ;;
                esac
            done <<EOF
$props
EOF
            [ "$class" = "user" ] || continue
            [ -n "$name" ] || continue
            if [ "$count" -ge "$MAX_SESSIONS" ]; then
                truncated=1
                break
            fi
            [ -n "$ts" ] && since=$(date -d "$ts" +%s 2>/dev/null || echo "")
            objs+=$(jq -cn \
                --arg user "$name" \
                --arg from "$remote" \
                --arg tty "$tty" \
                --argjson since "${since:-null}" \
                '{user: $user, from: $from, tty: $tty, since: $since}')
            objs+=$'\n'
            count=$((count + 1))
        done
    else
        # who(1) columns: NAME LINE DATE TIME [(HOST)].
        local user tty d t host since
        while read -r user tty d t host; do
            [ -n "$user" ] || continue
            if [ "$count" -ge "$MAX_SESSIONS" ]; then
                truncated=1
                break
            fi
            host=$(echo "$host" | tr -d '()')
            since=""
            [ -n "$d" ] && [ -n "$t" ] && since=$(date -d "$d $t" +%s 2>/dev/null || echo "")
            objs+=$(jq -cn \
                --arg user "$user" \
                --arg from "$host" \
                --arg tty "$tty" \
                --argjson since "${since:-null}" \
                '{user: $user, from: $from, tty: $tty, since: $since}')
            objs+=$'\n'
            count=$((count + 1))
        done < <(who 2>/dev/null || true)
    fi

    [ "$truncated" = "1" ] && log_warn "Reported session list truncated to $MAX_SESSIONS entries"

    if [ -z "$objs" ]; then
        echo '[]'
    else
        printf '%s' "$objs" | jq -s '.'
    fi
}

# No -f: a refusal (401, 403) must reach ob_pam_post, which verifies it when
# it is signed, and the branches below that name its cause.
build_curl_opts() {
    CURL_OPTS=("-s" "--tlsv1.3" "--connect-timeout" "$TIMEOUT")

    if [ "$VERIFY_SSL" = "false" ] || [ "$VERIFY_SSL" = "0" ]; then
        CURL_OPTS+=("-k")
    fi
}

_OB_SIGN_LIB="${OB_SIGN_LIB:-/usr/lib/open-bastion/ob-sign-lib.sh}"
if [ ! -r "$_OB_SIGN_LIB" ]; then
    _OB_SIGN_LIB="$(dirname "$(readlink -f "$0")")/ob-sign-lib.sh"
fi
if [ -r "$_OB_SIGN_LIB" ]; then
    # shellcheck source=scripts/ob-sign-lib.sh
    . "$_OB_SIGN_LIB"
else
    # Without the library nothing can check the portal's signed answers
    # (#339). Under response_signing = off nothing was going to be checked:
    # call the portal unsigned, as before #339, so that a broken install does
    # not let the bastion's token expire. Anything else -- prefer, required,
    # an unknown value, an unreadable configuration -- refuses to call it
    # rather than take its answer on trust.
    #
    # response_signing from openbastion.conf, read like ob_conf_get in the
    # library: the last occurrence wins, one layer of quotes is removed, an
    # unquoted value ends at a '#' that starts it or follows a blank. Prints
    # "off" when the key is absent or empty, "unreadable" when the file is.
    _ob_nolib_response_signing() {
        [ -r "$1" ] || { echo unreadable; return 0; }
        awk '
            function trim(s) { sub(/^[ \t\r\n\v\f]+/, "", s); sub(/[ \t\r\n\v\f]+$/, "", s); return s }
            {
                line = trim($0)
                c = substr(line, 1, 1)
                if (line == "" || c == "#" || c == ";" || c == "[") next
                eq = index(line, "=")
                if (!eq || trim(substr(line, 1, eq - 1)) != "response_signing") next
                v = trim(substr(line, eq + 1))
                q = substr(v, 1, 1)
                if (q == "\"" || q == "\047") {
                    v = substr(v, 2)
                    for (i = length(v); i > 0; i--) {
                        if (substr(v, i, 1) == q) { v = substr(v, 1, i - 1); break }
                    }
                } else {
                    for (i = 1; i <= length(v); i++) {
                        if (substr(v, i, 1) == "#" && (i == 1 || substr(v, i - 1, 1) ~ /[ \t]/)) {
                            v = trim(substr(v, 1, i - 1)); break
                        }
                    }
                }
                mode = v
            }
            END { print (mode == "" ? "off" : mode) }
        ' "$1" 2>/dev/null || echo unreadable
    }
    # Same contract as the library's ob_pam_post, minus the checks. Each
    # caller reads only part of the OB_PAM_* variables.
    # shellcheck disable=SC2034
    ob_pam_post() {
        local base="$1" path="$2" payload="$3" mode raw rc=0
        shift 3
        OB_PAM_STATUS="" OB_PAM_BODY="" OB_PAM_SIGNED="" OB_PAM_ANONYMOUS=false
        OB_PAM_ERROR="" OB_PAM_WARNING="" OB_PAM_CURL_RC=0 OB_SIGN_NOTE=""
        mode=$(_ob_nolib_response_signing "${OB_SIGN_CONFIG:-/etc/open-bastion/openbastion.conf}")
        if [ "$mode" != "off" ]; then
            OB_PAM_ERROR="ob-sign-lib.sh not found and response_signing is not off ($mode): $path not sent"
            return 1
        fi
        OB_SIGN_NOTE="ob-sign-lib.sh not found; sending $path unsigned"
        # The body on stdin, not argv: ob-heartbeat's carries the refresh_token.
        raw=$(printf '%s' "$payload" | curl --tlsv1.3 "$@" -X POST \
            -H "Content-Type: application/json" --data-binary @- \
            -w '\n__OB_HTTP__:%{http_code}' "${base}${path}" 2>&1) || rc=$?
        if [ "$rc" -ne 0 ]; then
            OB_PAM_CURL_RC=$rc
            OB_PAM_ERROR="request to $path failed (curl exit $rc)"
            return 1
        fi
        case "$raw" in
            *$'\n'__OB_HTTP__:*) ;;
            *) OB_PAM_ERROR="no HTTP status for $path"; return 1 ;;
        esac
        OB_PAM_STATUS="${raw##*$'\n'__OB_HTTP__:}"
        OB_PAM_BODY="${raw%$'\n'__OB_HTTP__:*}"
        OB_PAM_SIGNED=unsigned
        return 0
    }
fi

# Keeps the existing refresh_token / enrolled_at.
update_access_token() {
    local at="$1" ttl="$2"
    local now exp tmp
    now=$(date +%s)
    exp=$((now + ttl))
    tmp=$(mktemp "${TOKEN_FILE}.XXXXXX") || { log_error "mktemp failed for $TOKEN_FILE"; return 1; }
    if ! AT="$at" jq --argjson exp "$exp" \
        '.access_token = env.AT | .expires_at = $exp' \
        "$TOKEN_FILE" > "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        log_error "Failed to rewrite access token in $TOKEN_FILE (jq error)"
        return 1
    fi
    # Fail loudly if we cannot install the new file: otherwise the timer would
    # look healthy while NSS/PAM keep using a token that will soon expire.
    if ! chmod 600 "$tmp" || ! mv -f "$tmp" "$TOKEN_FILE"; then
        rm -f "$tmp"
        log_error "Failed to install updated token file $TOKEN_FILE"
        return 1
    fi
    log_debug "Refreshed access token (expires in ${ttl}s)"
    return 0
}

send_heartbeat() {
    local hostname
    hostname=$(hostname -f 2>/dev/null || hostname)

    local uptime_seconds
    uptime_seconds=$(cat /proc/uptime 2>/dev/null | cut -d. -f1 || echo "0")

    local stats
    stats=$(get_stats)

    local sessions
    sessions=$(get_sessions)

    local payload
    payload=$(jq -n \
        --arg refresh_token "$REFRESH_TOKEN" \
        --arg hostname "$hostname" \
        --arg server_group "$SERVER_GROUP" \
        --arg version "$VERSION" \
        --arg node_role "$NODE_ROLE" \
        --argjson uptime "$uptime_seconds" \
        --argjson stats "$stats" \
        --argjson sessions "$sessions" \
        '{
            refresh_token: $refresh_token,
            hostname: $hostname,
            server_group: $server_group,
            version: $version,
            node_role: $node_role,
            uptime: $uptime,
            stats: $stats,
            sessions: $sessions
        }')

    build_curl_opts

    # Receives the `jwks` claim of a verified answer (see rotate_jwks).
    # PrivateTmp in the unit: nobody else sees this /tmp.
    local jwks_claim
    jwks_claim=$(mktemp) || jwks_claim=""
    # shellcheck disable=SC2064  # expand now: the trap outlives the local
    trap "rm -f '$jwks_claim'" EXIT

    # Read by ob-sign-lib.sh, which shellcheck cannot follow across the `.`.
    # shellcheck disable=SC2034
    OB_SIGN_CONFIG="$CONFIG_FILE"
    # shellcheck disable=SC2034
    OB_PAM_JWKS_OUT="$jwks_claim"
    if ! ob_pam_post "$PORTAL_URL" /pam/heartbeat "$payload" "${CURL_OPTS[@]}"; then
        if [ "${OB_PAM_CURL_RC:-0}" -ne 0 ]; then
            log_error "Failed to send heartbeat to ${PORTAL_URL}/pam/heartbeat: $OB_PAM_ERROR"
        else
            log_error "Heartbeat answer refused: $OB_PAM_ERROR"
        fi
        exit 1
    fi
    if [ -n "${OB_SIGN_NOTE:-}" ]; then
        log_debug "$OB_SIGN_NOTE"
    fi
    if [ -n "${OB_PAM_WARNING:-}" ]; then
        log_warn "$OB_PAM_WARNING"
    fi

    local response="$OB_PAM_BODY"
    local http_code="$OB_PAM_STATUS"

    if [ "$http_code" = "200" ]; then
        log_debug "Heartbeat sent successfully to $PORTAL_URL"

        local next_interval
        next_interval=$(echo "$response" | jq -r '.next_heartbeat // empty' 2>/dev/null)
        if [ -n "$next_interval" ]; then
            log_debug "Next heartbeat in ${next_interval}s"
        fi

        # Each heartbeat mints a fresh access token; persist it.
        local new_at new_ttl
        new_at=$(echo "$response" | jq -r '.access_token // empty' 2>/dev/null)
        new_ttl=$(echo "$response" | jq -r '.expires_in // empty' 2>/dev/null)
        if [ -n "$new_at" ]; then
            update_access_token "$new_at" "${new_ttl:-3600}" || exit 1
        fi

        if [ -n "$jwks_claim" ]; then
            rotate_jwks "$jwks_claim" || exit 1
        fi
    elif [ "$http_code" = "401" ]; then
        log_error "Heartbeat rejected: invalid or expired refresh_token"
        exit 1
    elif [ "$http_code" = "403" ]; then
        log_error "Heartbeat rejected: server not enrolled via Device Authorization"
        exit 1
    else
        log_error "Heartbeat failed with HTTP $http_code: $response"
        exit 1
    fi
}

# The kids of a JWKS file, comma-separated, for the log.
jwks_kids() {
    jq -r '[.keys[]? | .kid? // "?" | tostring] | join(",")' "$1" 2>/dev/null || echo "?"
}

# The fingerprint of a JWKS, given its canonical form (`jq -S -c .` output
# without its final newline): the SHA-256 of `jq -S -c . FILE`, the value
# ob-builder, the setup scripts and the installer use (--sso-jwks-sha256,
# PORTAL-CHECKLIST), which an operator gets with `jq -S -c . FILE | sha256sum`.
jwks_sha256() {
    printf '%s\n' "$1" | sha256sum | cut -d' ' -f1
}

# JWKS rotation (#339). The portal's signed heartbeat answer carries its
# current signature keys (`jwks`). They replace sso_jwks_file only when they
# arrived in an answer that verified against that very file: signed by a key
# this host already trusts, addressed to this client (`aud`), HTTP 200. A
# chain of trust from the provisioned keys, never a fetch: a key set taken on
# TLS alone would bring the protection back down to TLS. ob_pam_post writes
# the claim only for such an answer; the checks are repeated here so that this
# function stands on its own.
#
# Returns non-zero only when a key set that should be installed could not be:
# the host would then refuse every answer once the portal signs with its new
# key, and the unit failing is how that shows.
rotate_jwks() {
    local candidate="$1" target dir tmp info old_kids new_kids cur_c new_c old_fp

    [ "${OB_PAM_SIGNED:-}" = "verified" ] || return 0
    [ "${OB_PAM_ANONYMOUS:-true}" = "false" ] || return 0
    [ "${OB_PAM_STATUS:-}" = "200" ] || return 0
    case "${OB_RS_MODE:-off}" in prefer|required|invalid) ;; *) return 0 ;; esac
    [ -s "$candidate" ] || return 0

    target="$OB_RS_JWKS"
    # Verified against this file a moment ago; if it is gone or no longer a
    # regular file, the setup owns it now.
    if [ ! -f "$target" ] || [ -L "$target" ]; then
        return 0
    fi

    if ! new_c=$(jq -S -c . "$candidate" 2>/dev/null) || [ -z "$new_c" ]; then
        log_warn "The heartbeat answer carries a jwks claim that is not JSON; $target kept"
        return 0
    fi
    cur_c=$(jq -S -c . "$target" 2>/dev/null) || cur_c=""
    [ "$new_c" = "$cur_c" ] && return 0

    # Never install a key set that would refuse every answer.
    if ! info=$("$OB_RS_HELPER" check-jwks "$candidate" 2>&1); then
        log_warn "The portal sent a JWKS with no usable signature key ($info); $target kept"
        return 0
    fi

    # Written next to the file and renamed over it, so that the modules never
    # read half a trust anchor. ob-heartbeat.service lets the script write
    # under /var/lib/open-bastion only (ProtectSystem=strict): a sso_jwks_file
    # anywhere else, /etc included, cannot be rotated, and the run fails here.
    dir=$(dirname "$target")
    if ! tmp=$(mktemp "$dir/.sso-jwks.XXXXXX" 2>/dev/null); then
        log_error "Cannot create a file in $dir: the portal's new JWKS is not installed, $target kept. ob-heartbeat.service may only write under /var/lib/open-bastion: keep sso_jwks_file there (default /var/lib/open-bastion/jwks/sso-jwks.json)"
        return 1
    fi
    # Canonical form, as the setup scripts write it: its sha256sum is the
    # fingerprint.
    if ! printf '%s\n' "$new_c" > "$tmp" \
        || ! chmod 0644 "$tmp" \
        || { [ "$(id -u)" = "0" ] && ! chown 0:0 "$tmp"; } \
        || ! "$OB_RS_HELPER" check-jwks --anchor --quiet "$tmp" >/dev/null 2>&1; then
        rm -f "$tmp"
        log_error "Cannot write the portal's new JWKS next to $target; $target kept"
        return 1
    fi

    old_kids=$(jwks_kids "$target")
    new_kids=$(jwks_kids "$tmp")
    old_fp="?"
    [ -z "$cur_c" ] || old_fp=$(jwks_sha256 "$cur_c")
    if ! mv -f "$tmp" "$target"; then
        rm -f "$tmp"
        log_error "Cannot replace $target with the portal's new JWKS"
        return 1
    fi
    log_info "Signature keys of the portal rotated in $target: kids [$old_kids] -> [$new_kids], SHA-256 (jq -S -c . | sha256sum) $old_fp -> $(jwks_sha256 "$new_c")"
    return 0
}

# One run at a time: a manual run and the timer's must not interleave their
# token and JWKS updates -- an older answer's key set installed over a newer
# one could leave the host trusting a key the portal no longer signs with.
# Held on the token file's directory, which the unit may already write.
lock_run() {
    local dir
    command -v flock >/dev/null 2>&1 || return 0
    dir=$(dirname "$TOKEN_FILE")
    [ -d "$dir" ] || return 0
    exec 9<"$dir" || return 0
    if ! flock -w "$LOCK_WAIT" 9; then
        log_error "Another ob-heartbeat has held the lock on $dir for ${LOCK_WAIT}s; giving up"
        exit 1
    fi
}

usage() {
    cat << EOF
Usage: $PROG_NAME [OPTIONS]

Send heartbeat to LemonLDAP::NG PAM server.

Options:
  -c, --config FILE    Configuration file (default: $CONFIG_FILE)
  -t, --token-file F   Token file (default: $TOKEN_FILE)
  -d, --debug          Enable debug logging
  -h, --help           Show this help
  -V, --version        Show version

EOF
    exit 0
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -c|--config)
                CONFIG_FILE="$2"
                shift 2
                ;;
            -t|--token-file)
                TOKEN_FILE="$2"
                shift 2
                ;;
            -d|--debug)
                DEBUG=1
                shift
                ;;
            -h|--help)
                usage
                ;;
            -V|--version)
                echo "$PROG_NAME version $VERSION"
                exit 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                exit 1
                ;;
        esac
    done
}

main() {
    parse_args "$@"
    load_config
    lock_run
    read_token
    send_heartbeat
}

main "$@"
