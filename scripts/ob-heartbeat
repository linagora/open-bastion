#!/bin/bash
#
# ob-heartbeat - Send heartbeat to LemonLDAP::NG PAM server
#
# This script is called periodically by systemd timer to send heartbeat
# to the LLNG portal, allowing the SSO to track active PAM servers.
#
# Copyright (C) 2025 Linagora
# License: AGPL-3.0

set -e

VERSION="0.3.2"
PROG_NAME=$(basename "$0")

CONFIG_FILE="/etc/open-bastion/openbastion.conf"
TOKEN_FILE="/var/lib/open-bastion/token"
STATS_FILE="/var/lib/open-bastion/stats.json"
TIMEOUT=10

log_info() {
    logger -t "$PROG_NAME" -p auth.info "$*"
}

log_warn() {
    logger -t "$PROG_NAME" -p auth.warning "$*"
}

log_error() {
    logger -t "$PROG_NAME" -p auth.err "$*"
}

log_debug() {
    if [ -n "$DEBUG" ]; then
        logger -t "$PROG_NAME" -p auth.debug "$*"
    fi
}

read_config() {
    local key="$1"
    local file="$2"

    if [ -f "$file" ]; then
        awk -F '=' -v key="$key" '
            $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
                val = substr($0, index($0, "=") + 1)
                # Trim leading whitespace
                gsub(/^[[:space:]]+/, "", val)
                # Remove inline comments (quote-aware)
                in_sq = 0; in_dq = 0; out = ""
                for (i = 1; i <= length(val); i++) {
                    c = substr(val, i, 1)
                    if (c == "\"" && in_sq == 0) in_dq = 1 - in_dq
                    else if (c == "'"'"'" && in_dq == 0) in_sq = 1 - in_sq
                    if (c == "#" && in_sq == 0 && in_dq == 0) break
                    out = out c
                }
                val = out
                gsub(/[[:space:]]+$/, "", val)
                # Remove surrounding matching quote pairs
                while (length(val) >= 2) {
                    first = substr(val, 1, 1)
                    last  = substr(val, length(val), 1)
                    if ((first == last) && (first == "\"" || first == "'"'"'")) {
                        val = substr(val, 2, length(val) - 2)
                    } else break
                }
                result = val
            }
            END { if (result != "") print result }
        ' "$file"
    fi
}

load_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        exit 1
    fi

    PORTAL_URL=$(read_config "portal_url" "$CONFIG_FILE")
    [ -z "$PORTAL_URL" ] && PORTAL_URL=$(read_config "portal" "$CONFIG_FILE")

    SERVER_GROUP=$(read_config "server_group" "$CONFIG_FILE")
    [ -z "$SERVER_GROUP" ] && SERVER_GROUP="default"

    # bastion | standalone | backend, written by the setup scripts.
    NODE_ROLE=$(read_config "node_role" "$CONFIG_FILE")

    local token_file_config
    token_file_config=$(read_config "server_token_file" "$CONFIG_FILE")
    [ -z "$token_file_config" ] && token_file_config=$(read_config "token_file" "$CONFIG_FILE")
    [ -n "$token_file_config" ] && TOKEN_FILE="$token_file_config"

    VERIFY_SSL=$(read_config "verify_ssl" "$CONFIG_FILE")
    [ -z "$VERIFY_SSL" ] && VERIFY_SSL="true"

    REPORT_SESSIONS=$(read_config "report_sessions" "$CONFIG_FILE")
    [ -z "$REPORT_SESSIONS" ] && REPORT_SESSIONS="true"

    # Must be a positive integer: it feeds `[ -ge ]` tests under `set -e`.
    MAX_SESSIONS=$(read_config "max_reported_sessions" "$CONFIG_FILE")
    if ! [[ "$MAX_SESSIONS" =~ ^[1-9][0-9]*$ ]]; then
        [ -n "$MAX_SESSIONS" ] &&
            log_warn "Invalid max_reported_sessions '$MAX_SESSIONS', using default 200"
        MAX_SESSIONS=200
    fi

    if [ -z "$PORTAL_URL" ]; then
        log_error "portal_url not configured"
        exit 1
    fi

    PORTAL_URL="${PORTAL_URL%/}"

    if [[ "$PORTAL_URL" != https://* ]] && [[ "$VERIFY_SSL" != "false" ]]; then
        log_warn "PORTAL_URL does not use HTTPS - credentials will be sent in clear text"
    fi
}

read_token() {
    if [ ! -f "$TOKEN_FILE" ]; then
        log_debug "Token file not found: $TOKEN_FILE"
        exit 0  # Exit silently - server may not be enrolled yet
    fi

    if head -1 "$TOKEN_FILE" | grep -q '^{'; then
        REFRESH_TOKEN=$(jq -r '.refresh_token // empty' "$TOKEN_FILE" 2>/dev/null)
    else
        log_debug "Token file is in legacy format, cannot send heartbeat"
        exit 0
    fi

    if [ -z "$REFRESH_TOKEN" ]; then
        log_debug "No refresh_token in token file"
        exit 0
    fi
}

get_stats() {
    if [ -f "$STATS_FILE" ]; then
        cat "$STATS_FILE"
    else
        echo '{}'
    fi
}

# JSON array of {user, from, tty, since}; '[]' when disabled or nothing found.
get_sessions() {
    case "$REPORT_SESSIONS" in
        true | 1 | yes | on) ;;
        *)
            echo '[]'
            return 0
            ;;
    esac

    local objs="" count=0 truncated=0

    # loginctl may exist without a working logind (containers, chroots): fall
    # back to who(1) rather than report an empty list.
    local ids=""
    if command -v loginctl >/dev/null 2>&1 &&
        ids=$(loginctl list-sessions --no-legend 2>/dev/null); then
        ids=$(printf '%s\n' "$ids" | awk '{print $1}')
        local id props
        for id in $ids; do
            [ -n "$id" ] || continue
            props=$(loginctl show-session "$id" \
                -p Name -p RemoteHost -p TTY -p Timestamp -p Class 2>/dev/null) || props=""
            local name="" remote="" tty="" class="" ts="" since="" key val
            while IFS='=' read -r key val; do
                case "$key" in
                    Name) name="$val" ;;
                    RemoteHost) remote="$val" ;;
                    TTY) tty="$val" ;;
                    Class) class="$val" ;;
                    Timestamp) ts="$val" ;;
                esac
            done <<EOF
$props
EOF
            [ "$class" = "user" ] || continue
            [ -n "$name" ] || continue
            if [ "$count" -ge "$MAX_SESSIONS" ]; then
                truncated=1
                break
            fi
            [ -n "$ts" ] && since=$(date -d "$ts" +%s 2>/dev/null || echo "")
            objs+=$(jq -cn \
                --arg user "$name" \
                --arg from "$remote" \
                --arg tty "$tty" \
                --argjson since "${since:-null}" \
                '{user: $user, from: $from, tty: $tty, since: $since}')
            objs+=$'\n'
            count=$((count + 1))
        done
    else
        # who(1) columns: NAME LINE DATE TIME [(HOST)].
        local user tty d t host since
        while read -r user tty d t host; do
            [ -n "$user" ] || continue
            if [ "$count" -ge "$MAX_SESSIONS" ]; then
                truncated=1
                break
            fi
            host=$(echo "$host" | tr -d '()')
            since=""
            [ -n "$d" ] && [ -n "$t" ] && since=$(date -d "$d $t" +%s 2>/dev/null || echo "")
            objs+=$(jq -cn \
                --arg user "$user" \
                --arg from "$host" \
                --arg tty "$tty" \
                --argjson since "${since:-null}" \
                '{user: $user, from: $from, tty: $tty, since: $since}')
            objs+=$'\n'
            count=$((count + 1))
        done < <(who 2>/dev/null || true)
    fi

    [ "$truncated" = "1" ] && log_warn "Reported session list truncated to $MAX_SESSIONS entries"

    if [ -z "$objs" ]; then
        echo '[]'
    else
        printf '%s' "$objs" | jq -s '.'
    fi
}

build_curl_opts() {
    CURL_OPTS=("-s" "-f" "--connect-timeout" "$TIMEOUT")

    if [ "$VERIFY_SSL" = "false" ] || [ "$VERIFY_SSL" = "0" ]; then
        CURL_OPTS+=("-k")
    fi
}

_OB_SIGN_LIB="${OB_SIGN_LIB:-/usr/lib/open-bastion/ob-sign-lib.sh}"
if [ ! -r "$_OB_SIGN_LIB" ]; then
    _OB_SIGN_LIB="$(dirname "$(readlink -f "$0")")/ob-sign-lib.sh"
fi
if [ -r "$_OB_SIGN_LIB" ]; then
    # shellcheck source=scripts/ob-sign-lib.sh
    . "$_OB_SIGN_LIB"
else
    # A broken install must not stop a bastion from renewing its token: send
    # the request unsigned, which a portal in `required` refuses visibly.
    SIGN_HEADERS=()
    # OB_SIGN_NOTE is read by the call sites below, not here.
    # shellcheck disable=SC2034
    ob_sign_request() { SIGN_HEADERS=(); OB_SIGN_ERROR=""; \
        OB_SIGN_NOTE="ob-sign-lib.sh not found; sending $2 unsigned"; return 0; }
fi

# Keeps the existing refresh_token / enrolled_at.
update_access_token() {
    local at="$1" ttl="$2"
    local now exp tmp
    now=$(date +%s)
    exp=$((now + ttl))
    tmp=$(mktemp "${TOKEN_FILE}.XXXXXX") || { log_error "mktemp failed for $TOKEN_FILE"; return 1; }
    if ! AT="$at" jq --argjson exp "$exp" \
        '.access_token = env.AT | .expires_at = $exp' \
        "$TOKEN_FILE" > "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        log_error "Failed to rewrite access token in $TOKEN_FILE (jq error)"
        return 1
    fi
    # Fail loudly if we cannot install the new file: otherwise the timer would
    # look healthy while NSS/PAM keep using a token that will soon expire.
    if ! chmod 600 "$tmp" || ! mv -f "$tmp" "$TOKEN_FILE"; then
        rm -f "$tmp"
        log_error "Failed to install updated token file $TOKEN_FILE"
        return 1
    fi
    log_debug "Refreshed access token (expires in ${ttl}s)"
    return 0
}

send_heartbeat() {
    local hostname
    hostname=$(hostname -f 2>/dev/null || hostname)

    local uptime_seconds
    uptime_seconds=$(cat /proc/uptime 2>/dev/null | cut -d. -f1 || echo "0")

    local stats
    stats=$(get_stats)

    local sessions
    sessions=$(get_sessions)

    local payload
    payload=$(jq -n \
        --arg refresh_token "$REFRESH_TOKEN" \
        --arg hostname "$hostname" \
        --arg server_group "$SERVER_GROUP" \
        --arg version "$VERSION" \
        --arg node_role "$NODE_ROLE" \
        --argjson uptime "$uptime_seconds" \
        --argjson stats "$stats" \
        --argjson sessions "$sessions" \
        '{
            refresh_token: $refresh_token,
            hostname: $hostname,
            server_group: $server_group,
            version: $version,
            node_role: $node_role,
            uptime: $uptime,
            stats: $stats,
            sessions: $sessions
        }')

    build_curl_opts

    # Read by ob-sign-lib.sh, which shellcheck cannot follow across the `.`.
    # shellcheck disable=SC2034
    OB_SIGN_CONFIG="$CONFIG_FILE"
    if ! ob_sign_request POST /pam/heartbeat "$payload"; then
        log_error "$OB_SIGN_ERROR"
        exit 1
    fi
    if [ -n "${OB_SIGN_NOTE:-}" ]; then
        log_debug "$OB_SIGN_NOTE"
    fi

    local response
    local http_code

    response=$(curl "${CURL_OPTS[@]}" "${SIGN_HEADERS[@]}" -w "\n%{http_code}" \
        -X POST "${PORTAL_URL}/pam/heartbeat" \
        -H "Content-Type: application/json" \
        -d "$payload" 2>&1) || {
        log_error "Failed to send heartbeat to ${PORTAL_URL}/pam/heartbeat"
        exit 1
    }

    http_code=$(echo "$response" | tail -1)
    response=$(echo "$response" | sed '$d')

    if [ "$http_code" = "200" ]; then
        log_debug "Heartbeat sent successfully to $PORTAL_URL"

        local next_interval
        next_interval=$(echo "$response" | jq -r '.next_heartbeat // empty' 2>/dev/null)
        if [ -n "$next_interval" ]; then
            log_debug "Next heartbeat in ${next_interval}s"
        fi

        # Each heartbeat mints a fresh access token; persist it.
        local new_at new_ttl
        new_at=$(echo "$response" | jq -r '.access_token // empty' 2>/dev/null)
        new_ttl=$(echo "$response" | jq -r '.expires_in // empty' 2>/dev/null)
        if [ -n "$new_at" ]; then
            update_access_token "$new_at" "${new_ttl:-3600}" || exit 1
        fi
    elif [ "$http_code" = "401" ]; then
        log_error "Heartbeat rejected: invalid or expired refresh_token"
        exit 1
    elif [ "$http_code" = "403" ]; then
        log_error "Heartbeat rejected: server not enrolled via Device Authorization"
        exit 1
    else
        log_error "Heartbeat failed with HTTP $http_code: $response"
        exit 1
    fi
}

usage() {
    cat << EOF
Usage: $PROG_NAME [OPTIONS]

Send heartbeat to LemonLDAP::NG PAM server.

Options:
  -c, --config FILE    Configuration file (default: $CONFIG_FILE)
  -t, --token-file F   Token file (default: $TOKEN_FILE)
  -d, --debug          Enable debug logging
  -h, --help           Show this help
  -V, --version        Show version

EOF
    exit 0
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -c|--config)
                CONFIG_FILE="$2"
                shift 2
                ;;
            -t|--token-file)
                TOKEN_FILE="$2"
                shift 2
                ;;
            -d|--debug)
                DEBUG=1
                shift
                ;;
            -h|--help)
                usage
                ;;
            -V|--version)
                echo "$PROG_NAME version $VERSION"
                exit 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                exit 1
                ;;
        esac
    done
}

main() {
    parse_args "$@"
    load_config
    read_token
    send_heartbeat
}

main "$@"
