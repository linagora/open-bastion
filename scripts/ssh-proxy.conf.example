# ob-ssh configuration
#
# Read (never sourced) by ob-ssh, ob-scp and ob-sftp on the bastion.
# Copy this file to /etc/open-bastion/ssh-proxy.conf and adjust the values.

# LemonLDAP::NG portal URL (required)
PORTAL_URL="https://auth.example.com"

# Server token file (from ob-enroll), read by ob-cert-daemon.
SERVER_TOKEN_FILE="/var/lib/open-bastion/token"

# Ignored: the portal derives the bastion's group from its server token.
SERVER_GROUP="bastion"

# Target server group for backends
# Backends should be in this group to accept connections from this bastion
TARGET_GROUP="default"

# HTTP timeout for LLNG API calls (seconds)
TIMEOUT=10

# Verify SSL certificates
# Set to false only for testing with self-signed certificates
VERIFY_SSL=true

# Additional SSH options to pass when connecting to backends
# Examples:
#   SSH_OPTIONS="-o ConnectTimeout=10"
#   SSH_OPTIONS="-o StrictHostKeyChecking=no"
SSH_OPTIONS=""

# Enable debug output (logs to stderr)
DEBUG=false
