#!/bin/bash
# shellcheck disable=SC2155
#
# ob-bastion-setup - Configure a server as an Open Bastion node with LLNG
#
# One script for the three node roles. The role comes from the name the
# script is invoked under -- the other two are symlinks to this file -- and
# --node-role overrides it:
#
#   ob-bastion-setup     bastion     SSH entry point: accepts SSO certificates,
#                                    records every session (ForceCommand), mints
#                                    hop certificates for ob-ssh
#   ob-standalone-setup  standalone  the bastion stack, on a host with nothing
#                                    behind it; only the recorded role differs
#   ob-backend-setup     backend     reached through a bastion: accepts only
#                                    bastion-vouched certificates, creates Unix
#                                    accounts, authorizes sudo via LLNG rules
#
# Everything role-specific is keyed on the EFFECTIVE role (NODE_ROLE after
# option parsing), never on the program name, so `--node-role backend`
# configures a backend whatever the command was called.
#
# Copyright (C) 2025 Linagora
# Author: Xavier Guimard <xguimard@linagora.com>
# License: AGPL-3.0

set -euo pipefail

VERSION="0.2.3"
PROG_NAME=$(basename "$0")

# Default configuration
PORTAL_URL=""
# SERVER_GROUP must match a group defined in LLNG (pamAccessServerGroups);
# there is no sensible default, so we leave it empty and prompt for it in
# main() if --server-group was not provided.
SERVER_GROUP=""
SERVER_TOKEN=""
# Node role: what this run configures, recorded in openbastion.conf and
# reported in the heartbeat. PROG_ROLE is the default the command name gives;
# NODE_ROLE is the effective role, which --node-role overrides. Nothing may
# branch on the role before parse_args() has run.
case "$PROG_NAME" in
    ob-backend-setup)    PROG_ROLE="backend" ;;
    ob-standalone-setup) PROG_ROLE="standalone" ;;
    *)                   PROG_ROLE="bastion" ;;
esac
NODE_ROLE="$PROG_ROLE"
# Options that only mean something for one role, as given on the command
# line. They are checked against the effective role once parsing is over,
# because --node-role may come after them.
BACKEND_ONLY_OPTS=()
BASTION_ONLY_OPTS=()
SHOW_HELP=false
NODE_ROLE_GIVEN=false
NON_INTERACTIVE=false
VERIFY_SSL=true
TIMEOUT=30
DRY_RUN=false
BACKUP_DIR="/var/backup/open-bastion-setup-$(date +%Y%m%d-%H%M%S)"
MAX_SECURITY=false
# KRL refresh interval in minutes (Mode E), --krl-refresh-interval. The packaged
# ob-krl-refresh.timer runs every 30; any other value becomes a drop-in.
KRL_REFRESH_INTERVAL=30
KRL_INTERVAL_GIVEN=false
# How the summary describes the refresh schedule; set by download_krl.
KRL_SCHEDULE="every 30 min"
KRL_REFRESH_BIN="/usr/sbin/ob-krl-refresh"
ENABLE_AUDIT_TRACE=false
# ── Bastion and standalone only ──
# Session recording is a core bastion guarantee and is ON by default.
# Pass --disable-session-recorder to opt out (e.g. when recording is handled
# by an external mechanism); this skips recorder configuration and removes
# ForceCommand from the sshd config.
DISABLE_SESSION_RECORDER=false

# ── Backend only ──
# LLNG-authorized sudo (--no-sudo) and account creation (--no-create-user).
ENABLE_SUDO=true
CREATE_USERS=true
# Space/comma-separated list of bastion_id values (the enrolling client_id of a
# bastion) this backend accepts certs from. Empty = accept any vouched bastion
# (still rejects direct user SSO certs, which carry no bastion= key-id).
BASTION_ALLOWED_IDS=""
ALLOW_ANY_BASTION=false
# nobody-readable allowlist consumed by the AuthorizedPrincipalsCommand helper
# (openbastion.conf is 0600 root, so the helper cannot read the list from there).
OB_ALLOWED_BASTIONS_FILE="/etc/open-bastion/allowed_bastions"

# OIDC client credentials. CLIENT_ID defaults to "pam-access" inside ob-enroll
# when empty here. CLIENT_SECRET is empty in public-client mode; if the LLNG
# client requires authentication, set it via --client-secret-file or the
# OB_CLIENT_SECRET env var (CLI arg avoided to keep the secret out of /proc).
CLIENT_ID=""
CLIENT_SECRET=""

# Paths
SSH_CA_FILE="/etc/ssh/open-bastion_ca.pub"
SSHD_CONFIG="/etc/ssh/sshd_config"
SSHD_CONFIG_DIR="/etc/ssh/sshd_config.d"
PAM_SSHD="/etc/pam.d/sshd"
OB_CONFIG="/etc/open-bastion/openbastion.conf"
OB_TOKEN="/var/lib/open-bastion/token"
# ForceCommand points directly at the recorder. The recording is streamed to the
# root sink (ob-record-sink) over a socket, so the recorder no longer needs the
# old setgid ob-session-recorder-wrapper (which created a user-owned per-user
# dir — exactly what the tamper-evident design removes).
SESSION_RECORDER="/usr/sbin/ob-session-recorder"
SESSION_RECORDER_CONF="/etc/open-bastion/session-recorder.conf"
# ob-ssh's own configuration (bastion stack only; see configure_ssh_proxy)
SSH_PROXY_CONF="/etc/open-bastion/ssh-proxy.conf"
SSH_REVOKED_KEYS="/etc/ssh/revoked_keys"
PAM_SUDO="/etc/pam.d/sudo"
# sudo 1.9 uses a separate PAM service ("sudo-i") for `sudo -i`. It must get the
# same open-bastion stack as /etc/pam.d/sudo, otherwise `sudo -i` falls back to
# the distro default (common-auth/common-account = pam_unix), which cannot
# validate NSS-only SSO users and fails with "account validation failure".
PAM_SUDO_I="/etc/pam.d/sudo-i"
NSSWITCH_CONF="/etc/nsswitch.conf"
NSS_OB_CONF="/etc/open-bastion/nss_openbastion.conf"

# Hardening (session containment) — see doc/hardening.rst
HARDENING_TEMPLATE_DIR="/usr/share/open-bastion/hardening"
HARDENING_LOGIND_DST="/etc/systemd/logind.conf.d/open-bastion.conf"
HARDENING_LIMITS_DST="/etc/security/limits.d/open-bastion.conf"
HARDENING_AT_ALLOW="/etc/at.allow"
HARDENING_CRON_ALLOW="/etc/cron.allow"
ENABLE_HARDENING=false
# Opt-in: scope `timestamp_timeout=0` to %open-bastion-sudo so SSO users present
# a fresh LLNG token on every sudo instead of riding sudo's own credential cache
# (#178). Off by default: it changes the prompt cadence for every SSO user.
SUDO_FRESH_OTP=false
ENABLE_SERVICE_KEYS=false
# Result of setup_hardening, consumed by print_summary. One of:
#   not-applied (default — step never ran or was opt-out)
#   applied     (all sub-steps succeeded)
#   partial     (one or more sub-steps emitted warn/error but step continued)
#   declined    (user said no at the confirm prompt)
#   failed      (hard refusal: templates missing, linger gate, etc.)
#   dry-run     (--dry-run, nothing was actually applied)
HARDENING_RESULT="not-applied"

# Audit outcome for the summary: not-applied (default), applied, skipped
# (auditd missing), declined (user said no), dry-run, failed.
AUDIT_RESULT="not-applied"

# Audit trace paths (opt-in, see --enable-audit-trace)
AUDIT_TEMPLATE_DIR="${AUDIT_TEMPLATE_DIR:-/usr/share/open-bastion/audit}"
AUDIT_RULES_FILE="/etc/audit/rules.d/open-bastion.rules"
# Daily rotation: ob-audit-rotate.timer, enabled by --enable-audit-trace. Up to
# 0.6 it was a copy of a template in /etc/cron.daily; see ob-timers-lib.sh.

# Result of enroll_server, consumed by print_summary. One of:
#   not-attempted (default — step never ran)
#   success       (enrollment completed; server token stored)
#   token-provided (caller passed --token-file, no portal contact needed)
#   reused        (existing token at $OB_TOKEN adopted, no re-enrollment)
#   dry-run       (--dry-run, no enrollment attempted)
#   failed        (portal contact or device-authorization failed)
ENROLL_RESULT="not-attempted"

# Files created (not just modified) during this run. Used by rollback_on_failure()
# to remove inert config artefacts when the run aborts before SSH lockdown.
# Files we MODIFIED have their originals in BACKUP_DIR via backup_file().
CREATED_FILES=()

# Colors (only if terminal)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

info() { echo -e "${GREEN}[INFO]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*" >&2; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }
step() { echo -e "${BLUE}[STEP]${NC} $*"; }

# A standalone host runs the bastion stack; only the backend differs.
is_backend() { [ "$NODE_ROLE" = "backend" ]; }

# How the effective role reads in a sentence.
role_noun() {
    case "$NODE_ROLE" in
        standalone) printf 'standalone host' ;;
        *)          printf '%s' "$NODE_ROLE" ;;
    esac
}

# The same, capitalised, for titles.
role_title() {
    case "$NODE_ROLE" in
        backend)    printf 'Backend' ;;
        standalone) printf 'Standalone' ;;
        *)          printf 'Bastion' ;;
    esac
}

# The sshd drop-in carries the stack, not the recorded role: a standalone host
# gets the bastion one. debian/open-bastion.postinst and ob-post-upgrade tell a
# backend from a bastion by exactly these two names.
sshd_dropin_stack() {
    if is_backend; then printf 'backend'; else printf 'bastion'; fi
}

# The stack this host's sshd is configured for right now -- "bastion",
# "backend", or nothing when setup has not configured it -- read from what an
# earlier run wrote: the drop-in name, or, on an sshd without sshd_config.d,
# the principals line of the block appended to sshd_config (only the backend
# passes the key-id, %i). A host with both drop-ins, left by a role switch
# before #288, reads as a backend: that one sorts first and its
# AuthorizedPrincipalsCommand is the one sshd uses.
configured_sshd_stack() {
    local f stack
    if [ -d "$SSHD_CONFIG_DIR" ]; then
        for stack in backend bastion; do
            for f in "$SSHD_CONFIG_DIR/00-open-bastion-$stack.conf" \
                     "$SSHD_CONFIG_DIR/50-open-bastion-$stack.conf"; do
                [ -f "$f" ] && { printf '%s' "$stack"; return 0; }
            done
        done
        return 0
    fi
    grep -q "TrustedUserCAKeys.*open-bastion" "$SSHD_CONFIG" 2>/dev/null || return 0
    local line
    line=$(grep -m1 '^[[:space:]]*AuthorizedPrincipalsCommand[[:space:]].*ob-ssh-principals' \
           "$SSHD_CONFIG" 2>/dev/null)
    case "$line" in
        "")      ;;   # a block from before the principals helper: cannot tell
        *" %i"*) printf 'backend' ;;
        *)       printf 'bastion' ;;
    esac
}

# True when this run changes the stack the host's sshd is configured for.
is_role_switch() {
    local current
    current=$(configured_sshd_stack)
    [ -n "$current" ] && [ "$current" != "$(sshd_dropin_stack)" ]
}

# A boxed title, centred in the 57 columns of the frame.
print_box() {
    local text="$1" width=57 left right
    left=$(( (width - ${#text}) / 2 ))
    right=$(( width - ${#text} - left ))
    echo "┌─────────────────────────────────────────────────────────┐"
    printf '│%*s%s%*s│\n' "$left" "" "$text" "$right" ""
    echo "└─────────────────────────────────────────────────────────┘"
}

# Check if running as root
check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        error "This script must be run as root"
        exit 1
    fi
}

# Record a path as something we wrote. Used by rollback_on_failure() to
# decide what to restore from BACKUP_DIR (file existed before — restore)
# vs. what to remove (file did not exist before — delete).
track_created() {
    CREATED_FILES+=("$1")
}

# Rollback inert files written before enrollment, called if enrollment fails
# before SSH/PAM lockdown is applied. Safe because the affected files
# (open-bastion_ca.pub, ob-ssh-principals, openbastion.conf, and
# session-recorder.conf on a bastion or allowed_bastions on a backend) are not
# referenced by sshd/PAM until later steps.
rollback_on_failure() {
    if [ ${#CREATED_FILES[@]} -eq 0 ]; then
        return 0
    fi
    warn "Rolling back inert files written before enrollment..."
    local f base
    for f in "${CREATED_FILES[@]}"; do
        base=$(basename "$f")
        if [ -f "$BACKUP_DIR/$base" ]; then
            cp -a "$BACKUP_DIR/$base" "$f" && info "Restored $f from backup"
        else
            rm -f "$f" && info "Removed $f (no backup, file did not exist before)"
        fi
    done
    info "Backup directory preserved at: $BACKUP_DIR"
}

# Backup a file before modifying
backup_file() {
    local file="$1"
    if [ -f "$file" ]; then
        mkdir -p "$BACKUP_DIR"
        cp -a "$file" "$BACKUP_DIR/"
        info "Backed up: $file"
    fi
}

# Confirm action (unless non-interactive)
confirm() {
    local msg="$1"
    if [ "$NON_INTERACTIVE" = "true" ]; then
        return 0
    fi

    echo -en "${YELLOW}$msg [y/N] ${NC}"
    read -r response
    case "$response" in
        [yY][eE][sS]|[yY]) return 0 ;;
        *) return 1 ;;
    esac
}

# Build curl options
build_curl_opts() {
    CURL_OPTS=("-s" "-f" "--connect-timeout" "$TIMEOUT")
    if [ "$VERIFY_SSL" = "false" ]; then
        CURL_OPTS+=("-k")
    fi
}

# Download SSH CA public key
download_ca_key() {
    step "Downloading SSH CA public key from LLNG..."

    build_curl_opts

    local ca_key
    ca_key=$(curl "${CURL_OPTS[@]}" "${PORTAL_URL}/ssh/ca") || {
        error "Failed to download CA public key from ${PORTAL_URL}/ssh/ca"
        error "Make sure sshCaActivation is enabled in LLNG"
        return 1
    }

    if [ -z "$ca_key" ] || [[ ! "$ca_key" =~ ^ssh- ]]; then
        error "Invalid CA public key received"
        return 1
    fi

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would write CA key to $SSH_CA_FILE"
        return 0
    fi

    backup_file "$SSH_CA_FILE"
    echo "$ca_key" > "$SSH_CA_FILE"
    chmod 644 "$SSH_CA_FILE"
    track_created "$SSH_CA_FILE"
    info "CA public key saved to $SSH_CA_FILE"
}

# Install /usr/local/sbin/ob-ssh-principals and its spool directory.
# The script is invoked by sshd as AuthorizedPrincipalsCommand (running as
# nobody); it records the SHA256 fingerprint of the client certificate in
# /run/open-bastion/ssh-fp/<sshd-session-pid>.fp so pam_openbastion can
# forward it to LLNG for the /pam/authorize + /pam/verify fingerprint
# binding (see PamAccess >= 0.1.16). The backend variant also refuses any
# certificate that is not vouched by an allowed bastion (key-id, %i).
# Locate the shipped helper text and tmpfiles rule. They live in one place
# (share/ in the tree, /usr/lib/open-bastion once installed) because they used
# to be inline heredocs here AND in the other setup script AND would have been
# a third time in ob-post-upgrade -- which is how debian/ and systemd/ ended up
# with units that drifted apart (#254).
_ob_data_dir() {
    local d="${OB_DATA_DIR:-/usr/lib/open-bastion}"
    if [ ! -r "$d/ob-fp-spool.tmpfiles" ]; then
        local here
        here="$(dirname "$(readlink -f "$0")")"
        [ -r "$here/../share/ob-fp-spool.tmpfiles" ] && d="$here/../share"
    fi
    printf '%s' "$d"
}

install_principals_helper() {
    step "Installing SSH principals helper..."

    local script_path="/usr/local/sbin/ob-ssh-principals"
    local spool_dir="/run/open-bastion/ssh-fp"
    local tmpfiles_conf="/etc/tmpfiles.d/open-bastion-ssh-fp.conf"
    local data_dir helper_src
    data_dir="$(_ob_data_dir)"
    helper_src="$data_dir/ob-ssh-principals.$(sshd_dropin_stack)"

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would install $script_path (from $helper_src) and create $spool_dir"
        if is_backend; then
            info "[DRY-RUN] Would write $OB_ALLOWED_BASTIONS_FILE: ${BASTION_ALLOWED_IDS:-<empty: any vouched bastion>}"
        fi
        return 0
    fi

    if [ ! -r "$helper_src" ]; then
        error "Missing $helper_src — reinstall the open-bastion package"
        return 1
    fi

    # Every step is checked: main() calls this as `install_principals_helper ||
    # ...`, which suspends errexit for the whole body, so an unchecked failure
    # would fall through to "installed" and the run would carry on.
    #
    # The allowlist goes in BEFORE the backend helper. The backend helper with
    # no allowlist file at all is legacy non-enforcing mode, which accepts a
    # direct SSO certificate; it must never be live in that state, not even
    # between two lines of this function.
    if is_backend; then
        install_allowed_bastions || return 1
    fi

    install -D -m 0755 -o root -g root "$helper_src" "$script_path" || {
        error "Could not install $script_path"
        return 1
    }
    track_created "$script_path"

    # 0711 on /run/open-bastion, 0700 root on the drop directory: see the
    # tmpfiles rule for the rationale. ob-fp-daemon owns the drops; the
    # principals helper only needs to reach the deposit socket.
    install -d -m 0711 -o root -g root /run/open-bastion || return 1
    install -d -m 0700 -o root -g root "$spool_dir" || return 1

    install -D -m 0644 -o root -g root "$data_dir/ob-fp-spool.tmpfiles" "$tmpfiles_conf" \
        || return 1
    track_created "$tmpfiles_conf"

    # Enable the fingerprint sink socket (#249). The principals helper deposits
    # through it instead of writing the spool as nobody; without it there is no
    # fingerprint binding at all, so say so loudly rather than let logins
    # silently lose a security control.
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl enable --now ob-fp.socket >/dev/null 2>&1; then
            info "Enabled ob-fp.socket (SSH fingerprint sink)"
        else
            warn "Could not enable ob-fp.socket — the SSH fingerprint binding"
            warn "will be unavailable until you run:"
            warn "  systemctl enable --now ob-fp.socket"
        fi
    else
        warn "systemctl not available — enable ob-fp.socket manually"
    fi

    info "SSH principals helper installed at $script_path"
    info "SSH fingerprint spool prepared at $spool_dir"
}

# Phase 1 half of the principals helper. On a role switch it is NOT installed
# here: sshd keeps running the old role's configuration until it is restarted
# at the very end, and the new helper under the old configuration is a
# mismatch. Both helpers deny in that state, but a host locked for the length
# of an enrollment -- or for good, if the run stops -- is no better. So the
# helper goes in last, by finish_principals_helper, right before the restart,
# where the mismatch lasts a moment.
HELPER_DEFERRED=false
prepare_principals_helper() {
    if is_role_switch; then
        HELPER_DEFERRED=true
        info "This host's sshd is configured as a $(configured_sshd_stack): the principals"
        info "helper will be replaced together with the sshd restart, at the end."
        return 0
    fi
    install_principals_helper
}

finish_principals_helper() {
    [ "$HELPER_DEFERRED" = "true" ] || return 0
    install_principals_helper
}

# Backend: write the bastion allowlist the principals helper reads.
install_allowed_bastions() {
    # Allowed-bastions list, world-readable (no secrets — just client_id values)
    # so the principals helper (running as nobody) can read it. Empty file means
    # "any vouched bastion"; its mere presence turns on bastion-only enforcement.
    #
    # Every step is checked (errexit is suspended here, see the caller): a
    # write that failed unnoticed would leave no file, and the backend helper
    # then runs in legacy mode and accepts a direct SSO certificate.
    local dir
    dir=$(dirname "$OB_ALLOWED_BASTIONS_FILE")
    backup_file "$OB_ALLOWED_BASTIONS_FILE"
    if ! mkdir -p "$dir" \
       || ! printf '%s\n' "$BASTION_ALLOWED_IDS" > "$OB_ALLOWED_BASTIONS_FILE" \
       || ! chmod 644 "$OB_ALLOWED_BASTIONS_FILE"; then
        error "Could not write $OB_ALLOWED_BASTIONS_FILE"
        return 1
    fi
    track_created "$OB_ALLOWED_BASTIONS_FILE"
    # CRITICAL: the principals helper runs as nobody and must traverse this
    # directory to read the 0644 allowlist above. If the dir stays 0700 root,
    # nobody cannot stat the file, the helper fails closed (post-fix) — or,
    # before the fail-closed fix, silently fell OPEN and accepted direct SSO
    # certs. Every secret inside is individually 0600, so 0711 is safe.
    chmod 0711 "$dir" || {
        error "Could not make $dir traversable (0711) for the principals helper"
        return 1
    }
    if [ -n "$BASTION_ALLOWED_IDS" ]; then
        info "Backend accepts bastions: $BASTION_ALLOWED_IDS"
    else
        warn "allowed_bastions is EMPTY: this backend accepts a vouched"
        warn "certificate from ANY bastion enrolled in the project, not only"
        warn "from the ones you operate. That allowlist is the residual defence"
        warn "behind the SSO-side gap where any enrolled host in the project can"
        warn "declare itself a bastion and mint a hop voucher for a user."
        warn "Fix it with:  ob-backend-setup --allowed-bastions <bastion_id>[,<id>...]"
        warn "(the bastion_id of a bastion is printed by ob-bastion-id on it)"
    fi
}

# Refuse, before anything is written, a role switch on an sshd without
# sshd_config.d. There the setup appends its block to sshd_config and, finding
# one already, keeps it ("already exists"): the old role's sshd configuration
# would stay in force while the helper, PAM and the summary moved to the new
# one. Rewriting a hand-maintained sshd_config is not something to guess at,
# so the block has to go by hand.
preflight_sshd_config() {
    [ -d "$SSHD_CONFIG_DIR" ] && return 0
    local current
    current=$(configured_sshd_stack)
    [ -n "$current" ] || return 0
    [ "$current" = "$(sshd_dropin_stack)" ] && return 0
    error "$SSHD_CONFIG holds the Open Bastion block of a $current, and this run"
    error "configures a $(role_noun)."
    error "This sshd has no $SSHD_CONFIG_DIR, so the setup appends its block to"
    error "$SSHD_CONFIG and never rewrites one that is already there: the $current"
    error "configuration would stay in force under a $(role_noun)'s helper and PAM."
    error "Remove that block by hand (from '# LemonLDAP::NG ... Configuration' to"
    error "'PermitRootLogin no'), then run this again."
    return 1
}

# Configure sshd
configure_sshd() {
    step "Configuring SSH server..."

    # Role-specific pieces of the drop-in. The backend helper also gets the
    # certificate key-id (%i) to check the vouching bastion; only the bastion
    # stack forces sessions through the recorder and allows agent forwarding.
    local title principals_comment principals_args password_comment
    local agent_snippet forcecommand_snippet="" pam_comment
    if is_backend; then
        title="Backend"
        principals_comment="# Accept a certificate only when it is bastion-vouched: the helper checks the
# cert key-id (%i) carries an allowed bastion_id and the encoded user matches
# %u, then emits the principal and drops the key fingerprint (%f) for
# pam_openbastion to forward to LLNG. Direct user SSO certs are denied here."
        principals_args="%u %f %i %t %k"
        password_comment="# Disable password authentication (certificates from bastion only)"
        agent_snippet="# Disable agent forwarding (backend servers don't need it)
AllowAgentForwarding no"
        pam_comment="# Enable PAM for user creation and authorization"
    else
        title="Bastion"
        principals_comment="# Accept certificate if principal matches the requested username and drop the
# SSH key fingerprint to /run/open-bastion/ssh-fp/ so pam_openbastion can
# forward it to LLNG (see fingerprint binding on /pam/authorize + /pam/verify)."
        principals_args="%u %f %t %k"
        password_comment="# Disable password authentication (use certificates only)"
        agent_snippet="# Allow agent forwarding for bastion use
AllowAgentForwarding yes"
        if [ "$DISABLE_SESSION_RECORDER" = "true" ]; then
            forcecommand_snippet="# Session recording disabled via --disable-session-recorder

"
        else
            forcecommand_snippet="# Record all sessions via LLNG session recorder
ForceCommand $SESSION_RECORDER

"
        fi
        pam_comment="# Enable PAM for authorization"
    fi

    local config_content="# LemonLDAP::NG $title Configuration
# Generated by $PROG_NAME on $(date)

# Trust LLNG SSH CA for certificate authentication
TrustedUserCAKeys $SSH_CA_FILE

$principals_comment
AuthorizedPrincipalsCommand /usr/local/sbin/ob-ssh-principals $principals_args
AuthorizedPrincipalsCommandUser nobody

# Enable public key (certificate) authentication
PubkeyAuthentication yes

$password_comment
PasswordAuthentication no
KbdInteractiveAuthentication no

$agent_snippet

$forcecommand_snippet$pam_comment
UsePAM yes

# Disable X11 forwarding for security
X11Forwarding no

# Root access via console only (not SSH)
PermitRootLogin no
"

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would create LLNG sshd configuration"
        echo "$config_content"
        return 0
    fi

    # Use sshd_config.d if available (modern systems)
    if [ -d "$SSHD_CONFIG_DIR" ]; then
        # Ensure Include directive exists in main sshd_config
        if ! grep -q "^Include $SSHD_CONFIG_DIR/\*.conf" "$SSHD_CONFIG" 2>/dev/null; then
            backup_file "$SSHD_CONFIG"
            sed -i "1i Include $SSHD_CONFIG_DIR/*.conf" "$SSHD_CONFIG"
            info "Added Include directive to $SSHD_CONFIG"
        fi

        # Sort BEFORE distro drop-ins such as 50-cloud-init.conf, which ships
        # `PasswordAuthentication yes`. sshd uses the FIRST value seen for
        # keywords like PasswordAuthentication / PermitRootLogin / KbdInteractive,
        # so our cert-only hardening must be read first or it is silently
        # overridden. The 00- prefix guarantees that.
        local stack other
        stack=$(sshd_dropin_stack)
        if [ "$stack" = "backend" ]; then other="bastion"; else other="backend"; fi
        local ob_config="$SSHD_CONFIG_DIR/00-open-bastion-$stack.conf"
        # Drop the legacy 50- name from earlier installs (it sorted AFTER
        # 50-cloud-init.conf and therefore lost the PasswordAuthentication race).
        rm -f "$SSHD_CONFIG_DIR/50-open-bastion-$stack.conf"
        # And the other stack's drop-in, left by a run under the other role.
        # Both would be read: the backend one sorts first and wins every keyword
        # it sets, but the bastion's ForceCommand would still apply -- sending
        # every backend session through a recorder whose sink is not enabled
        # there, which fails closed.
        local stale
        for stale in "$SSHD_CONFIG_DIR/00-open-bastion-$other.conf" \
                     "$SSHD_CONFIG_DIR/50-open-bastion-$other.conf"; do
            [ -f "$stale" ] || continue
            backup_file "$stale"
            rm -f "$stale"
            warn "Removed $stale, left by an earlier $other setup of this host"
        done
        backup_file "$ob_config"
        echo "$config_content" > "$ob_config"
        chmod 644 "$ob_config"
        info "Created $ob_config"
    else
        # Append to main sshd_config
        backup_file "$SSHD_CONFIG"

        # Check if already configured
        if grep -q "TrustedUserCAKeys.*open-bastion" "$SSHD_CONFIG" 2>/dev/null; then
            warn "Open Bastion configuration already exists in $SSHD_CONFIG"
        else
            echo "" >> "$SSHD_CONFIG"
            echo "$config_content" >> "$SSHD_CONFIG"
            info "Added Open Bastion configuration to $SSHD_CONFIG"
        fi
    fi

    # Validate sshd config
    if ! sshd -t 2>/dev/null; then
        error "SSH configuration is invalid!"
        error "Please check the configuration and fix manually"
        return 1
    fi

    info "SSH configuration is valid"
}

# Configure PAM for SSH
# True if a PAM module (e.g. pam_systemd.so) is installed in any of the standard
# security module directories (covers Debian multiarch and RHEL lib64 layouts).
pam_module_present() {
    local m="$1" d
    for d in /lib/security /lib64/security /usr/lib/security /usr/lib64/security \
             /lib/*/security /usr/lib/*/security; do
        [ -e "$d/$m" ] && return 0
    done
    return 1
}

configure_pam_sshd() {
    step "Configuring PAM for SSH..."

    # Session phase: a backend has pam_openbastion create the Unix account
    # (create_user=true) and fails the session if it cannot; the bastion stack
    # only needs a home directory and keeps pam_openbastion optional.
    local session_comment session_lines
    if is_backend; then
        local create_user_opt=""
        if [ "$CREATE_USERS" = "true" ]; then
            create_user_opt=" create_user=true"
        fi
        session_comment="# Session: Create user account if needed, standard Unix session"
        session_lines="# Session - create user if needed, then standard Unix
session    required     pam_openbastion.so$create_user_opt
session    required     pam_unix.so"
    else
        session_comment="# Session: Standard Unix session handling"
        session_lines="# Session - create home directory if needed, standard Unix session
session    optional     pam_mkhomedir.so skel=/etc/skel umask=0077
session    required     pam_unix.so
session    optional     pam_openbastion.so"
    fi

    local pam_content="# PAM configuration for SSH with LemonLDAP::NG $(role_noun)
# Generated by $PROG_NAME on $(date)
#
# Authentication: Handled by SSH certificates (not PAM)
# Authorization: LLNG checks if user can access this $(role_noun)
$session_comment

# Authentication - refused. SSH certificates are validated by sshd, which never
# calls pam_authenticate() on the pubkey/certificate path, so this stack is only
# reached by password or keyboard-interactive authentication - neither of which
# this mode allows. pam_deny returns PAM_AUTH_ERR (authentication failure).
auth       required     pam_deny.so

# Authorization - check with LLNG (certificate-aware mode)
account    required     pam_openbastion.so ssh_cert_aware=true

$session_lines
"

    # Register the session with systemd-logind so who/w/loginctl — and the
    # ob-heartbeat connected-users report, which reads loginctl/who — actually
    # see it. Append the line only when pam_systemd is installed: with 'optional'
    # a missing module is normally ignored, but gating on presence avoids a
    # per-login dlopen error on a non-systemd host (and any PAM-version edge
    # case). Mirrors how distros tie the line to the libpam-systemd package.
    if pam_module_present pam_systemd.so; then
        pam_content="${pam_content}session    optional     pam_systemd.so
"
    fi

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would configure PAM for SSH"
        echo "$pam_content"
        return 0
    fi

    backup_file "$PAM_SSHD"
    echo "$pam_content" > "$PAM_SSHD"
    chmod 644 "$PAM_SSHD"
    info "Configured $PAM_SSHD"
}

# Render openbastion.conf content using current globals. Used both by
# the initial configure_pam_openbastion (Phase 1) and the post-enrollment
# refresh that persists any client_id/client_secret entered during the
# retry prompts.
render_openbastion_conf() {
    printf '# LemonLDAP::NG PAM module configuration\n'
    printf '# Generated by %s on %s\n\n' "$PROG_NAME" "$(date)"
    printf '# Portal URL (required)\n'
    printf 'portal_url = %s\n\n' "$PORTAL_URL"
    printf '# Server authentication token file\n'
    printf 'server_token_file = %s\n\n' "$OB_TOKEN"
    printf '# Server group for authorization rules\n'
    printf 'server_group = %s\n\n' "$SERVER_GROUP"
    printf '# Node role reported to the SSO (bastion | standalone | backend)\n'
    printf 'node_role = %s\n\n' "$NODE_ROLE"
    # Authorization-only mode: pam_sm_authenticate always succeeds (SSH already
    # validated the cert), only pam_sm_acct_mgmt calls /pam/authorize. Without
    # this, pam_openbastion would require client_id/client_secret in this file
    # for OIDC token introspection — which this host never receives, since
    # the user authenticates with an SSH certificate, not an OIDC token.
    printf '# SSH %s mode: cert auth via sshd, authorization via /pam/authorize\n' \
        "$(sshd_dropin_stack)"
    printf 'authorize_only = true\n\n'
    if [ -n "$CLIENT_ID" ]; then
        printf '# OIDC client used for enrollment (kept for re-enroll)\n'
        printf 'client_id = %s\n\n' "$CLIENT_ID"
    fi
    if [ -n "$CLIENT_SECRET" ]; then
        printf '# OIDC client secret (confidential client; kept for re-enroll)\n'
        printf 'client_secret = %s\n\n' "$CLIENT_SECRET"
    fi
    printf '# HTTP settings\n'
    printf 'timeout = 10\n'
    printf 'verify_ssl = %s\n\n' "$VERIFY_SSL"
    printf '# Cache settings (reduce load on portal)\n'
    printf 'cache_enabled = true\n'
    printf 'cache_dir = /var/cache/open-bastion\n'
    printf 'cache_ttl = 300\n\n'
    if is_backend; then
        printf '# User creation settings\n'
        printf 'create_user_enabled = %s\n' "$CREATE_USERS"
        printf 'create_home = true\n'
        printf 'default_shell = /bin/bash\n\n'
    fi
    # Carry over fingerprint_required if the operator set it. This function
    # rewrites openbastion.conf wholesale on every run, so a setting it does not
    # know about is silently dropped -- and this one decides whether a login with
    # no recoverable SSH fingerprint is refused or merely allowed through. Losing
    # it turns a deliberate control back off on the next setup run, which is the
    # kind of silent downgrade this project exists to prevent (#263).
    local _fpreq=""
    if [ -r "$OB_CONFIG" ]; then
        _fpreq=$(sed -n 's/^[[:space:]]*fingerprint_required[[:space:]]*=[[:space:]]*\([^#[:space:]]*\).*/\1/p' \
                 "$OB_CONFIG" | tail -1)
    fi
    if [ -n "$_fpreq" ]; then
        printf '# Refuse an SSH login whose key fingerprint cannot be determined\n'
        printf '# (preserved from the previous configuration)\n'
        printf 'fingerprint_required = %s\n\n' "$_fpreq"
    fi
    printf '# Logging\n'
    printf 'log_level = info\n\n'
    printf '# Audit logging\n'
    printf 'audit_enabled = true\n'
    printf 'audit_to_syslog = true\n'
}

# Configure PAM open-bastion module
configure_pam_openbastion() {
    step "Configuring PAM open-bastion module..."

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would create PAM LLNG configuration"
        render_openbastion_conf
        return 0
    fi

    backup_file "$OB_CONFIG"
    render_openbastion_conf > "$OB_CONFIG"
    chmod 600 "$OB_CONFIG"
    track_created "$OB_CONFIG"
    info "Created $OB_CONFIG"

    # Create cache directory
    mkdir -p /var/cache/open-bastion
    chmod 750 /var/cache/open-bastion
}

# Re-render openbastion.conf in place (no fresh backup, no track) after
# enrollment succeeds — persists credentials updated during retry prompts.
refresh_openbastion_conf() {
    if [ "$DRY_RUN" = "true" ]; then
        return 0
    fi
    render_openbastion_conf > "$OB_CONFIG"
    chmod 600 "$OB_CONFIG"
}

# Configure session recorder (bastion and standalone only: a backend records
# nothing, the bastion in front of it does)
configure_session_recorder() {
    step "Configuring session recorder..."

    # Check if session recorder is installed
    if [ ! -x "$SESSION_RECORDER" ]; then
        warn "Session recorder not found at $SESSION_RECORDER"
        warn "Make sure open-bastion package is installed"
    fi

    local config_content="# LemonLDAP::NG Session Recorder Configuration
# Generated by $PROG_NAME on $(date)

# Directory for session recordings
sessions_dir = /var/lib/open-bastion/sessions

# Recording format (script is always available)
format = script

# Maximum session duration (8 hours)
max_duration = 28800

# Retention (applied daily by ob-session-prune.timer). Recording is fail-closed,
# so recordings are compressed then expired to bound disk usage. Compression
# keeps the .json index readable; expiry is logged at notice level. Set
# recording_retention_days = 0 to keep recordings forever.
recording_compress_after_days = 1
recording_retention_days = 365
"

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would create session recorder configuration"
        return 0
    fi

    mkdir -p "$(dirname "$SESSION_RECORDER_CONF")"
    backup_file "$SESSION_RECORDER_CONF"
    echo "$config_content" > "$SESSION_RECORDER_CONF"
    chmod 644 "$SESSION_RECORDER_CONF"
    track_created "$SESSION_RECORDER_CONF"
    info "Created $SESSION_RECORDER_CONF"

    # ob-sessions group (normally created by the package; be defensive for
    # source installs). Recordings are owned root:ob-sessions so auditors in this
    # group can read them; the recorded user is NOT a member.
    getent group ob-sessions >/dev/null 2>&1 || groupadd --system ob-sessions 2>/dev/null || true

    # Sessions tree, NEW tamper-evident layout: root:ob-sessions 0750.
    #   - o-rwx  → a connecting user (not in ob-sessions) has NO access at all:
    #     it cannot list, read, unlink or truncate any recording, including its
    #     own. This is the whole point (#151); the recording is written by the
    #     root sink, not by the user.
    #   - g+rx (group ob-sessions) → auditors can read.
    # NOTE: this replaces the old 3771 setgid+sticky+o+x layout, which left the
    # tree user-traversable and the per-user dirs user-owned (deletable).
    mkdir -p /var/lib/open-bastion/sessions
    chown root:ob-sessions /var/lib/open-bastion/sessions
    chmod 0750 /var/lib/open-bastion/sessions

    # Migrate any legacy user-owned per-user dirs to root ownership, safely:
    # skip symlinks / non-dirs (a user could have planted one while the tree was
    # still writable), and re-own + lock down the rest. The sink also re-owns on
    # next use, but doing it here closes the window immediately.
    local d
    for d in /var/lib/open-bastion/sessions/*/; do
        [ -e "$d" ] || continue
        if [ -L "${d%/}" ] || [ ! -d "$d" ]; then
            warn "Skipping non-directory/symlink in sessions tree: ${d%/}"
            continue
        fi
        chown -h root:ob-sessions "${d%/}" 2>/dev/null || true
        chmod 0750 "${d%/}" 2>/dev/null || true
        # Recording/metadata files: root:ob-sessions 0640.
        find "$d" -maxdepth 1 -type f -exec chown root:ob-sessions {} + 2>/dev/null || true
        find "$d" -maxdepth 1 -type f -exec chmod 0640 {} + 2>/dev/null || true
    done

    # Enable the recording sink socket (mirrors ob-cert.socket). Recording is
    # mandatory when configured, so the recorder fails closed if this is down.
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl enable --now ob-record.socket >/dev/null 2>&1; then
            info "Enabled ob-record.socket (session recording sink)"
        else
            warn "Could not enable ob-record.socket — enable it manually:"
            warn "  systemctl enable --now ob-record.socket"
        fi
    else
        warn "systemctl not available — enable ob-record.socket manually"
    fi

    # Arm the daily retention timer. The package enables it at install time too
    # (dh_installsystemd, no ConditionPathExists gate), but re-assert it here for
    # source installs and to be idempotent. It bounds recording disk usage; on a
    # host without recordings it simply no-ops.
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl enable --now ob-session-prune.timer >/dev/null 2>&1; then
            info "Enabled ob-session-prune.timer (compresses + expires recordings)"
        else
            warn "Could not enable ob-session-prune.timer — enable it manually:"
            warn "  systemctl enable --now ob-session-prune.timer"
        fi
    fi
}

# Allow bastion users to obtain vouched ephemeral certificates (bastion and
# standalone only).
# ob-ssh runs as the logged-in user but /pam/bastion-cert requires the bastion's
# server token, which is root-only BY DESIGN. The bridge is ob-cert-daemon, a
# socket-activated service (runs as root) reached through the unprivileged
# ob-cert-request client. The daemon derives the certificate's user from the
# connection's SO_PEERCRED, so it always mints for the connecting user — no
# sudo, no setuid, and minting is decoupled from the interactive sudo policy.
configure_ssh_proxy() {
    step "Configuring ob-ssh (config + cert socket)..."

    # ob-ssh runs as the logged-in user, who cannot read the root-only
    # /etc/open-bastion/openbastion.conf — give it its own world-readable
    # configuration. It contains NO secret (the server token stays root-only;
    # the privileged call goes through ob-cert-daemon over its socket below).
    local proxy_conf="$SSH_PROXY_CONF"
    local proxy_conf_content="# Open Bastion ssh-proxy configuration
# Generated by $PROG_NAME on $(date)
# World-readable on purpose: ob-ssh runs as the connecting user and
# this file contains no secret.
PORTAL_URL=\"$PORTAL_URL\"
VERIFY_SSL=$VERIFY_SSL
TIMEOUT=10
"

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would create $proxy_conf"
    else
        backup_file "$proxy_conf"
        echo "$proxy_conf_content" > "$proxy_conf"
        chmod 644 "$proxy_conf"
        track_created "$proxy_conf"
        info "Created $proxy_conf"
        # The directory must be traversable (not readable) by users so they
        # can open the world-readable ssh-proxy.conf; every secret inside
        # (token, openbastion.conf) stays 0600 root and the dir stays
        # unlistable for non-root.
        chmod 711 /etc/open-bastion
    fi

    # The privileged /pam/bastion-cert call is performed by ob-cert-daemon, a
    # socket-activated service (runs as root, derives the certificate's user from
    # the connection's SO_PEERCRED). ob-ssh reaches it through the unprivileged
    # ob-cert-request client — no sudo, no setuid, and minting is decoupled from
    # the interactive sudo policy (Mode E). Remove any sudoers drop-in left by
    # older versions (the old ob-bastion-cert-helper bridge).
    local old_sudoers="/etc/sudoers.d/ob-bastion-cert-helper"

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would remove $old_sudoers (if present) and enable ob-cert.socket"
        return 0
    fi

    if [ -f "$old_sudoers" ]; then
        rm -f "$old_sudoers"
        info "Removed obsolete $old_sudoers (replaced by ob-cert.socket)"
    fi

    # The socket lives under /run/open-bastion (0711, traversable so users can
    # connect to the 0666 socket; every secret in the dir stays 0600 root).
    mkdir -p /run/open-bastion
    chmod 0711 /run/open-bastion

    if ! command -v ob-cert-daemon >/dev/null 2>&1 && [ ! -x /usr/sbin/ob-cert-daemon ]; then
        warn "ob-cert-daemon not found — ob-ssh will not work for normal users"
        return 0
    fi

    if command -v systemctl >/dev/null 2>&1; then
        if systemctl enable --now ob-cert.socket >/dev/null 2>&1; then
            info "Enabled ob-cert.socket"
        else
            warn "Could not enable ob-cert.socket — enable it manually:"
            warn "  systemctl enable --now ob-cert.socket"
        fi
    else
        warn "systemctl not available — enable ob-cert.socket manually"
    fi
}

# Arm the heartbeat timer now that the server token exists.
#
# The packaged ob-heartbeat.timer is enabled+started at install time by
# dh_installsystemd, but it carries ConditionPathExists=/var/lib/open-bastion/
# token. Enrollment runs *after* package install, so at that install-time start
# the token does not exist yet, the condition fails, and the timer is silently
# skipped — it never arms in the running system until the next reboot. With no
# heartbeat, the short-lived enrollment access token expires within hours and is
# never refreshed: PAM then falls back to the offline cache (SSH login still
# works but no bastion voucher is minted, so ob-ssh breaks with "voucher unset")
# and sudo locks out ("server token invalid or expired"). Starting it here, once
# the token is in place, closes that window. On a backend the same expiry
# makes /pam/authorize fail for every login.
enable_heartbeat_timer() {
    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would enable --now ob-heartbeat.timer"
        return 0
    fi

    # No token (enrollment skipped/declined) -> nothing to heartbeat yet.
    [ -s "$OB_TOKEN" ] || return 0

    if command -v systemctl >/dev/null 2>&1; then
        if systemctl enable --now ob-heartbeat.timer >/dev/null 2>&1; then
            info "Enabled ob-heartbeat.timer (keeps the server token fresh)"
        else
            warn "Could not enable ob-heartbeat.timer — enable it manually:"
            warn "  systemctl enable --now ob-heartbeat.timer"
        fi
    else
        warn "systemctl not available — enable ob-heartbeat.timer manually"
    fi
}

# Header stamped into every drop-in this function writes. It is what lets a
# later run tell OUR file from one an operator wrote by hand -- the difference
# between cleaning up after ourselves and deleting someone's configuration.
_OB_SVC_KEYS_MARK="# Open Bastion service-account SSH layer"

# Is there an AuthorizedKeysCommand on this host that is not ours?
#
# It matters because sshd keeps the FIRST value it sees for a keyword and
# configure_sshd puts `Include sshd_config.d/*.conf` on line 1, so our drop-in
# is read before the body of sshd_config. A host already running its own key
# server -- LDAP, a corporate helper -- would have that line made dead by ours,
# and every user who authenticates through it would lose access silently. That
# is a worse outcome than not enabling this feature, so it is a refusal.
_ob_foreign_authorized_keys_command() {
    local f hit=""
    for f in "$SSHD_CONFIG" "$SSHD_CONFIG_DIR"/*.conf; do
        [ -f "$f" ] || continue
        # Skip our own drop-in: re-running must be idempotent, not a refusal.
        grep -q "^${_OB_SVC_KEYS_MARK}\$" "$f" 2>/dev/null && continue
        if grep -qiE '^[[:space:]]*AuthorizedKeysCommand[[:space:]]' "$f" 2>/dev/null; then
            hit="$hit $f"
        fi
    done
    [ -n "$hit" ] && { printf '%s' "${hit# }"; return 0; }
    return 1
}

# Remove a drop-in we generated, when the feature is not requested.
#
# Without this the flag is one-way: a host that was set up with it once keeps
# AuthorizedKeysCommand and ExposeAuthInfo for every session forever, and a
# later run without the flag reports a configuration it is not producing. Only
# files carrying our header are touched -- an operator's hand-written file is
# theirs, and this function has no business deleting it.
_ob_drop_service_keys_dropin() {
    local drop_in="$SSHD_CONFIG_DIR/09-open-bastion-service-keys.conf"
    [ -f "$drop_in" ] || return 0
    grep -q "^${_OB_SVC_KEYS_MARK}\$" "$drop_in" 2>/dev/null || {
        warn "$drop_in exists but was not generated by $PROG_NAME; leaving it alone."
        warn "Service-account keys stay enabled on this host. Remove it by hand to disable them."
        return 0
    }
    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would remove $drop_in (--enable-service-keys not given)"
        return 0
    fi
    backup_file "$drop_in"
    rm -f "$drop_in"
    info "Removed $drop_in (--enable-service-keys not given)"
}

# Configure the SSH layer for service accounts (#263), opt-in.
#
# ob-builder writes service-accounts.conf, which tells pam_openbastion which
# accounts exist and what fingerprint each should present. It does NOT make the
# key usable: sshd needs an authorized key for the account, and on a bastion
# there is no ~/.ssh/authorized_keys to read (Mode E sets AuthorizedKeysFile
# none, and the account often does not exist until first login). Without the
# AuthorizedKeysCommand below, sshd refuses at the protocol layer and PAM never
# runs -- which is how #263 was reported.
#
# Opt-in, per this project's rule that changes to system-wide behaviour are
# --enable-*: this adds an sshd drop-in and turns ExposeAuthInfo on for every
# session, on hosts that may have no service account at all.
#
# ExposeAuthInfo is written HERE and not left to Mode E. It is what puts
# SSH_USER_AUTH in the PAM environment, and without it the fingerprint check
# pam_openbastion is supposed to do for a plain public-key login has nothing to
# read -- the principals spool cannot fill the gap either, since sshd runs
# AuthorizedPrincipalsCommand only for certificate sessions. Shipping the
# AuthorizedKeysCommand without ExposeAuthInfo would mean sshd accepts the key
# and key_fingerprint is never enforced: the silent half-configuration that
# doc/service-accounts.rst now warns about.
configure_service_account_keys() {
    if [ "$ENABLE_SERVICE_KEYS" != "true" ]; then
        _ob_drop_service_keys_dropin
        return 0
    fi

    step "Configuring the SSH layer for service accounts..."

    local helper="/usr/sbin/ob-service-account-keys"
    local keys_dir="/etc/open-bastion/service-accounts.d"
    local drop_in="$SSHD_CONFIG_DIR/09-open-bastion-service-keys.conf"
    local foreign=""

    # ── Preconditions, before the dry-run short-circuit ──────────────────────
    # Checked here so --dry-run reports the same refusals a real run would hit.
    # Reporting "would write ..." on a host where the real run aborts is the
    # opposite of what a preflight is for.
    if [ ! -x "$helper" ]; then
        error "$helper not found. It ships with the open-bastion package;"
        error "reinstall it, or drop --enable-service-keys."
        return 1
    fi
    if [ ! -d "$SSHD_CONFIG_DIR" ]; then
        error "$SSHD_CONFIG_DIR does not exist: this sshd does not take drop-ins."
        error "Add these lines to $SSHD_CONFIG by hand instead:"
        error "    AuthorizedKeysCommand $helper %u"
        error "    AuthorizedKeysCommandUser nobody"
        error "    ExposeAuthInfo yes"
        return 1
    fi
    if foreign=$(_ob_foreign_authorized_keys_command); then
        error "This host already has an AuthorizedKeysCommand, in:$foreign"
        error ""
        error "sshd keeps the FIRST value it sees for a keyword, and our drop-in is"
        error "read before $SSHD_CONFIG (configure_sshd puts the Include on line 1)."
        error "Enabling this would make that command dead and every user who"
        error "authenticates through it would lose access, silently."
        error ""
        error "Refusing rather than overriding it. To use both, have that command"
        error "fall through to $helper, then re-run without --enable-service-keys."
        return 1
    fi

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would write $drop_in and ensure $keys_dir"
        return 0
    fi

    # 0755: the AuthorizedKeysCommandUser (nobody) has to traverse and read it.
    # The package creates it; assert it here because an older host upgraded
    # from a release that did not ship it will not have it.
    install -d -m 0755 -o root -g root "$keys_dir" || return 1

    backup_file "$drop_in"
    # errexit is off inside this function -- main() calls it as
    # `configure_service_account_keys || exit 1`, and bash suspends errexit for
    # the whole body of a function run in an || list. A failing write would
    # otherwise fall through to "Created ..." and the setup would end 0 with no
    # drop-in on disk. So every step is checked.
    if ! cat > "$drop_in" <<SVCKEYS
${_OB_SVC_KEYS_MARK}
# Generated by $PROG_NAME on $(date)
#
# Serves /etc/open-bastion/service-accounts.d/<user>.pub to sshd, so a service
# account can authenticate with its key without a ~/.ssh/authorized_keys and
# without the Unix account existing yet. See doc/service-accounts.rst.
AuthorizedKeysCommand $helper %u
AuthorizedKeysCommandUser nobody

# Required for pam_openbastion to re-check the key's fingerprint against
# service-accounts.conf: it is what puts SSH_USER_AUTH in the PAM environment.
# Without it sshd accepts the key and the fingerprint is never verified.
ExposeAuthInfo yes
SVCKEYS
    then
        error "Could not write $drop_in"
        rm -f "$drop_in"
        return 1
    fi
    [ -s "$drop_in" ] || { error "$drop_in is empty after writing"; rm -f "$drop_in"; return 1; }
    chmod 644 "$drop_in" || return 1
    track_created "$drop_in"

    # Validate with the file in place. configure_sshd's own `sshd -t` runs
    # BEFORE this function, so nothing else checks what we just wrote -- and a
    # malformed keyword here does not break this feature, it breaks sshd for
    # everyone at the next restart.
    if command -v sshd >/dev/null 2>&1; then
        if ! sshd -t 2>/dev/null; then
            error "sshd rejects the configuration after writing $drop_in:"
            sshd -t 2>&1 | while IFS= read -r _l; do error "    $_l"; done
            rm -f "$drop_in"
            error "Removed it; sshd configuration is back to what it was."
            return 1
        fi
        info "sshd accepts the configuration with $drop_in"
    else
        warn "sshd binary not found; could not validate $drop_in"
    fi

    info "Created $drop_in"

    if [ -z "$(ls -A "$keys_dir" 2>/dev/null)" ]; then
        info "No key in $keys_dir yet. For each service account:"
        info "  install -m 0644 -o root -g root <key>.pub $keys_dir/<name>.pub"
    fi

    # fingerprint_required makes a missing fingerprint fatal instead of skipped.
    # Only report: turning it on affects every SSH login on the host, not just
    # service accounts, and that is the operator's call.
    if grep -qE '^[[:space:]]*(ssh_)?fingerprint_required[[:space:]]*=[[:space:]]*(1|true|yes|on)' \
       "$OB_CONFIG" 2>/dev/null; then
        info "fingerprint_required is set: a login whose fingerprint cannot be"
        info "determined is refused, so key_fingerprint is enforced."
    else
        warn "fingerprint_required is not set in $OB_CONFIG."
        warn "Without it, a login whose fingerprint cannot be determined is"
        warn "allowed rather than refused -- key_fingerprint is then advisory."
        warn "See doc/service-accounts.rst before enabling it: it applies to"
        warn "every SSH login on this host, not only service accounts."
    fi
    return 0
}
# Configure sshd for max security (Mode E)
configure_max_security_sshd() {
    if [ "$MAX_SECURITY" != "true" ]; then
        return 0
    fi

    step "Configuring maximum security SSH settings (Mode E)..."

    local config_content="# Open Bastion Maximum Security Configuration (Mode E)
# Generated by $PROG_NAME on $(date)
#
# SSH: only SSO-signed certificates accepted
# sudo: only via LLNG temporary token (PAM-access)
# KRL: mandatory for certificate revocation

# Disable unsigned key authentication
AuthorizedKeysFile none

# Enable Key Revocation List (mandatory for Mode E)
RevokedKeys $SSH_REVOKED_KEYS

# Expose certificate info for audit
ExposeAuthInfo yes
"

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would create max security sshd configuration"
        echo "$config_content"
        return 0
    fi

    if [ -d "$SSHD_CONFIG_DIR" ]; then
        local max_sec_config="$SSHD_CONFIG_DIR/60-max-security.conf"
        backup_file "$max_sec_config"
        echo "$config_content" > "$max_sec_config"
        chmod 644 "$max_sec_config"
        info "Created $max_sec_config"
    else
        backup_file "$SSHD_CONFIG"
        echo "" >> "$SSHD_CONFIG"
        echo "$config_content" >> "$SSHD_CONFIG"
        info "Added max security configuration to $SSHD_CONFIG"
    fi
}

# Timer helpers shared with ob-post-upgrade: the systemd timers that replaced
# the KRL and audit cron jobs, and the migration from those jobs (#281).
# Installed next to ob-sign-lib.sh; the tree copy serves an uninstalled run.
load_timers_lib() {
    declare -F ob_timer_enable >/dev/null && return 0
    local lib="${OB_TIMERS_LIB:-/usr/lib/open-bastion/ob-timers-lib.sh}"
    if [ ! -r "$lib" ]; then
        lib="$(dirname "$(readlink -f "$0")")/ob-timers-lib.sh"
    fi
    if [ ! -r "$lib" ]; then
        error "ob-timers-lib.sh not found (reinstall the open-bastion package)"
        return 1
    fi
    # shellcheck source=scripts/ob-timers-lib.sh
    . "$lib"
}

# Download the KRL now, and keep it fresh with ob-krl-refresh.timer (Mode E).
#
# The first download happens here, synchronously, because sshd is about to be
# restarted with RevokedKeys pointing at this file, and sshd refuses every key
# while that file is missing. Both the download and the timer run the packaged
# ob-krl-refresh, so there is one implementation of the checks that keep a bad
# list away from sshd.
#
# Until 0.7.0 this wrote /etc/cron.d/open-bastion-krl and a generated
# /usr/local/bin/open-bastion-refresh-krl. A run on such a host replaces them,
# carrying over the interval of the old job unless --krl-refresh-interval says
# otherwise, and removes them only once the timer is running.
download_krl() {
    if [ "$MAX_SECURITY" != "true" ]; then
        return 0
    fi

    step "Downloading Key Revocation List (KRL)..."

    load_timers_lib || return 1

    # An explicit --krl-refresh-interval wins. Without it ob_krl_timer_setup
    # carries over the interval of a 0.6 cron job, or leaves the schedule the
    # host already has.
    local given=""
    [ "$KRL_INTERVAL_GIVEN" = "true" ] && given="$KRL_REFRESH_INTERVAL"

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would download KRL from ${PORTAL_URL}/ssh/revoked with $KRL_REFRESH_BIN"
        OB_TIMERS_DRY_RUN=true
        ob_krl_timer_setup "$given" || true
        report_timers "[DRY-RUN] Would "
        return 0
    fi

    # 1. The list sshd reads, now.
    if [ -x "$KRL_REFRESH_BIN" ] \
       && "$KRL_REFRESH_BIN" --config "$OB_CONFIG" --output "$SSH_REVOKED_KEYS"; then
        info "KRL saved to $SSH_REVOKED_KEYS"
    elif [ -f "$SSH_REVOKED_KEYS" ]; then
        warn "KRL not available or invalid; keeping the current $SSH_REVOKED_KEYS"
    else
        # An empty file is a valid, empty KRL for sshd; a missing one is not.
        install -m 0644 /dev/null "$SSH_REVOKED_KEYS"
        warn "KRL not available or invalid format, created empty file"
    fi

    # 2. The timer that keeps it fresh, replacing the 0.6 cron job.
    OB_TIMERS_DRY_RUN=false
    if ! ob_krl_timer_setup "$given"; then
        report_timers ""
        error "KRL refresh: $OB_TIMERS_MSG"
        return 1
    fi
    report_timers ""
    KRL_SCHEDULE="$OB_TIMERS_SCHEDULE"
}

# Print what ob_krl_timer_setup / ob_audit_timer_setup did (or, in a dry run,
# would do). In a dry run their sentences start with "would "; PREFIX replaces
# that word, so the lines read like the other [DRY-RUN] lines.
report_timers() {
    local prefix="$1" line
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        if [ -n "$prefix" ]; then
            info "${prefix}${line#would }"
        else
            info "${line^}"
        fi
    done <<< "$OB_TIMERS_DONE"
    while IFS= read -r line; do
        if [ -n "$line" ]; then warn "${line^}"; fi
    done <<< "$OB_TIMERS_WARN"
    return 0
}

# Backend: stop what only a bastion runs, left by an earlier bastion setup of
# this host. ob-cert.socket is the one that matters: it mints hop certificates
# with this host's server token for any local user, and a backend must never
# vouch for anyone (the package never enables it on one). ob-record.socket is
# the recording sink, which nothing on a backend feeds. ssh-proxy.conf is
# ob-ssh's configuration; it holds no secret, but ob-ssh has nowhere to hop
# from a backend. ob-session-prune.timer stays: it expires the recordings the
# bastion left on disk, and the package enables it on every host anyway.
retire_bastion_services() {
    is_backend || return 0
    local unit proxy_conf="$SSH_PROXY_CONF"
    if command -v systemctl >/dev/null 2>&1; then
        for unit in ob-cert.socket ob-record.socket; do
            systemctl is-enabled --quiet "$unit" 2>/dev/null \
                || systemctl is-active --quiet "$unit" 2>/dev/null \
                || continue
            if [ "$DRY_RUN" = "true" ]; then
                info "[DRY-RUN] Would disable --now $unit (bastion only)"
            elif systemctl disable --now "$unit" >/dev/null 2>&1; then
                info "Disabled $unit (bastion only, left by an earlier bastion setup)"
            else
                warn "Could not disable $unit, which a backend must not run:"
                warn "  systemctl disable --now $unit"
            fi
        done
    fi
    if [ -f "$proxy_conf" ] \
       && head -1 "$proxy_conf" | grep -q '^# Open Bastion ssh-proxy configuration$'; then
        if [ "$DRY_RUN" = "true" ]; then
            info "[DRY-RUN] Would remove $proxy_conf (bastion only)"
        else
            backup_file "$proxy_conf"
            rm -f "$proxy_conf"
            info "Removed $proxy_conf (bastion only, left by an earlier bastion setup)"
        fi
    fi
    return 0
}

# Bastion stack: say so when a backend's LLNG sudo stack is still in place.
# Outside Mode E a bastion does not touch sudo, so an earlier backend setup of
# this host left /etc/pam.d/sudo authorizing SSO users through LLNG, with the
# sudoers rule that goes with it. Whether that should stay is a sudo policy
# decision this script cannot make for the operator; restoring the
# distribution's stack blindly could lock the local admin out.
warn_backend_sudo_left() {
    is_backend && return 0
    [ "$MAX_SECURITY" = "true" ] && return 0
    grep -q 'pam_openbastion.so service_type=sudo' "$PAM_SUDO" 2>/dev/null || return 0
    warn "$PAM_SUDO still holds the LLNG sudo stack of an earlier backend setup:"
    warn "SSO users that LLNG authorizes for sudo can still elevate on this $(role_noun)."
    warn "If they must not, restore the distribution's $PAM_SUDO and $PAM_SUDO_I"
    warn "and remove /etc/sudoers.d/open-bastion."
    return 0
}

# Configure PAM for sudo with LLNG authorization (backend only; Mode E then
# replaces the stack with the token-only one below)
configure_pam_sudo() {
    if ! is_backend; then
        return 0
    fi
    if [ "$ENABLE_SUDO" != "true" ]; then
        info "Sudo configuration skipped (--no-sudo)"
        return 0
    fi

    step "Configuring PAM for sudo..."

    # shellcheck disable=SC2155
    local pam_content="# PAM configuration for sudo with LemonLDAP::NG
# Generated by $PROG_NAME on $(date)
#
# SSO users (resolved through NSS openbastion, absent from /etc/passwd) are
# authenticated and authorized for sudo by LLNG. LOCAL Unix users (present in
# /etc/passwd, e.g. the machine's break-glass admin) keep standard Unix sudo:
# without these fallbacks a 'required pam_openbastion' line locks every local
# admin out of sudo, since LLNG cannot authorize users it does not know.

# Authentication - local Unix password first, then LLNG
auth       sufficient   pam_unix.so
auth       required     pam_openbastion.so service_type=sudo

# Account - local users (in /etc/passwd) pass; SSO users checked with LLNG
account    sufficient   pam_localuser.so
account    required     pam_openbastion.so service_type=sudo

# Session - standard Unix
session    required     pam_unix.so
"

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would configure PAM for sudo"
        echo "$pam_content"
        info "[DRY-RUN] Would create group open-bastion-sudo"
        info "[DRY-RUN] Would create /etc/sudoers.d/open-bastion with: %open-bastion-sudo ALL=(ALL) ALL"
        if [ "$SUDO_FRESH_OTP" = "true" ]; then
            info "[DRY-RUN] Would add: Defaults:%open-bastion-sudo timestamp_timeout=0"
        fi
        return 0
    fi

    backup_file "$PAM_SUDO"
    echo "$pam_content" > "$PAM_SUDO"
    chmod 644 "$PAM_SUDO"
    info "Configured $PAM_SUDO"

    # `sudo -i` uses the separate "sudo-i" PAM service; mirror the stack so it
    # behaves identically to plain sudo for SSO users.
    backup_file "$PAM_SUDO_I"
    echo "$pam_content" > "$PAM_SUDO_I"
    chmod 644 "$PAM_SUDO_I"
    info "Configured $PAM_SUDO_I"

    # PAM authorizes sudo, but sudoers must still grant the right. pam_openbastion
    # adds an authorized user to the open-bastion-sudo group during its session
    # phase — but only if that group exists — and the group needs a sudoers rule.
    # Without both, an LLNG-authorized SSO user still gets "not in the sudoers
    # file" (#154). Same drop-in as configure_max_security_sudo.
    groupadd --system open-bastion-sudo 2>/dev/null || true

    local sudoers_file="/etc/sudoers.d/open-bastion"
    write_open_bastion_sudoers "$sudoers_file" "# Open Bastion: defense-in-depth sudo authorization"
}

# Configure PAM for sudo with LLNG token (Mode E)
configure_max_security_sudo() {
    if [ "$MAX_SECURITY" != "true" ]; then
        return 0
    fi

    step "Configuring PAM sudo for LLNG token authentication (Mode E)..."

    # shellcheck disable=SC2155
    local pam_content="# PAM configuration for sudo with Open Bastion (Mode E - Maximum Security)
# Generated by $PROG_NAME on $(date)
#
# Authentication: LLNG temporary token ONLY
# - Unix passwords: REJECTED
# - LLNG tokens: REQUIRED (fresh re-authentication via SSO)
#
# Authorization: LLNG checks sudo_allowed flag

auth       sufficient   pam_openbastion.so
auth       required     pam_deny.so

account    required     pam_openbastion.so

session    required     pam_unix.so
"

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would configure PAM sudo for LLNG token auth"
        echo "$pam_content"
        info "[DRY-RUN] Would create group open-bastion-sudo"
        info "[DRY-RUN] Would create /etc/sudoers.d/open-bastion with: %open-bastion-sudo ALL=(ALL) ALL"
        if [ "$SUDO_FRESH_OTP" = "true" ]; then
            info "[DRY-RUN] Would add: Defaults:%open-bastion-sudo timestamp_timeout=0"
        fi
        return 0
    fi

    backup_file "$PAM_SUDO"
    echo "$pam_content" > "$PAM_SUDO"
    chmod 644 "$PAM_SUDO"
    info "Configured $PAM_SUDO for LLNG token authentication"

    # `sudo -i` uses the separate "sudo-i" PAM service. Give it the same stack,
    # otherwise it falls back to the distro default (pam_unix) and fails for
    # NSS-only SSO users ("account validation failure, is your account locked?").
    backup_file "$PAM_SUDO_I"
    echo "$pam_content" > "$PAM_SUDO_I"
    chmod 644 "$PAM_SUDO_I"
    info "Configured $PAM_SUDO_I for LLNG token authentication"

    # Create open-bastion-sudo group for defense-in-depth sudo authorization
    groupadd --system open-bastion-sudo 2>/dev/null || true

    # Configure sudoers: only open-bastion-sudo group members can sudo (PAM also required)
    local sudoers_file="/etc/sudoers.d/open-bastion"
    local sudoers_header="# Open Bastion Mode E: defense-in-depth sudo authorization"
    write_open_bastion_sudoers "$sudoers_file" "$sudoers_header"
}

# Render the drop-in's contents. Split out of write_open_bastion_sudoers so the
# exact bytes can be asserted in a test without root (install -o root would
# fail) and without touching /etc.
render_open_bastion_sudoers() {
    local header="$1"

    printf '%s\n' "$header"
    printf '%s\n' "# Both group membership (managed by PAM session) AND LLNG token are required"
    if [ "$SUDO_FRESH_OTP" = "true" ]; then
        printf '%s\n' "# --enable-sudo-fresh-otp: no sudo credential caching for SSO users, so"
        printf '%s\n' "# every elevation goes through the PAM auth phase and asks for an LLNG token."
        printf '%s\n' "Defaults:%open-bastion-sudo timestamp_timeout=0"
    fi
    printf '%s\n' "%open-bastion-sudo ALL=(ALL) ALL"
}

# Install /etc/sudoers.d/open-bastion, optionally with the fresh-OTP Defaults.
#
# sudo caches its own credential (timestamp_timeout, 15 min by default, idle-based
# and rearmed on every use). While that timestamp is valid sudo skips the PAM
# AUTH phase entirely, so pam_openbastion never runs and no LLNG one-time token
# is asked for -- a user who keeps sudoing is never prompted again (#178).
#
# What that does NOT weaken: authorization is re-checked live on every sudo (the
# account phase always runs), so an LLNG-side revocation takes effect at once,
# and each OTP is single-use on the portal. What it does weaken is the Mode E
# claim that every elevation is backed by a *fresh* SSO authentication.
#
# --enable-sudo-fresh-otp scopes timestamp_timeout=0 to the SSO group, so those
# users present a token on every sudo while local break-glass admins keep normal
# sudo behaviour. It is opt-in: turning it on by default would start prompting
# on every sudo across an upgraded fleet, including inside scripts.
write_open_bastion_sudoers() {
    local sudoers_file="$1" header="$2"
    local tmp_sudoers rendered

    rendered=$(render_open_bastion_sudoers "$header")

    if [ -f "$sudoers_file" ]; then
        # Never rewrite an operator's file behind their back; only add the
        # Defaults line they explicitly asked for, and only if it is missing.
        if [ "$SUDO_FRESH_OTP" != "true" ] \
           || grep -q '^Defaults:%open-bastion-sudo[[:space:]].*timestamp_timeout=0' "$sudoers_file"; then
            return 0
        fi
        tmp_sudoers=$(mktemp)
        {
            printf '%s\n' "# --enable-sudo-fresh-otp: no sudo credential caching for SSO users (#178)"
            printf '%s\n' "Defaults:%open-bastion-sudo timestamp_timeout=0"
            cat "$sudoers_file"
        } > "$tmp_sudoers"
        if visudo -cf "$tmp_sudoers" >/dev/null 2>&1; then
            backup_file "$sudoers_file"
            if install -m 0440 -o root -g root "$tmp_sudoers" "$sudoers_file"; then
                info "Added timestamp_timeout=0 for %open-bastion-sudo in $sudoers_file"
            else
                warn "Failed to update $sudoers_file"
            fi
        else
            warn "Updated sudoers rule failed visudo validation; leaving $sudoers_file untouched"
        fi
        rm -f "$tmp_sudoers"
        return 0
    fi

    # Write to a temp file and validate with visudo before installing, so a
    # malformed drop-in can never break sudo on the host.
    tmp_sudoers=$(mktemp)
    printf '%s\n' "$rendered" > "$tmp_sudoers"
    if visudo -cf "$tmp_sudoers" >/dev/null 2>&1; then
        # Ensure the drop-in directory exists (created 0750 root:root only when
        # missing, so we never relax an existing one), then install and CHECK the
        # result -- otherwise a failed install would leave sudo broken while we
        # log success.
        [ -d /etc/sudoers.d ] || install -d -m 0750 -o root -g root /etc/sudoers.d
        if install -m 0440 -o root -g root "$tmp_sudoers" "$sudoers_file"; then
            info "Created $sudoers_file"
            [ "$SUDO_FRESH_OTP" = "true" ] \
                && info "SSO users must present a fresh LLNG token on every sudo (timestamp_timeout=0)"
        else
            warn "Failed to install $sudoers_file; sudo may not work for SSO users"
        fi
    else
        warn "Generated sudoers rule failed visudo validation; not installing"
    fi
    rm -f "$tmp_sudoers"
}

# Ensure /etc/nsswitch.conf has a usable "<db>: files openbastion ..." line.
# Handles three cases:
#   1. Active line already includes "openbastion" → noop.
#   2. Active line exists without openbastion → insert openbastion after the
#      first source token (files / compat / etc.), preserving everything else.
#   3. No active line (missing or commented out) → APPEND a fresh
#      "<db>: files openbastion systemd" line. Crucial fix: previously the
#      script silently no-op'd here, leaving NSS unable to resolve any user.
nss_configure_db() {
    local db="$1"
    local file="$2"
    local default_line="$3"

    if grep -qE "^${db}:.*[[:space:]]openbastion([[:space:]]|\$)" "$file"; then
        info "NSS already configured for $db"
        return 0
    fi

    if grep -qE "^${db}:" "$file"; then
        # Active line present — insert openbastion after the first source token.
        if grep -qE "^${db}:[[:space:]]+files" "$file"; then
            sed -i -E "s/^(${db}:[[:space:]]+files)/\\1 openbastion/" "$file"
        elif grep -qE "^${db}:[[:space:]]+compat" "$file"; then
            sed -i -E "s/^(${db}:[[:space:]]+compat)/\\1 openbastion/" "$file"
        else
            sed -i -E "s/^(${db}:[[:space:]]+[^[:space:]]+)/\\1 openbastion/" "$file"
        fi
        info "Added openbastion to $db in $file"
    else
        # No active "<db>:" line — append a complete one. This fixes systems
        # where nsswitch.conf ships with passwd:/group: commented out (some
        # minimal images and "Example configuration" templates).
        warn "$file has no active '$db:' line; appending: $default_line"
        printf '%s\n' "$default_line" >> "$file"
        info "Appended new $db line to $file"
    fi

    # Sanity check: an active "<db>:" line containing openbastion must now exist.
    if ! grep -qE "^${db}:.*[[:space:]]openbastion([[:space:]]|\$)" "$file"; then
        error "Failed to add openbastion to $db in $file — please edit manually."
        return 1
    fi
}

# Configure NSS for user/group resolution via LLNG
configure_nss() {
    step "Configuring NSS for user/group resolution..."

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would configure NSS"
        return 0
    fi

    backup_file "$NSSWITCH_CONF"

    nss_configure_db passwd "$NSSWITCH_CONF" "passwd:         files openbastion systemd" || return 1
    nss_configure_db group  "$NSSWITCH_CONF" "group:          files openbastion systemd" || return 1

    # Create NSS configuration
    # shellcheck disable=SC2155
    local nss_content="# LemonLDAP::NG NSS module configuration
# Generated by $PROG_NAME on $(date)

# Portal URL
portal_url = $PORTAL_URL

# Server token file
server_token_file = $OB_TOKEN

# Cache settings
cache_enabled = true
cache_ttl = 300

# UID/GID range for dynamic users
min_uid = 10000
max_uid = 60000
min_gid = 10000
max_gid = 60000

# Default shell and home directory
default_shell = /bin/bash
home_base = /home
"

    backup_file "$NSS_OB_CONF"
    echo "$nss_content" > "$NSS_OB_CONF"
    chmod 644 "$NSS_OB_CONF"
    info "Created $NSS_OB_CONF"
}

# Install one hardening template by absolute source/destination path,
# creating the destination directory if missing and backing up any
# existing file. Mode 0644 root:root.
install_hardening_file() {
    local src="$1"
    local dst="$2"
    local dst_dir
    dst_dir=$(dirname "$dst")

    if [ ! -f "$src" ]; then
        warn "Hardening template missing: $src (package not fully installed?)"
        return 1
    fi

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would install $src -> $dst (0644 root:root)"
        return 0
    fi

    [ -d "$dst_dir" ] || mkdir -p "$dst_dir"
    backup_file "$dst"
    install -m 0644 -o root -g root "$src" "$dst"
    info "Installed $dst"
}

# Conditionally drop a *.allow whitelist if absent, keeping any
# pre-existing admin file untouched. We only warn — overwriting an
# admin-managed file silently would be hostile.
install_hardening_allowlist() {
    local src="$1"
    local dst="$2"

    if [ ! -f "$src" ]; then
        warn "Hardening template missing: $src"
        return 1
    fi

    if [ -f "$dst" ]; then
        if cmp -s "$src" "$dst"; then
            info "$dst already matches template, leaving as-is"
        else
            warn "$dst already exists with custom content — leaving untouched"
            warn "Review it manually against $src to ensure containment is preserved"
            # The shipped allow-list was NOT applied; containment may be weaker
            # than intended, so the overall hardening outcome is only partial.
            HARDENING_RESULT="partial"
        fi
        return 0
    fi

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would create $dst from $src (0644 root:root)"
        return 0
    fi

    install -m 0644 -o root -g root "$src" "$dst"
    info "Created $dst"
}

# Detect non-root users that have `loginctl enable-linger` set.
# A lingering user keeps a per-user systemd manager running after
# logout, which lets them schedule deferred work via
#   systemd-run --user --on-active=…
# That bypasses both KillUserProcesses=yes and the at/cron allowlists.
# This function prints offending "<user>:<uid>" lines to stdout (one
# per line, empty if none) and returns 0. It returns 1 only when
# loginctl is missing — callers should treat that as "skip with a
# warning" since a host without systemd cannot enable linger anyway.
detect_lingering_users() {
    if ! command -v loginctl >/dev/null 2>&1; then
        return 1
    fi

    local users_raw
    # `loginctl list-users --no-legend` prints "<uid> <user> [..]" per row.
    # Some versions trail a header/legend even with --no-legend on older
    # systemd; we filter defensively by requiring a leading numeric uid.
    users_raw=$(loginctl list-users --no-legend 2>/dev/null || true)
    [ -n "$users_raw" ] || return 0

    local uid user linger
    while read -r uid user _rest; do
        case "$uid" in
            ''|*[!0-9]*) continue ;;     # skip non-numeric rows / headers
        esac
        [ "$uid" = "0" ] && continue     # root is allowed to linger
        [ -n "$user" ] || continue
        linger=$(loginctl show-user "$user" --property=Linger --value 2>/dev/null || echo "")
        if [ "$linger" = "yes" ]; then
            printf '%s:%s\n' "$user" "$uid"
        fi
    done <<< "$users_raw"

    return 0
}

# Configure host-level session containment. All steps are pure system
# config — no setuid binary is added. See doc/hardening.rst for rationale.
setup_hardening() {
    step "Applying session containment hardening..."

    if [ ! -d "$HARDENING_TEMPLATE_DIR" ]; then
        warn "Hardening templates not found in $HARDENING_TEMPLATE_DIR"
        warn "Skipping hardening step — install the open-bastion package."
        HARDENING_RESULT="failed"
        return 1
    fi

    # Pre-flight: refuse to harden if any non-root user has linger
    # enabled. Such a user could schedule jobs via `systemd-run --user`
    # that survive logout, defeating both KillUserProcesses=yes and the
    # at/cron allow-lists. This is a security gate, not a UX one — we
    # fail even in --yes mode. In --dry-run, only log so operators can
    # discover the problem before committing.
    local linger_offenders
    if linger_offenders=$(detect_lingering_users); then
        if [ -n "$linger_offenders" ]; then
            if [ "$DRY_RUN" = "true" ]; then
                warn "[DRY-RUN] Linger enabled for the following non-root users (would abort in real run):"
                while IFS=: read -r u uid; do
                    [ -n "$u" ] || continue
                    warn "[DRY-RUN]   $u (uid $uid)"
                done <<< "$linger_offenders"
            else
                error "Hardening refused: the following users have systemd linger enabled,"
                error "        which would let them schedule deferred jobs via 'systemd-run --user',"
                error "        bypassing this hardening:"
                while IFS=: read -r u uid; do
                    [ -n "$u" ] || continue
                    error "          $u (uid $uid)"
                done <<< "$linger_offenders"
                error ""
                error "        To proceed, disable linger for these users:"
                error "          loginctl disable-linger <user>"
                error ""
                error "        Then re-run: $PROG_NAME --portal $PORTAL_URL --enable-hardening [...]"
                HARDENING_RESULT="failed"
                return 1
            fi
        fi
    else
        warn "loginctl not available, skipping linger pre-check"
    fi

    if ! confirm "Apply session containment hardening (KillUserProcesses, nproc cap, at/cron allowlists, mask atd)?"; then
        info "Hardening skipped by user"
        HARDENING_RESULT="declined"
        return 0
    fi

    # Optimistic: assume each sub-step will succeed; downgrade to
    # "partial" on any failure that we choose to recover from rather
    # than abort. Final state is reported by print_summary and by the
    # closing log line below.
    HARDENING_RESULT="applied"

    # 1. logind: KillUserProcesses=yes
    if ! install_hardening_file \
            "$HARDENING_TEMPLATE_DIR/logind.conf.d/open-bastion.conf" \
            "$HARDENING_LOGIND_DST"; then
        warn "Failed to install $HARDENING_LOGIND_DST — containment is incomplete"
        HARDENING_RESULT="partial"
    fi

    # 2. limits.d: nproc cap
    if ! install_hardening_file \
            "$HARDENING_TEMPLATE_DIR/security/limits.d/open-bastion.conf" \
            "$HARDENING_LIMITS_DST"; then
        warn "Failed to install $HARDENING_LIMITS_DST — fork-bomb cap not in place"
        HARDENING_RESULT="partial"
    fi

    # 3. at.allow / cron.allow — never overwrite an admin-managed file
    if ! install_hardening_allowlist \
            "$HARDENING_TEMPLATE_DIR/at.allow" \
            "$HARDENING_AT_ALLOW"; then
        warn "Failed to deploy $HARDENING_AT_ALLOW — at(1) lockdown skipped"
        HARDENING_RESULT="partial"
    fi

    if ! install_hardening_allowlist \
            "$HARDENING_TEMPLATE_DIR/cron.allow" \
            "$HARDENING_CRON_ALLOW"; then
        warn "Failed to deploy $HARDENING_CRON_ALLOW — crontab(1) lockdown skipped"
        HARDENING_RESULT="partial"
    fi

    # 3b. Warn if cron.allow doesn't list 'root'. The Mode E KRL refresh
    #     job (/etc/cron.d/open-bastion-krl) runs as root, and cron
    #     refuses to dispatch jobs for users absent from cron.allow when
    #     the file exists. An admin-managed cron.allow without 'root'
    #     would silently break KRL refresh.
    if [ -f "$HARDENING_CRON_ALLOW" ] \
       && ! grep -qE '^[[:space:]]*root[[:space:]]*$' "$HARDENING_CRON_ALLOW"; then
        warn "$HARDENING_CRON_ALLOW exists but does not list 'root' — this will break"
        warn "the KRL refresh job (/etc/cron.d/open-bastion-krl). Add 'root' on its"
        warn "own line to $HARDENING_CRON_ALLOW."
    fi

    # 4. Mask atd if it exists. We do NOT mask cron because
    #    --max-security writes /etc/cron.d/open-bastion-krl which needs
    #    a running cron daemon.
    if systemctl list-unit-files atd.service 2>/dev/null | grep -q '^atd\.service'; then
        if [ "$DRY_RUN" = "true" ]; then
            info "[DRY-RUN] Would systemctl mask atd && systemctl stop atd"
        else
            systemctl stop atd 2>/dev/null || true
            if systemctl mask atd 2>/dev/null; then
                info "Masked atd.service (deferred at(1) jobs disabled)"
            else
                warn "Failed to mask atd.service — at(1) jobs may still run"
                HARDENING_RESULT="partial"
            fi
        fi
    else
        info "atd.service not present, nothing to mask"
    fi

    # 5. Reload logind so KillUserProcesses=yes takes effect.
    #    `systemctl reload` (SIGHUP) is non-disruptive: logind re-reads
    #    its drop-ins without restarting and without killing active
    #    sessions. KillUserProcesses=yes is consulted at session-end
    #    cleanup, so the new behaviour applies to existing sessions
    #    when they eventually log out, while currently-connected admins
    #    keep their shells. Avoid `reload-or-restart` here: a fallback
    #    to restart would terminate every user session, including the
    #    admin running this setup.
    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would systemctl reload systemd-logind (SIGHUP, non-disruptive)"
        # In dry-run, nothing was actually written; report as such so
        # the operator doesn't read "applied" and assume the host is
        # configured.
        HARDENING_RESULT="dry-run"
    else
        info "Reloading systemd-logind (SIGHUP, no session disruption)"
        if systemctl reload systemd-logind 2>/dev/null; then
            info "Reloaded systemd-logind"
        else
            warn "Failed to reload systemd-logind — run 'systemctl reload systemd-logind' manually"
            HARDENING_RESULT="partial"
        fi
    fi

    case "$HARDENING_RESULT" in
        applied)
            info "Hardening applied. Verify with: loginctl show-user <user> | grep Linger"
            ;;
        partial)
            warn "Hardening applied with warnings — review the output above before relying on containment"
            ;;
        dry-run)
            info "[DRY-RUN] Hardening would be applied. Re-run without --dry-run to commit."
            ;;
        *)
            ;;
    esac
}

# Configure primary audit trace via auditd (opt-in).
# Goal: tamper-evident syscall-level evidence of non-sudo user activity,
# independent of the pty session recording (which a malicious user could
# wipe or bypass via setsid/at/cron). Targets auid >= 1000.
#
# Caller decides whether this runs (see ENABLE_AUDIT_TRACE in main()).
# This function never tries to install the auditd package itself: it only
# *configures* an auditd that is already present (Recommends in packaging).
setup_audit_trace() {
    step "Configuring primary audit trace (auditd)..."

    # 1. Sanity: auditd must be installed. We don't try to be clever — both
    #    `auditctl` (the CLI) and `augenrules` (the rules.d compiler) are
    #    needed at runtime. systemctl probe is an additional belt-and-braces.
    local auditd_ok=true
    if ! command -v auditctl >/dev/null 2>&1; then
        auditd_ok=false
    fi
    if ! command -v augenrules >/dev/null 2>&1; then
        auditd_ok=false
    fi
    if [ "$auditd_ok" != "true" ]; then
        warn "auditd is not installed; skipping audit trace setup."
        warn "  To enable audit trace later, install auditd then re-run with --enable-audit-trace:"
        warn "    Debian/Ubuntu: apt install auditd"
        warn "    RHEL/Rocky/Fedora: dnf install audit"
        AUDIT_RESULT="skipped"
        return 0
    fi

    # 2. Templates must be deployed (CMake installs them under datarootdir).
    local rules_template="$AUDIT_TEMPLATE_DIR/rules.d/open-bastion.rules"
    if [ ! -f "$rules_template" ]; then
        error "Audit rules template not found: $rules_template"
        error "Reinstall the open-bastion package, or set AUDIT_TEMPLATE_DIR=<path>."
        AUDIT_RESULT="failed"
        return 1
    fi
    if ! load_timers_lib; then
        AUDIT_RESULT="failed"
        return 1
    fi

    # 3. Confirmation: this deploys a rules.d entry and the rotation timer and
    #    restarts auditd. Default-OFF policy applies. /etc/audit/auditd.conf is
    #    NOT touched — see rationale below.
    if ! confirm "Enable primary audit trace? Installs rules.d + a daily rotation timer and restarts auditd."; then
        info "Audit trace setup skipped by user."
        AUDIT_RESULT="declined"
        return 0
    fi

    if [ "$DRY_RUN" = "true" ]; then
        OB_TIMERS_DRY_RUN=true
        ob_audit_timer_setup || true
        report_timers "[DRY-RUN] Would "
        info "[DRY-RUN] Would install $AUDIT_RULES_FILE (0640 root:root)"
        info "[DRY-RUN] Would augenrules --load and restart auditd"
        info "[DRY-RUN] /etc/audit/auditd.conf intentionally NOT modified"
        AUDIT_RESULT="dry-run"
        return 0
    fi

    # 4. The rotation, first: if it cannot be armed, stop before auditd is
    #    touched rather than leave a trace that grows without bound. A 0.6
    #    /etc/cron.daily (or cron.weekly) rotation is replaced on the same
    #    schedule, and removed only once the timer runs.
    OB_TIMERS_DRY_RUN=false
    if ! ob_audit_timer_setup; then
        report_timers ""
        error "Audit rotation: $OB_TIMERS_MSG"
        AUDIT_RESULT="failed"
        return 1
    fi
    report_timers ""

    # 5. Install rules template into /etc/audit/rules.d/.
    #    auditd's default rules.d entries (e.g. audit.rules) ship as 0640
    #    root:root on Debian; we match that.
    #    Guard against `set -e` aborting the whole setup run if
    #    /etc/audit/rules.d/ is missing, RO, or perms-denied — return 1
    #    instead so main() catches it via `setup_audit_trace || warn …`.
    if ! install -o root -g root -m 0640 "$rules_template" "$AUDIT_RULES_FILE"; then
        error "Failed to install $AUDIT_RULES_FILE"
        AUDIT_RESULT="failed"
        return 1
    fi
    info "Installed $AUDIT_RULES_FILE"

    # /etc/audit/auditd.conf is intentionally NOT modified. It is a single
    # admin-tunable file owned by the audit distro package. Drop-in mechanisms
    # (rules.d/, a timer) are used where they exist; auditd.conf is left
    # for the administrator to tune manually (see doc/audit.rst).
    info "Audit trace deployed. /etc/audit/auditd.conf is intentionally NOT modified."
    info "For ~1 week retention, set num_logs=7 max_log_file=50 max_log_file_action=ROTATE in /etc/audit/auditd.conf manually (see doc/audit.rst)."

    # 6. Compile + load rules. augenrules merges everything under
    #    /etc/audit/rules.d/*.rules into /etc/audit/audit.rules and tells
    #    auditctl to load them. A non-zero exit usually means a bad rule
    #    (e.g. arch mismatch on 32-bit kernel) — surface it but don't abort:
    #    the rotation timer is still in effect.
    if augenrules --load >/dev/null 2>&1; then
        info "auditd rules loaded via augenrules"
    else
        warn "augenrules --load failed; check 'augenrules --check' output."
    fi

    # 7. Restart auditd to activate the new rules.d entries.
    #    auditd does not honour SIGHUP for rules.d changes — restart is the
    #    documented way. Unlike logind, restarting auditd does NOT terminate
    #    SSH sessions, so this is safe to run on a live host.
    if systemctl is-active --quiet auditd 2>/dev/null; then
        if systemctl restart auditd 2>/dev/null; then
            info "Restarted auditd.service"
        else
            warn "Failed to restart auditd; run 'systemctl restart auditd' manually."
        fi
    else
        warn "auditd.service is not active; start it with 'systemctl enable --now auditd'."
    fi

    AUDIT_RESULT="applied"
}

# Pre-flight: verify the portal's Device Authorization endpoint is reachable
# BEFORE applying any SSH/PAM lockdown. Without this check, a failed
# enrollment could leave the host in a state where no one can log in
# (PasswordAuthentication disabled + no certs because no enrollment).
preflight_check_portal() {
    # If user provided a pre-shared token, no portal contact is needed.
    if [ -n "$SERVER_TOKEN" ]; then
        return 0
    fi
    if [ "$DRY_RUN" = "true" ]; then
        return 0
    fi

    step "Pre-flight: checking Device Authorization endpoint reachability..."

    build_curl_opts
    # POST with no body. Any HTTP status (even 400/401/405) means the endpoint
    # exists. A network failure (curl exit != 22 typically yields "000" via -w).
    # We strip "-f" so we get the HTTP code instead of curl returning non-zero on 4xx.
    local opts=()
    local opt
    for opt in "${CURL_OPTS[@]}"; do
        [ "$opt" = "-f" ] || opts+=("$opt")
    done

    local http_code
    http_code=$(curl "${opts[@]}" -X POST -o /dev/null -w '%{http_code}' \
                "${PORTAL_URL}/oauth2/device" 2>/dev/null) || http_code="000"

    if [ "$http_code" = "000" ]; then
        error "Cannot reach Device Authorization endpoint at ${PORTAL_URL}/oauth2/device"
        error "Aborting BEFORE any SSH/PAM lockdown to avoid leaving the $(role_noun) unreachable."
        error ""
        error "Possible causes:"
        error "  - Portal URL incorrect (got: $PORTAL_URL)"
        error "  - Device Authorization Grant not enabled on the LLNG portal"
        error "  - Network/DNS/TLS failure (test: curl -v ${PORTAL_URL}/oauth2/device)"
        error "  - Use -k/--insecure if portal uses a self-signed certificate"
        return 1
    fi

    if [ "$http_code" = "404" ]; then
        error "Portal responded with 404 on /oauth2/device — Device Authorization Grant is not enabled."
        error "Enable 'oidcServiceAllowAuthorizationCodeGrant' / Device Flow on the LLNG portal."
        return 1
    fi

    info "Device Authorization endpoint reachable (HTTP $http_code)"
    return 0
}

# Abort if the saved server token has no refresh_token. Without an offline
# refresh token the short-lived access token cannot be renewed, and SSO/NSS
# lookups (getent passwd <user>) stop working ~1h after setup. A missing
# refresh_token means the OIDC client does not grant offline access.
require_refresh_token() {
    [ -s "$OB_TOKEN" ] || return 0
    local rt
    rt=$(jq -r '.refresh_token // ""' "$OB_TOKEN" 2>/dev/null)
    if [ -z "$rt" ]; then
        error "The server token at $OB_TOKEN has NO refresh_token."
        error "The access token cannot be renewed, so SSO/NSS lookups will stop"
        error "working about 1 hour after this setup."
        error ""
        error "The OIDC client '${CLIENT_ID:-pam-access}' must grant offline access:"
        error "  - set oidcRPMetaDataOptionsAllowOffline = 1 on that client in LLNG"
        error "  - ensure 'offline_access' is an allowed scope"
        error "Then delete $OB_TOKEN and re-run this setup."
        return 1
    fi
    return 0
}

# Enroll server with LLNG. Sets ENROLL_RESULT and returns 0 on success,
# 1 on failure. Callers must inspect the return code to decide whether to
# proceed with SSH/PAM lockdown.
enroll_server() {
    step "Enrolling server with LLNG..."

    if [ -n "$SERVER_TOKEN" ]; then
        # Token provided directly
        if [ "$DRY_RUN" = "true" ]; then
            info "[DRY-RUN] Would save provided server token"
            ENROLL_RESULT="dry-run"
            return 0
        fi

        echo "$SERVER_TOKEN" > "$OB_TOKEN"
        chmod 600 "$OB_TOKEN"
        info "Server token saved"
        ENROLL_RESULT="token-provided"
        return 0
    fi

    # Reuse an existing token instead of re-enrolling. A prior ob-enroll run
    # (e.g. the installer's separate enrollment step, or a previous setup)
    # may already have written the canonical token file. Re-running the
    # device-authorization flow would force a second browser approval and,
    # in --non-interactive mode, fail outright ("requires --token-file").
    # If the token file exists and is non-empty, adopt it. Delete it first
    # if you deliberately want to re-enroll.
    if [ -s "$OB_TOKEN" ]; then
        info "Existing server token found at $OB_TOKEN — reusing it (no re-enrollment)."
        require_refresh_token || { ENROLL_RESULT="failed"; return 1; }
        ENROLL_RESULT="reused"
        return 0
    fi

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would run ob-enroll"
        ENROLL_RESULT="dry-run"
        return 0
    fi

    if [ ! -x /usr/sbin/ob-enroll ]; then
        error "Enrollment helper /usr/sbin/ob-enroll not found or not executable."
        error "Install the open-bastion package or provide a token via --token-file."
        ENROLL_RESULT="failed"
        return 1
    fi

    if [ "$NON_INTERACTIVE" = "true" ]; then
        error "Cannot enroll in non-interactive mode without --token-file"
        ENROLL_RESULT="failed"
        return 1
    fi

    local enroll_opts=("-p" "$PORTAL_URL" "-g" "$SERVER_GROUP")
    if [ "$VERIFY_SSL" = "false" ]; then
        enroll_opts+=("-k")
    fi
    if [ -n "$CLIENT_ID" ]; then
        enroll_opts+=("-c" "$CLIENT_ID")
    fi

    # Pass the secret via env var (not CLI) to keep it out of /proc/<pid>/cmdline.
    # ob-enroll honours OB_CLIENT_SECRET with highest priority (see ob-enroll).
    if [ -n "$CLIENT_SECRET" ]; then
        if OB_CLIENT_SECRET="$CLIENT_SECRET" /usr/sbin/ob-enroll "${enroll_opts[@]}"; then
            require_refresh_token || { ENROLL_RESULT="failed"; return 1; }
            ENROLL_RESULT="success"
            return 0
        fi
    else
        if /usr/sbin/ob-enroll "${enroll_opts[@]}"; then
            require_refresh_token || { ENROLL_RESULT="failed"; return 1; }
            ENROLL_RESULT="success"
            return 0
        fi
    fi

    ENROLL_RESULT="failed"
    return 1
}

# Prompt for required settings (SERVER_GROUP and CLIENT_ID) before any
# system change. No silent defaults: misconfiguring either makes the host
# unusable, and the user should see exactly what is going to LLNG. In
# non-interactive mode (-y), missing values are fatal — the caller must
# pass them explicitly via -g / -c. A backend is also asked for its bastion
# allowlist.
prompt_required_settings() {
    if [ -z "$SERVER_GROUP" ]; then
        if [ "$NON_INTERACTIVE" = "true" ]; then
            error "Missing --server-group (required in non-interactive mode)."
            exit 1
        fi
        printf "Server group (must match a group defined in LLNG): " >&2
        IFS= read -r SERVER_GROUP
        if [ -z "$SERVER_GROUP" ]; then
            error "Server group cannot be empty."
            exit 1
        fi
    fi

    if [ -z "$CLIENT_ID" ]; then
        if [ "$NON_INTERACTIVE" = "true" ]; then
            error "Missing --client-id (required in non-interactive mode)."
            exit 1
        fi
        local input
        printf "OIDC client_id [pam-access]: " >&2
        IFS= read -r input
        CLIENT_ID="${input:-pam-access}"
    fi

    if is_backend; then
        prompt_allowed_bastions
        normalize_allowed_bastions
    fi
}

# Validate and normalise the bastion_id allowlist.
#
# Entries must match the charset LLNG guarantees for a bastion_id
# ([A-Za-z0-9._-]) -- the same one the principals helper enforces on the id it
# reads out of a certificate key-id. Without this, a typo would sit in the
# allowlist matching nothing (every hop denied, with no explanation), and a
# whitespace-only value would silently mean "any bastion" while looking set.
normalize_allowed_bastions() {
    local raw normalized entry had_noglob
    raw=$(printf '%s' "$BASTION_ALLOWED_IDS" | tr ',;' '  ')
    # Splitting $raw also runs PATHNAME EXPANSION, which would defeat the
    # validation below instead of triggering it: an entry containing a glob
    # metacharacter that happens to match a file in the current directory is
    # rewritten to the match ('b[1]' -> the file 'b1'), so a typo is silently
    # accepted as a different, valid-looking id. Split with globbing off.
    case $- in *f*) had_noglob=1 ;; *) had_noglob=0 ;; esac
    set -f
    normalized=""
    for entry in $raw; do
        case "$entry" in
            *[!A-Za-z0-9._-]*)
                error "Invalid bastion id in the allowed-bastions list: '$entry'"
                error "Ids are what 'ob-bastion-id' prints on a bastion ([A-Za-z0-9._-])."
                exit 1
                ;;
        esac
        normalized="${normalized:+$normalized }$entry"
    done
    [ "$had_noglob" = 1 ] || set +f
    BASTION_ALLOWED_IDS="$normalized"
}

# Ask which bastions this backend should accept hops from (#182).
#
# An empty allowlist means "any vouched bastion": the backend accepts a hop
# voucher minted by any host enrolled in the project, which is exactly the
# residual defence behind the SSO-side gap where a compromised enrolled host can
# declare itself a bastion. Defaulting to that silently is what the issue is
# about, so ask -- but do not make it mandatory: a single-bastion lab, and a
# fleet whose bastions are not enrolled yet, both legitimately start empty.
#
# Non-interactive runs keep the empty default (an upgrade must not start
# refusing hops that worked yesterday); they get the warning at the end of
# install_principals_helper, and the helper logs one on every hop.
#
# An INTERACTIVE run is not an upgrade path, so there is nothing to preserve:
# leaving the list empty there has to be a decision the operator took, not the
# one they get for pressing Enter. Pressing Enter re-asks, with the exposure
# spelled out, and only a "y" to "accept ANY bastion" leaves it empty.
# --allow-any-bastion states that answer up front (a lab, or a host whose
# bastion is not enrolled yet).
prompt_allowed_bastions() {
    [ -n "$BASTION_ALLOWED_IDS" ] && return 0
    [ "$NON_INTERACTIVE" = "true" ] && return 0
    [ "$ALLOW_ANY_BASTION" = "true" ] && return 0

    local input
    printf "\n" >&2
    warn "Which bastions may hop to this backend?"
    warn "Run 'ob-bastion-id' on each bastion to get its id."
    while :; do
        printf "Allowed bastion ids (comma-separated): " >&2
        IFS= read -r input
        # Not [ -n "$input" ]: normalize_allowed_bastions collapses whitespace
        # AND the separators to nothing, so "   ", ",," or " ; , " would all
        # reach the empty list -- the very thing the explicit "y" below exists
        # to gate -- while looking like an answer.
        if [ -n "${input//[[:space:],;]/}" ]; then
            BASTION_ALLOWED_IDS="$input"
            return 0
        fi
        printf "\n" >&2
        warn "An empty list accepts a hop voucher from ANY host enrolled in the"
        warn "project that can declare itself a bastion to the SSO -- not only"
        warn "from the bastions you operate (#182). It is the residual defence"
        warn "behind an SSO-side gap, and this is the only place it gets set."
        if confirm "Accept a hop from ANY bastion?"; then
            return 0
        fi
        printf "\n" >&2
    done
}

# Interactive prompt that asks the user for client_id and client_secret
# when an enrollment attempt failed (typically with invalid_client). Returns 0
# if new values were supplied, 1 if the user declined (or non-interactive).
prompt_for_client_credentials() {
    if [ "$NON_INTERACTIVE" = "true" ]; then
        return 1
    fi

    echo ""
    info "The LLNG portal seems to require a confidential client."
    info "Current: client_id='${CLIENT_ID:-pam-access (default)}', client_secret=$([ -n "$CLIENT_SECRET" ] && echo 'set' || echo 'empty')"
    echo ""
    if ! confirm "Provide/update client credentials and retry?"; then
        return 1
    fi

    local new_id new_secret
    printf "Client ID [%s]: " "${CLIENT_ID:-pam-access}" >&2
    IFS= read -r new_id
    if [ -n "$new_id" ]; then
        CLIENT_ID="$new_id"
    fi

    printf "Client secret (input hidden, empty = keep current): " >&2
    IFS= read -rs new_secret
    echo "" >&2
    if [ -n "$new_secret" ]; then
        CLIENT_SECRET="$new_secret"
    fi

    if [ -z "$CLIENT_SECRET" ]; then
        warn "No client_secret provided — retry will likely fail again."
    fi
    return 0
}

# Restart SSH service
restart_sshd() {
    step "Restarting SSH service..."

    if [ "$DRY_RUN" = "true" ]; then
        info "[DRY-RUN] Would restart sshd"
        return 0
    fi

    if systemctl is-active --quiet sshd 2>/dev/null; then
        systemctl restart sshd
        info "Restarted sshd.service"
    elif systemctl is-active --quiet ssh 2>/dev/null; then
        systemctl restart ssh
        info "Restarted ssh.service"
    else
        warn "Could not restart SSH service automatically"
        warn "Please restart it manually: systemctl restart sshd"
    fi
}

# Print summary
# The portal-side prerequisite for R-P1, printed at the end of every run.
#
# `pamAccessServerGroups` and `pamAccessAllowedRps` live in the LemonLDAP::NG
# Manager, not here, and nothing on this host can read them back -- asking the
# portal whether they are set would mean an API that publishes the project's
# bastions and server groups, which is not something an SSO should offer. So
# the only honest thing a setup script can do is state the requirement, every
# time, rather than let a host come up looking finished while the gap is open.
#
# The text is shipped as data (share/ -> /usr/lib/open-bastion) because it is
# printed by three setup scripts and ob-post-upgrade; a heredoc in each is how
# the units of #254 drifted apart.
print_portal_prerequisites() {
    local f
    f="$(_ob_data_dir)/ob-portal-prerequisites.txt"
    if [ -r "$f" ]; then
        echo ""
        cat "$f"
    else
        echo ""
        echo "PORTAL-SIDE PREREQUISITE (R-P1): set pamAccessServerGroups and"
        echo "pamAccessAllowedRps in the LLNG Manager, or any enrolled host can"
        echo "declare itself a bastion. See doc/security/09-portail-llng.rst."
        echo "($f is missing — reinstall the open-bastion package)"
    fi
}

print_summary() {
    echo ""
    if [ "$ENROLL_RESULT" = "failed" ]; then
        print_box "$(role_title) Configuration INCOMPLETE"
    else
        print_box "$(role_title) Configuration Complete"
    fi
    echo ""
    echo "Configuration:"
    echo "  Node role:     $NODE_ROLE"
    echo "  Portal URL:    $PORTAL_URL"
    echo "  Server Group:  $SERVER_GROUP"
    echo "  CA Key:        $SSH_CA_FILE"
    if is_backend; then
        echo "  Allowed bastions: ${BASTION_ALLOWED_IDS:-<any vouched bastion>}"
    fi
    echo ""
    echo "Features enabled:"
    echo "  ✓ SSH certificate authentication"
    if is_backend; then
        echo "  ✓ Only bastion-vouched certificates accepted"
        if [ "$CREATE_USERS" = "true" ]; then
            echo "  ✓ Automatic user creation"
        else
            echo "  ✗ Automatic user creation disabled (--no-create-user)"
        fi
        if [ "$ENABLE_SUDO" = "true" ]; then
            echo "  ✓ LLNG-controlled sudo access"
        else
            echo "  ✗ LLNG-controlled sudo disabled (--no-sudo)"
        fi
    elif [ "$DISABLE_SESSION_RECORDER" = "true" ]; then
        echo "  ✗ Session recording disabled (--disable-session-recorder)"
    else
        echo "  ✓ Session recording (ForceCommand)"
    fi
    echo "  ✓ LLNG authorization"
    echo "  ✓ NSS user/group resolution"
    echo "  ✓ Password authentication disabled"
    case "$ENROLL_RESULT" in
        success)
            echo "  ✓ Server enrolled with LLNG (token stored)"
            ;;
        token-provided)
            echo "  ✓ Server token installed (provided via --token-file)"
            ;;
        reused)
            echo "  ✓ Existing server token reused (no re-enrollment)"
            ;;
        dry-run)
            echo "  ✓ Server enrollment (dry-run — nothing actually saved)"
            ;;
        failed)
            echo "  ✗ Server enrollment FAILED — see [ERROR] above"
            echo "    The $(role_noun) will REJECT all logins until you run:"
            echo "      ob-enroll -p $PORTAL_URL -g $SERVER_GROUP"
            ;;
        *)
            echo "  ? Server enrollment status unknown ($ENROLL_RESULT)"
            ;;
    esac
    case "$HARDENING_RESULT" in
        applied)
            echo "  ✓ Session containment (logind KillUserProcesses, nproc cap, at/cron allowlists)"
            ;;
        partial)
            echo "  ⚠ Session containment partially applied — see [WARN] lines above"
            ;;
        dry-run)
            echo "  ✓ Session containment (dry-run — nothing actually written)"
            ;;
        declined)
            echo "  ✗ Session containment hardening (declined at confirm prompt)"
            ;;
        failed)
            echo "  ✗ Session containment hardening (failed — see [ERROR] lines above)"
            ;;
        *)
            echo "  ✗ Session containment hardening (not applied — use --enable-hardening to opt in)"
            ;;
    esac
    if [ "$MAX_SECURITY" = "true" ]; then
        echo "  ✓ Maximum Security Mode E"
        echo "    - SSH: SSO-signed certificates only"
        echo "    - sudo: LLNG temporary token required"
        echo "    - KRL: mandatory, refreshed ${KRL_SCHEDULE} (ob-krl-refresh.timer)"
        if [ "$SUDO_FRESH_OTP" = "true" ]; then
            echo "    - sudo: fresh LLNG token on EVERY elevation (timestamp_timeout=0)"
        else
            echo "    - sudo: sudo's own 15-min credential cache applies between"
            echo "      elevations (use --enable-sudo-fresh-otp to require a token each time)"
        fi
    fi
    case "$AUDIT_RESULT" in
        applied)
            echo "  ✓ Audit trace: applied (auditd rules + daily rotation)"
            ;;
        skipped)
            echo "  ✗ Audit trace: NOT applied (auditd not installed)"
            ;;
        declined)
            echo "  ✗ Audit trace: NOT applied (declined at prompt)"
            ;;
        dry-run)
            echo "  ✓ Audit trace: dry-run (nothing actually changed)"
            ;;
        failed)
            echo "  ✗ Audit trace: FAILED — see [ERROR] lines above"
            ;;
        *)
            echo "  ✗ Audit trace: not applied (opt-in: --enable-audit-trace)"
            ;;
    esac
    # A change that alters sshd for every session on the host has to be visible
    # in the record the operator keeps. Without this line a --yes run ends
    # byte-identical whether or not the flag was given.
    if [ "$ENABLE_SERVICE_KEYS" = "true" ]; then
        echo "  ✓ Service-account SSH layer: AuthorizedKeysCommand + ExposeAuthInfo"
        if grep -qE '^[[:space:]]*(ssh_)?fingerprint_required[[:space:]]*=[[:space:]]*(1|true|yes|on)' \
           "$OB_CONFIG" 2>/dev/null; then
            echo "    - fingerprint_required: set (key_fingerprint is enforced)"
        else
            echo "    - fingerprint_required: NOT set (key_fingerprint is advisory)"
        fi
    else
        echo "  ✗ Service-account SSH layer: not configured (opt-in: --enable-service-keys)"
    fi
    echo ""
    echo "Backup location: $BACKUP_DIR"
    echo ""
    if [ "$ENROLL_RESULT" = "failed" ]; then
        echo "ACTION REQUIRED — the $(role_noun) is NOT operational:"
        echo "  1. KEEP your current shell open (you may be locked out otherwise)."
        echo "  2. Fix portal connectivity and run:"
        echo "       ob-enroll -p $PORTAL_URL -g $SERVER_GROUP"
        echo "  3. Or roll back manually using files in $BACKUP_DIR."
        echo ""
    else
        echo "Next steps:"
        if is_backend; then
            echo "  1. Verify SSH connectivity from a bastion (ob-ssh on the bastion)"
            echo "  2. Check user creation works correctly"
            if [ "$ENABLE_SUDO" = "true" ]; then
                echo "  3. Test sudo access for authorized users"
            fi
        else
            echo "  1. Verify SSH connectivity from another terminal"
            echo "  2. Test certificate authentication with ob-ssh-cert"
            if [ "$DISABLE_SESSION_RECORDER" != "true" ]; then
                echo "  3. Check session recordings in /var/lib/open-bastion/sessions/"
            fi
        fi
        echo ""
    fi
    print_portal_prerequisites
}

# Usage
usage() {
    # The examples below must run as shown, so they carry --node-role when the
    # role in effect is not the one the command name implies.
    local role_opt=""
    if [ "$NODE_ROLE" != "$PROG_ROLE" ]; then
        role_opt=" --node-role $NODE_ROLE"
    fi
    cat << EOF
Usage: $PROG_NAME --portal URL [OPTIONS]

Configure this server as an SSH $(role_noun) with LemonLDAP::NG.

One command, three node roles. The name it is invoked under chooses the
default role, --node-role overrides it:
  ob-bastion-setup     bastion     SSH entry point; records every session
  ob-standalone-setup  standalone  the bastion stack, with no hop behind it
  ob-backend-setup     backend     reached through a bastion; creates Unix
                                   accounts and authorizes sudo via LLNG
This help describes the $NODE_ROLE role. Options of another role are refused.

Required:
  -p, --portal URL        LLNG portal URL

Options:
  -g, --server-group NAME Server group name (must match a group defined in
                          LLNG). Prompted interactively if omitted; required
                          when --yes is used.
      --node-role ROLE    Role to configure, recorded in the config and
                          reported to the SSO: bastion|standalone|backend
                          (default for $PROG_NAME: $PROG_ROLE).
  -t, --token-file FILE   Read server token from file (use - for stdin)
  -c, --client-id ID      OIDC client_id for enrollment. Prompted interactively
                          if omitted (suggested: pam-access); required when
                          --yes is used.
  -S, --client-secret-file FILE
                          Read OIDC client_secret from file (use - for stdin).
                          Alternative: set OB_CLIENT_SECRET env var.
                          Required when the LLNG client is a confidential client.
  -y, --yes               Non-interactive mode. Requires --token-file unless a
                          server token already exists at the canonical path
                          ($OB_TOKEN), in which case it is reused.
  -k, --insecure          Skip SSL certificate verification
  --max-security          Enable Mode E (SSO certificates only, sudo via LLNG token, KRL)
  --krl-refresh-interval MINUTES
                          Mode E: refresh the KRL every MINUTES (1-60) instead
                          of every 30, via a drop-in for ob-krl-refresh.timer.
                          Without it a new run keeps the schedule the host has.
  --enable-service-keys   Configure the SSH layer for service accounts: writes
                          the AuthorizedKeysCommand drop-in that serves
                          /etc/open-bastion/service-accounts.d/<name>.pub, plus
                          ExposeAuthInfo yes so the fingerprint is verifiable.
                          Without it, service-accounts.conf alone does not let a
                          service account log in (#263). OFF by default — it
                          changes sshd for every session on the host.
  --enable-sudo-fresh-otp Require a fresh LLNG token on EVERY sudo for SSO users
                          (writes \`Defaults:%open-bastion-sudo timestamp_timeout=0\`).
                          Without it, sudo's own 15-minute credential cache lets a
                          user keep elevating without being asked again. Local
                          break-glass admins are unaffected. OFF by default.
  --enable-hardening      Apply system-wide containment hardening (logind KillUserProcesses,
                          mask atd, at/cron allow-lists, nproc limit). OFF by default —
                          modifies system-wide behaviour, opt in only on dedicated hosts.
  --enable-audit-trace    Enable primary audit trace via auditd (OFF by default).
                          Installs audit rules (rules.d/open-bastion.rules)
                          and a daily rotation timer, then restarts auditd.
                          /etc/audit/auditd.conf is NOT modified; tune
                          retention manually (see doc/audit.rst).
                          Requires auditd package (apt install auditd /
                          dnf install audit).
  -n, --dry-run           Show what would be done without making changes
  -h, --help              Show this help (for the role in effect)
  -V, --version           Show version

EOF
    if is_backend; then
        cat << EOF
Backend options:
      --allowed-bastions IDS
                          Comma/space-separated bastion_id allowlist: only these
                          bastions may hop to this backend. Get an id by running
                          'ob-bastion-id' on the bastion. Prompted interactively
                          if omitted. An EMPTY list accepts a hop from any host
                          enrolled in the project that can declare itself a
                          bastion to the SSO -- see doc/security-reference.rst.
      --allow-any-bastion Answer the prompt above with "any bastion", without
                          being asked. Same (weaker) result as an empty list;
                          the point is that it is written down. Non-interactive
                          runs (--yes) already default to it, so that an upgrade
                          does not start refusing hops that worked yesterday.
  --no-sudo               Don't configure sudo with LLNG (refused together
                          with --max-security, which configures it regardless)
  --no-create-user        Don't enable automatic user creation

Example:
  $PROG_NAME${role_opt} --portal https://auth.example.com \\
      --server-group production --allowed-bastions bastion-01

What this script does:
  1. Downloads SSH CA public key from LLNG
  2. Installs the principals helper and the allowed-bastions list
  3. Enrolls the server with LLNG (Device Authorization)
  4. Configures sshd to accept bastion-vouched certificates only
  5. Configures PAM for LLNG authorization and user creation
  6. Configures sudo for LLNG authorization (unless --no-sudo)
  7. Configures NSS for user/group resolution
  8. Restarts SSH service
  Session containment hardening is applied ONLY if --enable-hardening is
  passed; it is OFF by default.

EOF
    else
        cat << EOF
Bastion and standalone options:
  --disable-session-recorder  Do NOT configure the session recorder and do not
                          force it via sshd ForceCommand. Session recording
                          is ON by default; this opts out (weakens the audit
                          guarantee — use only when recording is handled
                          elsewhere).

Example:
  $PROG_NAME${role_opt} --portal https://auth.example.com --server-group bastion

What this script does:
  1. Downloads SSH CA public key from LLNG
  2. Configures sshd for certificate authentication
  3. Enables session recording via ForceCommand (unless --disable-session-recorder)
  4. Configures PAM for LLNG authorization, and NSS
  5. Enrolls the server with LLNG (Device Authorization)
  6. Restarts SSH service
  7. Applies session containment hardening (logind KillUserProcesses,
     nproc cap, at/cron allowlists, mask atd) ONLY if --enable-hardening
     is passed. Hardening is OFF by default.

EOF
    fi
    exit 0
}

# Parse arguments
parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -p|--portal)
                if [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                    error "Option $1 requires an argument"
                    exit 1
                fi
                PORTAL_URL="$2"
                shift 2
                ;;
            -g|--server-group)
                if [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                    error "Option $1 requires an argument"
                    exit 1
                fi
                SERVER_GROUP="$2"
                shift 2
                ;;
            --node-role)
                if [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                    error "Option $1 requires an argument"
                    exit 1
                fi
                case "$2" in
                    bastion | standalone | backend) NODE_ROLE="$2"; NODE_ROLE_GIVEN=true ;;
                    *)
                        error "Invalid --node-role '$2' (bastion|standalone|backend)"
                        exit 1
                        ;;
                esac
                shift 2
                ;;
            --allowed-bastions)
                # Comma/space-separated bastion_id allowlist. An explicit empty
                # value ("") is allowed and means "any vouched bastion".
                if [ -z "${2+x}" ]; then
                    error "Option $1 requires an argument"
                    exit 1
                fi
                BASTION_ALLOWED_IDS="$2"
                BACKEND_ONLY_OPTS+=("$1")
                shift 2
                ;;
            --allow-any-bastion)
                # Say up front that the empty list is the intended answer, so an
                # interactive run does not stop to ask. Does not change what an
                # empty list MEANS -- only who is on record for choosing it.
                ALLOW_ANY_BASTION=true
                BACKEND_ONLY_OPTS+=("$1")
                shift
                ;;
            -t|--token-file)
                if [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                    error "Option $1 requires an argument"
                    exit 1
                fi
                if [ "$2" = "-" ]; then
                    SERVER_TOKEN=$(cat)
                elif [ -f "$2" ]; then
                    SERVER_TOKEN=$(cat "$2")
                else
                    error "Token file not found: $2"
                    exit 1
                fi
                shift 2
                ;;
            -c|--client-id)
                if [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                    error "Option $1 requires an argument"
                    exit 1
                fi
                CLIENT_ID="$2"
                shift 2
                ;;
            -S|--client-secret-file)
                if [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
                    error "Option $1 requires an argument"
                    exit 1
                fi
                if [ "$2" = "-" ]; then
                    CLIENT_SECRET=$(cat)
                elif [ -f "$2" ]; then
                    CLIENT_SECRET=$(cat "$2")
                else
                    error "Client secret file not found: $2"
                    exit 1
                fi
                shift 2
                ;;
            -y|--yes)
                NON_INTERACTIVE=true
                shift
                ;;
            -k|--insecure)
                VERIFY_SSL=false
                shift
                ;;
            --max-security)
                MAX_SECURITY=true
                shift
                ;;
            --krl-refresh-interval)
                # Minutes, as cron's */N meant them: the timer runs at
                # *:0/N, which only means "every N minutes" for 1..60.
                if ! [[ "${2:-}" =~ ^[1-9][0-9]?$ ]] || [ "$2" -gt 60 ]; then
                    error "Option $1 requires a number of minutes between 1 and 60"
                    exit 1
                fi
                KRL_REFRESH_INTERVAL="$2"
                KRL_INTERVAL_GIVEN=true
                shift 2
                ;;
            --no-sudo)
                ENABLE_SUDO=false
                BACKEND_ONLY_OPTS+=("$1")
                shift
                ;;
            --no-create-user)
                CREATE_USERS=false
                BACKEND_ONLY_OPTS+=("$1")
                shift
                ;;
            --enable-sudo-fresh-otp)
                SUDO_FRESH_OTP=true
                shift
                ;;
            --enable-service-keys)
                ENABLE_SERVICE_KEYS=true
                shift
                ;;
            --enable-hardening)
                ENABLE_HARDENING=true
                shift
                ;;
            --enable-audit-trace)
                ENABLE_AUDIT_TRACE=true
                shift
                ;;
            --disable-session-recorder)
                DISABLE_SESSION_RECORDER=true
                BASTION_ONLY_OPTS+=("$1")
                shift
                ;;
            -n|--dry-run)
                DRY_RUN=true
                shift
                ;;
            -h|--help)
                # Deferred: the help describes the effective role, and a
                # --node-role later on the line changes it.
                SHOW_HELP=true
                shift
                ;;
            -V|--version)
                echo "$PROG_NAME version $VERSION"
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done

    if [ "$SHOW_HELP" = "true" ]; then
        usage
    fi
    check_role_options
}

# Refuse options that do not apply to the effective role. Silently ignoring
# them would be worse than an error: --no-sudo on a bastion, or
# --disable-session-recorder on a backend, reads like a decision the run then
# does not carry out -- and before the two setup scripts were merged each one
# rejected the other's options as unknown.
check_role_options() {
    local opt bad=false
    if is_backend; then
        for opt in ${BASTION_ONLY_OPTS[@]+"${BASTION_ONLY_OPTS[@]}"}; do
            error "Option $opt applies to a bastion or standalone host, not to a backend:"
            error "  a backend records no session, the bastion in front of it does."
            bad=true
        done
    else
        for opt in ${BACKEND_ONLY_OPTS[@]+"${BACKEND_ONLY_OPTS[@]}"}; do
            error "Option $opt applies to a backend only; this run configures a $(role_noun)."
            bad=true
        done
        if [ "$bad" = "true" ]; then
            error "Run ob-backend-setup (or pass --node-role backend) to configure a backend."
        fi
    fi
    if [ "$bad" = "true" ]; then
        exit 1
    fi

    # The interval is the schedule of Mode E's KRL refresh; without Mode E there
    # is no refresh, and an accepted option that does nothing reads as done.
    if [ "$KRL_INTERVAL_GIVEN" = "true" ] && [ "$MAX_SECURITY" != "true" ]; then
        error "--krl-refresh-interval applies to --max-security (Mode E) only."
        exit 1
    fi

    # --no-sudo cannot be honoured under Mode E: configure_max_security_sudo
    # replaces /etc/pam.d/sudo with the LLNG-token-only stack whatever this
    # flag says. Accepting both used to install that stack with no sudoers
    # rule for the SSO group, so no SSO user could elevate while the summary
    # reported Mode E sudo as active. Refuse the contradiction instead.
    if is_backend && [ "$ENABLE_SUDO" != "true" ] && [ "$MAX_SECURITY" = "true" ]; then
        error "--no-sudo cannot be combined with --max-security: Mode E replaces the"
        error "sudo PAM stack with LLNG-token-only authentication (see doc/pam-modes.rst)."
        exit 1
    fi
}

# Main
main() {
    parse_args "$@"

    # A copy of the script under another name falls back to the bastion role,
    # as ob-bastion-setup always did. Interactively the banner shows the role
    # and asks before anything happens. Under --yes nobody reads the banner,
    # and a renamed copy of ob-backend-setup would configure a bastion -- a
    # principals helper that accepts direct SSO certificates -- without a word.
    # So a non-interactive run under an unknown name must say which role.
    case "$PROG_NAME" in
        ob-bastion-setup | ob-backend-setup | ob-standalone-setup) ;;
        *)
            if [ "$NODE_ROLE_GIVEN" != "true" ]; then
                if [ "$NON_INTERACTIVE" = "true" ]; then
                    error "Invoked as '$PROG_NAME', a name that does not choose a node role,"
                    error "and --yes leaves nobody to check the role in the banner."
                    error "Pass --node-role bastion|standalone|backend."
                    exit 1
                fi
                warn "Invoked as '$PROG_NAME', a name that does not choose a node role:"
                warn "configuring a $(role_noun). Pass --node-role to choose another."
            fi
            ;;
    esac

    # Validate required parameters
    if [ -z "$PORTAL_URL" ]; then
        error "Portal URL is required (-p/--portal)"
        exit 1
    fi

    # Remove trailing slash
    PORTAL_URL="${PORTAL_URL%/}"

    # Validate the URL shape before it is used anywhere.
    #
    # PORTAL_URL is interpolated into generated artefacts -- openbastion.conf,
    # ssh-proxy.conf -- that root programs read back, ob-krl-refresh among them
    # (it applies the same check before writing into /etc/ssh). No privilege
    # boundary is crossed here — this script already requires root and the
    # value is the admin's own --portal argument — but a URL containing shell
    # metacharacters would silently produce a broken or surprising
    # configuration. The character class is the same one ob-builder enforces
    # with is_valid_url(), so a portal accepted by the builder is accepted here.
    if ! [[ "$PORTAL_URL" =~ ^https?://[A-Za-z0-9._:/?#@!()*+,\;=~%-]+$ ]]; then
        error "Invalid portal URL: $PORTAL_URL"
        error "Expected http(s)://host[:port][/path] without shell metacharacters"
        exit 1
    fi

    # Pick up client_secret from env if not provided via --client-secret-file.
    # Storing it in OB_CLIENT_SECRET keeps it out of /proc/<pid>/cmdline.
    if [ -z "$CLIENT_SECRET" ] && [ -n "${OB_CLIENT_SECRET:-}" ]; then
        CLIENT_SECRET="$OB_CLIENT_SECRET"
    fi

    # Security: warn if not using HTTPS (credentials sent in clear)
    if [[ "$PORTAL_URL" != https://* ]] && [[ "$VERIFY_SSL" != "false" ]]; then
        warn "PORTAL_URL does not use HTTPS - credentials will be sent in clear text"
    fi

    # Check root
    check_root

    # Check dependencies
    for cmd in curl sshd sed; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            error "Required command not found: $cmd"
            exit 1
        fi
    done

    preflight_sshd_config || exit 1

    # Ask for server_group and client_id BEFORE printing the banner so the
    # final summary the user confirms reflects the values that will be used.
    prompt_required_settings

    echo ""
    print_box "LemonLDAP::NG $(role_title) Setup"
    echo ""
    echo "This script will configure this server as an SSH $(role_noun)."
    echo ""
    echo "Node role:     $NODE_ROLE"
    echo "Portal URL:    $PORTAL_URL"
    echo "Server Group:  $SERVER_GROUP"
    echo "Client ID:     $CLIENT_ID"
    if is_backend; then
        echo "Create Users:  $CREATE_USERS"
        echo "Allowed bastions: ${BASTION_ALLOWED_IDS:-<any vouched bastion>}"
        echo "Sudo via LLNG: $ENABLE_SUDO"
    fi
    if [ "$MAX_SECURITY" = "true" ]; then
        echo "Max Security: true (Mode E)"
    fi
    echo ""

    if [ "$DRY_RUN" = "true" ]; then
        warn "DRY-RUN MODE - No changes will be made"
        echo ""
    fi

    if ! confirm "Continue with $(role_noun) setup?"; then
        info "Aborted"
        exit 0
    fi

    echo ""

    # ── Phase 1: inert preparation (no SSH/PAM lockdown yet) ──
    # These steps download/create files that are NOT referenced by sshd or PAM
    # until phase 3 runs. If anything fails here, or if enrollment fails in
    # phase 2, the system is still usable: rollback_on_failure() restores
    # backups / removes new files and exits.
    download_ca_key || { rollback_on_failure; exit 1; }
    # On a role switch this only records that the helper is to be replaced
    # at the end; see prepare_principals_helper.
    prepare_principals_helper || { rollback_on_failure; exit 1; }
    configure_pam_openbastion || { rollback_on_failure; exit 1; }
    if is_backend; then
        : # a backend records nothing: the bastion in front of it does
    elif [ "$DISABLE_SESSION_RECORDER" = "true" ]; then
        info "Session recorder disabled (--disable-session-recorder)"
    else
        configure_session_recorder || { rollback_on_failure; exit 1; }
    fi

    # ── Phase 2: portal connectivity + enrollment ──
    # Must succeed before we lock down SSH/PAM, otherwise the host would
    # be unreachable (PasswordAuthentication=no + no certs because no token).
    if ! preflight_check_portal; then
        rollback_on_failure
        exit 1
    fi

    # Retry loop: on enrollment failure (typically invalid_client), offer
    # the user a chance to provide/update client_id and client_secret and
    # retry — without restarting the whole setup.
    local max_attempts=3
    local attempt=1
    while ! enroll_server; do
        error ""
        error "Server enrollment FAILED (attempt $attempt/$max_attempts)."

        if [ $attempt -ge $max_attempts ]; then
            error "Maximum enrollment attempts reached."
            break
        fi

        if ! prompt_for_client_credentials; then
            # User declined / non-interactive — fall through to fatal handling.
            break
        fi

        attempt=$((attempt + 1))
        info "Retrying enrollment..."
    done

    if [ "$ENROLL_RESULT" != "success" ] && [ "$ENROLL_RESULT" != "token-provided" ] && [ "$ENROLL_RESULT" != "reused" ] && [ "$ENROLL_RESULT" != "dry-run" ]; then
        if [ "$MAX_SECURITY" = "true" ]; then
            error "Refusing to apply --max-security lockdown: without enrollment, no user"
            error "can authenticate (SSO certs cannot be issued, sudo would require"
            error "a token nobody can obtain). Aborting BEFORE any SSH/PAM changes."
            rollback_on_failure
            exit 1
        fi
        warn "PAM authorization will fail until you run:"
        warn "  ob-enroll -p $PORTAL_URL -g $SERVER_GROUP${CLIENT_ID:+ -c $CLIENT_ID}"
        warn "manually after this setup completes."
        echo ""
        if ! confirm "Continue applying SSH/PAM lockdown anyway? (DANGEROUS)"; then
            info "Aborted by user."
            rollback_on_failure
            exit 1
        fi
    else
        # Persist any client_id/client_secret entered during retry prompts so
        # future re-enrollments via ob-enroll alone keep working.
        refresh_openbastion_conf
    fi

    # Keep the freshly enrolled token alive. Without this the timer only arms on
    # the next reboot (ConditionPathExists was false at package-install time),
    # and the token expires overnight -> offline fallback + sudo lockout.
    enable_heartbeat_timer

    # ── Phase 3: SSH / PAM lockdown ──
    # From this point on, a failure may require restoring files from
    # $BACKUP_DIR by hand.
    configure_sshd || exit 1
    configure_service_account_keys || exit 1
    configure_pam_sshd || exit 1
    if is_backend; then
        configure_pam_sudo || true
        retire_bastion_services
    else
        configure_ssh_proxy || exit 1
        warn_backend_sudo_left
    fi
    configure_max_security_sshd || exit 1
    configure_max_security_sudo || exit 1
    # NSS belongs here, not in phase 1: nsswitch.conf is live for every
    # process on the host as soon as it is written, so it is not one of the
    # inert files rollback_on_failure can take back.
    configure_nss || exit 1
    if [ "$ENABLE_HARDENING" = "true" ]; then
        setup_hardening || warn "Hardening step reported errors"
    else
        info "Session containment hardening not applied (opt-in: pass --enable-hardening to activate)"
    fi
    download_krl || warn "KRL download or refresh timer failed (see above)"

    # Optional primary audit trace (default OFF — modifies global system).
    if [ "$ENABLE_AUDIT_TRACE" = "true" ]; then
        setup_audit_trace || warn "Audit trace setup failed (see errors above)"
    else
        info "Audit trace not applied (opt-in: pass --enable-audit-trace)"
    fi

    if [ "$HELPER_DEFERRED" = "true" ]; then
        finish_principals_helper || {
            error "The sshd configuration of the new role is written but its principals"
            error "helper is not. sshd was not restarted and still runs the old role; its"
            error "next restart would pair the new configuration with the old helper,"
            error "which denies every certificate login. Re-run this setup first."
            exit 1
        }
    fi

    if [ "$DRY_RUN" = "false" ]; then
        restart_sshd || warn "Failed to restart SSH"
    fi

    print_summary
}

main "$@"
