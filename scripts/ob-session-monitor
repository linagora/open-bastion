#!/bin/bash
# ob-session-monitor - Network revalidation service for Open Bastion
#
# Monitors network state and revalidates offline sessions when
# connectivity to the LLNG portal returns.
#
# Copyright (C) 2025 Linagora
# License: AGPL-3.0

set -euo pipefail

CONFIG_FILE="${OB_CONFIG_FILE:-/etc/open-bastion/openbastion.conf}"

_OB_SIGN_LIB="${OB_SIGN_LIB:-/usr/lib/open-bastion/ob-sign-lib.sh}"
if [ ! -r "$_OB_SIGN_LIB" ]; then
    _OB_SIGN_LIB="$(dirname "$(readlink -f "$0")")/ob-sign-lib.sh"
fi
if [ -r "$_OB_SIGN_LIB" ]; then
    # shellcheck source=scripts/ob-sign-lib.sh
    . "$_OB_SIGN_LIB"
else
    # Without the library nothing can check the portal's signed answers
    # (#339). Under response_signing = off nothing was going to be checked:
    # call the portal unsigned, as before #339, so that a broken install does
    # not let the bastion's token expire. Anything else -- prefer, required,
    # an unknown value, an unreadable configuration -- refuses to call it
    # rather than take its answer on trust.
    #
    # response_signing from openbastion.conf, read like ob_conf_get in the
    # library: the last occurrence wins, one layer of quotes is removed, an
    # unquoted value ends at a '#' that starts it or follows a blank. Prints
    # "off" when the key is absent or empty, "unreadable" when the file is.
    _ob_nolib_response_signing() {
        [ -r "$1" ] || { echo unreadable; return 0; }
        awk '
            function trim(s) { sub(/^[ \t\r\n\v\f]+/, "", s); sub(/[ \t\r\n\v\f]+$/, "", s); return s }
            {
                line = trim($0)
                c = substr(line, 1, 1)
                if (line == "" || c == "#" || c == ";" || c == "[") next
                eq = index(line, "=")
                if (!eq || trim(substr(line, 1, eq - 1)) != "response_signing") next
                v = trim(substr(line, eq + 1))
                q = substr(v, 1, 1)
                if (q == "\"" || q == "\047") {
                    v = substr(v, 2)
                    for (i = length(v); i > 0; i--) {
                        if (substr(v, i, 1) == q) { v = substr(v, 1, i - 1); break }
                    }
                } else {
                    for (i = 1; i <= length(v); i++) {
                        if (substr(v, i, 1) == "#" && (i == 1 || substr(v, i - 1, 1) ~ /[ \t]/)) {
                            v = trim(substr(v, 1, i - 1)); break
                        }
                    }
                }
                mode = v
            }
            END { print (mode == "" ? "off" : mode) }
        ' "$1" 2>/dev/null || echo unreadable
    }
    # Same contract as the library's ob_pam_post, minus the checks. Each
    # caller reads only part of the OB_PAM_* variables.
    # shellcheck disable=SC2034
    ob_pam_post() {
        local base="$1" path="$2" payload="$3" mode raw rc=0
        shift 3
        OB_PAM_STATUS="" OB_PAM_BODY="" OB_PAM_SIGNED="" OB_PAM_ANONYMOUS=false
        OB_PAM_ERROR="" OB_PAM_WARNING="" OB_PAM_CURL_RC=0 OB_SIGN_NOTE=""
        mode=$(_ob_nolib_response_signing "${OB_SIGN_CONFIG:-/etc/open-bastion/openbastion.conf}")
        if [ "$mode" != "off" ]; then
            OB_PAM_ERROR="ob-sign-lib.sh not found and response_signing is not off ($mode): $path not sent"
            return 1
        fi
        OB_SIGN_NOTE="ob-sign-lib.sh not found; sending $path unsigned"
        # The body on stdin, not argv: ob-heartbeat's carries the refresh_token.
        raw=$(printf '%s' "$payload" | curl --tlsv1.3 "$@" -X POST \
            -H "Content-Type: application/json" --data-binary @- \
            -w '\n__OB_HTTP__:%{http_code}' "${base}${path}" 2>&1) || rc=$?
        if [ "$rc" -ne 0 ]; then
            OB_PAM_CURL_RC=$rc
            OB_PAM_ERROR="request to $path failed (curl exit $rc)"
            return 1
        fi
        case "$raw" in
            *$'\n'__OB_HTTP__:*) ;;
            *) OB_PAM_ERROR="no HTTP status for $path"; return 1 ;;
        esac
        OB_PAM_STATUS="${raw##*$'\n'__OB_HTTP__:}"
        OB_PAM_BODY="${raw%$'\n'__OB_HTTP__:*}"
        OB_PAM_SIGNED=unsigned
        return 0
    }
fi
MARKER_DIR="/run/open-bastion/offline_sessions"
FORCE_ONLINE_FILE="/etc/open-bastion/force_online"
FORCE_ONLINE_LOCK="/run/open-bastion/force_online.lock"
POLL_INTERVAL=60
REVALIDATION_GRACE=14400    # 4 hours
MAX_SSO_UNREACHABLE=3600    # 1 hour

sso_unreachable_since=0
# Separate from sso_unreachable_since: check_portal() resets that one whenever
# the front end answers, so a broken /pam/userinfo would never hit the bound.
userinfo_unusable_since=0
userinfo_unusable=false

for cmd in curl jq loginctl; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: required command '$cmd' not found" >&2
        exit 1
    fi
done

log_info() {
    logger -t ob-session-monitor -p auth.info "$@"
}

log_warn() {
    logger -t ob-session-monitor -p auth.warning "$@"
}

log_crit() {
    logger -t ob-session-monitor -p auth.crit "$@"
}

log_debug() {
    logger -t ob-session-monitor -p auth.debug "$@"
}

read_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        log_warn "Configuration file not found: $CONFIG_FILE"
        return
    fi

    local portal_url_val
    portal_url_val=$(grep -E '^\s*portal_url\s*=' "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/.*=\s*//' | tr -d '"'"'" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [ -n "$portal_url_val" ]; then
        PORTAL_URL="$portal_url_val"
    fi

    local server_token_file_val
    server_token_file_val=$(grep -E '^\s*server_token_file\s*=' "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/.*=\s*//' | tr -d '"'"'" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [ -n "$server_token_file_val" ] && [ -f "$server_token_file_val" ]; then
        SERVER_TOKEN=$(cat "$server_token_file_val" 2>/dev/null)
    fi

    local reval_enabled
    reval_enabled=$(grep -E '^\s*offline_revalidation_enabled\s*=' "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/.*=\s*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [ "$reval_enabled" = "false" ] || [ "$reval_enabled" = "0" ] || [ "$reval_enabled" = "no" ]; then
        log_info "Offline revalidation disabled in configuration"
        exit 0
    fi

    local grace_val
    grace_val=$(grep -E '^\s*offline_revalidation_grace\s*=' "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/.*=\s*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [ -n "$grace_val" ] && [ "$grace_val" -gt 0 ] 2>/dev/null; then
        REVALIDATION_GRACE=$grace_val
    fi

    local max_unreachable_val
    max_unreachable_val=$(grep -E '^\s*offline_max_sso_unreachable\s*=' "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/.*=\s*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [ -n "$max_unreachable_val" ] && [ "$max_unreachable_val" -gt 0 ] 2>/dev/null; then
        MAX_SSO_UNREACHABLE=$max_unreachable_val
    fi

    local force_online_val
    force_online_val=$(grep -E '^\s*auth_cache_force_online\s*=' "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/.*=\s*//' | tr -d '"'"'" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [ -n "$force_online_val" ]; then
        FORCE_ONLINE_FILE="$force_online_val"
    fi
}

check_portal() {
    local url="${PORTAL_URL}/desktop/login?check=1"
    if curl -sf --tlsv1.3 -o /dev/null -m 5 "$url" 2>/dev/null; then
        return 0
    fi
    return 1
}

check_network() {
    local hostname
    hostname=$(echo "$PORTAL_URL" | sed -E 's|https?://([^/:]+).*|\1|')
    if [ -z "$hostname" ]; then
        return 1
    fi
    if command -v host >/dev/null 2>&1 && host "$hostname" >/dev/null 2>&1; then
        return 0
    fi
    if ping -c1 -W2 8.8.8.8 >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

# Returns 0 valid, 1 revoked (the portal said so), 2 unknown (could not ask or
# parse the reply); only 1 may terminate sessions. No curl -f: HTTP errors must
# stay distinguishable from transport failures.
check_user_valid() {
    local user="$1"
    local -a curl_args=(-s --tlsv1.3 -m 10)
    if [ -n "${SERVER_TOKEN:-}" ]; then
        curl_args+=(-H "Authorization: Bearer $SERVER_TOKEN")
    fi

    local payload
    payload=$(jq -n --arg u "$user" '{user: $u}')

    # Unsigned, this would report every user gone once the portal sets
    # pamAccessRequestSigningMode=required -- and this loop prunes sessions.
    # ob_pam_post signs the request and, under response_signing, verifies the
    # answer (#339): a forged `found: false` must not terminate anyone, so an
    # answer that does not verify is no verdict at all.
    # Read by ob-sign-lib.sh, which shellcheck cannot follow across the `.`.
    # shellcheck disable=SC2034
    OB_SIGN_CONFIG="$CONFIG_FILE"
    if ! ob_pam_post "$PORTAL_URL" /pam/userinfo "$payload" "${curl_args[@]}"; then
        if [ "${OB_PAM_CURL_RC:-0}" -ne 0 ]; then
            log_warn "cannot reach ${PORTAL_URL}/pam/userinfo (curl exit $OB_PAM_CURL_RC) -- $user left alone"
        else
            log_warn "${OB_PAM_ERROR:-no usable answer from /pam/userinfo} -- cannot ask about $user"
        fi
        return 2
    fi
    if [ -n "${OB_PAM_WARNING:-}" ]; then
        log_warn "$OB_PAM_WARNING"
    fi

    local http_code="$OB_PAM_STATUS" body="$OB_PAM_BODY"

    case "$http_code" in
        200) ;;
        401|403)
            # Our credentials, not the user's status. An expired server token
            # must not read as every user revoked.
            log_crit "portal refused our own credentials on /pam/userinfo (HTTP $http_code): check the server token and the heartbeat timer -- $user left alone"
            return 2 ;;
        *)
            log_warn "/pam/userinfo answered HTTP $http_code -- $user left alone"
            return 2 ;;
    esac

    # Not `.found // empty`: `//` treats false as empty, which would turn every
    # revocation into "unknown".
    local found
    # `|| true`: a jq failure must reach the "unknown" branch even for a caller
    # that does not suspend errexit.
    found=$(echo "$body" | jq -r 'if has("found") then (.found|tostring) else "missing" end' 2>/dev/null) || true
    case "$found" in
        true)  return 0 ;;
        false) return 1 ;;
        *)
            # A 200 we cannot parse is not a verdict either.
            log_warn "/pam/userinfo returned an answer without a usable 'found' field -- $user left alone"
            return 2 ;;
    esac
}

get_cache_age() {
    local user="$1"
    local marker_file="$MARKER_DIR/$user"
    if [ -f "$marker_file" ]; then
        local marker_time
        marker_time=$(cat "$marker_file" 2>/dev/null | head -1)
        if [ -n "$marker_time" ]; then
            local now
            now=$(date +%s)
            echo $(( now - marker_time ))
            return
        fi
    fi
    echo 0
}

revalidate_sessions() {
    userinfo_unusable=false
    if [ ! -d "$MARKER_DIR" ]; then
        return
    fi

    local found=false
    for marker_path in "$MARKER_DIR"/*; do
        [ -e "$marker_path" ] || continue
        found=true
        break
    done
    if [ "$found" = "false" ]; then
        return
    fi

    for marker_path in "$MARKER_DIR"/*; do
        [ -e "$marker_path" ] || continue
        local user_file
        user_file=$(basename "$marker_path")

        case "$user_file" in
            *.* ) continue ;;
        esac

        local user="$user_file"
        log_debug "Checking offline session for user: $user"

        local has_session=false
        while IFS= read -r line; do
            local session_user
            session_user=$(loginctl show-session "$line" -p Name --value 2>/dev/null) || continue
            if [ "$session_user" = "$user" ]; then
                has_session=true
                break
            fi
        done < <(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}')

        if [ "$has_session" = "false" ]; then
            log_debug "No active session for $user, removing marker"
            rm -f "$MARKER_DIR/$user"
            continue
        fi

        local verdict=0
        check_user_valid "$user" || verdict=$?
        if [ "$verdict" -eq 2 ]; then
            # Leave the session alone, but only for a bounded time (see
            # handle_userinfo_unusable).
            userinfo_unusable=true
            continue
        fi
        if [ "$verdict" -eq 0 ]; then
            log_debug "User $user is valid on LLNG"

            local cache_age
            cache_age=$(get_cache_age "$user")
            if [ "$cache_age" -gt "$REVALIDATION_GRACE" ]; then
                log_info "User $user: offline cache age ($cache_age seconds) exceeds grace period ($REVALIDATION_GRACE seconds), forcing online re-auth"
                {
                    flock -x 200
                    if ! grep -qxF "$user" "$FORCE_ONLINE_FILE" 2>/dev/null; then
                        printf '%s\n' "$user" >> "$FORCE_ONLINE_FILE"
                    fi
                } 200>"$FORCE_ONLINE_LOCK"
            fi
        else
            log_crit "User $user no longer valid on LLNG, terminating session"

            while IFS= read -r line; do
                local session_id
                session_id=$(echo "$line" | awk '{print $1}')
                local session_user
                session_user=$(loginctl show-session "$session_id" -p Name --value 2>/dev/null) || continue
                if [ "$session_user" = "$user" ]; then
                    log_crit "Terminating session $session_id for revoked user $user"
                    loginctl terminate-session "$session_id" 2>/dev/null || true
                fi
            done < <(loginctl list-sessions --no-legend 2>/dev/null)

            rm -f "$MARKER_DIR/$user"
        fi
    done
}

# Same bound as handle_sso_unreachable: a broken revocation endpoint must not
# keep offline sessions alive forever.
handle_userinfo_unusable() {
    local now
    now=$(date +%s)

    if [ "$userinfo_unusable_since" -eq 0 ]; then
        userinfo_unusable_since=$now
        log_warn "/pam/userinfo is unusable although the portal answers; sessions left alone for now"
        return
    fi

    local duration=$(( now - userinfo_unusable_since ))
    if [ "$duration" -lt "$MAX_SSO_UNREACHABLE" ]; then
        log_warn "/pam/userinfo unusable for ${duration}s (max: ${MAX_SSO_UNREACHABLE}s)"
        return
    fi

    log_crit "/pam/userinfo unusable for ${duration}s, terminating all offline sessions"
    if [ ! -d "$MARKER_DIR" ]; then
        return
    fi
    local marker_path
    for marker_path in "$MARKER_DIR"/*; do
        [ -e "$marker_path" ] || continue
        local user_file
        user_file=$(basename "$marker_path")
        case "$user_file" in
            *.* ) continue ;;
        esac

        local user="$user_file"
        log_crit "Terminating offline session for $user (/pam/userinfo unusable for ${duration}s)"

        while IFS= read -r line; do
            local session_id
            session_id=$(echo "$line" | awk '{print $1}')
            local session_user
            session_user=$(loginctl show-session "$session_id" -p Name --value 2>/dev/null) || continue
            if [ "$session_user" = "$user" ]; then
                loginctl terminate-session "$session_id" 2>/dev/null || true
            fi
        done < <(loginctl list-sessions --no-legend 2>/dev/null)

        rm -f "$MARKER_DIR/$user"
    done
}

# Network up but SSO unreachable may be a firewall bypass: bound it.
handle_sso_unreachable() {
    local now
    now=$(date +%s)

    if [ "$sso_unreachable_since" -eq 0 ]; then
        sso_unreachable_since=$now
        log_warn "SSO portal unreachable despite network being available"
        return
    fi

    local unreachable_duration=$(( now - sso_unreachable_since ))
    if [ "$unreachable_duration" -ge "$MAX_SSO_UNREACHABLE" ]; then
        log_crit "SSO portal unreachable for ${unreachable_duration}s despite network, terminating all offline sessions"

        if [ -d "$MARKER_DIR" ]; then
            for marker_path in "$MARKER_DIR"/*; do
                [ -e "$marker_path" ] || continue
                local user_file
                user_file=$(basename "$marker_path")
                case "$user_file" in
                    *.* ) continue ;;
                esac

                local user="$user_file"
                log_crit "Terminating offline session for $user (SSO unreachable for ${unreachable_duration}s)"

                while IFS= read -r line; do
                    local session_id
                    session_id=$(echo "$line" | awk '{print $1}')
                    local session_user
                    session_user=$(loginctl show-session "$session_id" -p Name --value 2>/dev/null) || continue
                    if [ "$session_user" = "$user" ]; then
                        loginctl terminate-session "$session_id" 2>/dev/null || true
                    fi
                done < <(loginctl list-sessions --no-legend 2>/dev/null)

                rm -f "$MARKER_DIR/$user"
            done
        fi
    else
        log_warn "SSO portal unreachable for ${unreachable_duration}s (max: ${MAX_SSO_UNREACHABLE}s)"
    fi
}

main() {
    log_info "Starting ob-session-monitor"

    read_config

    if [ -z "${PORTAL_URL:-}" ]; then
        log_crit "portal_url not configured, exiting"
        exit 1
    fi

    case "$PORTAL_URL" in
        https://*|http://*)
            ;;
        *)
            log_crit "Invalid portal_url format (must start with http:// or https://): $PORTAL_URL"
            exit 1
            ;;
    esac

    log_info "Portal URL: $PORTAL_URL"
    log_info "Revalidation grace period: ${REVALIDATION_GRACE}s"
    log_info "Max SSO unreachable: ${MAX_SSO_UNREACHABLE}s"

    mkdir -p "$MARKER_DIR"
    chmod 700 "$MARKER_DIR"

    while true; do
        network_up=false
        sso_up=false

        if check_network; then
            network_up=true
        fi

        if check_portal; then
            sso_up=true
            if [ "$sso_unreachable_since" -gt 0 ]; then
                log_info "SSO portal is reachable again"
                sso_unreachable_since=0
            fi
        fi

        if [ "$network_up" = "true" ] && [ "$sso_up" = "true" ]; then
            revalidate_sessions
            if [ "$userinfo_unusable" = "true" ]; then
                handle_userinfo_unusable
            elif [ "$userinfo_unusable_since" -gt 0 ]; then
                log_info "/pam/userinfo is usable again"
                userinfo_unusable_since=0
            fi
        elif [ "$network_up" = "true" ] && [ "$sso_up" = "false" ]; then
            handle_sso_unreachable
        else
            log_debug "Network unavailable, skipping revalidation"
            sso_unreachable_since=0
        fi

        sleep "$POLL_INTERVAL"
    done
}

main "$@"
