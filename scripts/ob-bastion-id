#!/bin/bash
#
# ob-bastion-id - Print this bastion's identifier (as seen by backends)
#
# Asks the portal (POST /pam/whoami, or the legacy /pam/bastion-token probe on
# portals that lack it) for the bastion_id backends list in allowed_bastions.
#
# Usage:
#   ob-bastion-id                    # prints bastion_id on stdout
#   ob-bastion-id --verbose          # full portal response as JSON
#   ob-bastion-id --json             # bastion_id wrapped in JSON (machine-readable)
#
# Copyright (C) 2026 Linagora
# License: AGPL-3.0

set -euo pipefail

VERSION="0.3.0"
PROG_NAME=$(basename "$0")

CONFIG_FILE="/etc/open-bastion/openbastion.conf"
TOKEN_FILE="/var/lib/open-bastion/token"
PORTAL_URL=""
SERVER_GROUP=""
VERIFY_SSL=true
TIMEOUT=10
VERBOSE=false
JSON_OUT=false
QUIET=false

SERVER_TOKEN=""
CURL_OPTS=()
HTTP_STATUS=""
BODY=""

log_info()  { [ "$QUIET" = "true" ] || printf '[INFO] %s\n' "$*" >&2; }
log_error() { printf '[ERROR] %s\n' "$*" >&2; }
# die MESSAGE [EXIT_CODE]
die() { log_error "$1"; exit "${2:-1}"; }

usage() {
    cat <<EOF
$PROG_NAME $VERSION

Print this bastion's identifier (the 'bastion_id' LLNG assigned it at
enrolment). Run on a bastion that has been enrolled and configured.

The bastion_id is a synthetic per-device identity, NOT the OIDC client_id:
two bastions enrolled with the same client_id have different bastion_ids,
and re-enrolling a bastion gives it a new one.

Backends list these values, one per line (commas and semicolons also work),
in /etc/open-bastion/allowed_bastions -- managed by
'ob-backend-setup --allowed-bastions <ids>'. An empty file accepts any
vouched bastion; an absent file is legacy non-enforcing mode.

USAGE:
  $PROG_NAME [OPTIONS]

OPTIONS:
  -v, --verbose          Print the portal's whole response as pretty JSON
  -j, --json             Print {"bastion_id":"..."} for scripting
  -q, --quiet            Suppress informational logs (errors still go to stderr)
  -c, --config FILE      Path to openbastion.conf  (default: $CONFIG_FILE)
  -t, --token FILE       Path to server token file (default: $TOKEN_FILE)
  -h, --help             Show this help
  -V, --version          Print version

EXIT STATUS:
  0  bastion_id printed successfully
  1  configuration or token missing / unreadable
  2  the portal request failed or was refused
  3  the portal answered, but with no identity in it
EOF
    exit 0
}

read_config() {
    local key="$1" file="$2"
    [ -f "$file" ] || return 0
    grep -E "^\\s*${key}\\s*=" "$file" 2>/dev/null \
        | sed -E 's/^[^=]+=\s*//' \
        | sed -E 's/^["'\'']//' \
        | sed -E 's/["'\'']$//' \
        | sed -E 's/\s*#.*$//' \
        | tail -1 \
        || true
}

base64url_decode() {
    local s="$1"
    # Whitespace would skew the ${#s}-based padding computation.
    s="${s//[$' \t\r\n']/}"
    s=$(printf '%s' "$s" | tr '\-_' '+/')
    local pad=$(( (4 - ${#s} % 4) % 4 ))
    case "$pad" in
        1) s="${s}=" ;;
        2) s="${s}==" ;;
        3) s="${s}===" ;;
    esac
    printf '%s' "$s" | base64 -d 2>/dev/null
}

_OB_SIGN_LIB="${OB_SIGN_LIB:-/usr/lib/open-bastion/ob-sign-lib.sh}"
if [ ! -r "$_OB_SIGN_LIB" ]; then
    _OB_SIGN_LIB="$(dirname "$(readlink -f "$0")")/ob-sign-lib.sh"
fi
if [ -r "$_OB_SIGN_LIB" ]; then
    # shellcheck source=scripts/ob-sign-lib.sh
    . "$_OB_SIGN_LIB"
else
    SIGN_HEADERS=()
    # OB_SIGN_NOTE is read by the call sites below, not here.
    # shellcheck disable=SC2034
    ob_sign_request() { SIGN_HEADERS=(); OB_SIGN_ERROR=""; \
        OB_SIGN_NOTE="ob-sign-lib.sh not found; sending $2 unsigned"; return 0; }
fi

# Sets HTTP_STATUS and BODY. No curl -f: the fallback in main() must tell
# 404 (endpoint absent) from 403 (refused), and -f fails on both alike.
pam_post() {
    local path="$1" payload="$2" response
    # Read by ob-sign-lib.sh, which shellcheck cannot follow across the `.`.
    # shellcheck disable=SC2034
    OB_SIGN_CONFIG="$CONFIG_FILE"
    if ! ob_sign_request POST "$path" "$payload"; then
        log_error "$OB_SIGN_ERROR"
        return 1
    fi
    if [ -n "${OB_SIGN_NOTE:-}" ]; then
        log_info "$OB_SIGN_NOTE"
    fi
    response=$(curl "${CURL_OPTS[@]}" \
        -X POST \
        -H "Authorization: Bearer $SERVER_TOKEN" \
        -H "Content-Type: application/json" \
        "${SIGN_HEADERS[@]}" \
        -w '\n__HTTP_STATUS__:%{http_code}' \
        -d "$payload" \
        "${PORTAL_URL}${path}" 2>&1) || {
            log_error "Request to $path failed: $response"
            return 1
        }
    HTTP_STATUS="${response##*__HTTP_STATUS__:}"
    BODY="${response%$'\n'__HTTP_STATUS__:*}"
    return 0
}

# Print the identity and exit 0; return non-zero if the document has none.
emit_id() {
    local body="$1" filter="$2" id
    # Check the id before --verbose, or the portal's HTML page would be dumped.
    id=$(printf '%s' "$body" | jq -r "$filter" 2>/dev/null) || return 1
    [ -n "$id" ] || return 1
    if [ "$VERBOSE" = "true" ]; then
        printf '%s\n' "$body" | jq .
        exit 0
    fi
    if [ "$JSON_OUT" = "true" ]; then
        jq -nc --arg id "$id" '{bastion_id: $id}'
    else
        printf '%s\n' "$id"
    fi
    exit 0
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -v|--verbose)  VERBOSE=true; shift ;;
            -j|--json)     JSON_OUT=true; shift ;;
            -q|--quiet)    QUIET=true; shift ;;
            -c|--config)   CONFIG_FILE="${2:?--config requires a path}"; shift 2 ;;
            -t|--token)    TOKEN_FILE="${2:?--token requires a path}"; shift 2 ;;
            -h|--help)     usage ;;
            -V|--version)  echo "$PROG_NAME $VERSION"; exit 0 ;;
            *) die "Unknown option: $1 (use --help)" ;;
        esac
    done
}

main() {
    parse_args "$@"

    command -v curl >/dev/null || die "curl is required"
    command -v jq   >/dev/null || die "jq is required"

    [ -r "$CONFIG_FILE" ] || die "Config file not readable: $CONFIG_FILE (run as root?)"

    PORTAL_URL=$(read_config "portal_url" "$CONFIG_FILE")
    SERVER_GROUP=$(read_config "server_group" "$CONFIG_FILE")
    local verify_ssl_raw
    verify_ssl_raw=$(read_config "verify_ssl" "$CONFIG_FILE")
    case "$verify_ssl_raw" in false|no|0) VERIFY_SSL=false ;; esac

    if [ "$TOKEN_FILE" = "/var/lib/open-bastion/token" ]; then
        local conf_token_file
        conf_token_file=$(read_config "server_token_file" "$CONFIG_FILE")
        [ -n "$conf_token_file" ] && TOKEN_FILE="$conf_token_file"
    fi
    [ -r "$TOKEN_FILE" ]  || die "Token file not readable: $TOKEN_FILE (bastion not enrolled?)"

    [ -n "$PORTAL_URL" ]   || die "portal_url missing from $CONFIG_FILE"
    [ -n "$SERVER_GROUP" ] || die "server_group missing from $CONFIG_FILE"

    # Same formats as the PAM module: plain token, or JSON with .access_token.
    local server_token
    if server_token=$(jq -er '.access_token' "$TOKEN_FILE" 2>/dev/null) \
       && [ -n "$server_token" ] && [ "$server_token" != "null" ]; then
        :
    else
        server_token=$(tr -d '\r\n' < "$TOKEN_FILE")
    fi
    [ -n "$server_token" ] || die "Token file is empty or unparseable: $TOKEN_FILE"

    SERVER_TOKEN="$server_token"

    CURL_OPTS=( -sS --max-time "$TIMEOUT" -L )
    [ "$VERIFY_SSL" = "true" ] || CURL_OPTS+=( --insecure )

    log_info "Asking $PORTAL_URL/pam/whoami"
    pam_post /pam/whoami '{}' || exit 2

    if [ "$HTTP_STATUS" = "200" ]; then
        # A 200 without an id is LLNG's catch-all login page: the endpoint is
        # absent, so fall through to the legacy probe.
        emit_id "$BODY" '.bastion_id // .server_id // empty' || true
        log_info "/pam/whoami answered 200 with no identity in it —" \
                 "this portal does not implement it"
    elif [ "$HTTP_STATUS" != "404" ]; then
        # A real refusal: the fallback would fail too and name the wrong URL.
        log_error "LLNG returned HTTP $HTTP_STATUS on /pam/whoami: $BODY"
        exit 2
    fi

    # Legacy fallback for portals without /pam/whoami; delete once none remain.
    log_info "Portal has no /pam/whoami; falling back to the legacy" \
             "/pam/bastion-token probe (group=$SERVER_GROUP)"

    # user/target_host are placeholders: probe mode skips the per-user checks.
    local payload
    payload=$(jq -n \
        --arg user "ob-bastion-id-probe" \
        --arg target_host "127.0.0.1" \
        --arg target_group "$SERVER_GROUP" \
        --arg bastion_group "$SERVER_GROUP" \
        '{user: $user, target_host: $target_host, target_group: $target_group, bastion_group: $bastion_group, probe: true}')

    pam_post /pam/bastion-token "$payload" || exit 2
    if [ "$HTTP_STATUS" != "200" ]; then
        log_error "LLNG returned HTTP $HTTP_STATUS on /pam/bastion-token: $BODY"
        exit 2
    fi

    if printf '%s' "$BODY" | jq -e '.bastion_id // empty' >/dev/null 2>&1; then
        emit_id "$BODY" '.bastion_id // empty' \
            || die "No bastion_id in probe response: $BODY" 3
    fi

    local jwt
    # `|| jwt=""`: under set -e + pipefail, jq failing on HTML would kill us.
    jwt=$(printf '%s' "$BODY" | jq -r '.bastion_jwt // empty' 2>/dev/null) || jwt=""
    [ -n "$jwt" ] || die "this portal implements neither /pam/whoami nor the legacy /pam/bastion-token probe: $BODY" 3

    local b64payload claims
    b64payload="${jwt#*.}"; b64payload="${b64payload%.*}"
    # `|| claims=""`: same set -e + pipefail trap as above.
    claims=$(base64url_decode "$b64payload") || claims=""
    [ -n "$claims" ] || die "Failed to base64url-decode JWT payload" 3

    emit_id "$claims" '.bastion_id // .sub // empty' \
        || die "JWT has neither bastion_id nor sub claim" 3
}

main "$@"
