#!/bin/bash
#
# ob-krl-refresh - download the SSH key revocation list from the portal
#
# sshd reads a RevokedKeys file it cannot parse as "every key is revoked", so
# a list is installed only once it has the KRL header and parses, by an atomic
# rename. Anything else keeps the current list and exits non-zero.
#
# Copyright (C) 2026 Linagora
# License: AGPL-3.0

set -euo pipefail

VERSION="1.0.0"
PROG_NAME=$(basename "$0")

CONFIG_FILE="/etc/open-bastion/openbastion.conf"
OUTPUT="/etc/ssh/revoked_keys"
# Far above any real KRL; bounds what a portal can write into /etc/ssh.
MAX_SIZE=$((16 * 1024 * 1024))

# "SSHKRL\n\0" then format version 1 as a big-endian uint32 (PROTOCOL.krl).
KRL_HEADER_HEX="5353484b524c0a0000000001"

# A throwaway public key: ssh-keygen -Q needs one to test the list against.
PROBE_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIxgURjbVDXbfvWlXT6wQ/gqTxGgDNCd2pxbXwFX3lgT ob-krl-refresh-probe"

log()  { echo "$PROG_NAME: $*" >&2; }
die()  { local rc="$1"; shift; log "$*"; exit "$rc"; }

usage() {
    cat <<EOF
Usage: $PROG_NAME [OPTIONS]

Download the SSH key revocation list from the LemonLDAP::NG portal named in
openbastion.conf, check it, and atomically replace the file sshd reads.

Options:
  -c, --config FILE   Configuration file (default: $CONFIG_FILE)
  -o, --output FILE   Revocation list to replace (default: $OUTPUT)
  -h, --help          Show this help
  -V, --version       Show version

Exit status:
  0  the list is current (replaced, or already identical)
  1  configuration error
  2  the portal could not be reached or refused the request
  3  the portal answered with something that is not a valid KRL
  4  the new list could not be installed
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -c|--config)
            [ $# -ge 2 ] || die 1 "$1 needs an argument"
            CONFIG_FILE="$2"; shift 2 ;;
        -o|--output)
            [ $# -ge 2 ] || die 1 "$1 needs an argument"
            OUTPUT="$2"; shift 2 ;;
        -h|--help)    usage; exit 0 ;;
        -V|--version) echo "$PROG_NAME version $VERSION"; exit 0 ;;
        *) usage >&2; die 1 "unknown option: $1" ;;
    esac
done

# Same parser as ob-heartbeat.
read_config() {
    awk -v key="$1" '
        $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
            val = substr($0, index($0, "=") + 1)
            gsub(/^[[:space:]]+/, "", val)
            in_sq = 0; in_dq = 0; out = ""
            for (i = 1; i <= length(val); i++) {
                c = substr(val, i, 1)
                if (c == "\"" && in_sq == 0) in_dq = 1 - in_dq
                else if (c == "'"'"'" && in_dq == 0) in_sq = 1 - in_sq
                if (c == "#" && in_sq == 0 && in_dq == 0) break
                out = out c
            }
            val = out
            gsub(/[[:space:]]+$/, "", val)
            if (length(val) >= 2) {
                first = substr(val, 1, 1); last = substr(val, length(val), 1)
                if (first == last && (first == "\"" || first == "'"'"'"))
                    val = substr(val, 2, length(val) - 2)
            }
            result = val
        }
        END { if (result != "") print result }
    ' "$CONFIG_FILE"
}

# The URL decides what root writes into a file sshd trusts: the configuration
# must be ours and writable by nobody else.
[ -f "$CONFIG_FILE" ] || die 1 "configuration file not found: $CONFIG_FILE"
[ -r "$CONFIG_FILE" ] || die 1 "configuration file not readable: $CONFIG_FILE"
conf_stat=$(stat -Lc '%u %a' "$CONFIG_FILE") || die 1 "cannot stat $CONFIG_FILE"
conf_owner=${conf_stat% *}
conf_mode=${conf_stat#* }
if [ "$conf_owner" != "$(id -u)" ]; then
    die 1 "$CONFIG_FILE is owned by uid $conf_owner, not by uid $(id -u): refusing to use it"
fi
if (( (8#$conf_mode & 8#022) != 0 )); then
    die 1 "$CONFIG_FILE is group- or world-writable (mode $conf_mode): refusing to use it"
fi

PORTAL_URL=$(read_config portal_url)
[ -n "$PORTAL_URL" ] || PORTAL_URL=$(read_config portal)
[ -n "$PORTAL_URL" ] || die 1 "portal_url is not set in $CONFIG_FILE"
PORTAL_URL="${PORTAL_URL%/}"
# Same shape as ob-bastion-setup and ob-builder accept.
if ! [[ "$PORTAL_URL" =~ ^https?://[A-Za-z0-9._:/?#@!()*+,\;=~%-]+$ ]]; then
    die 1 "invalid portal_url in $CONFIG_FILE: $PORTAL_URL"
fi

TIMEOUT=$(read_config timeout)
if ! [[ "$TIMEOUT" =~ ^[1-9][0-9]{0,2}$ ]]; then
    [ -z "$TIMEOUT" ] || log "invalid timeout '$TIMEOUT' in $CONFIG_FILE, using 10"
    TIMEOUT=10
fi

CURL_OPTS=(-s -S -f --proto '=http,https' --connect-timeout "$TIMEOUT"
           --max-time $((TIMEOUT * 6)) --max-filesize "$MAX_SIZE")
case "$(read_config verify_ssl)" in
    false|0|no|off) CURL_OPTS+=(-k) ;;
esac
CA_CERT=$(read_config ca_cert)
if [ -n "$CA_CERT" ]; then
    [ -r "$CA_CERT" ] || die 1 "ca_cert $CA_CERT is not readable"
    CURL_OPTS+=(--cacert "$CA_CERT")
fi

# Same directory as the target, so the final mv is an atomic rename(2).
out_dir=$(dirname "$OUTPUT")
[ -d "$out_dir" ] || die 4 "directory $out_dir does not exist"
tmp=$(mktemp "$out_dir/.$(basename "$OUTPUT").XXXXXX") \
    || die 4 "cannot create a temporary file in $out_dir"
probe=""
trap 'rm -f "$tmp" ${probe:+"$probe"}' EXIT

if ! curl "${CURL_OPTS[@]}" -o "$tmp" "$PORTAL_URL/ssh/revoked"; then
    die 2 "download of $PORTAL_URL/ssh/revoked failed; $OUTPUT left unchanged"
fi

header=$(od -An -tx1 -N12 "$tmp" | tr -d ' \n')
if [ "$header" != "$KRL_HEADER_HEX" ]; then
    die 3 "$PORTAL_URL/ssh/revoked did not return an SSH KRL (bad magic); $OUTPUT left unchanged"
fi

# A truncated body behind a good header: ssh-keygen -Q exits 0 or 1 (not
# revoked, revoked) only if the whole list parses.
if command -v ssh-keygen >/dev/null 2>&1; then
    probe=$(mktemp) || die 4 "cannot create a temporary file"
    printf '%s\n' "$PROBE_KEY" > "$probe"
    rc=0
    ssh-keygen -Q -f "$tmp" "$probe" >/dev/null 2>&1 || rc=$?
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
        die 3 "the KRL from $PORTAL_URL/ssh/revoked does not parse (ssh-keygen -Q exit $rc); $OUTPUT left unchanged"
    fi
fi

# The date of an identical list is still updated, so the file's age tells
# when the refresh last worked.
if [ -f "$OUTPUT" ] && cmp -s "$tmp" "$OUTPUT"; then
    touch -c "$OUTPUT" || die 4 "cannot update the date of $OUTPUT"
    exit 0
fi
chmod 0644 "$tmp" || die 4 "cannot set the mode of $tmp"
mv -f "$tmp" "$OUTPUT" || die 4 "cannot replace $OUTPUT"
log "updated $OUTPUT from $PORTAL_URL/ssh/revoked ($(stat -c %s "$OUTPUT") bytes)"
exit 0
