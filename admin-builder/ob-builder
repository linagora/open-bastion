#!/usr/bin/env bash
#
# ob-builder - Generate Open Bastion deployment artefacts from a single
# admin questionnaire (or YAML config).
#
# Produces a self-extracting shell installer and/or an Ansible role tree
# pre-loaded with the SSO discovery results (CA, KRL, JWKS) so that
# target machines need only bash + curl (or ansible) to install.
#
# Copyright (C) 2025 Linagora
# License: AGPL-3.0

set -euo pipefail

VERSION="0.5.1"
PROG_NAME=$(basename "$0")
SCRIPT_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" >/dev/null 2>&1 && pwd)

# Library path. When installed, libs live under /usr/share/open-bastion-builder/lib.
# In dev, they live next to the script.
OB_BUILDER_LIB_DIR="${OB_BUILDER_LIB_DIR:-}"
if [ -z "$OB_BUILDER_LIB_DIR" ]; then
    if [ -d "$SCRIPT_DIR/lib" ]; then
        OB_BUILDER_LIB_DIR="$SCRIPT_DIR/lib"
    elif [ -d "/usr/share/open-bastion-builder/lib" ]; then
        OB_BUILDER_LIB_DIR="/usr/share/open-bastion-builder/lib"
    else
        echo "[ERROR] Cannot locate ob-builder lib directory" >&2
        exit 1
    fi
fi

# Templates live alongside the libs in the install prefix.
OB_BUILDER_SHARE="${OB_BUILDER_SHARE:-}"
if [ -z "$OB_BUILDER_SHARE" ]; then
    if [ -d "$SCRIPT_DIR/templates" ]; then
        OB_BUILDER_SHARE="$SCRIPT_DIR"
    elif [ -d "/usr/share/open-bastion-builder/templates" ]; then
        OB_BUILDER_SHARE="/usr/share/open-bastion-builder"
    else
        OB_BUILDER_SHARE="$SCRIPT_DIR"
    fi
fi
TEMPLATES_DIR="$OB_BUILDER_SHARE/templates"
KEYRINGS_DIR="$OB_BUILDER_SHARE/keyrings"
DEFAULT_REPO_KEYRING="$KEYRINGS_DIR/open-bastion-linagora.gpg"

# shellcheck source=lib/common.sh
. "$OB_BUILDER_LIB_DIR/common.sh"
# shellcheck source=lib/validators.sh
. "$OB_BUILDER_LIB_DIR/validators.sh"
# shellcheck source=lib/prompts.sh
. "$OB_BUILDER_LIB_DIR/prompts.sh"
# shellcheck source=lib/sso-discovery.sh
. "$OB_BUILDER_LIB_DIR/sso-discovery.sh"

# ── Default APT repo parameters ─────────────────────────────────────────
DEFAULT_APT_URL="https://linagora.github.io/open-bastion"
DEFAULT_APT_SUITE="trixie"
DEFAULT_APT_COMPONENT="main"

# ── CLI-collected variables ─────────────────────────────────────────────
CONFIG_FILE=""
OUTPUT_SHELL=""
OUTPUT_ANSIBLE=""
REPO_KEYRING=""
APT_SUITE="$DEFAULT_APT_SUITE"
APT_COMPONENT="$DEFAULT_APT_COMPONENT"
APT_URL="$DEFAULT_APT_URL"
SIGN_WITH=""
# Set when given on the CLI, so the questionnaire does not ask again.
REPO_KEYRING_SET=0
APT_URL_SET=0
APT_SUITE_SET=0
APT_COMPONENT_SET=0
SIGN_WITH_SET=0
# --save-config: write the resolved answers, defaults included, as a YAML that
# --config replays (#311). The questionnaire offers it too.
SAVE_CONFIG=""
# Whether the saved config carries the embedded client_secret. Off unless the
# admin says yes in the questionnaire: the file is meant to be kept and reused,
# and a secret in it outlives the artefact that needed it.
SAVE_CONFIG_SECRET=0
# `insecure:` read from a config, applied once both parsers are done.
CONFIG_INSECURE=""
# --insecure: allow an http:// portal AND skip TLS verification, both for the
# builder's own fetches and in the generated artefacts (verify_ssl = false).
INSECURE=0
DRY_RUN=0
BUNDLE=0

# ── Questionnaire-collected variables (also overridable via YAML) ───────
DEPLOYMENT_SLUG=""
SCENARIO=""
PORTAL_URL=""
CLIENT_ID=""
CLIENT_ID_POLICY=""
CLIENT_SECRET_MODE=""
EMBEDDED_CLIENT_SECRET=""
SERVER_GROUP=""
SERVER_GROUP_POLICY=""
TARGET_ROLE=""
# Every role to generate artefacts for (interactive mode may pick several).
# TARGET_ROLE stays the first one.
TARGET_ROLES=()
AUTO_ENROLL_SETUP=""
# Pass --enable-service-keys through to the setup script the bundle runs.
#
# Without it the bundle deploys the keys and then the setup run it launches
# REMOVES the drop-in that serves them: a setup run without the flag cleans up
# its own generated file (#265), and the installer's setup argv had no way to
# carry one. The two features together were self-defeating.
#
# Defaults to on when any service account carries a key, since deploying a key
# nothing serves is the exact state #263 was reported for; an explicit
# `service_keys: false` overrides.
SERVICE_KEYS_SETUP=""
SELF_DELETE=""
ALLOWED_BASTIONS=""
ANSIBLE_AUTO_APPROVE=""
# Optional opt-in features (yes/no). Hardening and audit-trace are intrusive
# and OFF by default; session recording is ON by default on bastion/standalone
# and DISABLE_SESSION_RECORDER=yes opts out of it (never applies to backend).
ENABLE_HARDENING=""
ENABLE_AUDIT_TRACE=""
DISABLE_SESSION_RECORDER=""

# Service accounts (SSH-key-only local accounts: ansible, backup, …). Each entry
# is one account encoded as a single record whose fields are joined by the ASCII
# Unit Separator (US, \x1f) in this fixed order:
#   name, key_fingerprint, sudo_allowed, sudo_nopasswd, shell, home, gecos,
#   uid, gid, public_key
#
# public_key is the account's authorized SSH public key. It is what
# service-accounts.conf could never carry (#263): the fingerprint alone tells
# pam_openbastion what to expect but gives sshd nothing to accept, so the
# operator had to deploy the key by hand and the deployment looked complete
# when it was not. With the key here, ob-builder writes
# /etc/open-bastion/service-accounts.d/<name>.pub itself.
# Populated from the questionnaire or from the YAML `service_accounts:` list, and
# rendered into /etc/open-bastion/service-accounts.conf on the target.
SERVICE_ACCOUNTS_RECORDS=()
_OB_SA_US=$'\x1f'
# Module defaults from include/config.h (DEFAULT_APPROVED_HOME_PREFIXES /
# DEFAULT_APPROVED_SHELLS). A service account whose home/shell falls outside
# these is SILENTLY DROPPED at load by pam_openbastion unless the target's
# openbastion.conf widens approved_home_prefixes / approved_shells — so we warn
# about it at build time. Keep in sync with config.h.
_OB_SA_DEFAULT_HOME_PREFIXES="/home /var/home"
_OB_SA_DEFAULT_SHELLS="/bin/bash /bin/sh /usr/bin/bash /usr/bin/sh /bin/zsh /usr/bin/zsh /bin/dash /usr/bin/dash /bin/fish /usr/bin/fish"
# Common Debian/Linux system users. A service account that reuses one of these is
# still ACCEPTED (NSS `files` resolves it, PAM authorizes it by name), but the
# existing account is used as-is — its shell/home/uid are NOT overridden by the
# config (pam_openbastion only applies those when it CREATES the account). Most
# of these ship with /usr/sbin/nologin, which breaks the login. We warn, not block.
_OB_SA_SYSTEM_NAMES="root daemon bin sys sync games man lp mail news uucp proxy www-data backup list irc gnats nobody ftp sshd messagebus systemd-network systemd-resolve systemd-timesync _apt tss tcpdump"

# Derived values populated after the questionnaire.
PAM_MODE=""
BUILD_DATE=""
WORK_DIR=""  # Temp dir for fetched assets (CA, KRL, JWKS).

usage() {
    cat << EOF
$PROG_NAME version $VERSION

Generate Open Bastion deployment artefacts (self-extracting shell installer
and/or Ansible role tree) from a single admin questionnaire or YAML config.

USAGE:
  $PROG_NAME [OPTIONS]

INPUT MODES:
  (no args)                  Fully interactive questionnaire (asks for the
                             outputs too, and may target several roles)
  --config FILE              Non-interactive, read all answers from a YAML file
  --bundle                   Generate paired bastion + backend artefacts in one run

OUTPUTS (with --config, at least one of them is required):
  --output-shell DIR         Write the self-extracting shell installer(s) in
                             this directory, created if missing, as
                             bootstrap-<slug>-<role>.sh (+ .sig, and
                             PORTAL-CHECKLIST-<role>.md)
  --output-ansible PATH      Write Ansible role tree here (directory)
                             With several roles, each role tree gets the role
                             as suffix (PATH-bastion, PATH-backend)
  --save-config PATH         Also save the answers, defaults included, as a
                             YAML replayable with --config (the questionnaire
                             offers it too). An embedded client_secret is left
                             out unless the questionnaire is told otherwise.

REPO / SIGNING:
  --repo-keyring PATH        Path to a local GPG keyring (.gpg) for the APT
                             repo. Defaults to the Linagora keyring shipped
                             with the builder ($DEFAULT_REPO_KEYRING).
                             Override for a different APT repo (your own
                             mirror, etc.) via this flag or 'repo_keyring'
                             in the --config YAML.
  --apt-url URL              APT repo base URL (default: $DEFAULT_APT_URL)
  --apt-suite SUITE          APT suite/codename       (default: $DEFAULT_APT_SUITE)
  --apt-component COMP       APT component            (default: $DEFAULT_APT_COMPONENT)
  --sign-with KEYID          GPG-sign the shell output with this key (.sig sidecar)

OTHER:
  --insecure                 Allow an http:// SSO URL and skip TLS verification,
                             both here and on the targets (verify_ssl = false,
                             ob-enroll/setup -k). Test setups only.
  --allow-http               Deprecated alias of --insecure
  --dry-run                  Print what would be generated, do not write any files
  -h, --help                 Show this help
  -V, --version              Print version

QUESTIONNAIRE (asked when no --config is given; CLI values are not re-asked):
  1. Deployment slug (filesystem-safe)
  2. Artefacts to generate (shell | ansible | both) and their paths
  3. Security scenario: token-only | token+unix | keys+llng | mixed | max-security
  4. SSO portal URL (OIDC discovery is performed to validate it; an http://
     URL offers to switch to --insecure)
  5. OIDC client_id + policy (fixed | modifiable)
  6. OIDC client_secret mode (none | prompt | embedded)
  7. Server group + policy (fixed | modifiable)
  8. Target role(s): bastion | standalone | backend (one or more)
  9. Allowed bastions (backend), hardening, audit trace, session recording
 10. Service accounts (SSH-key-only local accounts: ansible, backup, …)
 11. Auto-launch enroll/setup on the target? (yes | no | prompt), self-delete
 12. APT repository (URL, suite, component, keyring) and GPG signing key
 13. Save the answers as a YAML config for --config?

SERVICE ACCOUNTS (--config YAML):
  Declare SSH-key-only local accounts under a 'service_accounts:' list. They are
  rendered into /etc/open-bastion/service-accounts.conf (0600) on the target and
  apply to every role.

  Give each account its public_key (or public_key_file): the fingerprint alone
  tells pam_openbastion what to expect but gives sshd nothing to accept, so
  without the key the account cannot log in and the deployment looks complete
  (#263). With it, the bundle also writes
  /etc/open-bastion/service-accounts.d/<name>.pub.

  sshd still needs the AuthorizedKeysCommand that serves those files. When any
  account carries a key the bundle passes --enable-service-keys to the setup it
  runs, so this is handled; set service_keys: false to opt out, or true to
  force it. If setup is skipped, run it by hand on the target -- the installer
  says so when it finds sshd not serving them. Example:
    service_accounts:
      - name: ci-ansible            # dedicated name (not an existing system user)
        public_key_file: keys/ci.pub  # or public_key: "ssh-ed25519 AAAA… ci@host"
                                      # (relative to THIS file; the two are exclusive)
        # key_fingerprint is DERIVED from the key. Give it too only if you want
        # it cross-checked: a mismatch stops the build rather than shipping a
        # bundle that installs cleanly and refuses the login.
        sudo_allowed: true
        sudo_nopasswd: true
        shell: /bin/bash
        home: /home/ci-ansible      # under an approved prefix (/home, /var/home)
        gecos: Ansible Automation
        uid: 6001                   # fixed uid+gid → NSS-resolvable → reachable over SSH
        gid: 6001
  Notes: use a dedicated (non-system) name, a home under /home or /var/home, and
  a fixed uid+gid, or the account is dropped / unreachable. See doc/service-accounts.rst.

EXAMPLES:
  # Fully interactive (outputs, roles and repository are asked for)
  $PROG_NAME

  # Interactive, keeping the answers for the next, non-interactive, run
  $PROG_NAME --save-config build.yml

  # Interactive, shell installer directory given up front
  $PROG_NAME --output-shell /tmp/bootstrap/

  # Replayable build from YAML config (e.g. for CI)
  $PROG_NAME --config build.yml \\
             --output-shell /tmp/bootstrap/ --output-ansible /tmp/role/

  # Bundle (bastion + backend share the same CA / JWKS fetched once)
  $PROG_NAME --config build.yml --bundle \\
             --output-shell /tmp/bootstrap/

EOF
}

show_version() {
    printf '%s version %s\n' "$PROG_NAME" "$VERSION"
}

# ─────────────────────────────────────────────────────────────────────────
# Argument parsing.
# Matches the case-statement style of ob-bastion-setup: explicit requires-arg
# check, hard fail on unknown flags.
# ─────────────────────────────────────────────────────────────────────────
parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --config)
                [ -n "${2:-}" ] && [[ "${2:-}" != -* ]] || die "Option $1 requires an argument"
                CONFIG_FILE="$2"; shift 2
                ;;
            --output-shell)
                [ -n "${2:-}" ] && [[ "${2:-}" != -* ]] || die "Option $1 requires an argument"
                OUTPUT_SHELL="$2"; shift 2
                ;;
            --output-ansible)
                [ -n "${2:-}" ] && [[ "${2:-}" != -* ]] || die "Option $1 requires an argument"
                OUTPUT_ANSIBLE="$2"; shift 2
                ;;
            --repo-keyring)
                [ -n "${2:-}" ] && [[ "${2:-}" != -* ]] || die "Option $1 requires an argument"
                REPO_KEYRING="$2"; REPO_KEYRING_SET=1; shift 2
                ;;
            --apt-url)
                [ -n "${2:-}" ] && [[ "${2:-}" != -* ]] || die "Option $1 requires an argument"
                APT_URL="$2"; APT_URL_SET=1; shift 2
                ;;
            --apt-suite)
                [ -n "${2:-}" ] && [[ "${2:-}" != -* ]] || die "Option $1 requires an argument"
                APT_SUITE="$2"; APT_SUITE_SET=1; shift 2
                ;;
            --apt-component)
                [ -n "${2:-}" ] && [[ "${2:-}" != -* ]] || die "Option $1 requires an argument"
                APT_COMPONENT="$2"; APT_COMPONENT_SET=1; shift 2
                ;;
            --sign-with)
                [ -n "${2:-}" ] && [[ "${2:-}" != -* ]] || die "Option $1 requires an argument"
                SIGN_WITH="$2"; SIGN_WITH_SET=1; shift 2
                ;;
            --save-config)
                [ -n "${2:-}" ] && [[ "${2:-}" != -* ]] || die "Option $1 requires an argument"
                SAVE_CONFIG="$2"; shift 2
                ;;
            --bundle)        BUNDLE=1; shift ;;
            --insecure|--allow-http)
                [ "$1" = "--allow-http" ] && log_warn "--allow-http is deprecated, use --insecure (same effect)"
                INSECURE=1
                export OB_BUILDER_INSECURE=1
                shift
                ;;
            --dry-run)       DRY_RUN=1; shift ;;
            -h|--help)       usage; exit 0 ;;
            -V|--version)    show_version; exit 0 ;;
            *)
                log_error "Unknown option: $1"
                echo "Use --help for usage information" >&2
                exit 1
                ;;
        esac
    done
}

# ─────────────────────────────────────────────────────────────────────────
# YAML loading.
# Prefer `yq` (Go or Python implementations both work for flat top-level
# keys); fall back to an awk parser for the documented flat subset:
#
#   key: value
#   key: "quoted value"
#
# Comments (#…) and blank lines ignored. No nested mappings, no lists, no
# multi-line strings. This is sufficient for ob-builder's flat schema and
# avoids a hard dependency on yq.
# ─────────────────────────────────────────────────────────────────────────
load_config() {
    local f="$1"
    [ -f "$f" ] || die "Config file not found: $f"

    log_step "Loading config from $f"

    if command -v yq >/dev/null 2>&1; then
        _load_config_yq "$f"
    else
        log_info "yq not found, using awk-based parser (flat keys only)"
        _load_config_awk "$f"
    fi

    # Service accounts are a nested list, which neither flat parser handles.
    # Parse them with a dedicated, yq-independent block scanner so behaviour is
    # identical whether or not yq is installed.
    _parse_service_accounts_block "$f"

    _normalise_config_values

    # When loading config we run non-interactively unless a missing value
    # forces a prompt. The prompts library checks OB_BUILDER_NON_INTERACTIVE.
    export OB_BUILDER_NON_INTERACTIVE=1
}

_load_config_yq() {
    local f="$1" v
    # Detect yq flavor ONCE so a transient failure on one query does not
    # silently fall back to the other parser (which could produce different
    # semantics for the same key — see PR #116 review).
    local _yq_flavor=""
    if yq --version 2>&1 | grep -qi "mikefarah"; then
        _yq_flavor="go"
    elif yq --help 2>&1 | grep -qi "yq is a wrapper\|kislyuk"; then
        _yq_flavor="python"
    else
        # Heuristic: Go yq accepts `eval`, Python yq doesn't.
        if yq eval '.' "$f" >/dev/null 2>&1; then
            _yq_flavor="go"
        else
            _yq_flavor="python"
        fi
    fi
    # `select(. != null)`, not `// …`: the alternative operator also drops
    # `false`, so `self_delete: false` read as unset and fell back to the
    # default, which is `yes` with an embedded secret.
    _yq_get() {
        local key="$1"
        local out
        if [ "$_yq_flavor" = "go" ]; then
            # By tag: `. != null` also matches the STRING "null".
            out=$(yq eval ".${key} | select(tag != \"!!null\")" "$f" 2>/dev/null) || out=""
        else
            out=$(yq -r ".${key} | select(. != null)" "$f" 2>/dev/null) || out=""
        fi
        printf '%s' "$out"
    }

    v=$(_yq_get deployment_slug);     [ -n "$v" ] && DEPLOYMENT_SLUG="$v"
    v=$(_yq_get scenario);            [ -n "$v" ] && SCENARIO="$v"
    v=$(_yq_get portal_url);          [ -n "$v" ] && PORTAL_URL="$v"
    v=$(_yq_get client_id);           [ -n "$v" ] && CLIENT_ID="$v"
    v=$(_yq_get client_id_policy);    [ -n "$v" ] && CLIENT_ID_POLICY="$v"
    v=$(_yq_get client_secret_mode);  [ -n "$v" ] && CLIENT_SECRET_MODE="$v"
    v=$(_yq_get embedded_client_secret); [ -n "$v" ] && EMBEDDED_CLIENT_SECRET="$v"
    v=$(_yq_get server_group);        [ -n "$v" ] && SERVER_GROUP="$v"
    v=$(_yq_get server_group_policy); [ -n "$v" ] && SERVER_GROUP_POLICY="$v"
    v=$(_yq_get target_role);         [ -n "$v" ] && TARGET_ROLE="$v"
    v=$(_yq_get auto_enroll_setup);   [ -n "$v" ] && AUTO_ENROLL_SETUP="$v"
    v=$(_yq_get service_keys);        [ -n "$v" ] && SERVICE_KEYS_SETUP="$v"
    v=$(_yq_get self_delete);         [ -n "$v" ] && SELF_DELETE="$v"
    v=$(_yq_get allowed_bastions);    [ -n "$v" ] && ALLOWED_BASTIONS="$v"
    v=$(_yq_get ansible_auto_approve); [ -n "$v" ] && ANSIBLE_AUTO_APPROVE="$v"
    v=$(_yq_get enable_hardening);    [ -n "$v" ] && ENABLE_HARDENING="$v"
    v=$(_yq_get enable_audit_trace);  [ -n "$v" ] && ENABLE_AUDIT_TRACE="$v"
    v=$(_yq_get disable_session_recorder); [ -n "$v" ] && DISABLE_SESSION_RECORDER="$v"
    v=$(_yq_get insecure);            [ -n "$v" ] && CONFIG_INSECURE="$v"
    v=$(_yq_get sign_with);           [ -n "$v" ] && [ "$SIGN_WITH_SET" = 0 ] && SIGN_WITH="$v"
    v=$(_yq_get repo_keyring);        [ -n "$v" ] && [ -z "$REPO_KEYRING" ] && REPO_KEYRING="$v"
    v=$(_yq_get apt_url);             [ -n "$v" ] && [ "$APT_URL" = "$DEFAULT_APT_URL" ] && APT_URL="$v"
    v=$(_yq_get apt_suite);           [ -n "$v" ] && [ "$APT_SUITE" = "$DEFAULT_APT_SUITE" ] && APT_SUITE="$v"
    v=$(_yq_get apt_component);       [ -n "$v" ] && [ "$APT_COMPONENT" = "$DEFAULT_APT_COMPONENT" ] && APT_COMPONENT="$v"
    # Trailing `cmd && X` returns non-zero when `cmd` is false. Without an
    # explicit success status the function exit code propagates and triggers
    # set -e in the caller. Keep this `return 0` at the end of the function.
    return 0
}

# Awk parser: emits "KEY\tVALUE" lines for known keys, strips quotes.
_load_config_awk() {
    local f="$1"
    local line key val
    while IFS= read -r line || [ -n "$line" ]; do
        # Strip CR (CRLF files) and leading/trailing whitespace.
        line="${line%$'\r'}"
        # Skip blanks and comments.
        case "$line" in
            ''|\#*) continue ;;
        esac
        # Match key: value
        if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*:[[:space:]]*(.*)$ ]]; then
            key="${BASH_REMATCH[1]}"
            val="${BASH_REMATCH[2]}"
            # Strip inline comment per YAML rule: '#' preceded by a space.
            val="${val%% #*}"
            # Strip surrounding whitespace.
            val="${val#"${val%%[![:space:]]*}"}"
            val="${val%"${val##*[![:space:]]}"}"
            # Strip matching quotes.
            case "$val" in
                \"*\") val="${val#\"}"; val="${val%\"}" ;;
                \'*\') val="${val#\'}"; val="${val%\'}" ;;
            esac
            case "$key" in
                deployment_slug)     DEPLOYMENT_SLUG="$val" ;;
                scenario)            SCENARIO="$val" ;;
                portal_url)          PORTAL_URL="$val" ;;
                client_id)           CLIENT_ID="$val" ;;
                client_id_policy)    CLIENT_ID_POLICY="$val" ;;
                client_secret_mode)  CLIENT_SECRET_MODE="$val" ;;
                embedded_client_secret) EMBEDDED_CLIENT_SECRET="$val" ;;
                server_group)        SERVER_GROUP="$val" ;;
                server_group_policy) SERVER_GROUP_POLICY="$val" ;;
                target_role)         TARGET_ROLE="$val" ;;
                auto_enroll_setup)   AUTO_ENROLL_SETUP="$val" ;;
                service_keys)        SERVICE_KEYS_SETUP="$val" ;;
                self_delete)         SELF_DELETE="$val" ;;
                allowed_bastions)    ALLOWED_BASTIONS="$val" ;;
                ansible_auto_approve) ANSIBLE_AUTO_APPROVE="$val" ;;
                enable_hardening)    ENABLE_HARDENING="$val" ;;
                enable_audit_trace)  ENABLE_AUDIT_TRACE="$val" ;;
                disable_session_recorder) DISABLE_SESSION_RECORDER="$val" ;;
                insecure)            CONFIG_INSECURE="$val" ;;
                sign_with)           [ "$SIGN_WITH_SET" = 0 ] && SIGN_WITH="$val" ;;
                repo_keyring)        [ -z "$REPO_KEYRING" ] && REPO_KEYRING="$val" ;;
                apt_url)             [ "$APT_URL"       = "$DEFAULT_APT_URL"       ] && APT_URL="$val" ;;
                apt_suite)           [ "$APT_SUITE"     = "$DEFAULT_APT_SUITE"     ] && APT_SUITE="$val" ;;
                apt_component)       [ "$APT_COMPONENT" = "$DEFAULT_APT_COMPONENT" ] && APT_COMPONENT="$val" ;;
                # Service-account list keys: consumed by _parse_service_accounts_block,
                # ignored here (they only appear nested under `service_accounts:`).
                service_accounts|name|key_fingerprint|fingerprint|sudo_allowed|sudo_nopasswd|shell|home|gecos|uid|gid|public_key|public_key_file) : ;;
                *) log_warn "Unknown config key '$key' (ignored)" ;;
            esac
        fi
    done < "$f"
    return 0
}

# A YAML boolean as the yes/no these keys expect. yq hands `true`/`false` back
# for an unquoted boolean, which validate_inputs would otherwise refuse.
_cfg_yesno() {
    case "$1" in
        true|True|TRUE)    printf 'yes' ;;
        false|False|FALSE) printf 'no' ;;
        *)                 printf '%s' "$1" ;;
    esac
}

# Shared by both parsers, after they ran.
_normalise_config_values() {
    AUTO_ENROLL_SETUP=$(_cfg_yesno "$AUTO_ENROLL_SETUP")
    SELF_DELETE=$(_cfg_yesno "$SELF_DELETE")
    ENABLE_HARDENING=$(_cfg_yesno "$ENABLE_HARDENING")
    ENABLE_AUDIT_TRACE=$(_cfg_yesno "$ENABLE_AUDIT_TRACE")
    DISABLE_SESSION_RECORDER=$(_cfg_yesno "$DISABLE_SESSION_RECORDER")
    ANSIBLE_AUTO_APPROVE=$(_cfg_yesno "$ANSIBLE_AUTO_APPROVE")
    # `insecure: yes` is the config form of --insecure, which a config saved
    # from a questionnaire that switched to it for an http:// portal needs to
    # replay at all. It only adds: `insecure: no` does not undo the flag.
    case "$(_cfg_yesno "$CONFIG_INSECURE")" in
        yes)
            INSECURE=1
            export OB_BUILDER_INSECURE=1
            ;;
        no|"") ;;
        *) die "Invalid insecure: $CONFIG_INSECURE" ;;
    esac
    return 0
}

# ─────────────────────────────────────────────────────────────────────────
# Service-account helpers.
# A record packs the 10 fields (in the fixed order documented next to
# SERVICE_ACCOUNTS_RECORDS) joined by the Unit Separator. _sa_pack builds one;
# _sa_field N extracts the Nth field (1-based) from a record.
# ─────────────────────────────────────────────────────────────────────────
_sa_pack() {
    local IFS="$_OB_SA_US"
    printf '%s' "$*"
}
_sa_field() {
    local n="$1" rec="$2"
    local -a _parts
    IFS="$_OB_SA_US" read -r -a _parts <<< "$rec"
    printf '%s' "${_parts[$((n - 1))]:-}"
}

# Compute the SHA256 fingerprint of an SSH public key, the way ssh-keygen -lf
# prints it. Deriving it removes a whole class of failure: a fingerprint typed
# or pasted separately from the key it is supposed to describe silently matches
# nothing, and the login fails at the fingerprint check with the key looking
# perfectly correct on both ends.
_sa_fingerprint_of() {
    local pub="$1" alg="${2:-sha256}" tmp out got
    command -v ssh-keygen >/dev/null 2>&1 || return 1
    tmp=$(mktemp) || return 1
    printf '%s\n' "$pub" > "$tmp"
    out=$(ssh-keygen -E "$alg" -lf "$tmp" 2>/dev/null) || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
    got=$(printf '%s' "$out" | awk '{print $2}')
    case "$alg:$got" in
        sha256:SHA256:*|md5:MD5:*) printf '%s' "$got" ;;
        *) return 1 ;;
    esac
}

# An SSH public key is one line: "<type> <base64> [comment]".
# Normalise an authorized_keys line to the bare "<type> <base64> [comment]" the
# helper serves, dropping any options prefix. A public_key_file pointed at a copy
# of someone's authorized_keys is the obvious way to get one, and silently
# refusing it produced the #263 shape: no .pub deployed, everything else fine.
_sa_strip_key_options() {
    local line="$1"
    case "$line" in
        ssh-*|ecdsa-*|sk-*) printf '%s' "$line"; return 0 ;;
    esac
    # Options come first, then the key type. Find the first field that looks
    # like one and keep from there.
    printf '%s' "$line" | grep -oE '(ssh-(rsa|ed25519|dss)|ecdsa-sha2-[a-z0-9]+|sk-(ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com)[[:space:]].*$' \
        || printf '%s' "$line"
}

# One line, a supported plain key type, and not a certificate.
#
# Certificates are rejected on purpose: the helper serves the file to sshd as an
# authorized key, and a cert is not one. The previous globs let
# ecdsa-sha2-*-cert-v01@openssh.com through while rejecting the ed25519 and rsa
# cert forms -- an accident of glob order, not a policy.
_sa_is_valid_pubkey() {
    local pub="$1"
    case "$pub" in *$'\n'*) return 1 ;; esac
    case "$pub" in *-cert-v01@openssh.com\ *) return 1 ;; esac
    case "$pub" in
        ssh-rsa\ *|ssh-ed25519\ *|ssh-dss\ *) ;;
        ecdsa-sha2-nistp256\ *|ecdsa-sha2-nistp384\ *|ecdsa-sha2-nistp521\ *) ;;
        sk-ssh-ed25519@openssh.com\ *|sk-ecdsa-sha2-nistp256@openssh.com\ *) ;;
        *) return 1 ;;
    esac
    return 0
}

# Reconcile the public key and the fingerprint of the account being parsed.
#
# Three cases, and only the third can go wrong silently today:
#   - key only        -> derive the fingerprint from it;
#   - fingerprint only -> keep it, and say the key is still needed on the target;
#   - both            -> derive and COMPARE. A mismatch is a build-time error,
#                        not a warning: it means the two were maintained apart,
#                        and on the target it shows up as a login refused with a
#                        key that looks right in every listing.
_sa_reconcile_key() {
    local derived want_alg="sha256"

    # A key that is present but unusable is an ERROR, not a warning.
    #
    # Warning and continuing produced the asymmetry the review caught: a stale
    # but parseable fingerprint killed the build, while a corrupt key shipped
    # and refused the login on the target. The second is the failure #263 is
    # about, so it gets the louder treatment, not the quieter one.
    if [ -n "$pubkey" ] && ! _sa_is_valid_pubkey "$pubkey"; then
        log_error "service account '$name': public_key is not a usable SSH public key."
        log_error "  got: ${pubkey:0:60}..."
        log_error "  Expected one line: '<type> <base64> [comment]'. Options prefixes"
        log_error "  (restrict,from=...) are stripped automatically; certificates are not"
        log_error "  supported here -- deploy the plain public key."
        return 1
    fi

    if [ -z "$pubkey" ]; then
        # Fingerprint-only. Promised a message here and never emitted one; the
        # branch was dead code. It matters: this is the pre-#263 shape, and the
        # bundle cannot make the account work on its own.
        if [ -n "$fp" ]; then
            log_warn "service account '$name': key_fingerprint without public_key."
            log_warn "  The bundle will deploy service-accounts.conf but no"
            log_warn "  /etc/open-bastion/service-accounts.d/$name.pub, so sshd has no key to"
            log_warn "  offer and the account cannot log in until you deploy one by hand."
            log_warn "  Add public_key or public_key_file to have this handled for you."
        fi
        return 0
    fi

    # Derive in the same algorithm the operator used, so an existing MD5 entry
    # can gain a public_key without the cross-check declaring both values stale.
    # is_valid_fingerprint, the questionnaire and src/service_account.c all still
    # accept MD5; refusing it here would have made this PR's own remediation
    # ("add the key") impossible for those entries.
    case "$fp" in
        MD5:*) want_alg="md5" ;;
    esac

    if ! derived=$(_sa_fingerprint_of "$pubkey" "$want_alg"); then
        log_error "service account '$name': could not compute the fingerprint of public_key."
        log_error "  ssh-keygen rejected it, or is not installed on this build host."
        log_error "  Refusing rather than shipping a key nothing has validated: on the"
        log_error "  target that is a login refused with everything looking deployed."
        return 1
    fi

    if [ -z "$fp" ]; then
        fp="$derived"
        log_info "service account '$name': fingerprint derived from public_key ($fp)."
        return 0
    fi
    if [ "$fp" != "$derived" ]; then
        log_error "service account '$name': key_fingerprint does not match public_key."
        log_error "  configured: $fp"
        log_error "  actual:     $derived"
        log_error "  One of the two is stale. On the target this is a login refused by PAM"
        log_error "  with a key that looks correct everywhere you would think to check."
        return 1
    fi
}
# Validate one packed record. Mirrors the authoritative checks in
# src/service_account.c so a bad value is caught at build time rather than
# failing the PAM module load on the target.
validate_service_account_record() {
    local rec="$1"
    local name fp sudo_allowed sudo_nopasswd shell home uid gid
    name=$(_sa_field 1 "$rec");          fp=$(_sa_field 2 "$rec")
    sudo_allowed=$(_sa_field 3 "$rec");   sudo_nopasswd=$(_sa_field 4 "$rec")
    shell=$(_sa_field 5 "$rec");          home=$(_sa_field 6 "$rec")
    uid=$(_sa_field 8 "$rec");            gid=$(_sa_field 9 "$rec")

    is_valid_service_username "$name" || { log_error "Invalid service-account name: '$name'"; return 1; }
    is_valid_fingerprint "$fp"        || { log_error "Invalid key_fingerprint for '$name' (must be SHA256:… or MD5:…): '$fp'"; return 1; }
    case "$sudo_allowed"  in true|false) ;; *) log_error "service account '$name': sudo_allowed must be true/false"; return 1 ;; esac
    case "$sudo_nopasswd" in true|false) ;; *) log_error "service account '$name': sudo_nopasswd must be true/false"; return 1 ;; esac
    is_valid_abs_path "$shell" || { log_error "service account '$name': shell must be an absolute path: '$shell'"; return 1; }
    is_valid_abs_path "$home"  || { log_error "service account '$name': home must be an absolute path: '$home'"; return 1; }
    if [ -n "$uid" ] && ! [[ "$uid" =~ ^[0-9]+$ ]]; then log_error "service account '$name': uid must be numeric: '$uid'"; return 1; fi
    if [ -n "$gid" ] && ! [[ "$gid" =~ ^[0-9]+$ ]]; then log_error "service account '$name': gid must be numeric: '$gid'"; return 1; fi
    return 0
}

# Warn (non-fatal) when a service account's home/shell falls outside the module
# defaults: pam_openbastion silently DROPS such an account at load unless the
# target widens approved_home_prefixes / approved_shells in openbastion.conf.
warn_service_account_unapproved() {
    local rec="$1"
    local name home shell uid gid pfx ok
    name=$(_sa_field 1 "$rec"); shell=$(_sa_field 5 "$rec"); home=$(_sa_field 6 "$rec")
    uid=$(_sa_field 8 "$rec"); gid=$(_sa_field 9 "$rec")
    # Field 10 too. This function's contract is "a bad value is caught at build
    # time rather than failing on the target", and a record built anywhere other
    # than _sa_flush -- the interactive loop, a future caller -- would otherwise
    # reach the deployment with a key nothing had looked at.
    local pub
    pub=$(_sa_field 10 "$rec")
    if [ -n "$pub" ] && ! _sa_is_valid_pubkey "$pub"; then
        log_error "service account '$name': public_key is not a usable SSH public key."
        return 1
    fi
    # Reserved system name: still accepted, but the existing account is used as-is
    # (the config's shell/home/uid apply only to accounts ob-bastion creates).
    for pfx in $_OB_SA_SYSTEM_NAMES; do
        if [ "$name" = "$pfx" ]; then
            log_warn "service account '$name' is a well-known system account. It is still accepted"
            log_warn "  (matched by key fingerprint), but the EXISTING local account is used as-is —"
            log_warn "  its shell/home/uid are NOT overridden by this config. Many system accounts use"
            log_warn "  /usr/sbin/nologin, which breaks the login. Prefer a dedicated name (e.g. ob$name),"
            log_warn "  or ensure '$name' already has a usable login shell on the target."
            break
        fi
    done
    # NSS (libnss_openbastion) only synthesizes a service account when it has a
    # FIXED uid AND gid; sshd's pre-auth getpwnam then succeeds. Without them the
    # account is unreachable over SSH unless it already exists as a local user.
    if [ -z "$uid" ] || [ "$uid" = 0 ] || [ -z "$gid" ] || [ "$gid" = 0 ]; then
        log_warn "service account '$name': no fixed uid/gid. NSS cannot resolve it pre-auth, so"
        log_warn "  it is reachable over SSH only if the account already exists locally on the target."
        log_warn "  Set both 'uid' and 'gid' for a self-contained, fleet-consistent service account."
    fi
    if [ -n "$home" ]; then
        ok=0
        for pfx in $_OB_SA_DEFAULT_HOME_PREFIXES; do
            case "$home" in "$pfx"/*) ok=1; break ;; esac
        done
        if [ "$ok" -ne 1 ]; then
            log_warn "service account '$name': home '$home' is outside the default approved prefixes ($_OB_SA_DEFAULT_HOME_PREFIXES)."
            log_warn "  pam_openbastion will DROP this account unless the target's openbastion.conf sets e.g.:"
            log_warn "    approved_home_prefixes = /home:/var/home:${home%/*}"
        fi
    fi
    if [ -n "$shell" ]; then
        ok=0
        for pfx in $_OB_SA_DEFAULT_SHELLS; do
            [ "$shell" = "$pfx" ] && { ok=1; break; }
        done
        if [ "$ok" -ne 1 ]; then
            log_warn "service account '$name': shell '$shell' is not in the default approved shells."
            log_warn "  Set 'approved_shells' in the target's openbastion.conf or the account will be dropped."
        fi
    fi
}

# Parse the `service_accounts:` block of a YAML config file into
# SERVICE_ACCOUNTS_RECORDS. Independent of yq (the flat parsers can't read a
# list). Recognises the documented block-list form:
#
#   service_accounts:
#     - name: ansible
#       key_fingerprint: "SHA256:…"
#       sudo_allowed: true
#       shell: /bin/bash
#       home: /var/lib/ansible
#       gecos: Ansible Automation
#
# A `- name:` line opens a new account; subsequent more-indented `key: value`
# lines add fields; a line at the block's indent or shallower (or another
# top-level key) ends the block.
_parse_service_accounts_block() {
    local f="$1"
    local in_block=0 line key val
    local name fp sudo_allowed sudo_nopasswd shell home gecos uid gid pubkey
    local _sa_key_conflict=0
    _sa_reset_fields() { name=""; fp=""; sudo_allowed="false"; sudo_nopasswd="false"; shell=""; home=""; gecos=""; uid=""; gid=""; pubkey=""; _sa_key_conflict=0; }
    local have_acct=0
    _sa_flush() {
        [ "$have_acct" = 1 ] || return 0
        # Both public_key and public_key_file: which one wins was decided by
        # line order, silently. An operator rotating a key by adding the new
        # form above the old one would have shipped the OLD key -- and, with a
        # fingerprint matching the intended one, been told the value that was
        # actually shipped is the "stale" one.
        if [ "$_sa_key_conflict" = 1 ]; then
            log_error "service account '$name': both public_key and public_key_file are set."
            log_error "  Which one wins would depend on their order in the file. Keep one."
            exit 1
        fi

        # A key/fingerprint mismatch stops the build. Not a warning: the bundle
        # would install cleanly and refuse the login on the target, which is the
        # most expensive place to discover it. Explicit rather than relying on
        # errexit, whose behaviour here depends on the calling context.
        _sa_reconcile_key || exit 1
        SERVICE_ACCOUNTS_RECORDS+=("$(_sa_pack "$name" "$fp" "$sudo_allowed" "$sudo_nopasswd" "$shell" "$home" "$gecos" "$uid" "$gid" "$pubkey")")
        have_acct=0
    }
    _sa_reset_fields

    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        case "$line" in
            ''|\#*) continue ;;
        esac
        if [ "$in_block" = 0 ]; then
            [[ "$line" =~ ^service_accounts[[:space:]]*:[[:space:]]*$ ]] && in_block=1
            continue
        fi
        # In block. A non-indented line ends it.
        if [[ "$line" =~ ^[^[:space:]] ]]; then
            _sa_flush
            in_block=0
            continue
        fi
        # New list item: "- name: value"
        if [[ "$line" =~ ^[[:space:]]*-[[:space:]]*name[[:space:]]*:[[:space:]]*(.*)$ ]]; then
            _sa_flush
            _sa_reset_fields
            have_acct=1
            val="${BASH_REMATCH[1]}"
            val=$(_sa_unquote "$val")
            name="$val"
            continue
        fi
        # Field line: "  key: value"
        if [[ "$line" =~ ^[[:space:]]+([a-zA-Z_]+)[[:space:]]*:[[:space:]]*(.*)$ ]]; then
            key="${BASH_REMATCH[1]}"
            val=$(_sa_unquote "${BASH_REMATCH[2]}")
            case "$key" in
                name)            name="$val" ;;
                key_fingerprint|fingerprint) fp="$val" ;;
                sudo_allowed)    sudo_allowed=$(_sa_normbool "$val") ;;
                sudo_nopasswd)   sudo_nopasswd=$(_sa_normbool "$val") ;;
                shell)           shell="$val" ;;
                home)            home="$val" ;;
                gecos)           gecos="$val" ;;
                uid)             uid="$val" ;;
                gid)             gid="$val" ;;
                public_key)
                    [ -z "$pubkey" ] || { _sa_key_conflict=1; }
                    pubkey=$(_sa_strip_key_options "$val")
                    ;;
                public_key_file)
                    # Read at BUILD time: the target has no access to the
                    # builder's filesystem, and shipping a path would be a
                    # promise the installer cannot keep.
                    #
                    # Resolved against the CONFIG FILE's directory, not the
                    # builder's cwd. The documented example is relative
                    # ("keys/ci.pub"), and resolving it from wherever the build
                    # was launched made a correct config fail depending on the
                    # caller's directory.
                    [ -z "$pubkey" ] || { _sa_key_conflict=1; }
                    local _kf="$val"
                    case "$_kf" in
                        /*) ;;
                        *) _kf="$(dirname "$f")/$val" ;;
                    esac
                    if [ -r "$_kf" ]; then
                        pubkey=$(_sa_strip_key_options "$(head -n1 "$_kf")")
                    else
                        log_error "service account '$name': public_key_file '$val' is not readable."
                        log_error "  looked for: $_kf (relative paths resolve against the config file)"
                        log_error "  Refusing: continuing would ship the account without its key, which"
                        log_error "  is the state #263 was reported for."
                        exit 1
                    fi
                    ;;
            esac
        fi
    done < "$f"
    _sa_flush
    return 0
}

# Strip a YAML inline comment (" #…"), surrounding whitespace and matching quotes.
_sa_unquote() {
    local v="$1"
    v="${v%% #*}"
    v="${v#"${v%%[![:space:]]*}"}"
    v="${v%"${v##*[![:space:]]}"}"
    case "$v" in
        \"*\") v="${v#\"}"; v="${v%\"}" ;;
        \'*\') v="${v#\'}"; v="${v%\'}" ;;
    esac
    printf '%s' "$v"
}

# Normalise a YAML boolean-ish value to true/false.
_sa_normbool() {
    case "$1" in
        true|True|TRUE|yes|Yes|YES|1)  printf 'true' ;;
        *)                              printf 'false' ;;
    esac
}

# Render SERVICE_ACCOUNTS_RECORDS into service-accounts.conf INI text on stdout.
# key_fingerprint, sudo_allowed and sudo_nopasswd are always emitted; gecos /
# shell / home / uid / gid only when set (uid/gid only when non-zero).
_render_service_accounts_conf() {
    local rec name fp sudo_allowed sudo_nopasswd shell home gecos uid gid
    printf '# Open Bastion service accounts\n'
    printf '# Generated by ob-builder %s on %s\n' "$VERSION" "$BUILD_DATE"
    printf '# SSH-key-only local accounts (no OIDC). See ob-builder(1) and doc/service-accounts.rst.\n'
    for rec in "${SERVICE_ACCOUNTS_RECORDS[@]}"; do
        name=$(_sa_field 1 "$rec");          fp=$(_sa_field 2 "$rec")
        sudo_allowed=$(_sa_field 3 "$rec");   sudo_nopasswd=$(_sa_field 4 "$rec")
        shell=$(_sa_field 5 "$rec");          home=$(_sa_field 6 "$rec")
        gecos=$(_sa_field 7 "$rec")
        uid=$(_sa_field 8 "$rec");            gid=$(_sa_field 9 "$rec")
        printf '\n[%s]\n' "$name"
        printf 'key_fingerprint = %s\n' "$fp"
        printf 'sudo_allowed = %s\n' "$sudo_allowed"
        printf 'sudo_nopasswd = %s\n' "$sudo_nopasswd"
        [ -n "$gecos" ] && printf 'gecos = %s\n' "$gecos"
        [ -n "$shell" ] && printf 'shell = %s\n' "$shell"
        [ -n "$home" ]  && printf 'home = %s\n' "$home"
        [ -n "$uid" ] && [ "$uid" != 0 ] && printf 'uid = %s\n' "$uid"
        [ -n "$gid" ] && [ "$gid" != 0 ] && printf 'gid = %s\n' "$gid"
    done
    # Explicit success: the loop's last command is a `&&` chain that is false
    # whenever the final account has no gid (the common case), which would make
    # this function return non-zero and trip `set -e` in the caller.
    return 0
}

# Render the service-account public keys as "<name> <key>" lines, one per
# account that has one. The installer writes each to
# /etc/open-bastion/service-accounts.d/<name>.pub, which is what lets sshd
# accept the key at all -- service-accounts.conf only says what to expect.
_render_service_account_keys() {
    local rec name pub
    for rec in "${SERVICE_ACCOUNTS_RECORDS[@]}"; do
        name=$(_sa_field 1 "$rec")
        pub=$(_sa_field 10 "$rec")
        [ -n "$pub" ] || continue
        printf '%s %s\n' "$name" "$pub"
    done
    return 0
}

# Interactively collect service accounts into SERVICE_ACCOUNTS_RECORDS. Loops
# until the admin declines to add another. Each field is validated on entry.
collect_service_accounts_interactive() {
    explain "Service accounts are SSH-key-only local accounts (no SSO), e.g. 'ansible' or 'backup'. They are matched by the SSH key fingerprint and created automatically on the target. Leave this off if you don't need any."
    ask_yesno "Define service accounts on this target?" "n" || return 0

    while :; do
        local name fp sudo_allowed="false" sudo_nopasswd="false" shell home gecos uid gid rec
        while :; do
            name=$(ask "  Account name (lowercase; empty to finish)" "")
            [ -z "$name" ] && return 0
            is_valid_service_username "$name" && break
            log_warn "Invalid name. Start with a lowercase letter or '_', then [a-z0-9_-]."
        done
        while :; do
            explain "Get it with: ssh-keygen -lf key.pub  → use the 'SHA256:…' field."
            fp=$(ask "  SSH key fingerprint (SHA256:… or MD5:…)" "")
            is_valid_fingerprint "$fp" && break
            log_warn "Invalid fingerprint. Must start with SHA256: or MD5: and be base64-ish."
        done
        ask_yesno "  Allow sudo for '$name'?" "n" && sudo_allowed="true"
        if [ "$sudo_allowed" = "true" ]; then
            ask_yesno "  Sudo without password (NOPASSWD)?" "n" && sudo_nopasswd="true"
        fi
        while :; do
            gecos=$(ask "  Description / GECOS (optional)" "")
            # Checked now: the saved config would otherwise refuse it after
            # the whole questionnaire.
            [ -z "$gecos" ] || _yaml_str "$gecos" >/dev/null && break
            log_warn "Avoid control characters, ' #', and mixing both quote kinds."
        done
        while :; do
            shell=$(ask "  Login shell (optional, absolute path)" "")
            is_valid_abs_path "$shell" && break
            log_warn "Shell must be an absolute path (e.g. /bin/bash) or empty."
        done
        while :; do
            home=$(ask "  Home directory (optional, absolute path)" "")
            is_valid_abs_path "$home" && break
            log_warn "Home must be an absolute path (e.g. /var/lib/$name) or empty."
        done
        explain "Set a fixed uid+gid for an SSH-reachable account: NSS resolves it only when both are set (sshd checks the user before auth). Leave empty only if the account already exists locally on the target."
        uid=$(ask "  Fixed UID (recommended; empty = auto)" "")
        gid=$(ask "  Fixed GID (recommended; empty = auto)" "")

        # Ten fields, like the YAML path: a 9-field record leaves field 10
        # undefined rather than empty, and every consumer would have to know it.
        # The questionnaire does not ask for a key yet, so it is empty here --
        # and that is exactly the shape worth warning about.
        rec=$(_sa_pack "$name" "$fp" "$sudo_allowed" "$sudo_nopasswd" "$shell" "$home" "$gecos" "$uid" "$gid" "")
        log_warn "service account '$name': no public key given."
        log_warn "  The bundle will deploy service-accounts.conf but no"
        log_warn "  /etc/open-bastion/service-accounts.d/$name.pub, so sshd has no key to"
        log_warn "  offer and the account cannot log in until you deploy one by hand."
        log_warn "  Use --config with public_key_file to have this handled for you."
        if validate_service_account_record "$rec"; then
            SERVICE_ACCOUNTS_RECORDS+=("$rec")
            log_info "Added service account '$name' (${#SERVICE_ACCOUNTS_RECORDS[@]} total)."
        else
            log_warn "Service account '$name' rejected; not added."
        fi
        ask_yesno "Add another service account?" "n" || break
    done
}

# ─────────────────────────────────────────────────────────────────────────
# Interactive questionnaire. Each answer is also validated.
# ─────────────────────────────────────────────────────────────────────────
run_questionnaire() {
    log_step "Open Bastion deployment questionnaire"

    cat <<'EOF'

This wizard generates a self-contained deployment artefact (shell script and/or
Ansible role) that an administrator can later push to one or more target servers
to install and configure Open Bastion against a LemonLDAP::NG SSO.

Each question is preceded by a short explanation. You can press Enter to accept
the default shown in square brackets. Nothing is written until every answer is
collected and validated.

EOF

    # q1. Slug
    while :; do
        if [ -z "$DEPLOYMENT_SLUG" ]; then
            explain "Short label used only to name generated files (e.g. bootstrap-<slug>-<role>.sh)."
            DEPLOYMENT_SLUG=$(ask "Deployment slug (lowercase, [a-z0-9-])" "")
        fi
        if is_valid_slug "$DEPLOYMENT_SLUG"; then
            break
        fi
        log_warn "Invalid slug. Use only lowercase letters, digits and dashes."
        DEPLOYMENT_SLUG=""
    done

    # q1b. Outputs, unless one was given on the CLI.
    if [ -z "$OUTPUT_SHELL" ] && [ -z "$OUTPUT_ANSIBLE" ]; then
        explain "A shell installer is one self-extracting script to run on each target, written as bootstrap-${DEPLOYMENT_SLUG}-<role>.sh in the directory you give. An Ansible role deploys a fleet from a playbook. With several target roles (asked below), each role tree gets the role as suffix."
        local _kind _err
        _kind=$(ask_choice "Artefacts to generate" "shell|ansible|both" "shell")
        case "$_kind" in
            shell|both)
                while :; do
                    OUTPUT_SHELL=$(ask "Shell installer directory" ".")
                    _err=$(check_output_shell_dir "$OUTPUT_SHELL") && break
                    log_warn "$_err"
                done
                ;;
        esac
        case "$_kind" in
            ansible|both) OUTPUT_ANSIBLE=$(ask "Ansible role directory" "./ansible-${DEPLOYMENT_SLUG}") ;;
        esac
    fi

    # q2. Scenario
    while :; do
        if [ -z "$SCENARIO" ]; then
            explain "Choose the strictness of SSH authentication on the target. Maximum security is recommended for production: it accepts only LLNG-signed SSH certificates, requires a fresh LLNG token to use sudo, and enforces a key revocation list."
            SCENARIO=$(ask_choice "Security scenario" \
                "token-only|token+unix|keys+llng|mixed|max-security" \
                "max-security")
        fi
        if is_valid_scenario "$SCENARIO"; then
            break
        fi
        log_warn "Invalid scenario: $SCENARIO"
        SCENARIO=""
    done
    PAM_MODE=$(scenario_to_pam_mode "$SCENARIO")

    # q3. SSO URL
    while :; do
        if [ -z "$PORTAL_URL" ]; then
            explain "LemonLDAP::NG portal root. Validated now via OIDC discovery; SSH CA fetched from it."
            PORTAL_URL=$(ask "LLNG portal (SSO) URL" "")
        fi
        # Strip trailing slash.
        PORTAL_URL="${PORTAL_URL%/}"

        if ! is_valid_url "$PORTAL_URL"; then
            log_warn "Invalid URL: $PORTAL_URL"
            PORTAL_URL=""
            continue
        fi
        if [[ "$PORTAL_URL" != https://* ]] && [ "$INSECURE" -ne 1 ]; then
            explain "This portal is plain HTTP. The targets can only use it with TLS verification disabled (verify_ssl = false, ob-enroll/setup -k), exactly as with --insecure. Never do this in production."
            if ask_yesno "Use plain HTTP and disable TLS verification on targets? (test setups only)" "n"; then
                INSECURE=1
                export OB_BUILDER_INSECURE=1
            else
                PORTAL_URL=""
                continue
            fi
        fi
        break
    done

    # q4. client_id + policy
    if [ -z "$CLIENT_ID_POLICY" ]; then
        explain "Choose whether the client_id you provide is locked into the artefact, or whether the local admin on the target can override it at install time with --client-id."
        CLIENT_ID_POLICY=$(ask_choice "client_id policy" "fixed|modifiable" "modifiable")
    fi
    if [ -z "$CLIENT_ID" ]; then
        explain "OIDC client_id registered in LLNG (matches the 'pam-access' RP by default)."
        CLIENT_ID=$(ask "OIDC client_id (empty = no default)" "pam-access")
    fi
    if ! is_valid_client_id "$CLIENT_ID"; then
        die "Invalid client_id: $CLIENT_ID"
    fi

    # q5. client_secret mode
    if [ -z "$CLIENT_SECRET_MODE" ]; then
        explain "How the OIDC client_secret reaches the target. With 'none' the relying party is public (no secret). With 'prompt' the admin types the secret on each target server (recommended). With 'embedded' the secret is baked into the artefact in clear text — convenient but anyone who can read the artefact can read the secret, so distribute it only through a channel at least as confidential as the secret itself."
        CLIENT_SECRET_MODE=$(ask_choice "client_secret mode" \
            "none|prompt|embedded" "prompt")
    fi
    case "$CLIENT_SECRET_MODE" in
        none|prompt) ;;
        embedded)
            if [ -z "$EMBEDDED_CLIENT_SECRET" ]; then
                log_warn "Embedding the client_secret in the artefact in clear text."
                log_warn "Anyone with read access to the artefact can read this secret."
                EMBEDDED_CLIENT_SECRET=$(ask_secret_confirm "OIDC client_secret to embed")
            fi
            ;;
        *) die "Invalid client_secret_mode: $CLIENT_SECRET_MODE" ;;
    esac

    # q6. server_group + policy
    if [ -z "$SERVER_GROUP_POLICY" ]; then
        explain "Choose whether the default server_group you provide is locked into the artefact, or whether the local admin on the target can override it at install time with --server-group."
        SERVER_GROUP_POLICY=$(ask_choice "server_group policy" "fixed|modifiable" "modifiable")
    fi
    if [ -z "${SERVER_GROUP-}" ]; then
        explain "Group name configured in LLNG (pamAccessServerGroups). Leave empty for per-host override."
        SERVER_GROUP=$(ask "Default server_group (empty = no default, must be provided on target)" "")
    fi
    if ! is_valid_server_group "$SERVER_GROUP"; then
        die "Invalid server_group: $SERVER_GROUP"
    fi
    # A fixed-policy with empty value is non-sensical: the artefact would
    # carry no group AND refuse override.
    if [ "$SERVER_GROUP_POLICY" = "fixed" ] && [ -z "$SERVER_GROUP" ]; then
        die "server_group_policy=fixed requires a non-empty server_group"
    fi

    # q7. Target role(s). A preset role (config) or --bundle keeps a single one.
    if [ -n "$TARGET_ROLE" ] || [ "$BUNDLE" = "1" ]; then
        while :; do
            if [ -z "$TARGET_ROLE" ]; then
                explain "Pick what this artefact configures: a bastion (jump host accepting SSH from users), a backend (server reached only through a bastion), or a standalone host (isolated server with no bastion in front)."
                TARGET_ROLE=$(ask_choice "Target role" "bastion|standalone|backend" "bastion")
            fi
            if is_valid_target_role "$TARGET_ROLE"; then
                break
            fi
            log_warn "Invalid target role: $TARGET_ROLE"
            TARGET_ROLE=""
        done
        TARGET_ROLES=("$TARGET_ROLE")
    else
        collect_target_roles_interactive
    fi

    # q7b. (backend only) Allowed bastions whitelist
    # The bastion JWT is signed by the LLNG SSO itself, so the SSO identity is
    # already covered by bastion_jwt_issuer. What the backend can additionally
    # enforce is which specific bastion(s) (sub claim / bastion_id) are
    # permitted to forward sessions to it. Empty = accept any LLNG-enrolled
    # bastion in the same group.
    if _has_role backend && [ -z "${ALLOWED_BASTIONS-}" ]; then
        explain "Optional whitelist of bastion identifiers (the 'bastion_id' claim LLNG embeds in each bastion's JWT) that are allowed to reach this backend. Comma-separated, e.g. 'bastion-01,bastion-02'. Leave empty to accept any bastion enrolled in the same LLNG server group as this backend. You don't pick this value — LLNG assigns it at enrollment. To discover it: deploy the bastion first, then run 'sudo ob-bastion-id' on it (or check the LLNG Manager). You can also leave this empty now and tighten it later by editing /etc/open-bastion/openbastion.conf on the backend."
        ALLOWED_BASTIONS=$(ask "Allowed bastion ids (empty = any)" "")
    fi

    # q7c. Optional opt-in features: system hardening, audit trace, and
    # (bastion/standalone only) whether to OPT OUT of session recording.
    # Hardening and audit-trace are intrusive/system-wide, so they default to
    # OFF and must be opted into (see SECURITY.md). Session recording is a core
    # bastion guarantee: it stays ON unless explicitly disabled here. Backends
    # never record sessions, so the recorder question is skipped for them.
    if [ -z "$ENABLE_HARDENING" ]; then
        explain "System containment hardening applies logind KillUserProcesses, an nproc cap, at/cron allow-lists and masks atd on the target. It changes system-wide behaviour, so it is OFF by default — enable it only on hosts dedicated to this role."
        ENABLE_HARDENING=$(ask_choice "Enable system containment hardening (--enable-hardening)?" "yes|no" "no")
    fi
    if [ -z "$ENABLE_AUDIT_TRACE" ]; then
        explain "Audit trace installs auditd rules and a daily rotation timer on the target (requires the auditd package). OFF by default."
        ENABLE_AUDIT_TRACE=$(ask_choice "Enable primary audit trace via auditd (--enable-audit-trace)?" "yes|no" "no")
    fi
    if _has_non_backend_role && [ -z "$DISABLE_SESSION_RECORDER" ]; then
        explain "A bastion records every session by default (sshd ForceCommand -> ob-session-recorder). Disable this only when session capture is handled by another mechanism — turning it off weakens the audit guarantee. Backends never record sessions, so this does not apply to them."
        DISABLE_SESSION_RECORDER=$(ask_choice "Disable session recording on this bastion/standalone (--disable-session-recorder)?" "yes|no" "no")
    fi

    # q7d. Service accounts (SSH-key-only local accounts). Applies to every role.
    # Only prompt when none were supplied (e.g. via a partial config); a config
    # that already defined service_accounts skips the interactive loop.
    if [ "${#SERVICE_ACCOUNTS_RECORDS[@]}" -eq 0 ]; then
        collect_service_accounts_interactive
    fi

    # q8. Auto-launch enroll/setup
    if [ -z "$AUTO_ENROLL_SETUP" ]; then
        explain "Once the configs are deposited and the open-bastion package is installed, the target still needs to run ob-enroll then ob-*-setup. Choose whether the installer runs them automatically, skips them entirely, or asks the admin before each step."
        AUTO_ENROLL_SETUP=$(ask_choice "Auto-launch enroll/setup on target?" "yes|no|prompt" "prompt")
    fi
    case "$AUTO_ENROLL_SETUP" in
        yes|no|prompt) ;;
        *) die "Invalid auto_enroll_setup: $AUTO_ENROLL_SETUP" ;;
    esac

    # q9. Self-delete after deployment (shell only — irrelevant for Ansible)
    if [ -z "$SELF_DELETE" ]; then
        local _default="no"
        [ "$CLIENT_SECRET_MODE" = "embedded" ] && _default="yes"
        explain "Once the installer finishes successfully on the target, should it remove itself from disk? Useful when the client_secret is embedded so the artefact does not linger after deployment. Does not apply to the Ansible role."
        SELF_DELETE=$(ask_choice "Self-delete the shell installer after success?" "yes|no" "$_default")
    fi
    case "$SELF_DELETE" in
        yes|no) ;;
        *) die "Invalid self_delete: $SELF_DELETE" ;;
    esac

    # q10. (Ansible only) Offer auto-approval of the device code via an LLNG cookie
    # Only asked when the user requested an Ansible output — the shell installer
    # is designed for one machine at a time, where a manual browser approval is
    # acceptable. Ansible deploys to fleets, where it's the value-add.
    if [ -n "$OUTPUT_ANSIBLE" ] && [ -z "$ANSIBLE_AUTO_APPROVE" ]; then
        explain "When enabled, the generated Ansible role can approve the device code automatically by POSTing to LLNG with a session cookie. The cookie is asked for at every play run (vars_prompt) and never stored. Disable if you prefer manual browser approval, or if your operators don't have permission to run the LLNG verification endpoint."
        ANSIBLE_AUTO_APPROVE=$(ask_choice "Enable Ansible auto-approval via LLNG cookie?" "yes|no" "no")
    fi

    # q11. Package repository and signing, unless given on the CLI.
    collect_repo_options_interactive

    # q12. Keep the answers for --config (#311).
    collect_save_config_interactive
}

# Offer to save the answers as a --config YAML, unless --save-config gave the
# path (an explicit choice, not re-checked); then, for an embedded secret,
# whether the file may carry it. A path typed at the prompt that already exists
# is only reused after confirmation: that file is meant to be completed by hand.
collect_save_config_interactive() {
    if [ -z "$SAVE_CONFIG" ]; then
        explain "The answers, and the defaults of everything not asked, can be saved as a YAML file. 'ob-builder --config FILE' then replays them without any question, e.g. for the next deployment or in CI."
        ask_yesno "Save these answers as a YAML config?" "y" || return 0
        SAVE_CONFIG=$(ask "Config file path" "./ob-builder-${DEPLOYMENT_SLUG}.yml")
        # Re-entered below after a refused path, then with no default so that
        # Enter skips the save instead of naming the same file again.
        while :; do
            [ -n "$SAVE_CONFIG" ] || return 0
            if [ -d "$SAVE_CONFIG" ]; then
                log_warn "$SAVE_CONFIG is a directory; give a file path."
            elif [ -e "$SAVE_CONFIG" ]; then
                # The default path is the same on every run for a given slug, and
                # the README tells the operator to complete that file by hand
                # (the commented embedded_client_secret / public_key_file
                # lines): never replace it without a word.
                if ask_yesno "$SAVE_CONFIG exists; overwrite it?" "n"; then
                    break
                fi
                log_warn "$SAVE_CONFIG left as it is."
            else
                break
            fi
            # ask and ask_yesno answer their defaults without asking in this
            # mode, so the re-ask below would spin: decline the save instead.
            if [ "${OB_BUILDER_NON_INTERACTIVE:-}" = "1" ]; then
                if [ -d "$SAVE_CONFIG" ]; then
                    # save_config refuses a directory, so do not suggest it.
                    log_warn "Not saving the answers: $SAVE_CONFIG is a directory. Pass --save-config FILE."
                else
                    log_warn "Not saving the answers; pass --save-config \"$SAVE_CONFIG\" to replace it."
                fi
                SAVE_CONFIG=""
                return 0
            fi
            SAVE_CONFIG=$(ask "Another path (empty to skip saving the answers)" "")
        done
    fi
    if [ "$CLIENT_SECRET_MODE" = "embedded" ]; then
        explain "Without the client_secret, the saved config needs embedded_client_secret added back by hand before --config accepts it. With it, the file holds the secret in clear (written 0600) and must be kept as confidential as the artefacts."
        ask_yesno "Write the client_secret in clear into the saved config?" "n" && SAVE_CONFIG_SECRET=1
    fi
    return 0
}

# True when role $1 is among TARGET_ROLES.
_has_role() {
    local r
    for r in "${TARGET_ROLES[@]}"; do
        [ "$r" = "$1" ] && return 0
    done
    return 1
}

# True when at least one role records sessions (bastion or standalone).
_has_non_backend_role() {
    local r
    for r in "${TARGET_ROLES[@]}"; do
        [ "$r" != "backend" ] && return 0
    done
    return 1
}

# Interactively pick one or more target roles into TARGET_ROLES.
collect_target_roles_interactive() {
    local r
    explain "Pick what this artefact configures: a bastion (jump host accepting SSH from users), a backend (server reached only through a bastion), or a standalone host (isolated server with no bastion in front)."
    TARGET_ROLE=$(ask_choice "Target role" "bastion|standalone|backend" "bastion")
    TARGET_ROLES=("$TARGET_ROLE")
    explain "Other roles can be generated in the same run, sharing every other answer. Each gets its own artefact, suffixed with the role."
    while [ "${#TARGET_ROLES[@]}" -lt 3 ]; do
        r=$(ask "Another target role (bastion|standalone|backend, empty to finish)" "")
        [ -z "$r" ] && break
        if ! is_valid_target_role "$r"; then
            log_warn "Invalid target role: $r"
        elif _has_role "$r"; then
            log_warn "Role '$r' already selected"
        else
            TARGET_ROLES+=("$r")
        fi
    done
    return 0
}

# Interactively ask the APT repository and signing options still at their
# defaults (i.e. not given on the CLI).
collect_repo_options_interactive() {
    local v
    if [ "$APT_URL_SET" = 0 ] || [ "$APT_SUITE_SET" = 0 ] || [ "$APT_COMPONENT_SET" = 0 ] || [ "$REPO_KEYRING_SET" = 0 ]; then
        explain "Targets install the open-bastion package from this APT repository. Keep the defaults unless you publish the packages from your own mirror."
    fi
    if [ "$APT_URL_SET" = 0 ]; then
        while :; do
            v=$(ask "APT repository URL" "$APT_URL")
            v="${v%/}"
            is_valid_url "$v" && break
            log_warn "Invalid URL: $v"
        done
        APT_URL="$v"
    fi
    if [ "$APT_SUITE_SET" = 0 ]; then
        while :; do
            v=$(ask "APT suite" "$APT_SUITE")
            is_valid_apt_suite "$v" && break
            log_warn "Invalid suite (letters, digits, '.', '_', '-' and '/' only): $v"
        done
        APT_SUITE="$v"
    fi
    if [ "$APT_COMPONENT_SET" = 0 ]; then
        while :; do
            v=$(ask "APT component" "$APT_COMPONENT")
            is_valid_apt_component "$v" && break
            log_warn "Invalid component (space-separated names of letters, digits, '.', '_', '-'): $v"
        done
        APT_COMPONENT="$v"
    fi
    if [ "$REPO_KEYRING_SET" = 0 ]; then
        while :; do
            v=$(ask "APT repository keyring (.gpg)" "${REPO_KEYRING:-$DEFAULT_REPO_KEYRING}")
            [ -f "$v" ] && break
            log_warn "Keyring not found: $v"
        done
        REPO_KEYRING="$v"
    fi
    # Signing applies to the shell installer only.
    if [ "$SIGN_WITH_SET" = 0 ] && [ -n "$OUTPUT_SHELL" ]; then
        explain "Optionally GPG-sign the shell installer (writes a .sig next to it) so targets can verify it before running it."
        while :; do
            v=$(ask "GPG key id to sign with (empty = no signature)" "")
            [ -z "$v" ] && break
            command -v gpg >/dev/null 2>&1 && gpg --list-secret-keys -- "$v" >/dev/null 2>&1 && break
            log_warn "No usable GPG secret key '$v' on this host"
        done
        SIGN_WITH="$v"
    fi
    return 0
}

# Validate / normalise after either YAML or questionnaire so behaviour is
# identical for both paths.
validate_inputs() {
    [ -n "$DEPLOYMENT_SLUG" ]    || die "deployment_slug is required"
    is_valid_slug "$DEPLOYMENT_SLUG" || die "Invalid deployment_slug: $DEPLOYMENT_SLUG"

    [ -n "$SCENARIO" ]           || die "scenario is required"
    is_valid_scenario "$SCENARIO" || die "Invalid scenario: $SCENARIO"
    PAM_MODE=$(scenario_to_pam_mode "$SCENARIO")

    [ -n "$PORTAL_URL" ]         || die "portal_url is required"
    PORTAL_URL="${PORTAL_URL%/}"
    is_valid_url "$PORTAL_URL"   || die "Invalid portal_url: $PORTAL_URL"
    if [[ "$PORTAL_URL" != https://* ]] && [ "$INSECURE" -ne 1 ]; then
        die "Refusing non-HTTPS portal URL (use --insecure for a test setup)"
    fi

    : "${CLIENT_ID_POLICY:=modifiable}"
    case "$CLIENT_ID_POLICY" in fixed|modifiable) ;; *) die "Invalid client_id_policy: $CLIENT_ID_POLICY" ;; esac
    is_valid_client_id "$CLIENT_ID" || die "Invalid client_id: $CLIENT_ID"
    if [ "$CLIENT_ID_POLICY" = "fixed" ] && [ -z "$CLIENT_ID" ]; then
        die "client_id_policy=fixed requires a non-empty client_id"
    fi

    : "${CLIENT_SECRET_MODE:=prompt}"
    case "$CLIENT_SECRET_MODE" in
        none|prompt) ;;
        embedded)
            [ -n "$EMBEDDED_CLIENT_SECRET" ] || die "client_secret_mode=embedded requires embedded_client_secret to be set"
            ;;
        *) die "Invalid client_secret_mode: $CLIENT_SECRET_MODE" ;;
    esac

    : "${SERVER_GROUP_POLICY:=modifiable}"
    case "$SERVER_GROUP_POLICY" in fixed|modifiable) ;; *) die "Invalid server_group_policy: $SERVER_GROUP_POLICY" ;; esac
    is_valid_server_group "$SERVER_GROUP" || die "Invalid server_group: $SERVER_GROUP"
    if [ "$SERVER_GROUP_POLICY" = "fixed" ] && [ -z "$SERVER_GROUP" ]; then
        die "server_group_policy=fixed requires a non-empty server_group"
    fi

    # A config names several roles comma- or space-separated, like the
    # questionnaire picks them: "bastion,backend".
    if [ "${#TARGET_ROLES[@]}" -eq 0 ]; then
        local -a _cfg_roles=()
        IFS=', ' read -r -a _cfg_roles <<< "$TARGET_ROLE"
        TARGET_ROLES=("${_cfg_roles[@]}")
    fi
    [ "${#TARGET_ROLES[@]}" -gt 0 ] || die "target_role is required"
    local _role
    local -A _seen_role=()
    for _role in "${TARGET_ROLES[@]}"; do
        is_valid_target_role "$_role" || die "Invalid target_role: $_role"
        [ -z "${_seen_role[$_role]:-}" ] || die "target_role lists '$_role' twice"
        _seen_role[$_role]=1
    done
    TARGET_ROLE="${TARGET_ROLES[0]}"
    # --bundle adds the companion of ONE role; with several it would generate
    # some role twice, to the same paths.
    if [ "$BUNDLE" = "1" ] && [ "${#TARGET_ROLES[@]}" -gt 1 ]; then
        die "--bundle takes a single target_role (it adds the companion role itself)"
    fi

    # apt_url / apt_suite / apt_component are concatenated into the
    # "deb [signed-by=...] URL SUITE COMPONENT" line and interpolated verbatim
    # into the generated installer.sh, where it is written to
    # /etc/apt/sources.list.d as root. render_template() is a literal
    # substitution that preserves every character, so an unvalidated value
    # containing $(...), backticks, quotes or a newline would execute as root
    # or inject extra sources.list entries at install time. Restrict all three
    # to shell-safe charsets (same invariant as portal_url / allowed_bastions).
    [ -n "$APT_URL" ]            || die "apt_url is required"
    APT_URL="${APT_URL%/}"
    is_valid_url "$APT_URL"      || die "Invalid apt_url: $APT_URL"
    if [[ "$APT_URL" != https://* ]]; then
        log_warn "APT repo URL is not HTTPS: $APT_URL (packages remain GPG-verified via signed-by)"
    fi

    [ -n "$APT_SUITE" ]          || die "apt_suite is required"
    is_valid_apt_suite "$APT_SUITE" \
        || die "Invalid apt_suite (letters, digits, '.', '_', '-' and '/' only): $APT_SUITE"

    [ -n "$APT_COMPONENT" ]      || die "apt_component is required"
    is_valid_apt_component "$APT_COMPONENT" \
        || die "Invalid apt_component (space-separated names of letters, digits, '.', '_', '-'): $APT_COMPONENT"

    # allowed_bastions is embedded verbatim into the generated artefacts (the
    # self-extracting shell installer and the Ansible vars). Restrict it to safe
    # identifier characters so a malicious or typo'd value cannot inject shell
    # metacharacters ($(), backticks, quotes, newlines) into the installer that
    # runs as root. bastion_ids are [A-Za-z0-9._-], separated by comma/space.
    if [ -n "${ALLOWED_BASTIONS:-}" ] && ! [[ "$ALLOWED_BASTIONS" =~ ^[A-Za-z0-9._,\ -]+$ ]]; then
        die "Invalid allowed_bastions (only letters, digits, '.', '_', '-', ',' and spaces allowed): $ALLOWED_BASTIONS"
    fi

    : "${AUTO_ENROLL_SETUP:=prompt}"
    case "$AUTO_ENROLL_SETUP" in yes|no|prompt) ;; *) die "Invalid auto_enroll_setup: $AUTO_ENROLL_SETUP" ;; esac

    if [ -z "$SELF_DELETE" ]; then
        # Default: yes when secret is embedded (don't leave it on disk),
        # otherwise no (safer default — explicit opt-in for destruction).
        [ "$CLIENT_SECRET_MODE" = "embedded" ] && SELF_DELETE="yes" || SELF_DELETE="no"
    fi
    case "$SELF_DELETE" in yes|no) ;; *) die "Invalid self_delete: $SELF_DELETE" ;; esac

    : "${ENABLE_HARDENING:=no}"
    case "$ENABLE_HARDENING" in yes|no) ;; *) die "Invalid enable_hardening: $ENABLE_HARDENING" ;; esac
    : "${ENABLE_AUDIT_TRACE:=no}"
    case "$ENABLE_AUDIT_TRACE" in yes|no) ;; *) die "Invalid enable_audit_trace: $ENABLE_AUDIT_TRACE" ;; esac
    : "${DISABLE_SESSION_RECORDER:=no}"
    case "$DISABLE_SESSION_RECORDER" in yes|no) ;; *) die "Invalid disable_session_recorder: $DISABLE_SESSION_RECORDER" ;; esac
    # (Backend artefacts never carry the opt-out: see build_placeholder_map.)

    : "${ANSIBLE_AUTO_APPROVE:=no}"
    case "$ANSIBLE_AUTO_APPROVE" in yes|no) ;; *) die "Invalid ansible_auto_approve: $ANSIBLE_AUTO_APPROVE" ;; esac

    # The questionnaire checks the key when asked; a config or --sign-with
    # value used to fail only at signing, after the SSO fetch and with the
    # installer already written unsigned.
    if [ -n "$SIGN_WITH" ] && [ -n "$OUTPUT_SHELL" ]; then
        command -v gpg >/dev/null 2>&1 && gpg --list-secret-keys -- "$SIGN_WITH" >/dev/null 2>&1 \
            || die "No usable GPG secret key '$SIGN_WITH' to sign with (in YAML, quote a hex key id: sign_with: \"0x...\")"
    fi

    # Validate every service-account record (covers the YAML config path; the
    # interactive loop validates as it goes). Reject duplicate account names.
    if [ "${#SERVICE_ACCOUNTS_RECORDS[@]}" -gt 0 ]; then
        local _rec _name
        local -A _seen_sa=()
        for _rec in "${SERVICE_ACCOUNTS_RECORDS[@]}"; do
            validate_service_account_record "$_rec" || die "Invalid service account in config"
            warn_service_account_unapproved "$_rec"
            _name=$(_sa_field 1 "$_rec")
            [ -n "${_seen_sa[$_name]:-}" ] && die "Duplicate service account name: $_name"
            _seen_sa[$_name]=1
        done
    fi

    if [ -z "$REPO_KEYRING" ]; then
        if [ -f "$DEFAULT_REPO_KEYRING" ]; then
            REPO_KEYRING="$DEFAULT_REPO_KEYRING"
            log_info "Using default APT repo keyring: $REPO_KEYRING"
        else
            die "Missing --repo-keyring and default not found at $DEFAULT_REPO_KEYRING"
        fi
    fi
    [ -f "$REPO_KEYRING" ] || die "Repo keyring not found: $REPO_KEYRING"
    # (Outputs: checked fail-fast in main() with --config, asked otherwise.)
}

# --output-shell names a directory, ob-builder picks the file names in it. A
# file-name-looking argument (`bootstrap.sh`) is refused rather than turned
# into a directory of that name. Prints the reason and fails when DIR is not
# acceptable.
check_output_shell_dir() {
    local dir="$1"
    [ -d "$dir" ] && return 0
    if [ -e "$dir" ]; then
        printf '%s' "--output-shell takes a directory, and $dir exists but is not one. ob-builder writes bootstrap-<slug>-<role>.sh inside the directory given."
        return 1
    fi
    case "$dir" in
        *.sh)
            printf '%s' "--output-shell takes a directory, not a file name: ob-builder writes bootstrap-<slug>-<role>.sh inside it. Use --output-shell $(dirname -- "$dir") (or another directory) instead of $dir."
            return 1
            ;;
    esac
    return 0
}

shell_installer_path() {
    printf '%s/bootstrap-%s-%s.sh' "${OUTPUT_SHELL%/}" "$DEPLOYMENT_SLUG" "$1"
}

# Artefacts to produce, as parallel arrays (one entry per role). Shell
# installers always carry the role in their name. A single Ansible role tree
# uses the path as given; several get the role as suffix. --bundle adds its
# companion role the same way.
_PLAN_ROLES=()
_PLAN_SHELL=()
_PLAN_ANSIBLE=()
build_output_plan() {
    local r sh an n="${#TARGET_ROLES[@]}"
    _PLAN_ROLES=(); _PLAN_SHELL=(); _PLAN_ANSIBLE=()
    for r in "${TARGET_ROLES[@]}"; do
        sh=""; an="$OUTPUT_ANSIBLE"
        [ -n "$OUTPUT_SHELL" ] && sh=$(shell_installer_path "$r")
        if [ "$n" -gt 1 ] && [ -n "$an" ]; then
            an="${OUTPUT_ANSIBLE%/}-${r}"
        fi
        _PLAN_ROLES+=("$r"); _PLAN_SHELL+=("$sh"); _PLAN_ANSIBLE+=("$an")
    done
    if [ "$BUNDLE" = "1" ]; then
        # Companion of the primary role.
        r="backend"
        [ "$TARGET_ROLE" = "backend" ] && r="bastion"
        sh=""; an=""
        [ -n "$OUTPUT_SHELL" ]   && sh=$(shell_installer_path "$r")
        [ -n "$OUTPUT_ANSIBLE" ] && an="${OUTPUT_ANSIBLE%/}-${r}"
        _PLAN_ROLES+=("$r"); _PLAN_SHELL+=("$sh"); _PLAN_ANSIBLE+=("$an")
    fi
    return 0
}

# Print a recap before doing any work — last chance for the admin to bail.
print_recap() {
    local i r rec="n/a (backend role)" nb=0
    # Bundle: the companion bastion is in _PLAN_ROLES, not TARGET_ROLES
    for r in "${_PLAN_ROLES[@]}"; do [ "$r" != "backend" ] && nb=1; done
    if [ "$nb" = 1 ]; then
        [ "$DISABLE_SESSION_RECORDER" = "yes" ] && rec="disabled (opt-out)" || rec="enabled"
    fi
    log_step "Build summary"
    cat << EOF
  Deployment slug:     $DEPLOYMENT_SLUG
  Scenario:            $SCENARIO  (PAM mode $PAM_MODE)
  Target role(s):      ${TARGET_ROLES[*]}
  Portal URL:          $PORTAL_URL
  client_id:           ${CLIENT_ID:-<empty>}  (policy: $CLIENT_ID_POLICY)
  client_secret_mode:  $CLIENT_SECRET_MODE
  server_group:        ${SERVER_GROUP:-<empty>}  (policy: $SERVER_GROUP_POLICY)
  Auto enroll/setup:   $AUTO_ENROLL_SETUP
  Self-delete (shell): $SELF_DELETE
  Hardening:           $ENABLE_HARDENING
  Audit trace:         $ENABLE_AUDIT_TRACE
  Session recording:   $rec
  Allowed bastions:    ${ALLOWED_BASTIONS:-<any in same group>}
  Service accounts:    $([ "${#SERVICE_ACCOUNTS_RECORDS[@]}" -gt 0 ] && { _names=""; for _r in "${SERVICE_ACCOUNTS_RECORDS[@]}"; do _names="${_names:+$_names, }$(_sa_field 1 "$_r")"; done; echo "$_names"; } || echo "<none>")
  Ansible auto-approve: $ANSIBLE_AUTO_APPROVE
  APT repo:            $APT_URL  (suite=$APT_SUITE component=$APT_COMPONENT)
  Repo keyring:        $REPO_KEYRING
  Sign with:           ${SIGN_WITH:-<none>}
  Save config to:      ${SAVE_CONFIG:-<no>}
  Bundle:              $([ "$BUNDLE" = 1 ] && echo yes || echo no)
  Dry-run:             $([ "$DRY_RUN" = 1 ] && echo yes || echo no)
  TLS verification:    $([ "$INSECURE" = 1 ] && echo "DISABLED (--insecure)" || echo enabled)
EOF
    for ((i=0; i<${#_PLAN_ROLES[@]}; i++)); do
        printf '  %-21sshell=%s  ansible=%s\n' "Output (${_PLAN_ROLES[$i]}):" \
            "${_PLAN_SHELL[$i]:-<none>}" "${_PLAN_ANSIBLE[$i]:-<none>}"
    done
    if [ "$INSECURE" = "1" ]; then
        log_warn "TLS verification is disabled: targets get verify_ssl = false and run ob-enroll/setup with -k."
    fi
    if [ "$CLIENT_SECRET_MODE" = "embedded" ]; then
        log_warn "Embedded client_secret will be written in clear text into every generated artefact."
        log_warn "Treat the resulting files as confidential — anyone who reads them reads the secret."
    fi
}

# ─────────────────────────────────────────────────────────────────────────
# --save-config (#311): the resolved answers as a YAML --config replays.
# ─────────────────────────────────────────────────────────────────────────

# Quote $1 as a YAML scalar that every config reader gets back verbatim: yq,
# and the awk / service-account fallbacks, which strip one pair of quotes but
# neither unescape nor see quotes when cutting an inline comment at " #".
# Double quotes unless the value holds `"` or `\` (escapes there), then
# single quotes; fails for a value no quoting carries through all of them.
# Control characters (but tab) and NEL are refused too: yq folds CR and NEL
# into a space, and rejects the WHOLE file over a C0 byte, DEL or invalid
# UTF-8 -- every key then reads as empty, while awk loads it fine.
_yaml_str() {
    local v="$1" t="${1//$'\t'/}"
    case "$t" in
        *[[:cntrl:]]*|*$'\xc2\x85'*) return 1 ;;
    esac
    printf '%s' "$v" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 || return 1
    case "$v" in
        *' #'*) return 1 ;;
        *\"*|*\\*)
            case "$v" in *\'*) return 1 ;; esac
            printf "'%s'" "$v"
            ;;
        *) printf '"%s"' "$v" ;;
    esac
}

# Print `[indent]key: <quoted value>`, or die naming the key. render_config_yaml
# runs inside $(...), so the die only ends that subshell: save_config's
# `|| die` is what stops the build.
_yaml_kv() {
    local key="$1" q
    q=$(_yaml_str "$2") || die "--save-config: the value of '$key' cannot be written to YAML (control character, ' #', both quote kinds, or not UTF-8); change it or drop --save-config"
    printf '%s%s: %s\n' "${3:-}" "$key" "$q"
}

# The command replaying the saved config, for its header.
_replay_command() {
    local cmd
    cmd="$PROG_NAME --config $(printf '%q' "$1")"
    [ "$BUNDLE" = "1" ] && cmd="$cmd --bundle"
    [ -n "$OUTPUT_SHELL" ]   && cmd="$cmd --output-shell $(printf '%q' "$OUTPUT_SHELL")"
    [ -n "$OUTPUT_ANSIBLE" ] && cmd="$cmd --output-ansible $(printf '%q' "$OUTPUT_ANSIBLE")"
    printf '%s' "$cmd"
}

# The config YAML on stdout. Every key is written, defaults included, with the
# accepted values as comments: that is what makes the file worth keeping.
render_config_yaml() {
    local path="$1" rec name fp sudo_allowed sudo_nopasswd shell home gecos uid gid pub q
    printf '# ob-builder configuration, replayed without any question by:\n'
    printf '#   %s\n' "$(_replay_command "$path")"
    printf '# Generated by ob-builder %s on %s. Every key is written,\n' "$VERSION" "$BUILD_DATE"
    printf '# defaults included. Output paths, --bundle and --dry-run stay on the\n'
    printf '# command line.\n\n'

    _yaml_kv deployment_slug "$DEPLOYMENT_SLUG"
    printf '# token-only | token+unix | keys+llng | mixed | max-security\n'
    _yaml_kv scenario "$SCENARIO"
    _yaml_kv portal_url "$PORTAL_URL"
    printf '# yes: allow an http:// portal and skip TLS verification, here and on the\n'
    printf '# targets (verify_ssl = false, ob-enroll/setup -k). Test setups only.\n'
    _yaml_kv insecure "$([ "$INSECURE" = 1 ] && echo yes || echo no)"

    printf '\n'
    _yaml_kv client_id "$CLIENT_ID"
    printf '# fixed | modifiable (the target admin may override it with --client-id)\n'
    _yaml_kv client_id_policy "$CLIENT_ID_POLICY"
    printf '# none | prompt | embedded\n'
    _yaml_kv client_secret_mode "$CLIENT_SECRET_MODE"
    if [ "$CLIENT_SECRET_MODE" = "embedded" ]; then
        if [ "$SAVE_CONFIG_SECRET" = 1 ] && q=$(_yaml_str "$EMBEDDED_CLIENT_SECRET"); then
            printf '# In clear: keep this file as confidential as the artefacts.\n'
            printf 'embedded_client_secret: %s\n' "$q"
        else
            printf '# Not saved. Required by client_secret_mode=embedded: add it back.\n'
            printf '# embedded_client_secret: ""\n'
        fi
    fi
    _yaml_kv server_group "$SERVER_GROUP"
    printf '# fixed | modifiable (the target admin may override it with --server-group)\n'
    _yaml_kv server_group_policy "$SERVER_GROUP_POLICY"

    printf '\n# bastion | standalone | backend; several, comma-separated, give one\n'
    printf '# artefact each, suffixed with the role\n'
    _yaml_kv target_role "$(IFS=,; printf '%s' "${TARGET_ROLES[*]}")"
    printf '# backend only: bastion ids allowed to reach it, comma-separated (empty =\n'
    printf '# any bastion enrolled in the same server group)\n'
    _yaml_kv allowed_bastions "$ALLOWED_BASTIONS"
    printf '# yes | no: logind/nproc/at/cron containment (system-wide, see SECURITY.md)\n'
    _yaml_kv enable_hardening "$ENABLE_HARDENING"
    printf '# yes | no: auditd rules and their rotation timer\n'
    _yaml_kv enable_audit_trace "$ENABLE_AUDIT_TRACE"
    printf '# yes | no: bastion/standalone only, yes opts out of session recording\n'
    _yaml_kv disable_session_recorder "$DISABLE_SESSION_RECORDER"

    printf '\n# yes | no | prompt: the installer runs ob-enroll and ob-*-setup\n'
    _yaml_kv auto_enroll_setup "$AUTO_ENROLL_SETUP"
    printf '# yes | no: the shell installer removes itself after a successful run\n'
    _yaml_kv self_delete "$SELF_DELETE"
    printf '# yes | no: the Ansible role approves device codes with an LLNG cookie\n'
    printf '# asked at each play run\n'
    _yaml_kv ansible_auto_approve "$ANSIBLE_AUTO_APPROVE"
    if [ -n "$SERVICE_KEYS_SETUP" ]; then
        _yaml_kv service_keys "$SERVICE_KEYS_SETUP"
    else
        printf '# true | false: pass --enable-service-keys to the setup run (default: on\n'
        printf '# when a service account has a public key)\n'
        printf '# service_keys: true\n'
    fi

    printf '\n'
    _yaml_kv apt_url "$APT_URL"
    _yaml_kv apt_suite "$APT_SUITE"
    _yaml_kv apt_component "$APT_COMPONENT"
    # The default keyring stays a comment: its path is the builder's, and the
    # config may be replayed by another installation of it.
    if [ "$REPO_KEYRING" = "$DEFAULT_REPO_KEYRING" ]; then
        printf '# repo_keyring: %s\n' "$DEFAULT_REPO_KEYRING"
    else
        # Absolute: a relative path would resolve against the replay's cwd.
        _yaml_kv repo_keyring "$(realpath -- "$REPO_KEYRING")"
    fi
    printf '# GPG key id signing the shell installer (empty = no signature)\n'
    _yaml_kv sign_with "$SIGN_WITH"

    [ "${#SERVICE_ACCOUNTS_RECORDS[@]}" -gt 0 ] || return 0
    printf '\n# SSH-key-only local accounts, see doc/service-accounts.rst\n'
    printf 'service_accounts:\n'
    for rec in "${SERVICE_ACCOUNTS_RECORDS[@]}"; do
        name=$(_sa_field 1 "$rec");          fp=$(_sa_field 2 "$rec")
        sudo_allowed=$(_sa_field 3 "$rec");   sudo_nopasswd=$(_sa_field 4 "$rec")
        shell=$(_sa_field 5 "$rec");          home=$(_sa_field 6 "$rec")
        gecos=$(_sa_field 7 "$rec")
        uid=$(_sa_field 8 "$rec");            gid=$(_sa_field 9 "$rec")
        pub=$(_sa_field 10 "$rec")
        _yaml_kv name "$name" '  - '
        _yaml_kv key_fingerprint "$fp" '    '
        if [ -n "$pub" ]; then
            # The comment is free text that YAML may not carry (" #", both
            # quotes); sshd and the fingerprint ignore it, so drop it then.
            _yaml_str "$pub" >/dev/null || pub="${pub%% *} $(cut -d' ' -f2 <<<"$pub")"
            _yaml_kv public_key "$pub" '    '
        else
            # The questionnaire does not ask for the key, and without it sshd
            # has nothing to accept (#263).
            printf '    # No public key: the account cannot log in until one is deployed.\n'
            printf '    # public_key_file: keys/%s.pub\n' "$name"
        fi
        printf '    sudo_allowed: %s\n' "$sudo_allowed"
        printf '    sudo_nopasswd: %s\n' "$sudo_nopasswd"
        [ -z "$shell" ] || _yaml_kv shell "$shell" '    '
        [ -z "$home" ]  || _yaml_kv home "$home" '    '
        [ -z "$gecos" ] || _yaml_kv gecos "$gecos" '    '
        [ -z "$uid" ]   || printf '    uid: %s\n' "$uid"
        [ -z "$gid" ]   || printf '    gid: %s\n' "$gid"
    done
    return 0
}

save_config() {
    local path="$1" content mode="0644"
    # atomic_write's mv would drop the file INSIDE a directory and still
    # report it saved under the directory's name.
    [ ! -d "$path" ] || die "--save-config: $path is a directory; give a file path"
    if [ "$DRY_RUN" = "1" ]; then
        if [ -e "$path" ]; then
            log_info "[DRY-RUN] Would replace the existing config $path"
        else
            log_info "[DRY-RUN] Would save the config to $path"
        fi
        return 0
    fi
    # atomic_write replaces the file wholesale, so keys added by hand to an
    # earlier save (embedded_client_secret, public_key_file) are not carried
    # over. Say so rather than let the file change under the operator.
    if [ -e "$path" ]; then
        log_warn "$path already exists; keys added by hand (embedded_client_secret, public_key_file) are not carried over."
    fi
    content=$(render_config_yaml "$path") || die "Could not save the config to $path"
    [ "$CLIENT_SECRET_MODE" = "embedded" ] && [ "$SAVE_CONFIG_SECRET" = 1 ] && mode="0600"
    atomic_write "$path" "$mode" "$content"$'\n'
    log_info "Config saved to $path (replay with --config)"
    if [ "$CLIENT_SECRET_MODE" = "embedded" ]; then
        if [ "$SAVE_CONFIG_SECRET" != 1 ]; then
            log_warn "The client_secret was left out of $path: add embedded_client_secret before replaying it."
        elif ! _yaml_str "$EMBEDDED_CLIENT_SECRET" >/dev/null; then
            # Consent was given, so silence here would read as "it is in there".
            log_warn "The client_secret could not be written to $path (control character, ' #', both"
            log_warn "  quote kinds, or not UTF-8): add embedded_client_secret by hand before replaying it."
        fi
    fi
    return 0
}

# ─────────────────────────────────────────────────────────────────────────
# SSO discovery + asset fetch into a shared WORK_DIR.
# Files produced:
#   $WORK_DIR/ca.pub
#   $WORK_DIR/krl       (empty if not fetched)
#   $WORK_DIR/jwks.json (only when a backend artefact is produced)
# ─────────────────────────────────────────────────────────────────────────
fetch_sso_assets() {
    WORK_DIR=$(mktemp_dir)
    log_info "Working directory: $WORK_DIR"

    if ! sso_validate_url "$PORTAL_URL"; then
        die "SSO validation failed; aborting."
    fi

    if ! sso_fetch_ca "$PORTAL_URL" "$WORK_DIR/ca.pub"; then
        die "Failed to fetch SSH CA from portal."
    fi

    if [ "$SCENARIO" = "max-security" ] || [ "$PAM_MODE" = "E" ]; then
        sso_fetch_krl "$PORTAL_URL" "$WORK_DIR/krl" || log_warn "KRL fetch failed (non-fatal)"
    else
        : > "$WORK_DIR/krl"
    fi

    if _has_role backend || [ "$BUNDLE" = "1" ]; then
        if ! sso_fetch_jwks "$PORTAL_URL" "$WORK_DIR/jwks.json"; then
            die "JWKS fetch failed; backend artefacts require it."
        fi
    fi
}

# ─────────────────────────────────────────────────────────────────────────
# Template expansion.
#
# Placeholder syntax: @@VAR_NAME@@. To remain safe against arbitrary
# characters in values (slashes, ampersands, newlines, NULs would all
# break naïve sed), we use a pure-bash expansion: read the template into
# a single variable, then for each placeholder do ${var//@@K@@/$value}.
# This is O(N*M) but template files are small and the variable count is
# bounded, so it's negligible.
# ─────────────────────────────────────────────────────────────────────────

# render_template <template_path> <output_path> <mode>
# Uses the placeholder map populated by build_placeholder_map() and stored
# in the _PH_KEYS / _PH_VALS parallel arrays.
_PH_KEYS=()
_PH_VALS=()
ph_set() {
    _PH_KEYS+=("$1")
    _PH_VALS+=("$2")
}
ph_reset() {
    _PH_KEYS=()
    _PH_VALS=()
}

render_template() {
    local template="$1"
    local outfile="$2"
    local mode="$3"

    [ -f "$template" ] || die "Template not found: $template"

    # Read the entire template. The trailing-newline preservation trick
    # ($'\n'$content … then strip) is overkill for our use case; mapfile
    # would also work but loses trailing newlines.
    local content
    content=$(cat -- "$template")

    local i k v
    for ((i=0; i<${#_PH_KEYS[@]}; i++)); do
        k="${_PH_KEYS[$i]}"
        v="${_PH_VALS[$i]}"
        # shellcheck disable=SC2295  # @@${k}@@ is a literal pattern, not a glob
        content="${content//@@${k}@@/"$v"}"
    done

    if [ "$DRY_RUN" = "1" ]; then
        log_info "[DRY-RUN] Would render $template -> $outfile ($mode)"
        return 0
    fi

    atomic_write "$outfile" "$mode" "$content"
}

# Mode-specific settings emitted into openbastion.conf as plain key=val lines.
# Mirrors the working examples in local/etc/open-bastion/openbastion.conf and
# the per-mode rules documented in doc/security-scenarios/index.rst.
_mode_settings_conf() {
    local mode="$1"
    case "$mode" in
        A)
            cat << 'MODE'
# Mode A — LLNG token only
cache_enabled = true
cache_ttl = 300
MODE
            ;;
        B)
            cat << 'MODE'
# Mode B — LLNG token with Unix password fallback
cache_enabled = true
cache_ttl = 300
MODE
            ;;
        C)
            cat << 'MODE'
# Mode C — SSH key with LLNG authorization
cache_enabled = true
cache_ttl = 300
ssh_key_policy_enabled = true
ssh_key_allowed_types = ed25519,rsa
MODE
            ;;
        D)
            cat << 'MODE'
# Mode D — all methods accepted, LLNG authorization
cache_enabled = true
cache_ttl = 300
MODE
            ;;
        E)
            cat << 'MODE'
# Mode E — maximum security (SSO certs only, sudo via LLNG token, KRL)
min_tls_version = 13
cache_enabled = true
cache_ttl = 60
ssh_key_policy_enabled = true
ssh_key_allowed_types = ed25519,rsa
cache_rate_limit_enabled = true
cache_rate_limit_max_attempts = 3
MODE
            ;;
    esac
}

# Emit each mode-specific setting as a top-level ob_* Ansible variable so
# operators can override individual values via host_vars / extra-vars, and so
# the templates/openbastion.conf.j2 `is defined` checks actually see them
# (previously they were nested under ob_mode_settings: which made them
# invisible to top-level Jinja2 lookups).
_mode_settings_yaml() {
    local mode="$1"
    case "$mode" in
        A|B)
            cat << 'YML'
ob_cache_enabled: true
ob_cache_ttl: 300
YML
            ;;
        C)
            cat << 'YML'
ob_cache_enabled: true
ob_cache_ttl: 300
ob_ssh_key_policy_enabled: true
ob_ssh_key_allowed_types: "ed25519,rsa"
YML
            ;;
        D)
            cat << 'YML'
ob_cache_enabled: true
ob_cache_ttl: 300
YML
            ;;
        E)
            cat << 'YML'
ob_min_tls_version: 13
ob_cache_enabled: true
ob_cache_ttl: 60
ob_ssh_key_policy_enabled: true
ob_ssh_key_allowed_types: "ed25519,rsa"
ob_cache_rate_limit_enabled: true
ob_cache_rate_limit_max_attempts: 3
YML
            ;;
    esac
}

# Build the placeholder map for the current run. Called once per artefact
# (so the bastion + backend cycle in --bundle gets fresh role-specific
# values).
build_placeholder_map() {
    local role="$1"
    local pam_mode bastion_backend_block bastion_allowlist_yaml ca_b64 krl_b64 gpg_b64 apt_sources
    local mode_settings mode_settings_yaml max_security_bool
    local auto_enroll_bool auto_setup_bool insecure_default verify_ssl_bool norec

    pam_mode=$(scenario_to_pam_mode "$SCENARIO")

    # Backend "accept only this bastion": enforcement is NOT in openbastion.conf
    # anymore (the old bastion_jwt / LLNG_BASTION_JWT transport was broken —
    # pam_getenv can't read a SendEnv var). It is replaced by certificate
    # vouching: ob-backend-setup writes /etc/open-bastion/allowed_bastions and
    # wires an AuthorizedPrincipalsCommand keyed on the cert key-id + the cert's
    # source-address. So the conf block is empty; we only pass the allowlist to
    # the Ansible role (which forwards it as ob-backend-setup --allowed-bastions).
    bastion_backend_block=""
    # Role-scoped: the allowlist is meaningful only for a backend. Keep it empty
    # for bastion/standalone artefacts (matters in --bundle, where one config
    # produces both roles — the bastion installer must NOT embed the allowlist).
    local allowlist_for_role=""
    if [ "$role" = "backend" ] && [ -n "${ALLOWED_BASTIONS:-}" ]; then
        allowlist_for_role="$ALLOWED_BASTIONS"
        bastion_allowlist_yaml="ob_bastion_allowed_bastions: \"${ALLOWED_BASTIONS}\""
    else
        bastion_allowlist_yaml=""
    fi

    mode_settings=$(_mode_settings_conf "$pam_mode")
    mode_settings_yaml=$(_mode_settings_yaml "$pam_mode")
    if [ "$pam_mode" = "E" ]; then
        max_security_bool="true"
    else
        max_security_bool="false"
    fi

    case "$AUTO_ENROLL_SETUP" in
        yes)    auto_enroll_bool="true";  auto_setup_bool="true" ;;
        no)     auto_enroll_bool="false"; auto_setup_bool="false" ;;
        prompt|*) auto_enroll_bool="false"; auto_setup_bool="false" ;;
    esac

    # --insecure makes the artefacts default to verify_ssl = false / -k.
    if [ "$INSECURE" = "1" ]; then
        insecure_default="yes"; verify_ssl_bool="false"
    else
        insecure_default="no";  verify_ssl_bool="true"
    fi

    # Session recording does not exist on a backend; never emit the opt-out for it.
    norec="$DISABLE_SESSION_RECORDER"
    [ "$role" = "backend" ] && norec="no"

    # Base64-encode the binary blobs that will be embedded in artefacts.
    ca_b64=$(base64_file "$WORK_DIR/ca.pub")
    if [ -s "$WORK_DIR/krl" ]; then
        krl_b64=$(base64_file "$WORK_DIR/krl")
    else
        krl_b64=""
    fi
    gpg_b64=$(base64_file "$REPO_KEYRING")

    apt_sources="deb [signed-by=/etc/apt/keyrings/open-bastion.gpg] ${APT_URL} ${APT_SUITE} ${APT_COMPONENT}"

    ph_reset
    ph_set OB_BUILDER_VERSION   "$VERSION"
    ph_set BUILD_DATE           "$BUILD_DATE"
    ph_set DEPLOYMENT_SLUG      "$DEPLOYMENT_SLUG"
    ph_set SCENARIO             "$SCENARIO"
    ph_set PAM_MODE             "$pam_mode"
    ph_set TARGET_ROLE          "$role"
    ph_set PORTAL_URL           "$PORTAL_URL"
    ph_set CLIENT_ID            "$CLIENT_ID"
    ph_set CLIENT_ID_POLICY     "$CLIENT_ID_POLICY"
    ph_set CLIENT_SECRET_MODE     "$CLIENT_SECRET_MODE"
    # Shell installer: embed the secret base64-encoded so shell metacharacters
    # cannot break out of the bash literal.
    local _emb_b64=""
    [ -n "$EMBEDDED_CLIENT_SECRET" ] && _emb_b64=$(base64_string "$EMBEDDED_CLIENT_SECRET")
    ph_set EMBEDDED_CLIENT_SECRET_B64 "$_emb_b64"
    # Ansible defaults: the secret lands as a plain YAML string. No shell
    # parsing happens, so clear-text is safe; the encoding concern only applies
    # to the bash literal in the shell installer.
    ph_set EMBEDDED_CLIENT_SECRET "$EMBEDDED_CLIENT_SECRET"
    ph_set SERVER_GROUP         "$SERVER_GROUP"
    ph_set SERVER_GROUP_POLICY  "$SERVER_GROUP_POLICY"
    ph_set ALLOWED_BASTIONS     "$allowlist_for_role"
    ph_set AUTO_ENROLL_SETUP    "$AUTO_ENROLL_SETUP"
    ph_set SELF_DELETE          "$SELF_DELETE"
    ph_set CA_SSH_PUB_B64       "$ca_b64"
    ph_set CA_SSH_FINGERPRINT   "$SSO_CA_FINGERPRINT"
    ph_set KRL_B64              "$krl_b64"
    ph_set GPG_KEY_B64          "$gpg_b64"
    ph_set APT_SOURCES_LIST     "$apt_sources"
    ph_set BASTION_BACKEND_BLOCK     "$bastion_backend_block"
    ph_set BASTION_ALLOWLIST_VARS_YAML "$bastion_allowlist_yaml"
    ph_set MODE_SETTINGS         "$mode_settings"
    ph_set MODE_SETTINGS_YAML    "$mode_settings_yaml"
    ph_set MAX_SECURITY_BOOL     "$max_security_bool"
    ph_set AUTO_ENROLL_BOOL      "$auto_enroll_bool"
    ph_set AUTO_SETUP_BOOL       "$auto_setup_bool"
    ph_set INSECURE_DEFAULT      "$insecure_default"
    ph_set VERIFY_SSL_BOOL       "$verify_ssl_bool"

    # Optional opt-in features. Shell installer consumes the yes/no strings;
    # the Ansible role consumes the true/false boolean variants.
    local _harden_bool="false" _audit_bool="false" _norec_bool="false"
    [ "$ENABLE_HARDENING" = "yes" ]         && _harden_bool="true"
    [ "$ENABLE_AUDIT_TRACE" = "yes" ]       && _audit_bool="true"
    [ "$norec" = "yes" ]                    && _norec_bool="true"
    ph_set ENABLE_HARDENING              "$ENABLE_HARDENING"
    ph_set ENABLE_AUDIT_TRACE            "$ENABLE_AUDIT_TRACE"
    ph_set DISABLE_SESSION_RECORDER      "$norec"
    ph_set ENABLE_HARDENING_BOOL         "$_harden_bool"
    ph_set ENABLE_AUDIT_TRACE_BOOL       "$_audit_bool"
    ph_set DISABLE_SESSION_RECORDER_BOOL "$_norec_bool"

    # Service accounts. Applies to every role. The shell installer embeds the
    # rendered service-accounts.conf base64-encoded and writes it at 0600; the
    # Ansible role carries it as a YAML block scalar in defaults. The
    # openbastion.conf gets an explicit service_accounts_file directive (the C
    # default is already that path, so the line is documentation/clarity).
    local _sa_enabled_bool="false" _sa_conf="" _sa_conf_b64="" _sa_file_line="" _sa_defaults_yaml
    if [ "${#SERVICE_ACCOUNTS_RECORDS[@]}" -gt 0 ]; then
        _sa_enabled_bool="true"
        local _sa_keys _sa_keys_b64
        _sa_conf=$(_render_service_accounts_conf)
        _sa_conf_b64=$(base64_string "$_sa_conf")
        _sa_file_line=$'# Service accounts (SSH-key-only local accounts)\nservice_accounts_file = /etc/open-bastion/service-accounts.conf'
        # YAML block scalar: indent every conf line by two spaces under `|`.
        local _indented
        _indented=$(printf '%s\n' "$_sa_conf" | sed 's/^/  /')
        _sa_defaults_yaml=$'ob_service_accounts_enabled: true\nob_service_accounts_content: |\n'"$_indented"
        _sa_keys=$(_render_service_account_keys)
        _sa_keys_b64=$(base64_string "$_sa_keys")
        if [ -n "$_sa_keys" ]; then
            local _kindent
            _kindent=$(printf '%s\n' "$_sa_keys" | sed 's/^/  /')
            _sa_defaults_yaml="$_sa_defaults_yaml"$'\nob_service_account_keys: |\n'"$_kindent"
        else
            _sa_defaults_yaml="$_sa_defaults_yaml"$'\nob_service_account_keys: ""'
        fi
    else
        _sa_defaults_yaml='ob_service_accounts_enabled: false'$'\n''ob_service_accounts_content: ""'$'\n''ob_service_account_keys: ""'
    fi
    _sa_keys_b64="${_sa_keys_b64:-}"

    # Default on when any account carries a key: shipping a key that nothing
    # serves is the state #263 was reported for. An explicit `service_keys:`
    # in the config wins either way.
    local _svc_keys_bool="false"
    case "$(printf '%s' "${SERVICE_KEYS_SETUP:-}" | tr 'A-Z' 'a-z')" in
        true|yes|1|on)   _svc_keys_bool="true" ;;
        false|no|0|off)  _svc_keys_bool="false" ;;
        "") [ -n "${_sa_keys:-}" ] && _svc_keys_bool="true" ;;
        *)  log_warn "service_keys: unrecognised value '${SERVICE_KEYS_SETUP}', treating as false" ;;
    esac
    ph_set SERVICE_KEYS_SETUP_BOOL        "$_svc_keys_bool"
    ph_set SERVICE_ACCOUNTS_ENABLED_BOOL  "$_sa_enabled_bool"
    ph_set SERVICE_ACCOUNTS_CONF_B64      "$_sa_conf_b64"
    ph_set SERVICE_ACCOUNT_KEYS_B64       "$_sa_keys_b64"
    ph_set SERVICE_ACCOUNTS_FILE_LINE     "$_sa_file_line"
    ph_set SERVICE_ACCOUNTS_DEFAULTS_YAML "$_sa_defaults_yaml"

    # Ansible-only: device-code auto-approval via LLNG session cookie.
    local _auto_approve_bool="false" _vars_prompt_block=""
    if [ "$ANSIBLE_AUTO_APPROVE" = "yes" ]; then
        _auto_approve_bool="true"
        _vars_prompt_block=$(cat << 'VARSPROMPT'
  vars_prompt:
    - name: ob_llng_cookie
      prompt: |
        LLNG session cookie used to auto-approve device codes.
        Obtain with: llng --llng-server <portal> llng_cookie
        Leave empty to skip auto-approval and fall back to manual browser approval.
      private: true
      unsafe: true
      default: ""
VARSPROMPT
)
    fi
    ph_set ANSIBLE_AUTO_APPROVE_BOOL "$_auto_approve_bool"
    ph_set ANSIBLE_VARS_PROMPT_BLOCK "$_vars_prompt_block"

    return 0
}

# ─────────────────────────────────────────────────────────────────────────
# Protecting artefacts that carry the client secret (#203).
#
# With client_secret_mode=embedded the OIDC client secret is written in clear
# text into every artefact: the shell installer (0755 by default) and the
# Ansible role's defaults/main.yml (0644). Two accidents follow from that, and
# both were observed on a real build host: any local account could read the
# secret, and a bundle generated inside a git working tree was one `git add -A`
# away from being published.
#
# These helpers are no-ops for client_secret_mode=prompt/none, where nothing
# secret is written to disk in the first place.
# ─────────────────────────────────────────────────────────────────────────
_tighten_if_embedded() {
    local path="$1" mode="$2"

    [ "$CLIENT_SECRET_MODE" = "embedded" ] || return 0
    [ "$DRY_RUN" = "1" ] && return 0
    [ -e "$path" ] || return 0

    chmod -- "$mode" "$path" \
        || log_warn "Could not restrict permissions on $path (it holds the client secret)"
}

_write_bundle_gitignore() {
    local outpath="$1"

    [ "$CLIENT_SECRET_MODE" = "embedded" ] || return 0
    [ "$DRY_RUN" = "1" ] && return 0

    atomic_write "$outpath/.gitignore" "0644" \
"# Written by ob-builder $VERSION.
#
# This bundle was built with client_secret_mode=embedded:
# roles/open-bastion/defaults/main.yml holds the OIDC client secret in clear
# text, and the inventory names real hosts. Ignoring the whole directory keeps
# a stray 'git add -A' from publishing it.
#
# To version this bundle deliberately: delete this file, hold the secret with
# 'ansible-vault encrypt_string' and rebuild with client_secret_mode=prompt.
*
"
}

# ─────────────────────────────────────────────────────────────────────────
# Shell installer rendering.
# The template installer.sh.in references @@OPENBASTION_CONF_TEMPLATE@@,
# which must contain the (already-expanded) contents of the conf template
# so it can be emitted via a heredoc inside the generated script.
# ─────────────────────────────────────────────────────────────────────────
render_shell_installer() {
    local outpath="$1" role="$2"
    local installer_tpl="$TEMPLATES_DIR/shell/installer.sh.in"
    local conf_tpl="$TEMPLATES_DIR/shell/openbastion.conf.in"

    log_step "Rendering shell installer for role=$role"

    if [ ! -f "$installer_tpl" ]; then
        log_warn "Shell installer template not found: $installer_tpl"
        log_warn "Templates are produced by a sibling task; producing a stub recap instead."
        _render_stub_shell "$outpath" "$role"
        return 0
    fi

    build_placeholder_map "$role"

    # First, expand the conf template with the SAME placeholder map and
    # stash the result into @@OPENBASTION_CONF_TEMPLATE@@ so the installer
    # template can embed it via a heredoc.
    local conf_content=""
    if [ -f "$conf_tpl" ]; then
        conf_content=$(cat -- "$conf_tpl")
        local i k v
        for ((i=0; i<${#_PH_KEYS[@]}; i++)); do
            k="${_PH_KEYS[$i]}"
            v="${_PH_VALS[$i]}"
            # shellcheck disable=SC2295
            conf_content="${conf_content//@@${k}@@/"$v"}"
        done
    fi
    ph_set OPENBASTION_CONF_TEMPLATE "$conf_content"

    render_template "$installer_tpl" "$outpath" "0755"
    _tighten_if_embedded "$outpath" "0700"

    if [ "$DRY_RUN" != "1" ] && [ -n "$SIGN_WITH" ]; then
        log_step "Signing $outpath with key $SIGN_WITH"
        if ! gpg --detach-sign --armor -u "$SIGN_WITH" --output "${outpath}.sig" "$outpath"; then
            die "GPG signing failed"
        fi
        log_info "Signature written to ${outpath}.sig"
    fi
}

# Fallback emitted when the installer template hasn't been produced yet
# by the sibling task. Writes a short, executable shell script that
# explains how to use the captured config — enough to keep ob-builder
# functional end-to-end before the template lands.
_render_stub_shell() {
    local outpath="$1" role="$2"
    local pam_mode
    pam_mode=$(scenario_to_pam_mode "$SCENARIO")

    if [ "$DRY_RUN" = "1" ]; then
        log_info "[DRY-RUN] Would write stub installer to $outpath"
        return 0
    fi

    local content
    content=$(cat << EOF
#!/bin/bash
# Open Bastion bootstrap (stub) — generated by ob-builder $VERSION on $BUILD_DATE
# Deployment: $DEPLOYMENT_SLUG  Scenario: $SCENARIO  Role: $role  PAM mode: $pam_mode
#
# This is a stub artefact: the installer.sh.in template was not present at
# build time. The captured configuration is shown below; run ob-builder
# again once admin-builder/templates/shell/installer.sh.in has been
# provided to produce a real self-extracting installer.

set -euo pipefail

cat <<INFO
Deployment slug:      $DEPLOYMENT_SLUG
Scenario:             $SCENARIO  (PAM mode $pam_mode)
Target role:          $role
Portal URL:           $PORTAL_URL
client_id:            ${CLIENT_ID:-<empty>} (policy: $CLIENT_ID_POLICY)
client_secret_mode:   $CLIENT_SECRET_MODE
server_group:         ${SERVER_GROUP:-<empty>} (policy: $SERVER_GROUP_POLICY)
auto_enroll_setup:    $AUTO_ENROLL_SETUP
CA fingerprint:       $SSO_CA_FINGERPRINT
APT repo:             $APT_URL ($APT_SUITE $APT_COMPONENT)
INFO
EOF
)
    atomic_write "$outpath" "0755" "$content"
    log_info "Stub installer written to $outpath"
}

# ─────────────────────────────────────────────────────────────────────────
# Ansible role rendering.
# Mirrors the layout described in the design plan:
#   <out>/playbook.yml
#   <out>/roles/open-bastion/defaults/main.yml
#   <out>/roles/open-bastion/files/open-bastion-ca.pub
#   <out>/roles/open-bastion/files/open-bastion-krl       (if max-security)
#   <out>/roles/open-bastion/files/open-bastion.gpg
#   <out>/roles/open-bastion/files/jwks.json              (if backend/bundle)
#   <out>/roles/open-bastion/templates/openbastion.conf.j2
#   <out>/roles/open-bastion/tasks/main.yml
#   <out>/roles/open-bastion/tasks/{bastion,backend,standalone}.yml
#   <out>/roles/open-bastion/handlers/main.yml
# Each template at $TEMPLATES_DIR/ansible/... ending in .in is expanded;
# other files are copied as-is.
# ─────────────────────────────────────────────────────────────────────────
render_ansible_role() {
    local outpath="$1" role="$2"
    local src="$TEMPLATES_DIR/ansible"

    log_step "Rendering Ansible role for role=$role"

    if [ ! -d "$src" ]; then
        log_warn "Ansible template tree not found: $src"
        log_warn "Templates are produced by a sibling task; producing a minimal role stub."
        _render_stub_ansible "$outpath" "$role"
        return 0
    fi

    build_placeholder_map "$role"

    if [ "$DRY_RUN" = "1" ]; then
        log_info "[DRY-RUN] Would render Ansible role into $outpath"
        return 0
    fi

    mkdir -p "$outpath"

    # Walk the template tree.
    # The source layout uses a short "role/" prefix; the rendered output
    # follows the standard Ansible "roles/open-bastion/" layout. The
    # remap below performs that translation transparently so the source
    # tree stays compact while the artefact remains drop-in compatible
    # with `ansible-playbook -i inventory playbook.yml`.
    local rel f dest
    while IFS= read -r -d '' f; do
        rel="${f#"$src"/}"
        # Drop the trailing ".in" suffix on templated files.
        rel="${rel%.in}"
        # Remap "role/<x>" to "roles/open-bastion/<x>".
        case "$rel" in
            role/*) rel="roles/open-bastion/${rel#role/}" ;;
        esac
        dest="$outpath/$rel"
        if [[ "$f" == *.in ]]; then
            render_template "$f" "$dest" "0644"
        else
            mkdir -p -- "$(dirname -- "$dest")"
            atomic_write_from "$dest" "0644" "$f"
        fi
    done < <(find "$src" -type f -print0)

    # Drop in the binary assets that templates can't carry.
    local files_dir="$outpath/roles/open-bastion/files"
    mkdir -p "$files_dir"
    atomic_write_from "$files_dir/open-bastion-ca.pub" "0644" "$WORK_DIR/ca.pub"
    if [ "$SCENARIO" = "max-security" ]; then
        # Mode E always ships a KRL file: the role's mandatory "Deploy KRL" task
        # references it unconditionally. An empty/unavailable upstream KRL is
        # valid for a fresh portal with no revocations yet — ship an empty file
        # (ob-krl-refresh.timer fills it in later), matching ob-bastion-setup's
        # download_krl. Without this, Mode E deploys fail with "Could not find
        # open-bastion-krl" whenever the portal KRL is still empty.
        [ -f "$WORK_DIR/krl" ] || : > "$WORK_DIR/krl"
        atomic_write_from "$files_dir/open-bastion-krl" "0644" "$WORK_DIR/krl"
    fi
    atomic_write_from "$files_dir/open-bastion.gpg" "0644" "$REPO_KEYRING"
    if [ -f "$WORK_DIR/jwks.json" ]; then
        atomic_write_from "$files_dir/jwks.json" "0644" "$WORK_DIR/jwks.json"
    fi

    _tighten_if_embedded "$outpath/roles/open-bastion/defaults/main.yml" "0600"
    _write_bundle_gitignore "$outpath"

    log_info "Ansible role written to $outpath"
}

# Minimal Ansible stub when templates are missing — writes defaults/main.yml
# only, so the consumer can wire it up to their own playbook once templates
# land in the sibling task.
_render_stub_ansible() {
    local outpath="$1" role="$2"
    local pam_mode
    pam_mode=$(scenario_to_pam_mode "$SCENARIO")

    if [ "$DRY_RUN" = "1" ]; then
        log_info "[DRY-RUN] Would write stub Ansible role to $outpath"
        return 0
    fi

    local defaults_dir="$outpath/roles/open-bastion/defaults"
    local files_dir="$outpath/roles/open-bastion/files"
    mkdir -p "$defaults_dir" "$files_dir"

    local defaults
    defaults=$(cat << EOF
---
# Open Bastion role defaults — generated by ob-builder $VERSION on $BUILD_DATE
# This is a stub: real tasks/templates are emitted once the Ansible template
# tree at $TEMPLATES_DIR/ansible/ exists (sibling task).
ob_deployment_slug: $DEPLOYMENT_SLUG
ob_scenario: $SCENARIO
ob_pam_mode: $pam_mode
ob_role: $role
ob_portal_url: $PORTAL_URL
ob_verify_ssl: $([ "$INSECURE" = 1 ] && echo false || echo true)
ob_client_id: ${CLIENT_ID:-}
ob_client_id_policy: $CLIENT_ID_POLICY
ob_client_secret_mode: $CLIENT_SECRET_MODE
ob_server_group: ${SERVER_GROUP:-}
ob_server_group_policy: $SERVER_GROUP_POLICY
ob_auto_enroll_setup: $AUTO_ENROLL_SETUP
ob_ca_fingerprint: ${SSO_CA_FINGERPRINT:-}
ob_apt_url: $APT_URL
ob_apt_suite: $APT_SUITE
ob_apt_component: $APT_COMPONENT
EOF
)
    atomic_write "$defaults_dir/main.yml" "0644" "$defaults"

    atomic_write_from "$files_dir/open-bastion-ca.pub" "0644" "$WORK_DIR/ca.pub"
    if [ "$SCENARIO" = "max-security" ]; then
        # Mode E always ships a KRL file (empty is valid for a fresh portal).
        [ -f "$WORK_DIR/krl" ] || : > "$WORK_DIR/krl"
        atomic_write_from "$files_dir/open-bastion-krl" "0644" "$WORK_DIR/krl"
    fi
    atomic_write_from "$files_dir/open-bastion.gpg" "0644" "$REPO_KEYRING"
    if [ -f "$WORK_DIR/jwks.json" ]; then
        atomic_write_from "$files_dir/jwks.json" "0644" "$WORK_DIR/jwks.json"
    fi
    _tighten_if_embedded "$defaults_dir/main.yml" "0600"
    _write_bundle_gitignore "$outpath"

    log_info "Stub Ansible role written to $outpath"
}

# The portal side of R-P1, written next to the artefact.
#
# `pamAccessServerGroups` and `pamAccessAllowedRps` are Manager settings: no
# installer and no Ansible task can set them, and probing the portal for their
# state would need an API that publishes the project's bastions, server groups
# and RPs -- which is not something an SSO should offer. So the artefact carries
# the requirement instead, pre-filled with the client_id and server_group THIS
# bundle enrols with, rather than leaving the admin to map a generic warning
# onto their own deployment.
#
# It is written for both output kinds. The shell installer runs the setup
# script, which prints the same requirement; the Ansible role runs it through a
# task whose stdout nobody reads.
render_portal_checklist() {
    local dest="$1" role="$2"
    local tpl="$TEMPLATES_DIR/PORTAL-CHECKLIST.md.in"

    [ -f "$tpl" ] || { log_warn "Portal checklist template not found: $tpl"; return 0; }
    if [ "$DRY_RUN" = "1" ]; then
        log_info "[DRY-RUN] Would write $dest"
        return 0
    fi

    build_placeholder_map "$role"
    mkdir -p -- "$(dirname -- "$dest")"
    render_template "$tpl" "$dest" "0644"
    log_info "Portal checklist written to $dest"
}

run_outputs_for_role() {
    local role="$1"
    local shell_out="$2"
    local ansible_out="$3"

    [ -n "$shell_out" ]   && render_shell_installer "$shell_out" "$role"
    [ -n "$ansible_out" ] && render_ansible_role    "$ansible_out" "$role"
    # Next to the installer, and inside the role tree. Named per role so a
    # --bundle run does not have its bastion checklist overwritten by its
    # backend one.
    [ -n "$shell_out" ]   && render_portal_checklist \
        "$(dirname -- "$shell_out")/PORTAL-CHECKLIST-${role}.md" "$role"
    [ -n "$ansible_out" ] && render_portal_checklist \
        "$ansible_out/PORTAL-CHECKLIST.md" "$role"
    # When one of the outputs is empty the corresponding `cmd && X` is
    # false; the function would otherwise return non-zero and trip set -e
    # in main(). Explicit success keeps execution flowing.
    return 0
}

main() {
    BUILD_DATE=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

    # Install the temp-dir cleanup trap from the parent shell BEFORE any
    # mktemp_dir call. Doing it inside mktemp_dir would not work when
    # mktemp_dir is invoked from a command substitution (subshell scope).
    ob_init_tmpdir_trap

    parse_args "$@"

    if [ -n "$OUTPUT_SHELL" ]; then
        local _err
        _err=$(check_output_shell_dir "$OUTPUT_SHELL") || die "$_err"
    fi

    if [ -n "$CONFIG_FILE" ]; then
        # Fail fast: nothing to produce without an output target. The
        # questionnaire asks for them instead.
        if [ -z "$OUTPUT_SHELL" ] && [ -z "$OUTPUT_ANSIBLE" ]; then
            die "At least one of --output-shell or --output-ansible is required (nothing to produce otherwise). See --help."
        fi
        # The saved copy drops the comments and, for an embedded secret, the
        # secret itself: writing it over its source would lose both.
        if [ -n "$SAVE_CONFIG" ] && [ "$SAVE_CONFIG" -ef "$CONFIG_FILE" ]; then
            die "--save-config would overwrite the --config file $CONFIG_FILE; pick another path"
        fi
        load_config "$CONFIG_FILE"
    else
        run_questionnaire
    fi

    validate_inputs
    build_output_plan

    # If --bundle is set, we will fetch JWKS regardless of primary role.
    print_recap

    # Before the SSO fetch: the answers are kept even if the portal is down.
    if [ -n "$SAVE_CONFIG" ]; then
        save_config "$SAVE_CONFIG"
    fi

    if [ "$DRY_RUN" = "1" ]; then
        log_warn "DRY-RUN: no files will be written"
    fi

    fetch_sso_assets

    # One pass per role; with --bundle the last entry is the companion role.
    local i sh an
    for ((i=0; i<${#_PLAN_ROLES[@]}; i++)); do
        if [ "$BUNDLE" = "1" ] && [ "$i" -gt 0 ]; then
            log_step "Bundle: also generating ${_PLAN_ROLES[$i]} artefact"
        fi
        run_outputs_for_role "${_PLAN_ROLES[$i]}" "${_PLAN_SHELL[$i]}" "${_PLAN_ANSIBLE[$i]}"
    done

    log_step "Done"
    for ((i=0; i<${#_PLAN_ROLES[@]}; i++)); do
        sh="${_PLAN_SHELL[$i]}"; an="${_PLAN_ANSIBLE[$i]}"
        if [ -n "$sh" ]; then
            log_info "[${_PLAN_ROLES[$i]}] Shell installer:  $sh"
            [ -n "$SIGN_WITH" ] && log_info "[${_PLAN_ROLES[$i]}] Signature:        ${sh}.sig"
            log_info "[${_PLAN_ROLES[$i]}] Portal checklist: $(dirname -- "$sh")/PORTAL-CHECKLIST-${_PLAN_ROLES[$i]}.md"
        fi
        [ -n "$an" ] && log_info "[${_PLAN_ROLES[$i]}] Ansible role:     $an"
    done
    return 0
}

main "$@"
