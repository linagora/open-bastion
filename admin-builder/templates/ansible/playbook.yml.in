---
# Open Bastion deployment — auto-generated by ob-builder @@OB_BUILDER_VERSION@@
# Build:    @@BUILD_DATE@@
# Slug:     @@DEPLOYMENT_SLUG@@
# Scenario: @@SCENARIO@@ (Mode @@PAM_MODE@@)
# Role:     @@TARGET_ROLE@@
#
# Run with:
#   ansible-playbook -i inventory.yml playbook-@@TARGET_ROLE@@.yml
# or, to play every role of the deployment in order:
#   ansible-playbook -i inventory.yml site.yml
#
# Only the hosts that declare ob_role: @@TARGET_ROLE@@ (host_vars/group_vars)
# are configured; the others are skipped untouched.
#
# To pass the client secret at runtime (recommended):
#   ansible-playbook -i inventory.yml playbook-@@TARGET_ROLE@@.yml \
#     --extra-vars "ob_client_secret=$(cat /path/to/secret)"
#
# Or use ansible-vault:
#   ansible-playbook -i inventory.yml playbook-@@TARGET_ROLE@@.yml --ask-vault-pass

- hosts: all
  become: true
@@ANSIBLE_VARS_PROMPT_BLOCK@@
  roles:
    - role: open-bastion-@@TARGET_ROLE@@
