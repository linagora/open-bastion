---
# Open Bastion — main task entry point
# Auto-generated by ob-builder @@OB_BUILDER_VERSION@@
# Scenario: @@SCENARIO@@ (Mode @@PAM_MODE@@) | Role: @@TARGET_ROLE@@

# This tree configures one role. A host that declares none, or another one, is
# never contacted: the guards below are controller-side evaluations, and the
# play sets gather_facts: false, so no connection is opened before the host is
# known to be ours. site.yml plays every tree over the same inventory, and each
# host belongs to exactly one of them. Skipping rather than failing is what
# makes that work; a wrong VALUE still fails (below), so a typo is not
# mistaken for "not my host".
- name: Skip hosts that declare no role
  ansible.builtin.meta: end_host
  when: ob_role is not defined

- name: Check the declared role
  ansible.builtin.assert:
    that:
      - ob_role in ['bastion', 'standalone', 'backend']
    fail_msg: >-
      ob_role must be bastion, standalone or backend (got '{{ ob_role }}').
      Declare it in host_vars/group_vars for every host of the inventory.
  when: ob_role is defined

- name: Skip the hosts another role tree configures
  ansible.builtin.meta: end_host
  when: ob_role != ob_artefact_role

# Maximum security locks sudo to SSO tokens on every role (#361): once the
# setup has run, the stack refuses every local account, and each task with
# become would fail with "Missing sudo password". Read the stack without
# become (it is 0644) and leave such a host alone. Locked means the stack the
# setup writes: auth and account lines are pam_openbastion and pam_deny only.
# A hand edit that lets an account through (service-accounts.rst) adds another
# line, and the host is played as before.
- name: Read the sudo PAM stack
  ansible.builtin.slurp:
    src: /etc/pam.d/sudo
  become: false
  register: ob_pam_sudo
  failed_when: false
  check_mode: false

- name: Check whether sudo only takes SSO tokens
  ansible.builtin.set_fact:
    ob_sudo_locked: >-
      {{ (_ob_rules | select('match', 'account\s+\S+\s+pam_openbastion\.so(\s|$)') | list | length > 0)
         and (_ob_rules | reject('match', '-?session\s')
              | reject('match', '(auth|account)\s+\S+\s+pam_(openbastion|deny)\.so(\s|$)')
              | list | length == 0) }}
  vars:
    _ob_rules: >-
      {{ ((ob_pam_sudo.content | default('')) | b64decode).splitlines()
         | map('trim') | reject('match', '(#|$)') | list }}

- name: Warn that the role leaves this host alone
  ansible.builtin.debug:
    msg: >-
      {{ inventory_hostname }} runs maximum security: its sudo only takes SSO
      tokens, so Ansible cannot become root there after the run that deployed
      it, and the role skips it. To change its configuration, run
      ob-{{ ob_artefact_role }}-setup by hand from an SSO session allowed to
      sudo, or reinstall the host and run the play again.{% if ob_artefact_role == 'bastion' %}
      Backends configured by a later run cannot read its id: set
      ob_bastion_allowed_bastions in the inventory (ob-bastion-id prints it).{% endif %}
  when: ob_sudo_locked | bool

- name: Skip the hosts whose sudo only takes SSO tokens
  ansible.builtin.meta: end_host
  when: ob_sudo_locked | bool

# The guards above are controller-side or run without become, which is what
# lets a host that is not ours end the play without a connection ever being
# opened to it, and a locked one without a sudo attempt. Everything below
# reads ansible_facts['os_family'].
- name: Gather facts
  ansible.builtin.setup:

- name: Pre-checks
  ansible.builtin.assert:
    that:
      - ob_portal_url is defined and ob_portal_url | length > 0
      - ob_pam_mode in ['A', 'B', 'C', 'D', 'E']
    fail_msg: >-
      Required variables are missing or invalid.
      Set ob_portal_url and ob_pam_mode (A-E) in the role's defaults.

# Signed answers need the JWKS of the relying party the host enrols as: the
# one in files/ belongs to ob_sso_jwks_client_id; one fetched at play time
# (ob_sso_jwks_fetch) is ob_client_id's own.
- name: Check the signed-answers settings
  ansible.builtin.assert:
    that:
      - ob_response_signing | default('off') in ['off', 'prefer', 'required']
      - (ob_response_signing | default('off')) == 'off' or ob_sso_jwks_available | bool
      - >-
        (ob_response_signing | default('off')) == 'off' or (ob_sso_jwks_fetch | default(false) | bool)
        or ob_client_id == (ob_sso_jwks_client_id | default(''))
      - not (ob_sso_jwks_fetch | default(false) | bool) or (ob_client_id | default('')) | length > 0
    fail_msg: >-
      ob_response_signing is {{ ob_response_signing | default('off') }}, which
      needs the portal's JWKS for client_id {{ ob_client_id }}: the role carries
      {{ (ob_sso_jwks_src | default('')) | ternary('the one of client_id ' ~ (ob_sso_jwks_client_id | default('')), 'none') }}.
      Set ob_sso_jwks_fetch to true to fetch that client_id's at play time
      (ob_client_id must then be set), or ob_sso_jwks_src, ob_sso_jwks_sha256
      and ob_sso_jwks_client_id for it, or ob_response_signing to off.

- name: Install prerequisites
  ansible.builtin.apt:
    name:
      - gnupg
      - curl
      - apt-transport-https
    state: present
    update_cache: true
  when: ansible_facts['os_family'] == 'Debian'

- name: Deploy APT keyring
  ansible.builtin.copy:
    src: open-bastion.gpg
    dest: /etc/apt/keyrings/open-bastion.gpg
    owner: root
    group: root
    mode: '0644'
  when: ansible_facts['os_family'] == 'Debian'

- name: Deploy APT sources.list entry
  ansible.builtin.copy:
    content: "{{ ob_apt_sources_list_line }}\n"
    dest: /etc/apt/sources.list.d/open-bastion.list
    owner: root
    group: root
    mode: '0644'
  when: ansible_facts['os_family'] == 'Debian'

- name: Install open-bastion package
  ansible.builtin.apt:
    name: open-bastion
    state: present
    update_cache: true
  when: ansible_facts['os_family'] == 'Debian'

- name: Create /etc/open-bastion directory
  ansible.builtin.file:
    path: /etc/open-bastion
    state: directory
    owner: root
    group: root
    # 0711, not 0700: the AuthorizedKeysCommandUser (nobody) must traverse this
    # directory to read service-accounts.d/<name>.pub. Secrets inside are each
    # 0600 root, so traverse-only is safe and the directory stays unlistable.
    mode: '0711'

- name: Deploy SSH CA public key
  ansible.builtin.copy:
    src: open-bastion-ca.pub
    dest: /etc/ssh/open-bastion_ca.pub
    owner: root
    group: root
    mode: '0644'

# The trust anchor of signed portal answers (#339) is state, not configuration:
# ob-heartbeat replaces it on a verified key rotation, and may only write under
# /var/lib/open-bastion. The package makes this directory; asserted here for an
# ob_sso_jwks_file elsewhere under /var/lib/open-bastion. root:root 0755.
- name: Create the directory of the portal's JWKS
  ansible.builtin.file:
    path: "{{ ob_sso_jwks_file | dirname }}"
    state: directory
    owner: root
    group: root
    mode: '0755'
  when: ob_sso_jwks_available | bool

# The build-time JWKS goes on a host only once (#371), like the installer's
# without --force: a later run would put it back over the key set ob-heartbeat
# rotated since, and once the portal drops the old key every SSO login fails
# under required. Kept when the modules would load the host's file and the
# host still enrols as ob_client_id (openbastion.conf, deployed below, still
# names the previous one); ob_sso_jwks_force deploys it anyway.
- name: Check the JWKS already on the host
  ansible.builtin.command:
    argv: ['/usr/sbin/ob-verify-response', 'check-jwks', '--anchor', '--quiet', "{{ ob_sso_jwks_file }}"]
  register: _ob_jwks_check
  changed_when: false
  failed_when: false
  check_mode: false
  when: ob_sso_jwks_available | bool

# The file also holds client_secret: keep it out of the play's output.
- name: Read the client_id the host enrols as
  ansible.builtin.slurp:
    src: /etc/open-bastion/openbastion.conf
  register: _ob_conf_current
  no_log: true
  failed_when: false
  check_mode: false
  when: ob_sso_jwks_available | bool

- name: Decide whether to deploy the portal's JWKS
  ansible.builtin.set_fact:
    ob_sso_jwks_deploy: >-
      {{ ob_sso_jwks_available | bool
         and ((ob_sso_jwks_force | default(false) | bool)
              or _ob_jwks_check.rc | default(1) != 0
              or _ob_client_ids != [ob_client_id]) }}
  vars:
    _ob_client_ids: >-
      {{ ((_ob_conf_current.content | default('')) | b64decode).splitlines()
         | select('match', '\s*client_id\s*=')
         | map('regex_replace', '^\s*client_id\s*=\s*(.*?)\s*$', '\1') | list }}

# ob_sso_jwks_fetch: the JWKS of the host's ob_client_id, fetched by the
# controller now rather than by ob-builder at build time (#371). Same trust:
# TLS from the admin side, which ob_sso_jwks_fetch_sha256 can pin. Only when
# it is to be deployed: a kept JWKS follows the portal's rotations already.
- name: Check the JWKS URL
  ansible.builtin.assert:
    that:
      - (ob_sso_jwks_url | lower).startswith('https://') or not (ob_verify_ssl | default(true) | bool)
    fail_msg: >-
      ob_sso_jwks_url ({{ ob_sso_jwks_url }}) is not https://: the fetched keys
      would be trusted on a cleartext answer. Use the portal's https:// URL, or
      ob_verify_ssl: false on a test setup only.
  delegate_to: localhost
  become: false
  when:
    - ob_sso_jwks_fetch | default(false) | bool
    - ob_sso_jwks_deploy | bool

- name: Fetch the portal's JWKS for the host's client_id
  ansible.builtin.uri:
    url: "{{ ob_sso_jwks_url }}?client_id={{ ob_client_id | urlencode }}"
    return_content: true
    validate_certs: "{{ ob_verify_ssl | default(true) | bool }}"
    headers:
      Accept: application/json
  register: _ob_jwks_fetched
  delegate_to: localhost
  become: false
  check_mode: false
  when:
    - ob_sso_jwks_fetch | default(false) | bool
    - ob_sso_jwks_deploy | bool

# The canonical form ob-builder and ob-*-setup fingerprint (`jq -S -c .`,
# UTF-8), which ob-verify-response checks below before the file takes its
# place. Private members are refused here too, before anything is written,
# as the builder's and the setup's filters refuse them.
- name: Check the fetched JWKS
  ansible.builtin.assert:
    that:
      - _ob_jwks_fetched.json is mapping
      - _ob_jwks_fetched.json['keys'] is defined
      - _ob_jwks_fetched.json['keys'] is sequence
      - _ob_jwks_fetched.json['keys'] | length > 0
      - >-
        _ob_jwks_fetched.json['keys'] | select('mapping')
        | map('dict2items') | map('map', attribute='key') | map('intersect', _ob_jwk_private)
        | select | list | length == 0
      - >-
        (ob_sso_jwks_fetch_sha256 | default('')) | length == 0
        or (ob_sso_jwks_fetch_sha256 | lower) == (_ob_jwks_canonical | hash('sha256'))
    fail_msg: >-
      {{ ob_sso_jwks_url }}?client_id={{ ob_client_id }} did not return a JWKS
      of public keys
      {{- ' matching ob_sso_jwks_fetch_sha256 (got ' ~ (_ob_jwks_canonical | hash('sha256')) ~ ')'
          if (ob_sso_jwks_fetch_sha256 | default('')) | length > 0 else '' }}.
  vars:
    _ob_jwks_canonical: "{{ _ob_jwks_fetched.json | to_json(sort_keys=true, separators=[',', ':'], ensure_ascii=false) }}\n"
    # Private key material: `d` and the RSA CRT members, as the builder's and
    # the setup's filters refuse.
    _ob_jwk_private: [d, p, q, dp, dq, qi, oth]
  delegate_to: localhost
  become: false
  when:
    - ob_sso_jwks_fetch | default(false) | bool
    - ob_sso_jwks_deploy | bool

- name: Keep the fetched JWKS
  ansible.builtin.set_fact:
    ob_sso_jwks_content: "{{ _ob_jwks_fetched.json | to_json(sort_keys=true, separators=[',', ':'], ensure_ascii=false) }}\n"
  when:
    - ob_sso_jwks_fetch | default(false) | bool
    - ob_sso_jwks_deploy | bool

# A regular file, root:root, not writable by group or others, or the PAM and
# NSS modules refuse to load it: checked by the modules' own loader before it
# replaces the host's. Deployed before openbastion.conf, which names it.
- name: Deploy the portal's JWKS
  ansible.builtin.copy:
    src: "{{ omit if ob_sso_jwks_fetch | default(false) | bool else ob_sso_jwks_src }}"
    content: "{{ ob_sso_jwks_content if ob_sso_jwks_fetch | default(false) | bool else omit }}"
    dest: "{{ ob_sso_jwks_file }}"
    owner: root
    group: root
    mode: '0644'
    follow: false
    validate: /usr/sbin/ob-verify-response check-jwks --anchor --quiet %s
  when: ob_sso_jwks_deploy | bool

- name: Keep the host's JWKS
  ansible.builtin.debug:
    msg: >-
      Keeping {{ ob_sso_jwks_file }}: it may hold keys ob-heartbeat rotated
      since it was deployed. Set ob_sso_jwks_force to true to deploy the
      role's JWKS over it (with ob_sso_jwks_fetch, the portal's current one).
  when:
    - ob_sso_jwks_available | bool
    - not (ob_sso_jwks_deploy | bool)

# KRL (Key Revocation List) is mandatory in Mode E — certificate revocation
# requires an up-to-date KRL on every bastion and backend.
- name: Deploy KRL
  ansible.builtin.copy:
    src: open-bastion-krl
    dest: /etc/ssh/revoked_keys
    owner: root
    group: root
    mode: '0644'
  when: ob_max_security

# Appended to openbastion.conf by the template; absent before the package is
# installed (check mode on a new host), in which case the conf goes without it.
- name: Read the option reference the package ships
  ansible.builtin.slurp:
    src: /usr/share/open-bastion/openbastion.conf.reference
  register: ob_conf_reference
  failed_when: false

- name: Deploy openbastion.conf
  ansible.builtin.template:
    src: openbastion.conf.j2
    dest: /etc/open-bastion/openbastion.conf
    owner: root
    group: root
    mode: '0600'
  notify: Restart sshd

# Service accounts (SSH-key-only local accounts). Deployed only when enabled at
# build time (or overridden via host_vars/group_vars). 0600 root:root, as the
# PAM module requires.
- name: Deploy service-accounts.conf
  ansible.builtin.copy:
    content: "{{ ob_service_accounts_content }}"
    dest: /etc/open-bastion/service-accounts.conf
    owner: root
    group: root
    mode: '0600'
  when: ob_service_accounts_enabled | default(false)

# service-accounts.conf says what fingerprint to expect; it gives sshd nothing
# to accept. Without these files the account cannot log in and the deployment
# looks complete (#263). 0644 under a 0755 directory: the
# AuthorizedKeysCommandUser (nobody) reads them.
- name: Create the service-account key directory
  ansible.builtin.file:
    path: /etc/open-bastion/service-accounts.d
    state: directory
    owner: root
    group: root
    mode: '0755'
  when: (ob_service_account_keys | default('')) | length > 0

- name: Deploy service-account public keys
  ansible.builtin.copy:
    content: "{{ item.split(' ', 1)[1] }}\n"
    dest: "/etc/open-bastion/service-accounts.d/{{ item.split(' ', 1)[0] }}.pub"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ (ob_service_account_keys | default('')).splitlines() | select('search', ' ') | list }}"
  loop_control:
    label: "{{ item.split(' ', 1)[0] }}"

# open-bastion never creates a service account (#353): the operator does, with
# useradd. Check each declared account exists and say so when it does not, since
# sshd refuses the login of a missing account with everything else deployed.
# Names are read from the conf (its [section] lines), so a host_vars override is
# followed. Read-only, so it also runs in check mode, and it never fails the play.
- name: Check the service accounts exist on the host
  ansible.builtin.command:
    argv: ['getent', 'passwd', "{{ item }}"]
  loop: >-
    {{ (ob_service_accounts_content | default('')).splitlines()
       | reject('match', '^(#|$)') | reject('search', '=')
       | map('regex_replace', '^.', '') | map('regex_replace', '.$', '') | list }}
  register: ob_svc_accounts_getent
  changed_when: false
  failed_when: false
  check_mode: false
  when: ob_service_accounts_enabled | default(false)

# A host that records sessions runs the account's shell with the recorder as its
# command: with bash its rc files run first and could escape the recording.
- name: Warn about service accounts missing on the host
  ansible.builtin.debug:
    msg: >-
      Service account '{{ item.item }}' does not exist on this host and
      open-bastion does not create it. Run: useradd --system --create-home
      --shell {{ '/usr/sbin/ob-login-shell'
                 if (ob_artefact_role in ['bastion', 'standalone']
                     and not (ob_disable_session_recorder | default(false) | bool))
                 else '/bin/bash' }} {{ item.item }}
  loop: "{{ ob_svc_accounts_getent.results | default([]) | selectattr('rc', 'ne', 0) | list }}"
  loop_control:
    label: "{{ item.item }}"
  when: ob_service_accounts_enabled | default(false)

# The keys are only half of it: sshd needs the AuthorizedKeysCommand that serves
# them, which is a host-wide change and therefore opt-in.
# Remove keys for accounts no longer declared. Without this the directory is
# write-only: dropping an account from service_accounts: converges the .conf but
# leaves its .pub served, and ob-service-account-keys offers ANY present file
# without consulting the .conf -- so the account keeps being offered at the SSH
# layer indefinitely, and re-adding it fingerprint-only makes sshd offer the
# stale key while PAM denies it.
- name: Remove service-account keys that are no longer declared
  ansible.builtin.shell: |
    set -eu
    keep=$(printf '%s\n' "{{ ob_service_account_keys | default('') }}" \
           | awk 'NF {print $1 ".pub"}')
    cd /etc/open-bastion/service-accounts.d 2>/dev/null || exit 0
    for f in *.pub; do
      [ -e "$f" ] || continue
      printf '%s\n' "$keep" | grep -qxF "$f" || { rm -f -- "$f"; echo "removed $f"; }
    done
  register: ob_svc_keys_pruned
  changed_when: "'removed ' in ob_svc_keys_pruned.stdout"

- name: Dispatch role-specific tasks
  ansible.builtin.include_tasks: "{{ ob_artefact_role }}.yml"

# After the dispatch, not before: the setup run it includes is what installs
# the drop-in that serves the keys (--enable-service-keys), so checking first
# warned on every fresh deployment. When the setup ran, it checked in its own
# task (ob_setup_cmd, vars/main.yml): under maximum security it has locked
# sudo, and this task could not become root any more (#361).
- name: Check sshd serves the service-account keys
  ansible.builtin.shell: |
    set -u
    {{ ob_svc_keys_sshd_sh }}
    echo "ob-service-keys-sshd: $served"
  register: ob_svc_keys_sshd
  changed_when: false
  failed_when: false
  when: ob_setup_run is not defined or ob_setup_run is skipped

- name: Warn when sshd has no AuthorizedKeysCommand for service accounts
  ansible.builtin.debug:
    msg: >-
      Service-account keys were deployed, but sshd has no AuthorizedKeysCommand
      to serve them. Run "ob-bastion-setup --enable-service-keys" (or
      ob-backend-setup) on this host, or the accounts cannot log in.
  when:
    - ob_service_accounts_enabled | default(false)
    - "not ((ob_setup_run.stdout | default('')) is search('^ob-service-keys-sshd: yes$', multiline=True))"
    - "not ((ob_svc_keys_sshd.stdout | default('')) is search('^ob-service-keys-sshd: yes$', multiline=True))"
