---
# Open Bastion — backend role tasks
# Auto-generated by ob-builder @@OB_BUILDER_VERSION@@
# Scenario: @@SCENARIO@@ (Mode @@PAM_MODE@@)

# Enrollment uses Device Authorization Grant. By default the admin must open
# the printed URL and approve in a browser; if ob_ansible_auto_approve was
# enabled at build time and an LLNG cookie is provided at play time, the
# included tasks below approve the device code via the LLNG /device endpoint
# instead, so the play can run unattended on a fleet.
- name: "Run enrollment flow (auto-approve or manual)"
  ansible.builtin.include_tasks: _enroll.yml
  when: ob_auto_enroll
  vars:
    ob_role: backend

# The allowlist is the bastion_ids the portal assigned at enrolment, and the
# only place they exist is on the bastions. With no build-time list, read them
# there instead of asking the admin to copy them around: ob-bastion-id needs
# root (it reads the 0600 server token), which the play's become provides on
# the delegated host. An explicit ob_bastion_allowed_bastions wins, empty
# string included ("" = accept any vouched bastion, as ob-backend-setup's
# --allow-any-bastion).
- name: Read each bastion's id
  ansible.builtin.command: ob-bastion-id
  delegate_to: "{{ item }}"
  loop: "{{ groups.get(ob_bastion_group, []) }}"
  register: ob_bastion_ids
  changed_when: false
  # Read-only probe, and the tasks below consume its result: skipped in check
  # mode, the assert would fail on a missing 'stdout' rather than preview the
  # run.
  check_mode: false
  when:
    - ob_auto_setup
    - ob_bastion_allowed_bastions is not defined

# A missing group loops over nothing, and nothing is an allowlist too: the
# file would be written empty, which accepts any vouched bastion. Refuse
# instead. A delegated bastion that is unreachable or not enrolled fails its
# own item above, so this only has to catch the silent cases.
- name: Check every bastion answered
  ansible.builtin.assert:
    that:
      - groups.get(ob_bastion_group, []) | length > 0
      - ob_bastion_ids.results | length == groups.get(ob_bastion_group, []) | length
      - ob_bastion_ids.results | map(attribute='stdout') | map('trim') | select('eq', '') | length == 0
    fail_msg: >-
      Could not collect the bastion ids from ob_bastion_group
      ('{{ ob_bastion_group }}'): the group must exist, hold every bastion of
      this deployment, and each of them must answer ob-bastion-id (enrolled,
      reachable, root). Set ob_bastion_allowed_bastions explicitly to skip the
      collection; the empty string accepts any vouched bastion.
  when:
    - ob_auto_setup
    - ob_bastion_allowed_bastions is not defined

- name: Derive the allowed bastions from them
  ansible.builtin.set_fact:
    ob_bastion_allowed_bastions: >-
      {{ ob_bastion_ids.results | map(attribute='stdout') | map('trim') | join(',') }}
  when:
    - ob_auto_setup
    - ob_bastion_allowed_bastions is not defined

- name: Configure backend (ob-backend-setup)
  ansible.builtin.command:
    argv: >-
      {{
        ['/usr/sbin/ob-backend-setup',
         '--portal', ob_portal_url,
         '-g', ob_server_group,
         '-c', ob_client_id,
         '--yes']
        + (['--insecure'] if not (ob_verify_ssl | default(true) | bool) else [])
        + (['--allowed-bastions', ob_bastion_allowed_bastions]
           if ob_bastion_allowed_bastions is defined else [])
        + (['--max-security'] if ob_max_security else [])
        + (['--enable-hardening'] if ob_enable_hardening else [])
        + (['--enable-audit-trace'] if ob_enable_audit_trace else [])
      }}
  environment:
    OB_CLIENT_SECRET: "{{ ob_client_secret }}"
  when: ob_auto_setup
  changed_when: true
