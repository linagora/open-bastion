---
# Open Bastion Ansible role — internal constants (settings are in defaults/)
# Auto-generated by ob-builder @@OB_BUILDER_VERSION@@

# Sets served=yes when sshd serves the service-account keys: a file holds both
# the AuthorizedKeysCommand of ob-service-account-keys and ExposeAuthInfo yes.
# Anchored, and over *.conf only: `grep -r ob-service-account-keys` matched a
# commented-out line, a .bak left beside a drop-in, or a pre-#265 two-directive
# file with no ExposeAuthInfo -- all of which silence the warning while nothing
# is actually served or verified. Errors are dropped: a drop-in only root can
# read (cloud-init's 50-cloud-init.conf) is not one of ours (#361).
ob_svc_keys_sshd_sh: |
  served=no
  for f in /etc/ssh/sshd_config.d/*.conf /etc/ssh/sshd_config; do
    [ -f "$f" ] || continue
    grep -qiE '^[[:space:]]*AuthorizedKeysCommand[[:space:]].*ob-service-account-keys' "$f" 2>/dev/null || continue
    grep -qiE '^[[:space:]]*ExposeAuthInfo[[:space:]]+yes' "$f" 2>/dev/null && served=yes
  done

# Prefix of the setup task's argv: runs the setup given as arguments, then the
# check above, in the same become. Under maximum security the setup locks sudo
# to SSO tokens (#361): no later task of the role can become root to look.
# The last line of stdout is the verdict, read by tasks/main.yml.
ob_setup_cmd:
  - /bin/sh
  - -c
  - |
    "$@" || exit $?
    {{ ob_svc_keys_sshd_sh }}
    echo "ob-service-keys-sshd: $served"
  - ob-setup
