# Open Bastion configuration
# Generated by ob-builder @@OB_BUILDER_VERSION@@ on @@BUILD_DATE@@
# Scenario: @@SCENARIO@@ (PAM Mode @@PAM_MODE@@) | Role: @@TARGET_ROLE@@

# SSO portal URL
portal_url = @@PORTAL_URL@@

# OIDC client credentials
# client_id and server_group are resolved at install time (see installer)
client_id = ##CLIENT_ID##
client_secret = ##CLIENT_SECRET##

# Server group (must match a group defined in LLNG pamAccessServerGroups)
server_group = ##SERVER_GROUP##

# TLS verification of the portal (false only with the installer's --insecure,
# for a plain-http or self-signed test portal)
verify_ssl = ##VERIFY_SSL##

# Signed portal answers (#339), checked against the portal's JWKS deployed
# with this artefact (/var/lib/open-bastion/jwks/sso-jwks.json). prefer still accepts
# the unsigned answers of a portal whose plugin does not sign yet; switch to
# required once it does (see UPGRADE-NOTES.md). off when no JWKS was deployed.
response_signing = ##RESPONSE_SIGNING##
sso_jwks_file = /var/lib/open-bastion/jwks/sso-jwks.json

# Mode-specific settings — scenario: @@SCENARIO@@ (PAM Mode @@PAM_MODE@@)
@@MODE_SETTINGS@@

# Audit
log_level = warn
audit_enabled = true

@@SERVICE_ACCOUNTS_FILE_LINE@@

@@BASTION_BACKEND_BLOCK@@
